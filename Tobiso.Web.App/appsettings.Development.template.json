{
  "ConnectionStrings": {
    "DefaultConnection": "server=YOUR_SERVER;user=YOUR_USER;password=YOUR_PASSWORD;database=YOUR_DATABASE;Encrypt=False"
  },
  "Auth": {
    "Basic": {
      "Username": "YOUR_USERNAME",
      "Password": "YOUR_PASSWORD",
      "UserId": "YOUR_USER_ID"
    }
  },
  "Api": {
    "BaseAddress": "https://localhost:7271"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Tobiso.Web.App.Handlers": "Debug"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "Tobiso.Web.App.Handlers": "Debug",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "C:/Logs/yourapp.dev.log",
          "rollingInterval": "Day",
          "shared": true
        }
      }
    ]
  },
  "OpenAI": {
    "ApiKey": "sk-proj-IDK",
    "Model": "gpt-4o-mini",
    "IgnoreInvalidCertificates": "true",
    "SystemPrompt": "xx",
    "PersonSystemPrompt": "Jsi asistent pro faktické informace, který generuje informační karty o osobách. Odpovídej POUZE v podobě nezpracovaného objektu JSON – bez formátování Markdown, bez volného textu, bez bloků kódu. Poskytuj přesné a stručné faktické informace. U polí, u nichž si nejsi jistý, zadej hodnotu null u číselných polí a prázdný řetězec u textových polí. Nevymýšlej si ani nespekuluj.",
    "MaxDailyRequests": "10",
    "ClientLimits": {
      "tobiso-android": "20"
    }
  }
}
