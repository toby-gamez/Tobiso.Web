@using System.Text.Json
@using Tobiso.Web.Shared.DTOs
@using Tobiso.Web.Shared.Interfaces
@inject IInteractiveExerciseService ExerciseService
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="exercise-shell">
    @if (_unplaced.Count > 0)
    {
        <div class="chip-row">
            @foreach (var item in _unplaced)
            {
                <button class="chip @(_selectedItem == item.Id ? "chip-sel" : "")" @onclick="() => SelectItem(item.Id)">@item.Text</button>
            }
        </div>
    }

    <div class="categories-grid">
        @foreach (var category in _categories)
        {
            <button class="bucket @(_selectedItem != null ? "bucket-target" : "")" @onclick="() => PlaceInCategory(category.Id)">
                <span class="bucket-label">@category.Label</span>
                @foreach (var itemId in _placements.Where(p => p.Value == category.Id).Select(p => p.Key))
                {
                    var item = _items.FirstOrDefault(i => i.Id == itemId);
                    if (item != null)
                    {
                        var cls = GetItemClass(item.Id);
                        <span class="exercise-pill @cls" @onclick="() => RemoveItem(item.Id)" @onclick:stopPropagation="true">@item.Text</span>
                    }
                }
            </button>
        }
    </div>

    <div class="exercise-actions">
        <button class="pill" @onclick="Reset"><i data-lucide="rotate-ccw"></i> Znovu</button>
        <button class="pill pill-on" @onclick="CheckSolution" disabled="@(_checking || _placements.Count != _items.Count)">
            @if (_checking)
            {
                <i data-lucide="loader-2" class="spin-icon"></i>
            }
            Zkontrolovat
        </button>
        @if (_validationResult != null)
        {
            <span class="exercise-score @(_validationResult.IsCorrect ? "correct" : "incorrect")">@_validationResult.Feedback</span>
        }
        <span class="exercise-actions-spacer"></span>
        <div class="tooltip">
            <button class="help-btn" type="button" aria-label="Návod k ovládání"><i data-lucide="help-circle"></i></button>
            <span class="tooltip-text">Klikni na prvek, potom na správnou kategorii. Klikni na umístěný prvek pro jeho vrácení.</span>
        </div>
    </div>
</div>

<style>
    .chip-row {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }
    .categories-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: var(--space-3);
    }
    .bucket-label {
        font-family: var(--font-heading);
        font-size: 17px;
    }
</style>


@code {
    [Parameter, EditorRequired]
    public InteractiveExerciseResponse Exercise { get; set; } = null!;

    private List<DragDropCategory> _categories = new();
    private List<DragDropItem> _items = new();
    private Dictionary<string, string> _placements = new(); // itemId -> categoryId
    private string? _selectedItem;
    private bool _checking = false;
    private ExerciseValidationResult? _validationResult;
    private Dictionary<string, bool> _placementResults = new();
    private int? _loadedExerciseId;

    private List<DragDropItem> _unplaced => _items.Where(i => !_placements.ContainsKey(i.Id)).ToList();

    protected override void OnParametersSet()
    {
        if (_loadedExerciseId == Exercise.Id) return;
        _loadedExerciseId = Exercise.Id;
        LoadConfig();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("initLucide");
    }

    private void LoadConfig()
    {
        try
        {
            var doc = JsonDocument.Parse(Exercise.ConfigJson);

            if (doc.RootElement.TryGetProperty("categories", out var categoriesArray))
            {
                _categories.Clear();
                foreach (var item in categoriesArray.EnumerateArray())
                {
                    _categories.Add(new DragDropCategory
                    {
                        Id = item.GetProperty("id").GetString() ?? "",
                        Label = item.GetProperty("label").GetString() ?? ""
                    });
                }
            }

            if (doc.RootElement.TryGetProperty("items", out var itemsArray))
            {
                _items.Clear();
                foreach (var item in itemsArray.EnumerateArray())
                {
                    _items.Add(new DragDropItem
                    {
                        Id = item.GetProperty("id").GetString() ?? "",
                        Text = item.GetProperty("text").GetString() ?? ""
                    });
                }

                _items = _items.OrderBy(x => Guid.NewGuid()).ToList();
            }
        }
        catch
        {
            // Ignore
        }
    }

    private void SelectItem(string itemId)
    {
        _selectedItem = _selectedItem == itemId ? null : itemId;
    }

    private void PlaceInCategory(string categoryId)
    {
        if (_selectedItem == null) return;
        _placements[_selectedItem] = categoryId;
        _selectedItem = null;
        _validationResult = null;
    }

    private void RemoveItem(string itemId)
    {
        _placements.Remove(itemId);
        _validationResult = null;
    }

    private void Reset()
    {
        _placements.Clear();
        _selectedItem = null;
        _validationResult = null;
        _placementResults.Clear();
        LoadConfig(); // Znovu zamíchat
    }

    private async Task CheckSolution()
    {
        _checking = true;
        _validationResult = null;

        try
        {
            var userSolution = new { placements = _placements };
            var request = new ValidateSolutionRequest
            {
                UserSolutionJson = JsonSerializer.Serialize(userSolution)
            };

            _validationResult = await ExerciseService.ValidateSolutionAsync(Exercise.Id, request);
            _placementResults.Clear();
            if (_validationResult?.DetailedResults != null)
            {
                foreach (var kv in _validationResult.DetailedResults)
                {
                    _placementResults[kv.Key] = kv.Value;
                }
            }
        }
        catch (Exception ex)
        {
            _validationResult = new ExerciseValidationResult
            {
                IsCorrect = false,
                Score = 0,
                Feedback = $"Chyba při validaci: {ex.Message}"
            };
        }
        finally
        {
            _checking = false;
        }
    }

    private string GetItemClass(string itemId)
    {
        if (_placementResults.TryGetValue(itemId, out var ok))
            return ok ? "correct" : "incorrect";
        return string.Empty;
    }

    private class DragDropCategory
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
    }

    private class DragDropItem
    {
        public string Id { get; set; } = "";
        public string Text { get; set; } = "";
    }
}
