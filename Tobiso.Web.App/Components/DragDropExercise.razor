@using System.Text.Json
@using Tobiso.Web.Shared.DTOs
@using Tobiso.Web.Shared.Interfaces
@inject IInteractiveExerciseService ExerciseService
@rendermode InteractiveServer

<div class="dragdrop-exercise">
    <div class="card dragdrop-card">
        <div class="card-body">
            <div class="dragdrop-info-banner">
                <i class="bi bi-info-circle-fill"></i>
                <div>
                    <strong>Návod k ovládání:</strong>
                    <span>Uchop prvek myší a přetáhni ho do správné kategorie • Klikni na prvek v kategorii pro vrácení • Zkontroluj řešení tlačítkem</span>
                </div>
            </div>

            <div class="categories-container">
                @foreach (var category in _categories)
                {
                    <div class="category-zone @(GetCategoryClass(category.Id)) @(_dragOverCategory == category.Id ? "drag-over" : "")"
                         @ondrop="(e) => OnDrop(e, category.Id)"
                         @ondrop:preventDefault="true"
                         @ondrop:stopPropagation="true"
                         @ondragover="OnDragOver"
                         @ondragover:preventDefault="true"
                         @ondragover:stopPropagation="true"
                         @ondragenter="() => OnDragEnter(category.Id)"
                         @ondragenter:stopPropagation="true"
                         @ondragleave="OnDragLeave"
                         @ondragleave:stopPropagation="true">
                        <div class="category-header">
                            <i class="bi bi-folder-fill"></i>
                            <h6 class="category-title">@category.Label</h6>
                            <span class="category-count">@_userPlacements.Count(p => p.Value == category.Id)</span>
                        </div>
                        <div class="category-items">
                            @foreach (var itemId in _userPlacements.Where(p => p.Value == category.Id).Select(p => p.Key))
                            {
                                var item = _items.FirstOrDefault(i => i.Id == itemId);
                                if (item != null)
                                {
                                    <div class="draggable-item @(_draggedItem == itemId ? "dragging" : "")" 
                                         draggable="true"
                                         @ondragstart="() => OnDragStart(itemId)"
                                         @ondragend="OnDragEnd"
                                         @onclick="() => RemoveItem(itemId)"
                                         title="Klikni pro vrácení nebo přetáhni jinam">
                                        <i class="bi bi-grip-vertical drag-handle"></i>
                                        <span class="item-text">@item.Text</span>
                                        <i class="bi bi-x-circle remove-icon"></i>
                                    </div>
                                }
                            }
                            @if (!_userPlacements.Any(p => p.Value == category.Id))
                            {
                                <div class="category-empty">
                                    <i class="bi bi-inbox"></i>
                                    <span>Prázdná kategorie</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="items-source-section">
                <div class="source-header">
                    <i class="bi bi-box-seam"></i>
                    <h6 class="source-title">Prvky k zařazení</h6>
                    <span class="source-count">@_items.Count(i => !_userPlacements.ContainsKey(i.Id)) / @_items.Count</span>
                </div>
                <div class="items-source @(_dragOverSource ? "drag-over" : "")"
                     @ondrop="OnDropToSource"
                     @ondrop:preventDefault="true"
                     @ondrop:stopPropagation="true"
                     @ondragover="OnDragOver"
                     @ondragover:preventDefault="true"
                     @ondragover:stopPropagation="true"
                     @ondragenter="() => _dragOverSource = true"
                     @ondragenter:stopPropagation="true"
                     @ondragleave="() => _dragOverSource = false"
                     @ondragleave:stopPropagation="true">
                    @if (_items.Any(i => !_userPlacements.ContainsKey(i.Id)))
                    {
                        <div class="source-items">
                            @foreach (var item in _items.Where(i => !_userPlacements.ContainsKey(i.Id)))
                            {
                                <div class="draggable-item source-item @(_draggedItem == item.Id ? "dragging" : "")" 
                                     draggable="true"
                                     @ondragstart="() => OnDragStart(item.Id)"
                                     @ondragend="OnDragEnd"
                                     title="Přetáhni do správné kategorie">
                                    <i class="bi bi-grip-vertical drag-handle"></i>
                                    <span class="item-text">@item.Text</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="source-empty">
                            <i class="bi bi-check-circle-fill"></i>
                            <span>Všechny prvky jsou přiřazeny!</span>
                            <small>Zkontroluj správnost řešení</small>
                        </div>
                    }
                </div>
            </div>

            @if (_validationResult != null)
            {
                <div class="validation-result @(_validationResult.IsCorrect ? "result-success" : "result-warning")">
                    <div class="result-header">
                        @if (_validationResult.IsCorrect)
                        {
                            <i class="bi bi-check-circle-fill"></i>
                            <h6>Výborně! Všechny prvky jsou správně zařazeny!</h6>
                        }
                        else
                        {
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <h6>Některé prvky nejsou ve správné kategorii</h6>
                        }
                    </div>
                    <div class="result-details">
                        <div class="result-score">
                            <span class="score-label">Skóre:</span>
                            <span class="score-value">@_validationResult.Score%</span>
                        </div>
                        <div class="result-feedback">@_validationResult.Feedback</div>
                        @if (!string.IsNullOrEmpty(_validationResult.Explanation))
                        {
                            <div class="result-explanation">
                                <i class="bi bi-lightbulb"></i>
                                <span>@_validationResult.Explanation</span>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="dragdrop-actions">
                <button class="action-btn btn-reset" @onclick="Reset">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    <span>Resetovat</span>
                </button>
                <button class="action-btn btn-check" @onclick="CheckSolution" disabled="@(_checking || _userPlacements.Count != _items.Count)">
                    @if (_checking)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    <i class="bi bi-check-circle"></i>
                    <span>Zkontrolovat</span>
                </button>
            </div>
        </div>
    </div>
</div>

<style>
