</style>


@code {
    [Parameter, EditorRequired]
    public InteractiveExerciseResponse Exercise { get; set; } = null!;

    private List<DragDropCategory> _categories = new();
    private List<DragDropItem> _items = new();
    private Dictionary<string, string> _userPlacements = new(); // itemId -> categoryId
    private bool _checking = false;
    private ExerciseValidationResult? _validationResult;
    
    // Drag & drop state
    private string? _draggedItem;
    private string? _dragOverCategory;
    private bool _dragOverSource;

    protected override void OnParametersSet()
    {
        LoadConfig();
    }

    private void LoadConfig()
    {
        try
        {
            var doc = JsonDocument.Parse(Exercise.ConfigJson);

            if (doc.RootElement.TryGetProperty("categories", out var categoriesArray))
            {
                _categories.Clear();
                foreach (var item in categoriesArray.EnumerateArray())
                {
                    _categories.Add(new DragDropCategory
                    {
                        Id = item.GetProperty("id").GetString() ?? "",
                        Label = item.GetProperty("label").GetString() ?? ""
                    });
                }
            }

            if (doc.RootElement.TryGetProperty("items", out var itemsArray))
            {
                _items.Clear();
                foreach (var item in itemsArray.EnumerateArray())
                {
                    _items.Add(new DragDropItem
                    {
                        Id = item.GetProperty("id").GetString() ?? "",
                        Text = item.GetProperty("text").GetString() ?? ""
                    });
                }
                
                // Zamíchat prvky
                _items = _items.OrderBy(x => Guid.NewGuid()).ToList();
            }
        }
        catch
        {
            // Ignore
        }
    }

    private void OnDragStart(string itemId)
    {
        _draggedItem = itemId;
    }

    private void OnDragEnd()
    {
        _draggedItem = null;
        _dragOverCategory = null;
        _dragOverSource = false;
    }

    private void OnDragOver(DragEventArgs e)
    {
        // Musí být, aby drop fungoval
    }

    private void OnDragEnter(string categoryId)
    {
        _dragOverCategory = categoryId;
        _dragOverSource = false;
    }

    private void OnDragLeave()
    {
        _dragOverCategory = null;
    }

    private void OnDrop(DragEventArgs e, string categoryId)
    {
        if (_draggedItem != null)
        {
            PlaceItem(_draggedItem, categoryId);
        }
        _dragOverCategory = null;
        _dragOverSource = false;
        _draggedItem = null;
        StateHasChanged();
    }

    private void OnDropToSource()
    {
        if (_draggedItem != null)
        {
            RemoveItem(_draggedItem);
        }
        _dragOverSource = false;
        _draggedItem = null;
        StateHasChanged();
    }

    private void PlaceItem(string itemId, string categoryId)
    {
        if (string.IsNullOrEmpty(categoryId)) return;
        
        // Odstranit prvek z jakékoli předchozí kategorie
        if (_userPlacements.ContainsKey(itemId))
        {
            _userPlacements[itemId] = categoryId;
        }
        else
        {
            _userPlacements.Add(itemId, categoryId);
        }
        
        _validationResult = null;
        StateHasChanged();
    }

    private void RemoveItem(string itemId)
    {
        _userPlacements.Remove(itemId);
        _validationResult = null;
        StateHasChanged();
    }

    private string GetCategoryClass(string categoryId)
    {
        var count = _userPlacements.Count(p => p.Value == categoryId);
        return count > 0 ? "has-items" : "";
    }

    private void Reset()
    {
        _userPlacements.Clear();
        _validationResult = null;
        LoadConfig(); // Znovu zamíchat
    }

    private async Task CheckSolution()
    {
        _checking = true;
        _validationResult = null;

        try
        {
            var userSolution = new
            {
                placements = _userPlacements
            };

            var request = new ValidateSolutionRequest
            {
                UserSolutionJson = JsonSerializer.Serialize(userSolution)
            };

            _validationResult = await ExerciseService.ValidateSolutionAsync(Exercise.Id, request);
        }
        catch (Exception ex)
        {
            _validationResult = new ExerciseValidationResult
            {
                IsCorrect = false,
                Score = 0,
                Feedback = $"Chyba při validaci: {ex.Message}"
            };
        }
        finally
        {
            _checking = false;
        }
    }

    private class DragDropCategory
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
    }

    private class DragDropItem
    {
        public string Id { get; set; } = "";
        public string Text { get; set; } = "";
    }
}
