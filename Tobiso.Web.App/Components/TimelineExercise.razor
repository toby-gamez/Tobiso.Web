        border-color: var(--test-good-border-dark);
    }

    body.dark-mode .result-warning .result-header h6,
    body.dark-mode .result-warning .result-score,
    body.dark-mode .result-warning .result-feedback {
        color: var(--test-good-text-dark);
    }

    body.dark-mode .result-warning .result-header i {
        color: var(--test-good-text-dark);
    }
</style>

@code {
    [Parameter, EditorRequired]
    public InteractiveExerciseResponse Exercise { get; set; } = null!;

    private List<TimelineEvent> _events = new();
    private List<string> _userOrder = new();
    private string? _draggedEventId = null;
    private int? _dragOverSlot = null;
    private bool _dragOverSource = false;
    private int _timeRangeStart = 1300;
    private int _timeRangeEnd = 1700;
    private bool _checking = false;
    private ExerciseValidationResult? _validationResult;

    protected override void OnParametersSet()
    {
        LoadConfig();
    }

    private void LoadConfig()
    {
        try
        {
            var doc = JsonDocument.Parse(Exercise.ConfigJson);

            if (doc.RootElement.TryGetProperty("timeRange", out var timeRange))
            {
                if (timeRange.TryGetProperty("start", out var start))
                    _timeRangeStart = start.GetInt32();
                if (timeRange.TryGetProperty("end", out var end))
                    _timeRangeEnd = end.GetInt32();
            }

            if (doc.RootElement.TryGetProperty("events", out var eventsArray))
            {
                _events.Clear();
                foreach (var item in eventsArray.EnumerateArray())
                {
                    _events.Add(new TimelineEvent
                    {
                        Id = item.GetProperty("id").GetString() ?? "",
                        Label = item.GetProperty("label").GetString() ?? "",
                        Year = item.GetProperty("year").GetInt32()
                    });
                }

                // Zamíchat události
                _events = _events.OrderBy(x => Guid.NewGuid()).ToList();
            }
        }
        catch
        {
            // Ignore
        }
    }

    private void OnDragStart(string eventId)
    {
        _draggedEventId = eventId;
    }

    private void OnDragEnd()
    {
        _draggedEventId = null;
        _dragOverSlot = null;
    }

    private void OnDragOver(DragEventArgs e)
    {
        // Required for drop
    }

    private void OnDrop(DragEventArgs e, int slotIndex)
    {
        if (_draggedEventId == null)
            return;

        // Remove from previous position if already placed
        _userOrder.Remove(_draggedEventId);

        // Insert at slotIndex (replace if already filled)
        if (_userOrder.Count > slotIndex)
        {
            _userOrder.Insert(slotIndex, _draggedEventId);
            // If slot was filled, remove the next one
            if (_userOrder.Count > _events.Count)
                _userOrder.RemoveAt(_userOrder.Count - 1);
        }
        else
        {
            _userOrder.Add(_draggedEventId);
        }

        _draggedEventId = null;
        _dragOverSlot = null;
    }

    private void OnDropToSource()
    {
        if (_draggedEventId == null)
            return;

        RemoveEventById(_draggedEventId);
        _dragOverSource = false;
        _draggedEventId = null;
        StateHasChanged();
    }

    private void RemoveFromTimeline(int index)
    {
        if (index >= 0 && index < _userOrder.Count)
        {
            _userOrder.RemoveAt(index);
        }
    }

    private void RemoveEventById(string eventId)
    {
        var idx = _userOrder.IndexOf(eventId);
        if (idx >= 0)
        {
            _userOrder.RemoveAt(idx);
        }
    }

    private void Reset()
    {
        _userOrder.Clear();
        _validationResult = null;
        LoadConfig(); // Znovu zamíchat
    }

    private async Task CheckSolution()
    {
        _checking = true;
        _validationResult = null;

        try
        {
            var userSolution = new
            {
                order = _userOrder.ToArray()
            };

            var request = new ValidateSolutionRequest
            {
                UserSolutionJson = JsonSerializer.Serialize(userSolution)
            };

            _validationResult = await ExerciseService.ValidateSolutionAsync(Exercise.Id, request);
        }
        catch (Exception ex)
        {
            _validationResult = new ExerciseValidationResult
            {
                IsCorrect = false,
                Score = 0,
                Feedback = $"Chyba při validaci: {ex.Message}"
            };
        }
        finally
        {
            _checking = false;
        }
    }

    private class TimelineEvent
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
        public int Year { get; set; }
    }
}
