@using System.Text.Json
@using Tobiso.Web.Shared.DTOs
@using Tobiso.Web.Shared.Interfaces
@inject IInteractiveExerciseService ExerciseService
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="exercise-shell">
    @if (_unplaced.Count > 0)
    {
        <div class="chip-row">
            @foreach (var evt in _unplaced)
            {
                <button class="chip @(_selectedEvent == evt.Id ? "chip-sel" : "")" @onclick="() => SelectEvent(evt.Id)">@evt.Label</button>
            }
        </div>
    }

    <div class="years-grid">
        @foreach (var slot in _slots)
        {
            <button class="bucket year-bucket @(_selectedEvent != null ? "bucket-target" : "")" @onclick="() => PlaceInSlot(slot.Index)">
                <span class="year-label">@slot.Year</span>
                @foreach (var placement in _placements.Where(p => p.SlotIndex == slot.Index))
                {
                    var evt = _events.FirstOrDefault(e => e.Id == placement.EventId);
                    if (evt != null)
                    {
                        var cls = _checked ? (evt.Year == slot.Year ? "correct" : "incorrect") : "";
                        <span class="exercise-pill @cls" @onclick="() => RemoveEvent(evt.Id)" @onclick:stopPropagation="true">@evt.Label</span>
                    }
                }
            </button>
        }
    </div>

    <div class="exercise-actions">
        <button class="pill" @onclick="Reset"><i data-lucide="rotate-ccw"></i> Znovu</button>
        <button class="pill pill-on" @onclick="CheckSolution" disabled="@(_checking || _placements.Count != _events.Count)">
            @if (_checking)
            {
                <i data-lucide="loader-2" class="spin-icon"></i>
            }
            Zkontrolovat
        </button>
        @if (_validationResult != null)
        {
            <span class="exercise-score @(_validationResult.IsCorrect ? "correct" : "incorrect")">@_validationResult.Feedback</span>
        }
        <span class="exercise-actions-spacer"></span>
        <div class="tooltip">
            <button class="help-btn" type="button" aria-label="Návod k ovládání"><i data-lucide="help-circle"></i></button>
            <span class="tooltip-text">Klikni na událost, potom na rok, kdy se stala. Klikni na umístěnou událost pro její vrácení.</span>
        </div>
    </div>
</div>

<style>
    .chip-row {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }
    .years-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: var(--space-3);
    }
    .year-bucket {
        align-items: center;
        text-align: center;
    }
    .year-label {
        font-family: var(--font-heading);
        font-size: 19px;
    }
</style>

@code {
    [Parameter, EditorRequired]
    public InteractiveExerciseResponse Exercise { get; set; } = null!;

    private List<TimelineEvent> _events = new();
    private List<Slot> _slots = new();
    private List<Placement> _placements = new();
    private string? _selectedEvent;
    private bool _checking = false;
    private bool _checked;
    private ExerciseValidationResult? _validationResult;
    private int? _loadedExerciseId;

    private List<TimelineEvent> _unplaced => _events.Where(e => !_placements.Any(p => p.EventId == e.Id)).ToList();

    protected override void OnParametersSet()
    {
        if (_loadedExerciseId == Exercise.Id) return;
        _loadedExerciseId = Exercise.Id;
        LoadConfig();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("initLucide");
    }

    private void LoadConfig()
    {
        try
        {
            var doc = JsonDocument.Parse(Exercise.ConfigJson);

            if (doc.RootElement.TryGetProperty("events", out var eventsArray))
            {
                _events.Clear();
                foreach (var item in eventsArray.EnumerateArray())
                {
                    _events.Add(new TimelineEvent
                    {
                        Id = item.GetProperty("id").GetString() ?? "",
                        Label = item.GetProperty("label").GetString() ?? "",
                        Year = item.GetProperty("year").GetInt32()
                    });
                }

                _events = _events.OrderBy(x => Guid.NewGuid()).ToList();
            }

            _slots = _events
                .OrderBy(e => e.Year)
                .Select((e, idx) => new Slot { Index = idx, Year = e.Year })
                .ToList();
        }
        catch
        {
            // Ignore
        }
    }

    private void SelectEvent(string eventId)
    {
        _selectedEvent = _selectedEvent == eventId ? null : eventId;
    }

    private void PlaceInSlot(int slotIndex)
    {
        if (_selectedEvent == null) return;
        _placements.Add(new Placement { EventId = _selectedEvent, SlotIndex = slotIndex });
        _selectedEvent = null;
        _validationResult = null;
        _checked = false;
    }

    private void RemoveEvent(string eventId)
    {
        _placements.RemoveAll(p => p.EventId == eventId);
        _validationResult = null;
        _checked = false;
    }

    private void Reset()
    {
        _placements.Clear();
        _selectedEvent = null;
        _validationResult = null;
        _checked = false;
        LoadConfig(); // Znovu zamíchat
    }

    private async Task CheckSolution()
    {
        _checking = true;
        _validationResult = null;

        try
        {
            // Flatten placements slot-by-slot (ascending year) to reconstruct the
            // chronological order the server compares against.
            var order = _slots
                .SelectMany(slot => _placements.Where(p => p.SlotIndex == slot.Index).Select(p => p.EventId))
                .ToArray();

            var request = new ValidateSolutionRequest
            {
                UserSolutionJson = JsonSerializer.Serialize(new { order })
            };

            _validationResult = await ExerciseService.ValidateSolutionAsync(Exercise.Id, request);
            _checked = true;
        }
        catch (Exception ex)
        {
            _validationResult = new ExerciseValidationResult
            {
                IsCorrect = false,
                Score = 0,
                Feedback = $"Chyba při validaci: {ex.Message}"
            };
        }
        finally
        {
            _checking = false;
        }
    }

    private class TimelineEvent
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
        public int Year { get; set; }
    }

    private class Slot
    {
        public int Index { get; set; }
        public int Year { get; set; }
    }

    private class Placement
    {
        public string EventId { get; set; } = "";
        public int SlotIndex { get; set; }
    }
}
