@using System.Text.Json
@using Tobiso.Web.Shared.DTOs
@using Tobiso.Web.Shared.Interfaces
@inject IInteractiveExerciseService ExerciseService
@inject IJSRuntime JS

<div class="timeline-exercise">
    <div class="card dragdrop-card">
        <div class="card-body">
            <div class="dragdrop-info-banner">
                <i class="bi bi-info-circle-fill"></i>
                <div>
                    <strong>Návod k ovládání:</strong>
                    <span>Přetáhni události na osu v pořadí, v jakém se staly. Klikni na událost na ose pro odebrání.</span>
                </div>
            </div>

            <div class="mb-4">
                <div class="card mb-3">
                    <div class="card-header bg-success text-white">
                        <h6 class="mb-0"><i class="bi bi-card-text"></i> Časová osa</h6>
                    </div>
                    <div class="card-body">
                        <div class="timeline-axis timeline-axis-bg position-relative" style="min-height: 120px; height: 160px;">
                            @{
                                var minYear = _timeRangeStart;
                                var maxYear = _timeRangeEnd;
                                var range = maxYear - minYear == 0 ? 1 : maxYear - minYear;
                                var slotCount = _events.Count;
                            }
                            @{ 
                                var sortedEvents = _events.OrderBy(ev => ev.Year).ToList();
                                for (int i = 0; i < slotCount; i++)
                                {
                                    var correctEvent = sortedEvents.Count > i ? sortedEvents[i] : null;
                                    var correctYear = correctEvent?.Year ?? (minYear + (int)Math.Round((maxYear - minYear) * (i / (double)(slotCount - 1))));
                                    var left = ((correctYear - minYear) / (double)range) * 100.0;
                                    int? eventYear = null;
                                    var evtId = (_userOrder.Count > i) ? _userOrder[i] : null;
                                    var evt = evtId != null ? _events.FirstOrDefault(ev => ev.Id == evtId) : null;
                                    if (evt != null) eventYear = evt.Year;
                            <text>
                                <div class="timeline-slot-wrapper d-flex align-items-center" style="left:@(left)% ; top:50%; transform:translate(-50%,-50%); gap:8px;">
                                    <span class="timeline-year-label me-2">@correctYear</span>
                                    <div class="timeline-slot p-2 border rounded bg-light text-start @(i == _dragOverSlot ? "drag-over" : "")"
                                         @ondrop="(e) => OnDrop(e, i)"
                                         @ondrop:preventDefault="true"
                                         @ondragover="OnDragOver"
                                         @ondragover:preventDefault="true"
                                         style="min-width: 140px; min-height: 60px;">
                                        @if (evt != null)
                                        {
                                            <div class="draggable-item timeline-item @(evt.Id == _draggedEventId ? "dragging" : "")"
                                                 draggable="true"
                                                 @ondragstart="() => OnDragStart(evt.Id)"
                                                 @ondragend="OnDragEnd"
                                                 @onclick="(() => RemoveEventById(evt.Id))"
                                                 title="Klikni pro odebrání zpět dolů">
                                                <i class="bi bi-grip-vertical drag-handle"></i>
                                                <span class="item-text">@evt.Label <span class="event-year">(@evt.Year)</span></span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">(prázdné)</span>
                                        }
                                    </div>
                                </div>
                            </text>
                                }
                            }
                        </div>
                        <div class="d-flex justify-content-between mt-2">
                            <span class="fw-bold">@_timeRangeStart</span>
                            <span class="fw-bold">@_timeRangeEnd</span>
                        </div>
                    </div>
                </div>
                <div class="items-source-section">
                    <div class="source-header">
                        <i class="bi bi-box"></i>
                        <h6 class="source-title">Události k zařazení</h6>
                        <span class="source-count">@_events.Count(e => !_userOrder.Contains(e.Id)) / @_events.Count</span>
                    </div>
                    <div class="items-source @(_dragOverSource ? "drag-over" : "")"
                         @ondrop="OnDropToSource"
                         @ondrop:preventDefault="true"
                         @ondrop:stopPropagation="true"
                         @ondragover="OnDragOver"
                         @ondragover:preventDefault="true"
                         @ondragover:stopPropagation="true"
                         @ondragenter="() => _dragOverSource = true"
                         @ondragenter:stopPropagation="true"
                         @ondragleave="() => _dragOverSource = false"
                         @ondragleave:stopPropagation="true">
                        @if (_events.Any(e => !_userOrder.Contains(e.Id)))
                        {
                            <div class="source-items events-list">
                                @foreach (var evt in _events.Where(e => !_userOrder.Contains(e.Id)))
                                {
                                    <div class="draggable-item source-item @(evt.Id == _draggedEventId ? "dragging" : "")" draggable="true" @ondragstart="() => OnDragStart(evt.Id)" @ondragend="OnDragEnd" title="Přetáhni na osu">
                                        <i class="bi bi-grip-vertical drag-handle"></i>
                                        <span class="item-text">@evt.Label</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="source-empty">
                                <i class="bi bi-check-circle-fill"></i>
                                <span>Všechny události jsou přiřazeny!</span>
                                <small>Zkontroluj správnost řešení</small>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between mt-3">
                <button class="btn btn-warning" @onclick="Reset">
                    <i class="bi bi-arrow-counterclockwise"></i> Resetovat
                </button>
                <button class="btn btn-primary" @onclick="CheckSolution" disabled="@(_checking || _userOrder.Count != _events.Count)">
                    @if (_checking)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    <i class="bi bi-check-circle"></i> Zkontrolovat
                </button>
            </div>

            @if (_validationResult != null)
            {
                <div class="validation-result @(_validationResult.IsCorrect ? "result-success" : "result-warning")">
                    <div class="result-header">
                        @if (_validationResult.IsCorrect)
                        {
                            <i class="bi bi-check-circle-fill"></i>
                            <h6>Perfektní! Správné chronologické pořadí!</h6>
                        }
                        else
                        {
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <h6>Ještě to není úplně správně</h6>
                        }
                    </div>
                    <div class="result-details">
                        <div class="result-score">
                            <span class="score-label">Skóre:</span>
                            <span class="score-value">@_validationResult.Score%</span>
                        </div>
                        <div class="result-feedback">@_validationResult.Feedback</div>
                        @if (!string.IsNullOrEmpty(_validationResult.Explanation))
                        {
                            <div class="result-explanation">
                                <i class="bi bi-lightbulb"></i>
                                <span>@_validationResult.Explanation</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .dragdrop-card {
        background: var(--intro-bg);
        border: none;
        border-radius: 12px;
        box-shadow: none;
    }
    .dragdrop-card .card-body {
        padding: 1.5rem;
    }
    .dragdrop-info-banner {
        display: flex;
