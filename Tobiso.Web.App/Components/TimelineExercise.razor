        padding: 1rem;
        background: var(--intro-light-bg);
        border-radius: 10px;
        margin-bottom: 1.5rem;
        align-items: flex-start;
    }
    .dragdrop-info-banner i {
        font-size: 1.5rem;
        color: var(--color-accent-strong);
        flex-shrink: 0;
        margin-top: 2px;
    }
    .dragdrop-info-banner div {
        flex: 1;
    }
    .dragdrop-info-banner strong {
        display: block;
        margin-bottom: 0.25rem;
        color: var(--color-text);
    }
    .dragdrop-info-banner span {
        font-size: 0.9rem;
        color: var(--color-text);
        opacity: 0.85;
    }
    .draggable-item {
        cursor: grab;
        user-select: none;
        background: #f8f9fa;
        border-radius: 6px;
        margin-bottom: 6px;
        padding: 8px 12px;
        display: flex;
        align-items: center;
        transition: box-shadow 0.2s, background 0.2s;
        box-shadow: 0 1px 2px rgba(0,0,0,0.04);
    }
    .draggable-item.dragging {
        opacity: 0.6;
        background: #e2e6ea;
        box-shadow: 0 2px 8px rgba(0,0,0,0.12);
    }
    .drag-handle {
        margin-right: 8px;
        color: #adb5bd;
        font-size: 1.1rem;
    }
    .remove-icon {
        margin-left: auto;
        color: #dc3545;
        cursor: pointer;
        font-size: 1.1rem;
    }
    .timeline-axis {
        min-height: 80px;
        border-radius: 10px;
        border: 3px solid var(--color-accent);
        background: var(--intro-light-bg);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        position: relative;
        padding: 32px 8px 24px 8px;
        margin-bottom: 16px;
    }

    /* Dark mode for timeline axis (match CircuitSimulator canvas-container) */
    body.dark-mode .timeline-axis {
        background: var(--intro-light-bg-dark);
        border-color: var(--color-accent-dark);
    }

    /* Dark mode for source boxes and draggable items */
    body.dark-mode .items-source-section {
        background: var(--intro-light-bg-dark);
    }

    body.dark-mode .source-header {
        border-bottom-color: var(--color-accent-dark);
    }

    body.dark-mode .source-header i {
        color: var(--color-accent-strong-dark);
    }

    body.dark-mode .source-title {
        color: var(--color-text-dark);
    }

    body.dark-mode .source-count {
        background: var(--color-accent-dark);
        color: var(--color-button-text-dark);
    }

    body.dark-mode .items-source {
        border-color: var(--color-accent-dark);
    }

    body.dark-mode .items-source.drag-over {
        background: var(--color-accent-2-dark);
        border-color: var(--color-accent-strong-dark);
    }

    body.dark-mode .source-items {
        /* ensure grid items have dark backgrounds */
    }

    body.dark-mode .source-empty {
        color: var(--test-good-text-dark);
    }

    body.dark-mode .draggable-item {
        background: var(--color-accent-dark);
        border-color: var(--color-accent-dark);
    }

    body.dark-mode .draggable-item:hover {
        border-color: var(--color-accent-strong-dark);
    }

    body.dark-mode .draggable-item.source-item {
        background: var(--color-accent-2-dark);
        border-color: var(--color-accent-2-dark);
    }

    body.dark-mode .drag-handle,
    body.dark-mode .item-text,
    body.dark-mode .remove-icon {
        color: var(--color-button-text-dark);
    }

    /* Dark adjustments for timeline slots */
    body.dark-mode .timeline-slot {
        background: var(--intro-light-bg-dark);
        border-color: var(--color-accent-dark);
        color: var(--color-text-dark);
    }

    body.dark-mode .timeline-slot.drag-over {
        background: var(--color-accent-2-dark);
        border-color: var(--color-accent-strong-dark);
    }
    .timeline-slot-wrapper {
        min-width: 120px;
        pointer-events: auto;
        position: absolute;
    }
