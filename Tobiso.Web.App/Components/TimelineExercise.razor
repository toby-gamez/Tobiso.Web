        width: 100%;
        border-radius: 10px !important;
    }

    /* Items source section (styled like DragDropExercise) */
    .items-source-section {
        background: var(--intro-light-bg);
        border-radius: 10px;
        padding: 1rem;
        margin-bottom: 1.5rem;
    }

    .source-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding-bottom: 0.75rem;
        margin-bottom: 0.75rem;
        border-bottom: 2px solid var(--color-accent);
    }

    .source-header i {
        font-size: 1.25rem;
        color: var(--color-accent-strong);
    }

    .source-title {
        flex: 1;
        margin: 0;
        font-size: 1rem;
        font-weight: 600;
        color: var(--color-text);
