<!DOCTYPE html>
<html lang="cs">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    <!-- Google Analytics (Consent Mode v2 - analytics_storage stays denied until the cookie banner is accepted) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-1CDLST0SSK"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        window.gtag = gtag;
        gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied' });
        try {
            if (localStorage.getItem('tobiso-cookie-consent') === 'accepted') {
                gtag('consent', 'default', { analytics_storage: 'granted' });
            }
        } catch (e) { /* localStorage unavailable */ }
        gtag('js', new Date());
        gtag('config', 'G-1CDLST0SSK');
    </script>

    <link rel="stylesheet" href="css/variables.css" />
    <link rel="stylesheet" href="css/style.css" />
    <link rel="stylesheet" href="css/organic.css" />
    <link rel="stylesheet" href="Tobiso.Web.App.styles.css" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />

    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="https://cdn.jsdelivr.net/npm/lucide@0.453.0/dist/umd/lucide.min.js"></script>
    <script src="js/lucide-init.js"></script>
    <script src="js/katex-init.js"></script>
    <script src="js/pomodoro.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
