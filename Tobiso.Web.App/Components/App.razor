<!DOCTYPE html>
<html lang="cs">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    <!-- Google Analytics: gtag.js is NOT loaded until the visitor accepts the cookie banner
         (§89(3) zák. 127/2005 Sb. / GDPR). Before that nothing is sent to Google, not even the
         cookieless pings Consent Mode would send. Accept/decline handlers: js/lucide-init.js. -->
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        window.gtag = gtag;
        window.GA_MEASUREMENT_ID = 'G-1CDLST0SSK';
        window.loadAnalytics = function () {
            if (window.__gaLoaded) return;
            window.__gaLoaded = true;
            window['ga-disable-' + window.GA_MEASUREMENT_ID] = false;
            gtag('consent', 'default', { analytics_storage: 'granted', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
            gtag('js', new Date());
            gtag('config', window.GA_MEASUREMENT_ID, { anonymize_ip: true });
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + window.GA_MEASUREMENT_ID;
            document.head.appendChild(s);
        };
        try {
            if (localStorage.getItem('tobiso-cookie-consent') === 'accepted') window.loadAnalytics();
        } catch (e) { /* localStorage unavailable: no consent, no analytics */ }
    </script>

    <link rel="stylesheet" href="css/variables.css" />
    <link rel="stylesheet" href="css/style.css" />
    <link rel="stylesheet" href="css/organic.css" />
    <link rel="stylesheet" href="Tobiso.Web.App.styles.css" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />

    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="https://cdn.jsdelivr.net/npm/lucide@0.453.0/dist/umd/lucide.min.js"></script>
    <script src="js/lucide-init.js"></script>
    <script src="js/katex-init.js"></script>
    <script src="js/pomodoro.js"></script>
    <script src="js/auth.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
