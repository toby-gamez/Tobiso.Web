<div id="searchModal" class="search-modal" role="dialog" aria-modal="true" aria-label="Vyhledávání">
    <div class="search-backdrop"></div>
    <div class="search-container">
        <div class="search-header">
            <h2 class="visually-hidden">Vyhledávání</h2>
            <div class="search-input-wrapper">
                <i class="bi bi-search search-icon"></i>
                <input type="text" id="search" placeholder="Začněte psát a vyhledejte..." autocomplete="off" spellcheck="false" />
                <button id="closeSearch" class="search-close" aria-label="Zavřít vyhledávání (Esc)">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="search-shortcuts">
                <span class="search-shortcut">
                    <span class="key-icon">↑</span>
                    <span class="key-icon">↓</span>
                    <span>navigace</span>
                </span>
                <span class="search-shortcut">
                    <span class="key-icon">Enter</span>
                    <span>vybrat</span>
                </span>
                <span class="search-shortcut">
                    <span class="key-icon">Esc</span>
                    <span>zavřít</span>
                </span>
            </div>
        </div>
        <div class="search-content">
            <div id="results" class="search-results"></div>
            <div id="search-empty" class="search-empty" style="display: none;">
                <i class="bi bi-search"></i>
                <h3>Začněte psát pro vyhledávání</h3>
                <p>Zadejte alespoň 2 znaky</p>
            </div>
            <div id="search-no-results" class="search-no-results" style="display: none;">
                <i class="bi bi-emoji-frown"></i>
                <h3>Žádné výsledky</h3>
                <p>Zkuste jiný dotaz nebo méně specifické slova</p>
            </div>
        </div>
    </div>
</div>
