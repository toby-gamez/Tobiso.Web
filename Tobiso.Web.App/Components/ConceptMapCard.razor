@using Tobiso.Web.Shared.DTOs
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime Js

@if (_map != null || _loading)
{
    <div class="context-card concept-map-card">
        <div class="context-card-header" @onclick="Toggle">
            <span>🕸️ Myšlenková mapa</span>
            <span class="context-card-chevron">@(_open ? "▲" : "▼")</span>
        </div>

        @if (_open)
        {
            <div class="concept-map-body">
                @if (_loading)
                {
                    <div class="loading-wrap">
                        <div class="loading-circle"></div>
                        <p style="font-size:0.85rem">Generuji mapu pojmů…</p>
                    </div>
                }
                else if (_map != null && _map.Nodes.Count > 0)
                {
                    <div id="concept-map-@PostId" class="concept-map-svg-wrap"></div>
                    <button class="compare-retry" @onclick="Regenerate" style="margin-top:0.4rem">Vygenerovat znovu</button>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public int PostId { get; set; }

    private bool _open;
    private bool _loading;
    private ConceptMapResponse? _map;
    private int _loadedPostId;
    private IJSObjectReference? _jsModule;
    private bool _rendered;

    protected override void OnInitialized()
    {
        _ = LoadBackground();
    }

    private async Task LoadBackground()
    {
        if (_loadedPostId == PostId) return;
        _loading = true;
        StateHasChanged();
        try
        {
            var resp = await Http.GetAsync(new Uri(Navigation.BaseUri + $"api/ai/concept-map/{PostId}"));
            if (resp.IsSuccessStatusCode)
            {
                _map = await resp.Content.ReadFromJsonAsync<ConceptMapResponse>();
                _loadedPostId = PostId;
            }
        }
        catch { }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
        if (_open && _map != null)
            await RenderMap();
    }

    private async Task Toggle()
    {
        _open = !_open;
        if (_open && _map != null && !_rendered)
            await RenderMap();
    }

    private async Task Regenerate()
    {
        _map = null;
        _rendered = false;
        _loadedPostId = 0;
        await LoadBackground();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_open && _map != null && !_rendered)
            await RenderMap();
    }

    private async Task RenderMap()
    {
        if (_map == null) return;
        try
        {
            _jsModule ??= await Js.InvokeAsync<IJSObjectReference>("import", "/js/concept-map.js?v=3");
            await _jsModule.InvokeVoidAsync("renderConceptMap", $"concept-map-{PostId}", _map);
            _rendered = true;
        }
        catch { }
    }
}
