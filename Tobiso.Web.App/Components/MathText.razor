@using System.Text.RegularExpressions
@using Microsoft.JSInterop
@inject IJSRuntime Js

@((MarkupString)_renderedHtml)

@code {
    /// <summary>Plain (non-markdown) text that may contain inline fractions like "1/2" or "{n+1}/{n-1}" -
    /// rendered the same way MarkdownContent renders fractions in post bodies, via KaTeX.</summary>
    [Parameter] public string? Text { get; set; }

    private string _renderedHtml = string.Empty;
    private string? _lastProcessedText;

    protected override void OnParametersSet()
    {
        if (Text == _lastProcessedText) return;
        _lastProcessedText = Text;
        _renderedHtml = RenderFractions(Text);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Same lazy KaTeX (self-hosted) bootstrap as MarkdownContent.razor, via the CSP-safe named
        // function in wwwroot/js/katex-init.js -- never via eval(), which Content-Security-Policy
        // blocks. renderMarkdownMath targets every [data-math] span in the document (not just this
        // component's), so it's safe for multiple MathText instances on one page to share the
        // single KaTeX load.
        await Js.InvokeVoidAsync("renderMarkdownMath", (string?)null);
    }

    // Same fraction syntax as MarkdownContent (shared FractionMath), but the input is a raw DB
    // string rather than markdown that Markdig will encode, so HTML-encode it first.
    private static string RenderFractions(string? text)
    {
        if (string.IsNullOrEmpty(text)) return string.Empty;

        return Tobiso.Web.App.Services.FractionMath.Replace(System.Net.WebUtility.HtmlEncode(text));
    }
}
