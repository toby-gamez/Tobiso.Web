@using System.Text.Json
@using Tobiso.Web.Shared.DTOs
@using Tobiso.Web.Shared.Interfaces
@using Microsoft.JSInterop
@inject IInteractiveExerciseService ExerciseService
@inject IJSRuntime JS

<div class="circuit-simulator">
    <div class="card circuit-card">
        <div class="card-body">
            <div class="circuit-info-banner">
                <i class="bi bi-info-circle-fill"></i>
                <div>
                    <strong>Návod k ovládání:</strong>
                    <span>Přetáhni komponenty na plochu • Klikni na dvě komponenty pro spojení • Dvojklik pro nastavení • Pravé tlačítko pro smazání</span>
                </div>
            </div>

            <div class="canvas-container" 
                 @ref="_canvasRef"
                 @onmousemove="OnCanvasMouseMove"
                 @onmouseup="OnCanvasMouseUp"
                 @oncontextmenu:preventDefault="true">
                
                @* SVG pro spojení (pod komponentami) *@
                <svg style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1;">
                    @foreach (var connection in _connections)
                    {
                        var from = _components.FirstOrDefault(c => c.Id == connection.From);
                        var to = _components.FirstOrDefault(c => c.Id == connection.To);
                        if (from != null && to != null)
                        {
                            var isLive = _circuitState.LiveConnections.Contains(connection.Id);
                            <line x1="@(from.X + 40)" y1="@(from.Y + 40)" 
                                  x2="@(to.X + 40)" y2="@(to.Y + 40)" 
                                  stroke="@(isLive ? "#ffc107" : "#6c757d")" 
                                  stroke-width="@(isLive ? "4" : "3")"
                                  style="@(isLive ? "filter: drop-shadow(0 0 8px #ffc107);" : "")" />
                        }
                    }
                    
                    @* Kreslení nového spojení *@
                    @if (_connectingFrom != null)
                    {
                        var from = _components.FirstOrDefault(c => c.Id == _connectingFrom);
                        if (from != null)
                        {
                            <line x1="@(from.X + 40)" y1="@(from.Y + 40)" 
                                  x2="@_mouseX" y2="@_mouseY" 
                                  stroke="#0d6efd" stroke-width="3" stroke-dasharray="5,5" />
                        }
                    }
                </svg>

                @* Komponenty *@
                @foreach (var component in _components)
                {
                    var brightness = GetBrightness(component);
                    var isActive = brightness > 0.1; // Aktivní jen když má dostatečný výkon
                    var isSwitchOn = component.Type == "switch" && _circuitState.SwitchStates.GetValueOrDefault(component.Id, false);
                    
                    <div class="circuit-component @(component.Id == _selectedComponent ? "selected" : "")"
                         style="position: absolute; left: @(component.X)px; top: @(component.Y)px; cursor: @(_draggingComponent == component.Id ? "grabbing" : "grab"); z-index: 10;"
                         @onmousedown="(e) => OnComponentMouseDown(e, component.Id)"
                         @onmousedown:stopPropagation="true"
                         @oncontextmenu="() => OnComponentRightClick(component.Id)"
                         @oncontextmenu:preventDefault="true">
                        
                        <div class="component-icon @(GetBrightnessClass(brightness)) @(component.Type == "switch" ? (isSwitchOn ? "switch-on" : "switch-off") : "")">
                            @if (component.Type == "battery")
                            {
                                <i class="bi bi-battery-charging" style="font-size: 2.5rem; color: #198754;"></i>
                            }
                            else if (component.Type == "bulb")
                            {
                                <i class="bi bi-lightbulb@(isActive ? "-fill" : "")" style="font-size: 2.5rem; color: @GetBulbColor(brightness); opacity: @GetBulbOpacity(brightness);"></i>
                            }
                            else if (component.Type == "switch")
                            {
                                <i class="bi bi-toggle-@(isSwitchOn ? "on" : "off")" style="font-size: 2.5rem; color: @(isSwitchOn ? "#0d6efd" : "#6c757d");"></i>
                            }
                            else if (component.Type == "resistor")
                            {
                                <i class="bi bi-activity" style="font-size: 2.5rem; color: #dc3545;"></i>
                            }
                            else if (component.Type == "capacitor")
                            {
                                <i class="bi bi-battery-half" style="font-size: 2.5rem; color: #0dcaf0;"></i>
                            }
                            else if (component.Type == "led")
                            {
                                <i class="bi bi-lightbulb@(isActive ? "-fill" : "")" style="font-size: 2.5rem; color: @(isActive ? "#0d6efd" : "#6c757d");"></i>
                            }
                            else if (component.Type == "motor")
                            {
                                <i class="bi bi-fan" style="font-size: 2.5rem; color: @(isActive ? "#6610f2" : "#6c757d"); @(isActive ? "animation: spin 1s linear infinite;" : "")"></i>
                            }
                            else if (component.Type == "buzzer")
                            {
                                <i class="bi bi-volume-up@(isActive ? "-fill" : "")" style="font-size: 2.5rem; color: @(isActive ? "#fd7e14" : "#6c757d");"></i>
                            }
                        </div>
                        <div class="component-label">@component.Label</div>
                        @if (component.Value > 0)
                        {
                            <div class="component-value">@GetValueDisplay(component)</div>
                        }
                        @if (isActive && _circuitState.ComponentMetrics.ContainsKey(component.Id))
                        {
                            var metrics = _circuitState.ComponentMetrics[component.Id];
                            <div class="component-metrics">
                                @if (component.Type == "bulb")
                                {
                                    <span>@metrics.Power.ToString("F1")W</span>
                                }
                                else if (component.Type == "resistor")
                                {
                                    <span>@metrics.Current.ToString("F2")A</span>
                                }
                                else
                                {
                                    <span>⚡</span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="circuit-toolbar">
                <div class="toolbar-section">
                    <h6 class="toolbar-title">
                        <i class="bi bi-plus-circle-fill"></i>
                        Dostupné komponenty
                    </h6>
                    <div class="component-buttons">
                        @foreach (var type in new[] { "battery", "bulb", "switch", "resistor", "capacitor", "led", "motor", "buzzer" })
                        {
                            <button class="component-btn" @onclick="() => AddComponent(type)" title="Přidat @GetComponentTypeLabel(type)">
                                <i class="bi bi-@GetBootstrapIcon(type)"></i>
                                <span>@GetComponentTypeLabel(type)</span>
                            </button>
                        }
                    </div>
                </div>
            </div>

            @if (_circuitState.HasPower || !_circuitState.CircuitClosed)
            {
                <div class="circuit-status">
                    @if (_circuitState.HasPower && _circuitState.CircuitClosed)
                    {
                        <div class="status-message status-success">
                            <i class="bi bi-lightning-charge-fill"></i>
                            <div>
                                <strong>Obvod je uzavřený a má napájení!</strong>
                                @if (_circuitState.LitBulbs.Any())
                                {
                                    <span>💡 Komponenty jsou aktivní!</span>
                                }
                            </div>
                        </div>
                    }
                    else if (!_circuitState.HasPower)
                    {
                        <div class="status-message status-warning">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <div>
                                <strong>Chybí zdroj napájení</strong>
                                <span>Přidej baterii do obvodu</span>
                            </div>
                        </div>
                    }
                    else if (!_circuitState.CircuitClosed)
                    {
                        <div class="status-message status-info">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <div>
                                <strong>Obvod není uzavřený</strong>
                                <span>Propoj všechny komponenty do smyčky nebo zapni přepínač</span>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (_components.Any(c => c.Type == "battery" || c.Type == "resistor" || c.Type == "bulb" || c.Type == "capacitor" || c.Type == "switch"))
            {
                <div class="component-settings">
                    <h6 class="settings-title">
                        <i class="bi bi-sliders"></i>
                        Nastavení komponent
                    </h6>
                    <div class="settings-grid">
                        @foreach (var comp in _components.Where(c => c.Type == "battery" || c.Type == "resistor" || c.Type == "bulb" || c.Type == "capacitor" || c.Type == "switch"))
                        {
                            <div class="setting-card">
                                <div class="setting-header">
                                    <i class="bi bi-@GetBootstrapIcon(comp.Type)"></i>
                                    <span class="setting-label">@comp.Label</span>
                                </div>
                                <div class="setting-control">
                                    @if (comp.Type == "battery")
                                    {
                                        <div class="control-group">
                                            <label>Napětí</label>
                                            <div class="input-with-unit">
                                                <input type="number" @bind="comp.Value" @bind:after="EvaluateCircuit" min="1" max="24" step="1" />
                                                <span class="unit">V</span>
                                            </div>
                                        </div>
                                    }
                                    else if (comp.Type == "resistor")
                                    {
                                        <div class="control-group">
                                            <label>Odpor</label>
                                            <div class="input-with-unit">
                                                <input type="number" @bind="comp.Value" @bind:after="EvaluateCircuit" min="1" max="10000" step="10" />
                                                <span class="unit">Ω</span>
                                            </div>
                                        </div>
                                    }
                                    else if (comp.Type == "bulb")
                                    {
                                        <div class="control-group">
                                            <label>Výkon</label>
                                            <div class="input-with-unit">
                                                <input type="number" @bind="comp.Value" @bind:after="EvaluateCircuit" min="1" max="100" step="5" />
                                                <span class="unit">W</span>
                                            </div>
                                        </div>
                                    }
                                    else if (comp.Type == "capacitor")
                                    {
                                        <div class="control-group">
                                            <label>Kapacita</label>
                                            <div class="input-with-unit">
                                                <input type="number" @bind="comp.Value" @bind:after="EvaluateCircuit" min="1" max="1000" step="10" />
                                                <span class="unit">μF</span>
                                            </div>
                                        </div>
                                    }
                                    else if (comp.Type == "switch")
                                    {
                                        <button type="button" class="switch-toggle @(_circuitState.SwitchStates.GetValueOrDefault(comp.Id, false) ? "switch-on" : "switch-off")"
                                                @onclick="() => ToggleSwitch(comp.Id)"
                                                @onclick:stopPropagation="true">
                                            <i class="bi bi-toggle-@(_circuitState.SwitchStates.GetValueOrDefault(comp.Id, false) ? "on" : "off")"></i>
                                            <span>@(_circuitState.SwitchStates.GetValueOrDefault(comp.Id, false) ? "Zapnuto" : "Vypnuto")</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (_circuitState.CircuitClosed && _circuitState.HasPower)
            {
                <div class="circuit-calculations">
                    <h6 class="calculations-title">
                        <i class="bi bi-calculator-fill"></i>
                        Výpočty obvodu
                    </h6>
                    <div class="calculations-grid">
                        <div class="calc-item calc-voltage">
                            <i class="bi bi-lightning-fill"></i>
                            <div class="calc-content">
                                <span class="calc-label">Napětí</span>
                                <span class="calc-value">@_circuitState.Voltage.ToString("F1") V</span>
                            </div>
                        </div>
                        <div class="calc-item calc-resistance">
                            <i class="bi bi-activity"></i>
                            <div class="calc-content">
                                <span class="calc-label">Celkový odpor</span>
                                <span class="calc-value">@_circuitState.TotalResistance.ToString("F1") Ω</span>
                            </div>
                        </div>
                        <div class="calc-item calc-current">
                            <i class="bi bi-arrow-repeat"></i>
                            <div class="calc-content">
                                <span class="calc-label">Proud</span>
                                <span class="calc-value">@_circuitState.Current.ToString("F2") A</span>
                            </div>
                        </div>
                        <div class="calc-item calc-power">
                            <i class="bi bi-fire"></i>
                            <div class="calc-content">
                                <span class="calc-label">Výkon</span>
                                <span class="calc-value">@_circuitState.Power.ToString("F1") W</span>
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(_circuitState.Warning))
                    {
                        <div class="circuit-warning">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <span>@_circuitState.Warning</span>
                        </div>
                    }
                </div>
            }

            <div class="circuit-actions">
                <button class="action-btn btn-reset" @onclick="Reset">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    <span>Resetovat obvod</span>
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .circuit-simulator {
        width: 100%;
    }
    
    .circuit-card {
        background: var(--intro-bg);
        border: none;
        border-radius: 12px;
        box-shadow: none;
    }
    
    .circuit-card .card-body {
        padding: 1.5rem;
    }
    
    /* Info banner */
    .circuit-info-banner {
        display: flex;
        gap: 1rem;
        padding: 1rem;
        background: var(--intro-light-bg);
        border-radius: 10px;
        margin-bottom: 1.5rem;
        align-items: flex-start;
    }
    
    .circuit-info-banner i {
        font-size: 1.5rem;
        color: var(--color-accent-strong);
        flex-shrink: 0;
        margin-top: 2px;
    }
    
    .circuit-info-banner div {
        flex: 1;
    }
    
    .circuit-info-banner strong {
        display: block;
        margin-bottom: 0.25rem;
        color: var(--color-text);
    }
    
    .circuit-info-banner span {
        font-size: 0.9rem;
        color: var(--color-text);
        opacity: 0.85;
    }
    
    /* Canvas container */
    .canvas-container {
        position: relative;
        border: 3px solid var(--color-accent);
        min-height: 500px;
        background: var(--intro-light-bg);
        border-radius: 10px;
        overflow: hidden;
        user-select: none;
        margin-bottom: 1.5rem;
    }
    
    /* Circuit component */
    .circuit-component {
        width: 80px;
        height: 80px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: var(--color-accent-2);
        border: 2px solid var(--color-accent);
        border-radius: 8px;
        transition: all 0.2s;
        user-select: none;
    }
    
    .circuit-component:hover {
        border-color: var(--color-accent-strong);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        transform: scale(1.05);
    }
    
    .circuit-component.selected {
        border-color: var(--color-accent-strong);
        border-width: 3px;
        box-shadow: 0 0 0 3px rgba(209, 117, 166, 0.25);
    }
    
    .component-label {
        font-size: 0.7rem;
        text-align: center;
        margin-top: 4px;
        font-weight: bold;
    }
    
    .component-value {
        font-size: 0.65rem;
        text-align: center;
        color: #6c757d;
        font-weight: normal;
    }
    
    .component-metrics {
        font-size: 0.6rem;
        text-align: center;
        color: #0d6efd;
        font-weight: bold;
        background: rgba(13, 110, 253, 0.1);
        border-radius: 3px;
        padding: 1px 3px;
        margin-top: 2px;
    }
    
    .bulb-lit {
        animation: glow 0.5s ease-in-out infinite alternate;
    }
    
    .bulb-bright {
        animation: glow-bright 0.5s ease-in-out infinite alternate;
    }
    
    .bulb-dim {
        animation: glow-dim 1s ease-in-out infinite alternate;
    }
    
    @@keyframes glow {
        from { filter: drop-shadow(0 0 5px #ffc107); }
        to { filter: drop-shadow(0 0 15px #ffc107); }
    }
    
    @@keyframes glow-bright {
        from { filter: drop-shadow(0 0 10px #ffc107) drop-shadow(0 0 20px #ffc107); }
        to { filter: drop-shadow(0 0 20px #ffc107) drop-shadow(0 0 30px #ffc107); }
    }
    
    @@keyframes glow-dim {
        from { filter: drop-shadow(0 0 2px #ff8800); }
        to { filter: drop-shadow(0 0 5px #ff8800); }
    }
    
    @@keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
    
    /* Toolbar */
    .circuit-toolbar {
        margin-bottom: 1.5rem;
    }
    
    .toolbar-section {
        background: var(--intro-light-bg);
        padding: 1.25rem;
        border-radius: 10px;
    }
    
    .toolbar-title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0 0 1rem 0;
        color: var(--color-text);
        font-size: 1rem;
        text-decoration: none;
    }
    
    .toolbar-title i {
        color: var(--color-accent-strong);
    }
    
    .component-buttons {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 0.75rem;
    }
    
    .component-btn {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    
    .component-btn i {
        font-size: 1.25rem;
    }
    
    .component-btn span {
        font-size: 0.9rem;
    }
    
    /* Status messages */
    .circuit-status {
        margin-bottom: 1.5rem;
    }
    
    .status-message {
        display: flex;
        gap: 1rem;
        padding: 1rem 1.25rem;
        border-radius: 10px;
        align-items: flex-start;
    }
    
    .status-message i {
        font-size: 1.5rem;
        flex-shrink: 0;
        margin-top: 2px;
    }
    
    .status-message div {
        flex: 1;
    }
    
    .status-message strong {
        display: block;
        margin-bottom: 0.25rem;
    }
    
    .status-message span {
        font-size: 0.9rem;
        opacity: 0.9;
    }
    
    .status-success {
        background: var(--good-bg);
        border: 2px solid var(--good-border);
        color: var(--good-text);
    }
    
    .status-success i {
        color: var(--good);
    }
    
    .status-warning {
        background: var(--warning-bg);
        border: 2px solid var(--warning-border);
        color: var(--warning-text);
    }
    
    .status-warning i {
        color: var(--warning-text);
    }
    
    .status-info {
        background: rgba(13, 110, 253, 0.1);
        border: 2px solid rgba(13, 110, 253, 0.3);
        color: #0d6efd;
    }
    
    .status-info i {
        color: #0d6efd;
    }
    
    /* Component settings */
    .component-settings {
        background: var(--intro-light-bg);
        padding: 1.25rem;
        border-radius: 10px;
        margin-bottom: 1.5rem;
    }
    
    .settings-title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0 0 1rem 0;
        color: var(--color-text);
        font-size: 1rem;
        text-decoration: none;
    }
    
    .settings-title i {
        color: var(--color-accent-strong);
    }
    
    .settings-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 1rem;
    }
    
    .setting-card {
        background: var(--color-accent);
        border: 2px solid var(--color-accent);
        border-radius: 8px;
        padding: 1rem;
        transition: all 0.2s;
    }
    
    .setting-card:hover {
        border-color: var(--color-accent-2);
    }
    
    .setting-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
    }
    
    .setting-header i {
        font-size: 1.25rem;
        color: #000;
    }
    
    .setting-label {
        font-weight: 600;
        color: var(--color-button-text);
        font-size: 0.95rem;
    }
    
    .setting-control {
        width: 100%;
    }
    
    .control-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    
    .control-group label {
        font-size: 0.85rem;
        color: var(--color-button-text);
        font-weight: 500;
        opacity: 0.9;
    }
    
    .input-with-unit {
        display: flex;
        align-items: stretch;
        background: var(--intro-light-bg);
        border: 2px solid var(--intro-light-bg);
        border-radius: 6px;
        overflow: hidden;
        transition: all 0.2s;
    }
    
    .input-with-unit:focus-within {
        border-color: var(--color-accent-strong);
    }
    
    .input-with-unit input {
        flex: 1;
        padding: 0.5rem;
        border: none;
        background: transparent;
        color: var(--color-text);
        font-size: 0.95rem;
        font-weight: 500;
        outline: none;
    }
    
    .input-with-unit .unit {
        display: flex;
        align-items: center;
        padding: 0 0.75rem;
        background: var(--color-accent-2);
        color: var(--color-button-text);
        font-weight: 600;
        font-size: 0.85rem;
        border-left: 2px solid var(--intro-light-bg);
    }
    
    .switch-toggle i {
        font-size: 1.25rem;
    }
    
    .switch-toggle.switch-on {
        background: var(--good-bg);
        border-color: var(--good-border);
        color: var(--good-text);
    }
    
    .switch-toggle.switch-on:hover {
        background: var(--good-border);
    }
    
    .switch-toggle.switch-off {
        background: var(--intro-light-bg);
        border-color: var(--intro-light-bg);
        color: var(--color-text);
    }
    
    .switch-toggle.switch-off:hover {
        border-color: var(--color-accent-2);
    }
    
    /* Circuit calculations */
    .circuit-calculations {
        background: var(--intro-light-bg);
        padding: 1.25rem;
        border-radius: 10px;
        margin-bottom: 1.5rem;
        border: 2px solid var(--color-accent);
    }
    
    .calculations-title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0 0 1rem 0;
        color: var(--color-text);
        font-size: 1rem;
        text-decoration: none;
    }
    
    .calculations-title i {
        color: var(--color-accent-strong);
    }
    
    .calculations-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 1rem;
    }
    
    .calc-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1rem;
        background: var(--color-accent);
        border: 2px solid var(--color-accent);
        border-radius: 8px;
        transition: all 0.2s;
    }
    
    .calc-item:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }
    
    .calc-item i {
        font-size: 1.75rem;
        flex-shrink: 0;
        color: #000 !important;
    }
    
    .calc-content {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }
    
    .calc-label {
        font-size: 0.75rem;
        color: var(--color-button-text);
        opacity: 0.8;
        font-weight: 500;
