@using System.Text.Json
@using Tobiso.Web.Shared.DTOs
@using Microsoft.JSInterop
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="exercise-shell circuit-simulator">
    <div class="canvas-container"
         @onmousemove="OnCanvasMouseMove"
         @onmouseup="OnCanvasMouseUp"
         @oncontextmenu:preventDefault="true">

        <svg class="wires-layer">
            @foreach (var connection in _connections)
            {
                var from = _components.FirstOrDefault(c => c.Id == connection.From);
                var to = _components.FirstOrDefault(c => c.Id == connection.To);
                if (from != null && to != null)
                {
                    var isLive = _circuitState.LiveConnections.Contains(connection.Id);
                    <line x1="@(from.X + 40)" y1="@(from.Y + 40)"
                          x2="@(to.X + 40)" y2="@(to.Y + 40)"
                          class="wire @(isLive ? "wire-live" : "")" />
                    @* Wider invisible hit-target over the thin wire, so right-click is easy to land. *@
                    <line x1="@(from.X + 40)" y1="@(from.Y + 40)"
                          x2="@(to.X + 40)" y2="@(to.Y + 40)"
                          class="wire-hit"
                          @oncontextmenu="() => OnWireRightClick(connection.Id)"
                          @oncontextmenu:preventDefault="true"
                          @oncontextmenu:stopPropagation="true" />
                }
            }

            @if (_connectingFrom != null)
            {
                var from = _components.FirstOrDefault(c => c.Id == _connectingFrom);
                if (from != null)
                {
                    <line x1="@(from.X + 40)" y1="@(from.Y + 40)" x2="@_mouseX" y2="@_mouseY" class="wire wire-pending" />
                }
            }
        </svg>

        @foreach (var component in _components)
        {
            var brightness = GetBrightness(component);
            var isActive = brightness > 0.1;
            var isSwitchOn = component.Type is "switch" or "pushbutton" && _circuitState.SwitchStates.GetValueOrDefault(component.Id, false);

            <div class="circuit-component @(component.Id == _selectedComponent ? "selected" : "")"
                 style="left:@(component.X)px; top:@(component.Y)px; cursor:@(_draggingComponent == component.Id ? "grabbing" : "grab");"
                 @onmousedown="(e) => OnComponentMouseDown(e, component.Id)"
                 @onmousedown:stopPropagation="true"
                 @oncontextmenu="() => OnComponentRightClick(component.Id)"
                 @oncontextmenu:preventDefault="true">

                <div class="component-icon @GetBrightnessClass(brightness)" style="color:@GetComponentColor(component.Type, isActive, isSwitchOn)">
                    <i data-lucide="@GetIconName(component.Id, component.Type, isActive, isSwitchOn)"></i>
                </div>
                <div class="component-label">@component.Label</div>
                @if (component.Value > 0)
                {
                    <div class="component-value">@GetValueDisplay(component)</div>
                }
                @if ((isActive || component.Type == "ammeter") && _circuitState.ComponentMetrics.TryGetValue(component.Id, out var metrics))
                {
                    <div class="component-metrics">@metrics.Current.ToString("F2")A</div>
                }
                else if (component.Type == "voltmeter" && _circuitState.ComponentMetrics.ContainsKey(component.Id))
                {
                    <div class="component-metrics">@_circuitState.Voltage.ToString("F1")V</div>
                }
            </div>
        }
    </div>

    @if (_availableTypes.Count > 0)
    {
        <div class="component-buttons">
            @foreach (var type in _availableTypes)
            {
                <button class="pill" @onclick="() => AddComponent(type)" aria-label="Přidat @GetComponentTypeLabel(type)">
                    <i data-lucide="@GetIconName("", type, false, false)"></i>
                    <span>@GetComponentTypeLabel(type)</span>
                </button>
            }
        </div>
    }

    @if (_circuitState.HasPower || !_circuitState.CircuitClosed)
    {
        <div class="circuit-status @(_circuitState.HasPower && _circuitState.CircuitClosed ? "status-good" : "status-warn")">
            @if (_circuitState.HasPower && _circuitState.CircuitClosed)
            {
                <i data-lucide="zap"></i>
                <span>Obvod je uzavřený a má napájení!</span>
            }
            else if (!_circuitState.HasPower)
            {
                <i data-lucide="alert-triangle"></i>
                <span>Chybí zdroj napájení - přidej baterii nebo sluneční článek do obvodu.</span>
            }
            else
            {
                <i data-lucide="alert-triangle"></i>
                <span>Obvod není uzavřený - propoj všechny komponenty do smyčky nebo zapni přepínač.</span>
            }
        </div>
    }

    @if (_components.Any(c => c.Type is "battery" or "resistor" or "bulb" or "capacitor" or "switch" or "fuse" or "photoresistor" or "solarcell" or "pushbutton"))
    {
        <div class="settings-grid">
            @foreach (var comp in _components.Where(c => c.Type is "battery" or "resistor" or "bulb" or "capacitor" or "switch" or "fuse" or "photoresistor" or "solarcell" or "pushbutton"))
            {
                <div class="setting-card">
                    <span class="setting-label">@comp.Label</span>
                    @if (comp.Type == "switch")
                    {
                        <button type="button" class="pill @(_circuitState.SwitchStates.GetValueOrDefault(comp.Id, false) ? "pill-on" : "")"
                                @onclick="() => ToggleSwitch(comp.Id)" @onclick:stopPropagation="true">
                            <i data-lucide="@(_circuitState.SwitchStates.GetValueOrDefault(comp.Id, false) ? "toggle-right" : "toggle-left")"></i>
                            @(_circuitState.SwitchStates.GetValueOrDefault(comp.Id, false) ? "Zapnuto" : "Vypnuto")
                        </button>
                    }
                    else if (comp.Type == "pushbutton")
                    {
                        <button type="button" class="pill @(_circuitState.SwitchStates.GetValueOrDefault(comp.Id, false) ? "pill-on" : "")"
                                @onmousedown="() => SetPushButtonState(comp.Id, true)"
                                @onmouseup="() => SetPushButtonState(comp.Id, false)"
                                @onmouseleave="() => SetPushButtonState(comp.Id, false)"
                                @onmousedown:stopPropagation="true">
                            <i data-lucide="@(_circuitState.SwitchStates.GetValueOrDefault(comp.Id, false) ? "circle-dot" : "circle")"></i>
                            Drž pro sepnutí
                        </button>
                    }
                    else if (comp.Type == "photoresistor")
                    {
                        <div class="control-slider">
                            <input type="range" min="0" max="100" step="5" @bind="comp.Value" @bind:after="EvaluateCircuit" />
                            <span class="unit">@comp.Value.ToString("0")% světla</span>
                        </div>
                    }
                    else
                    {
                        <div class="input-with-unit">
                            <input type="number" @bind="comp.Value" @bind:after="EvaluateCircuit" min="1" max="10000" step="@GetValueStep(comp.Type)" />
                            <span class="unit">@GetUnit(comp.Type)</span>
                        </div>
                    }
                </div>
            }
        </div>
    }

    @if (_circuitState.Current > 0)
    {
        <div class="calculations-grid">
            <div class="calc-item"><span class="calc-label">Napětí</span><span class="calc-value">@_circuitState.Voltage.ToString("F1") V</span></div>
            <div class="calc-item"><span class="calc-label">Odpor</span><span class="calc-value">@_circuitState.TotalResistance.ToString("F1") Ω</span></div>
            <div class="calc-item"><span class="calc-label">Proud</span><span class="calc-value">@_circuitState.Current.ToString("F2") A</span></div>
            <div class="calc-item"><span class="calc-label">Výkon</span><span class="calc-value">@_circuitState.Power.ToString("F1") W</span></div>
        </div>
    }
    @if (!string.IsNullOrEmpty(_circuitState.Warning))
    {
        <div class="circuit-status status-warn"><i data-lucide="alert-triangle"></i><span>@_circuitState.Warning</span></div>
    }

    <div class="exercise-actions">
        <button class="pill" @onclick="Reset"><i data-lucide="rotate-ccw"></i> Znovu</button>
        <span class="exercise-actions-spacer"></span>
        <div class="tooltip">
            <button class="help-btn" type="button" aria-label="Návod k ovládání"><i data-lucide="help-circle"></i></button>
            <span class="tooltip-text">Přetáhni komponenty na plochu • Klikni na dvě komponenty pro spojení vodičem • Pravé tlačítko pro smazání komponenty nebo vodiče</span>
        </div>
    </div>
</div>

<style>
    .circuit-simulator {
        --wire-color: var(--color-neutral-500);
        --wire-live-color: var(--color-accent-500);
    }

    .canvas-container {
        position: relative;
        min-height: 420px;
        background: var(--color-neutral-100);
        border: 2px dashed var(--color-divider);
        border-radius: var(--radius-lg);
        overflow: hidden;
        user-select: none;
    }

    .wires-layer {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 1;
    }

    .wire {
        stroke: var(--wire-color);
        stroke-width: 3;
    }

    .wire-live {
        stroke: var(--wire-live-color);
        stroke-width: 4;
        filter: drop-shadow(0 0 6px var(--wire-live-color));
    }

    .wire-pending {
        stroke: var(--color-accent-2-600);
        stroke-width: 3;
        stroke-dasharray: 5, 5;
    }

    .wire-hit {
        stroke: transparent;
        stroke-width: 16px;
        pointer-events: stroke;
        cursor: pointer;
    }

    .circuit-component {
        position: absolute;
        z-index: 10;
        width: 80px;
        height: 80px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 2px;
        background: var(--color-surface);
        border: 2px solid var(--color-divider);
        border-radius: var(--radius-md);
        transition: border-color 120ms ease, transform 120ms ease;
    }

    .circuit-component:hover {
        border-color: var(--color-accent-500);
    }

    .circuit-component.selected {
        border-color: var(--color-accent-600);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent-600) 30%, transparent);
    }

    .component-icon svg {
        width: 28px;
        height: 28px;
    }

    .component-icon.bulb-lit svg,
    .component-icon.bulb-bright svg {
        animation: circuit-glow 0.6s ease-in-out infinite alternate;
    }

    @@keyframes circuit-glow {
        from { filter: drop-shadow(0 0 4px currentColor); }
        to { filter: drop-shadow(0 0 12px currentColor); }
    }

    .component-icon.spin svg {
        animation: circuit-spin 1s linear infinite;
    }

    @@keyframes circuit-spin {
        to { transform: rotate(360deg); }
    }

    .component-label {
        font-size: 11px;
        font-weight: 600;
        text-align: center;
        color: var(--color-text);
    }

    .component-value {
        font-size: 10px;
        color: var(--color-neutral-600);
    }

    .component-metrics {
        font-size: 10px;
        font-weight: 600;
        color: var(--color-accent-700);
    }

    .component-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
    }

    .circuit-status {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        padding: var(--space-3) var(--space-4);
        border-radius: var(--radius-md);
        font-size: 14px;
    }

    .circuit-status.status-good {
        background: var(--color-accent-2-100);
        color: var(--color-accent-2-900);
    }

    .circuit-status.status-warn {
        background: var(--color-accent-100);
        color: var(--color-accent-800);
    }

    .settings-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: var(--space-3);
    }

    .setting-card {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
        padding: var(--space-3);
        border-radius: var(--radius-md);
        background: var(--color-neutral-100);
    }

    .setting-label {
        font-size: 13px;
        font-weight: 600;
        color: var(--color-text);
    }

    .input-with-unit {
        display: flex;
        align-items: stretch;
        border-radius: var(--radius-sm);
        overflow: hidden;
        border: 1px solid var(--color-divider);
        background: var(--color-surface);
    }

    .input-with-unit input {
        flex: 1;
        min-width: 0;
        padding: 6px 8px;
        border: none;
        background: transparent;
        color: var(--color-text);
        font: inherit;
    }

    .input-with-unit .unit {
        display: flex;
        align-items: center;
        padding: 0 10px;
        background: var(--color-neutral-200);
        color: var(--color-neutral-700);
        font-size: 12px;
        font-weight: 600;
    }

    .control-slider {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
    }

    .control-slider input[type="range"] {
        width: 100%;
        accent-color: var(--color-accent-600);
    }

    .control-slider .unit {
        font-size: 12px;
        font-weight: 600;
        color: var(--color-neutral-700);
    }

    .calculations-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
        gap: var(--space-3);
    }

    .calc-item {
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding: var(--space-3);
        border-radius: var(--radius-md);
        background: var(--color-neutral-100);
    }

    .calc-label {
        font-size: 11px;
        color: var(--color-neutral-600);
    }

    .calc-value {
        font-size: 16px;
        font-weight: 700;
        color: var(--color-text);
    }

    @@media (max-width: 640px) {
        .canvas-container {
            min-height: 320px;
        }
    }
</style>

@code {
    [Parameter, EditorRequired]
    public InteractiveExerciseResponse Exercise { get; set; } = null!;

    private List<PlacedComponent> _components = new();
    private List<ConnectionInstance> _connections = new();
    private List<string> _availableTypes = new();
    private int _componentCounter = 1;
    private int? _loadedExerciseId;

    private string? _draggingComponent;
    private double _dragOffsetX;
    private double _dragOffsetY;
    private double _mouseDownX;
    private double _mouseDownY;
    private bool _hasDragged;

    private string? _connectingFrom;
    private string? _selectedComponent;
    private double _mouseX;
    private double _mouseY;

    private CircuitState _circuitState = new();

    private static readonly string[] DefaultPalette =
    {
        "battery", "bulb", "switch", "resistor", "capacitor", "led", "motor", "buzzer", "fuse", "ammeter",
        "voltmeter", "coil", "photoresistor", "solarcell", "pushbutton"
    };

    protected override void OnParametersSet()
    {
        if (_loadedExerciseId == Exercise.Id) return;
        _loadedExerciseId = Exercise.Id;
        LoadConfig();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("initLucide");
    }

    private void LoadConfig()
    {
        _components.Clear();
        _connections.Clear();
        _availableTypes.Clear();
        _circuitState = new CircuitState();
        _componentCounter = 1;

        try
        {
            var doc = JsonDocument.Parse(Exercise.ConfigJson);

            if (doc.RootElement.TryGetProperty("components", out var componentsArray))
            {
                foreach (var item in componentsArray.EnumerateArray())
                {
                    var type = item.GetProperty("type").GetString() ?? "";
                    var comp = new PlacedComponent
                    {
                        Id = item.GetProperty("id").GetString() ?? "",
                        Type = type,
                        Label = GetComponentTypeLabel(type),
                        X = item.TryGetProperty("x", out var x) ? x.GetDouble() : 50,
                        Y = item.TryGetProperty("y", out var y) ? y.GetDouble() : 50,
                        Value = item.TryGetProperty("voltage", out var v) ? v.GetDouble()
                              : item.TryGetProperty("resistance", out var r) ? r.GetDouble()
                              : item.TryGetProperty("lightLevel", out var l) ? l.GetDouble()
                              : 0
                    };
                    _components.Add(comp);

                    if (type == "switch" && item.TryGetProperty("state", out var state) && state.GetString() == "on")
                    {
                        _circuitState.SwitchStates[comp.Id] = true;
                    }
                }
            }

            if (doc.RootElement.TryGetProperty("availableComponents", out var availableArray))
            {
                foreach (var item in availableArray.EnumerateArray())
                {
                    var type = item.GetProperty("type").GetString();
                    if (!string.IsNullOrEmpty(type)) _availableTypes.Add(type);
                }
            }
        }
        catch
        {
            // Neplatný nebo prázdný ConfigJson - pokračujeme s prázdnou plochou.
        }

        // "wire" is never something a student places - a wire is created by clicking
        // two components, so it must not appear as an addable palette item.
        _availableTypes = _availableTypes.Where(t => t != "wire").Distinct().ToList();

        if (_availableTypes.Count == 0 && _components.Count == 0)
        {
            _availableTypes.AddRange(DefaultPalette);
        }

        // A battery is always offered, even when the exercise's ConfigJson restricts
        // the palette to a smaller set, so the student can always power a circuit.
        if (!_availableTypes.Contains("battery"))
        {
            _availableTypes.Insert(0, "battery");
        }

        EvaluateCircuit();
    }

    private void AddComponent(string type)
    {
        var id = $"usr_{_componentCounter++}";
        var defaultValue = type switch
        {
            "battery" => 9.0,
            "resistor" => 100.0,
            "bulb" => 10.0,
            "capacitor" => 100.0,
            "fuse" => 2.0,
            "solarcell" => 6.0,
            "photoresistor" => 50.0,
            _ => 0.0
        };

        _components.Add(new PlacedComponent
        {
            Id = id,
            Type = type,
            Label = $"{GetComponentTypeLabel(type)} {_componentCounter - 1}",
            Value = defaultValue,
            X = 50 + (_components.Count % 5) * 100,
            Y = 50 + (_components.Count / 5) * 100
        });
        EvaluateCircuit();
    }

    private void OnComponentMouseDown(MouseEventArgs e, string componentId)
    {
        if (e.Button != 0) return;

        _draggingComponent = componentId;
        _hasDragged = false;
        _mouseDownX = e.ClientX;
        _mouseDownY = e.ClientY;

        var comp = _components.FirstOrDefault(c => c.Id == componentId);
        if (comp != null)
        {
            _dragOffsetX = e.ClientX - comp.X;
            _dragOffsetY = e.ClientY - comp.Y;
        }
    }

    private void OnCanvasMouseMove(MouseEventArgs e)
    {
        _mouseX = e.OffsetX;
        _mouseY = e.OffsetY;

        if (_draggingComponent == null) return;

        var distance = Math.Sqrt(Math.Pow(e.ClientX - _mouseDownX, 2) + Math.Pow(e.ClientY - _mouseDownY, 2));
        if (distance > 5) _hasDragged = true;

        if (_hasDragged)
        {
            var comp = _components.FirstOrDefault(c => c.Id == _draggingComponent);
            if (comp != null)
            {
                comp.X = Math.Max(0, Math.Min(e.ClientX - _dragOffsetX, 800));
                comp.Y = Math.Max(0, Math.Min(e.ClientY - _dragOffsetY, 340));
            }
        }
    }

    private void OnCanvasMouseUp(MouseEventArgs e)
    {
        if (_draggingComponent != null && !_hasDragged)
        {
            OnComponentClick(_draggingComponent);
        }

        _draggingComponent = null;
        _hasDragged = false;
    }

    private void OnComponentClick(string componentId)
    {
        var comp = _components.FirstOrDefault(c => c.Id == componentId);
        if (comp == null) return;

        if (_connectingFrom == null)
        {
            _connectingFrom = componentId;
            _selectedComponent = componentId;
        }
        else if (_connectingFrom != componentId)
        {
            var alreadyWired = _connections.Any(c =>
                (c.From == _connectingFrom && c.To == componentId) ||
                (c.To == _connectingFrom && c.From == componentId));

            if (!alreadyWired)
            {
                _connections.Add(new ConnectionInstance
                {
                    Id = $"conn_{_connections.Count + 1}",
                    From = _connectingFrom,
                    To = componentId
                });
            }

            _connectingFrom = null;
            _selectedComponent = null;
            EvaluateCircuit();
        }
        else
        {
            _connectingFrom = null;
            _selectedComponent = null;
        }
    }

    private void OnComponentRightClick(string componentId)
    {
        var comp = _components.FirstOrDefault(c => c.Id == componentId);
        if (comp == null) return;

        _components.RemoveAll(c => c.Id == componentId);
        _connections.RemoveAll(c => c.From == componentId || c.To == componentId);

        if (_selectedComponent == componentId)
        {
            _selectedComponent = null;
            _connectingFrom = null;
        }

        EvaluateCircuit();
    }

    private void OnWireRightClick(string connectionId)
    {
        _connections.RemoveAll(c => c.Id == connectionId);
        EvaluateCircuit();
    }

    private void ToggleSwitch(string switchId)
    {
        var current = _circuitState.SwitchStates.GetValueOrDefault(switchId, false);
        _circuitState.SwitchStates[switchId] = !current;
        EvaluateCircuit();
    }

    // Unlike ToggleSwitch, a push-button only conducts while actively held down.
    private void SetPushButtonState(string buttonId, bool pressed)
    {
        _circuitState.SwitchStates[buttonId] = pressed;
        EvaluateCircuit();
    }

    private void EvaluateCircuit()
    {
        var previousSwitchStates = new Dictionary<string, bool>(_circuitState.SwitchStates);
        _circuitState = new CircuitState { SwitchStates = previousSwitchStates };

        // "solarcell" is a second power-source type alongside "battery" - both contribute voltage the same way.
        var powerSources = _components.Where(c => c.Type is "battery" or "solarcell").ToList();
        if (!powerSources.Any())
        {
            _circuitState.HasPower = false;
            return;
        }

        _circuitState.HasPower = true;
        _circuitState.Voltage = powerSources.Sum(b => b.Value);

        var graph = new Dictionary<string, List<string>>();
        foreach (var comp in _components) graph[comp.Id] = new List<string>();
        foreach (var conn in _connections)
        {
            if (graph.ContainsKey(conn.From)) graph[conn.From].Add(conn.To);
            if (graph.ContainsKey(conn.To)) graph[conn.To].Add(conn.From);
        }

        foreach (var source in powerSources)
        {
            var pathFound = FindClosedCircuit(source.Id, source.Id, new HashSet<string>(), graph, new List<string>());
            if (!pathFound.found) continue;

            _circuitState.CircuitClosed = true;
            var visited = new HashSet<string>(pathFound.path);

            double totalResistance = 0;
            foreach (var compId in visited)
            {
                var comp = _components.FirstOrDefault(c => c.Id == compId);
                if (comp == null) continue;

                totalResistance += comp.Type switch
                {
                    "resistor" or "bulb" => comp.Value,
                    "photoresistor" => GetPhotoresistorResistance(comp.Value),
                    "motor" => 5,
                    "led" => 100,
                    "buzzer" => 50,
                    "coil" => 2,
                    _ => 0
                };
            }

            if (totalResistance < 0.1) totalResistance = 0.1;

            _circuitState.TotalResistance = totalResistance;
            _circuitState.Current = _circuitState.Voltage / totalResistance;
            _circuitState.Power = _circuitState.Voltage * _circuitState.Current;

            var blownFuse = _components.FirstOrDefault(c =>
                c.Type == "fuse" && visited.Contains(c.Id) && c.Value > 0 && _circuitState.Current > c.Value);
            if (blownFuse != null)
            {
                _circuitState.BlownFuses.Add(blownFuse.Id);
                _circuitState.CircuitClosed = false;
                _circuitState.Warning = $"⚠️ Pojistka „{blownFuse.Label}“ shořela - proud {_circuitState.Current:F2}A překročil mez {blownFuse.Value:F1}A.";
                continue;
            }

            if (_circuitState.Current > 3)
            {
                _circuitState.Warning = "⚠️ Obvodem prochází velký proud - zvyšte odpor nebo snižte napětí.";
            }

            foreach (var compId in visited)
            {
                var comp = _components.FirstOrDefault(c => c.Id == compId);
                if (comp != null)
                {
                    _circuitState.ComponentMetrics[comp.Id] = new ComponentMetrics { Current = _circuitState.Current };
                }
            }

            foreach (var comp in _components.Where(c => c.Type is "bulb" or "led" or "motor" or "buzzer"))
            {
                if (visited.Contains(comp.Id)) _circuitState.LitComponents.Add(comp.Id);
            }

            for (int i = 0; i < pathFound.path.Count - 1; i++)
            {
                var conn = _connections.FirstOrDefault(c =>
                    (c.From == pathFound.path[i] && c.To == pathFound.path[i + 1]) ||
                    (c.To == pathFound.path[i] && c.From == pathFound.path[i + 1]));
                if (conn != null) _circuitState.LiveConnections.Add(conn.Id);
            }
        }
    }

    private (bool found, List<string> path) FindClosedCircuit(string start, string current, HashSet<string> visited, Dictionary<string, List<string>> graph, List<string> path)
    {
        path.Add(current);
        visited.Add(current);

        var currentComp = _components.FirstOrDefault(c => c.Id == current);
        if (currentComp?.Type is "switch" or "pushbutton" && !_circuitState.SwitchStates.GetValueOrDefault(current, false) && path.Count > 1)
        {
            path.RemoveAt(path.Count - 1);
            visited.Remove(current);
            return (false, path);
        }

        foreach (var neighbor in graph.GetValueOrDefault(current, new List<string>()))
        {
            if (neighbor == start && path.Count >= 3)
            {
                path.Add(neighbor);
                return (true, new List<string>(path));
            }

            if (!visited.Contains(neighbor))
            {
                var result = FindClosedCircuit(start, neighbor, visited, graph, path);
                if (result.found) return result;
            }
        }

        path.RemoveAt(path.Count - 1);
        visited.Remove(current);
        return (false, path);
    }

    private void Reset()
    {
        LoadConfig();
    }

    private double GetBrightness(PlacedComponent comp)
    {
        if (!_circuitState.LitComponents.Contains(comp.Id)) return 0;
        if (!_circuitState.ComponentMetrics.TryGetValue(comp.Id, out var metrics)) return 0;
        return metrics.Current;
    }

    private string GetBrightnessClass(double current)
    {
        if (current <= 0) return "";
        if (current < 0.5) return "bulb-dim";
        if (current > 2) return "bulb-bright";
        return "bulb-lit";
    }

    // More light -> lower resistance, like a real LDR. lightPercent is 0 (dark) - 100 (bright).
    private static double GetPhotoresistorResistance(double lightPercent)
    {
        const double minResistance = 50, maxResistance = 5000;
        var clamped = Math.Clamp(lightPercent, 0, 100);
        return maxResistance - clamped / 100.0 * (maxResistance - minResistance);
    }

