        public HashSet<string> LitBulbs { get; set; } = new();
        public HashSet<string> LiveConnections { get; set; } = new();
        public Dictionary<string, bool> SwitchStates { get; set; } = new();
        public Dictionary<string, ComponentMetrics> ComponentMetrics { get; set; } = new();
        public double Voltage { get; set; }
        public double TotalResistance { get; set; }
        public double Current { get; set; }
        public double Power { get; set; }
        public string Warning { get; set; } = "";
