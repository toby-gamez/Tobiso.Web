@inherits LayoutComponentBase
@inject IJSRuntime JS

<div class="app-shell">
    <NavMenu OnSearchOpen="OpenSearch" />
    <main class="main-content">
        @Body
    </main>
</div>

<ActivityPinger />
<SearchModal @ref="_search" />
<AddendumModal />
<PersonModal />
<AccountRequiredModal />
@* Cookie banner first = lowest (column-reverse), so the legal notice stacks above it when both show. *@
<div class="floating-stack">
    <CookieConsentBanner />
    <LegalChangeBanner />
</div>

@code {
    private SearchModal? _search;

    private void OpenSearch() => _search?.Open();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The session now lives in an HttpOnly cookie the circuit already authenticated from;
        // just drop any token an older version left in localStorage.
        if (firstRender)
            await JS.InvokeVoidAsync("tobisoClearLegacyToken");
    }
}
