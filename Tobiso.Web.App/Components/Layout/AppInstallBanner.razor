@using Tobiso.Web.App.Services
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<div id="app-install-banner" class="@(visible ? "" : "hidden")" role="region" aria-label="Tobiso mobilní aplikace">
    <p>Proč nemáš ještě mobilní aplikaci Tobiso?</p>
    <div class="buttons">
        <button class="download" @onclick="DownloadApp">Stáhnout</button>
        <button class="hide" @onclick="HideBanner" aria-label="Schovat banner">✕</button>
    </div>
</div>

@code {
    private bool visible = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var pref = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "appInstallHidden");
            visible = pref != "true";
        }
        catch
        {
            visible = true;
        }
    }

    private async Task DownloadApp()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("sessionStorage.setItem", "appInstallHidden", "true");
        }
        catch { }
        visible = false;
        NavigationManager.NavigateTo("/post/240");
    }

    private async Task HideBanner()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("sessionStorage.setItem", "appInstallHidden", "true");
        }
        catch { }
        visible = false;
        StateHasChanged();
    }
}
