@code {
    [Parameter]
    public bool IsDarkMode { get; set; }

    [CascadingParameter]
    private MainLayout? Layout { get; set; }

    private bool isMobileMenuOpen = false;
    private void ToggleMobileMenu() => isMobileMenuOpen = !isMobileMenuOpen;
    private void CloseMobileMenu() => isMobileMenuOpen = false;
    private bool isSidebarExpanded = false;

    private async Task ToggleSidebar()
    {
        isSidebarExpanded = !isSidebarExpanded;
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "sidebar-expanded", isSidebarExpanded.ToString().ToLower());
        }
        catch { }
        Layout?.SetNavMenuExpanded(isSidebarExpanded);
    }

    private void OpenGraph()
    {
        CloseMobileMenu();
        GraphModalService.OpenGraphModal();
    }

    private void HandleCloseMobileMenuKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" || e.Key == "Enter" || e.Key == " " || e.Key == "Spacebar")
            CloseMobileMenu();
    }

    private List<Tobiso.Web.Shared.DTOs.GradeResponse>? grades;
    private int? selectedGradeId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            grades = (await AnonymApi.GetGrades()).ToList();
            selectedGradeId = await PreferenceService.GetPreferredGradeIdAsync();
        }
        catch
        {
            // ignore
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var saved = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "sidebar-expanded");
                isSidebarExpanded = saved == "true";
                Layout?.SetNavMenuExpanded(isSidebarExpanded);
                StateHasChanged();
            }
            catch { }
        }
    }

    private async Task OnGradeChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (int.TryParse(val, out var id))
        {
            selectedGradeId = id;
            await PreferenceService.SetPreferredGradeIdAsync(id);
        }
        else
        {
            selectedGradeId = null;
            await PreferenceService.RemovePreferenceAsync("preferredGradeId");
        }
        // reload page to apply filter
        NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: false);
    }
}
