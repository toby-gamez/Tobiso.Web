<!-- Mobilní menu -->
<nav id="myNavbar">
    <div class="mobile-header">
        <div>
            <a href="categories" @onclick="CloseMobileMenu">
                <img class="navImg" src="https://tobiso.com/images/normal-logo.png" width="150px" alt="normální logo">
            </a>
        </div>
        <div class="nav-link-content">
            <div>
                @if (IsDarkMode)
                {
                    <i class="bi bi-sun"></i>
                }
                else
                {
                    <i class="bi bi-sun-fill"></i>
                }
                <label class="switch">
                    <input type="checkbox" id="dark-mode-toggle-mobile">
                    <span class="slider round"></span>
                </label>
                @if (IsDarkMode)
                {
                    <i class="bi bi-moon-fill"></i>
                }
                else
                {
                    <i class="bi bi-moon"></i>
                }
            </div>
            <span id="openSearch"><i class="bi bi-search"></i></span>
        </div>

        <button class="navbar-toggler" type="button" aria-label="Toggle navigation" @onclick="ToggleMobileMenu">
            <i class="bi bi-list"></i>
        </button>
    </div>
    
    @if (isMobileMenuOpen)
    {
        <div class="mobile-menu-overlay" @onclick="CloseMobileMenu"></div>
        <style>
            main a,
            main strong,
            main h1,
            main h2,
            main h3,
            main h4,
            main h5,
            main h6 {
                z-index: -1 !important;
            }
        </style>
    }
    
    <div class="mobile-menu @(isMobileMenuOpen ? "show" : "")">
        <div class="mobile-menu-header">
            <h5>Menu</h5>
            <button class="event-modal-close" @onclick="CloseMobileMenu">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div class="mobile-menu-content">
            <!-- Grid 1: Domů a Procvičování -->
            <div class="menu-section">
                <div class="menu-grid grid-main">
                    <a class="menu-grid-item navHo" href="categories" @onclick="CloseMobileMenu">
                        <i class="bi bi-house-door"></i>
                        <span>Domů</span>
                    </a>
                    <a class="menu-grid-item" href="all-questions" @onclick="CloseMobileMenu">
                        <i class="bi bi-person-walking"></i>
                        <span>Procvičování</span>
                    </a>
                    <a class="menu-grid-item" href="latest" @onclick="CloseMobileMenu">
                        <i class="bi bi-star"></i>
                        <span>Nejnovější učivo</span>
                    </a>
                </div>
            </div>
            <!-- Grid 2: Předměty -->
            <div class="menu-section">
                <h6 class="section-title">Předměty</h6>
                <div class="menu-grid grid-subjects">
                    <a class="menu-grid-item navAb" href="categories/2" @onclick="CloseMobileMenu">
                        <i class="bi bi-journal-text"></i>
                        <span>Mluvnice</span>
                    </a>
                    <a class="menu-grid-item navLi" href="categories/5" @onclick="CloseMobileMenu">
                        <i class="bi bi-book"></i>
                        <span>Literatura</span>
                    </a>
                    <a class="menu-grid-item navSl" href="categories/3" @onclick="CloseMobileMenu">
                        <i class="bi bi-pen"></i>
                        <span>Sloh</span>
                    </a>
                    <a class="menu-grid-item navHu" href="categories/4" @onclick="CloseMobileMenu">
                        <i class="bi bi-music-note"></i>
                        <span>Hudební výchova</span>
                    </a>
                    <a class="menu-grid-item navMa" href="categories/6" @onclick="CloseMobileMenu">
                        <i class="bi bi-calculator"></i>
                        <span>Matematika</span>
                    </a>
                    <a class="menu-grid-item navCh" href="categories/7" @onclick="CloseMobileMenu">
                        <i class="bi bi-balloon"></i>
                        <span>Chemie</span>
                    </a>
                    <a class="menu-grid-item navFy" href="categories/8" @onclick="CloseMobileMenu">
                        <i class="bi bi-gear"></i>
                        <span>Fyzika</span>
                    </a>
                    <a class="menu-grid-item navFy" href="categories/9" @onclick="CloseMobileMenu">
                        <i class="bi bi-flower2"></i>
                        <span>Přírodopis</span>
                    </a>
                    <a class="menu-grid-item navFy" href="categories/10" @onclick="CloseMobileMenu">
                        <i class="bi bi-globe-americas"></i>
                        <span>Zeměpis</span>
                    </a>
                </div>
            </div>

            <!-- Grid 3: Ostatní -->
            <div class="menu-section">
                <h6 class="section-title">Ostatní</h6>
                <div class="menu-grid grid-other">
                    <a class="menu-grid-item navAnd" href="post/240" @onclick="CloseMobileMenu">
                        <i class="bi bi-android"></i>
                        <span>Android aplikace</span>
                    </a>
                    <a class="menu-grid-item navAb" href="post/16" @onclick="CloseMobileMenu">
                        <i class="bi bi-info-circle"></i>
                        <span>O mně</span>
                    </a>
                    <a class="menu-grid-item navCil" href="post/230" @onclick="CloseMobileMenu">
                        <i class="bi bi-bullseye"></i>
                        <span>Cíl projektu</span>
                    </a>
                    <a class="menu-grid-item navNa" href="post/105" @onclick="CloseMobileMenu">
                        <i class="bi bi-megaphone"></i>
                        <span>Zpětná vazba</span>
                    </a>
                    <a class="menu-grid-item navCha" href="post/134" @onclick="CloseMobileMenu">
                        <i class="bi bi-file-text"></i>
                        <span>Deník změn</span>
                    </a>
                    <a class="menu-grid-item navAnd" href="calendar" @onclick="CloseMobileMenu">
                        <i class="bi bi-calendar-week"></i>
                        <span>Kalendář</span>
                    </a>
                </div>
            </div>
            
            <div class="version-info">2.8.1</div>
        </div>
    </div>

