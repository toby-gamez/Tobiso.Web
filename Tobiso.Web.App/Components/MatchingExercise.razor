@using System.Text.Json
@using Tobiso.Web.Shared.DTOs
@using Tobiso.Web.Shared.Interfaces
@inject IInteractiveExerciseService ExerciseService
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="exercise-shell">
    <div class="matching-columns">
        <div class="matching-col">
            @foreach (var l in _left)
            {
                <button class="chip @(SelectedLeft == l.Id ? "chip-sel" : "")" style="text-align:left" @onclick="() => SelectLeft(l.Id)">@l.Text</button>
            }
        </div>
        <div class="matching-col">
            @foreach (var r in _right)
            {
                <button class="chip @(SelectedRight == r.Id ? "chip-sel" : "")" @onclick="() => SelectRight(r.Id)">@r.Text</button>
            }
        </div>
    </div>

    @if (_userPairs.Count > 0)
    {
        <div class="paired-section">
            <span class="panel-label">Spárováno</span>
            @foreach (var pair in _userPairs)
            {
                var l = _allLeft.FirstOrDefault(x => x.Id == pair.LeftId);
                var r = _allRight.FirstOrDefault(x => x.Id == pair.RightId);
                if (l != null && r != null)
                {
                    var cls = GetPairClass(pair.LeftId);
                    <div class="exercise-pill paired-row @cls">
                        <span class="paired-text">@l.Text → @r.Text</span>
                        @if (_validationResult != null)
                        {
                            <i data-lucide="@(cls == "correct" ? "check-circle-2" : "x-circle")"></i>
                        }
                        else
                        {
                            <button class="paired-remove" @onclick="() => RemovePair(pair.LeftId, pair.RightId)" aria-label="Zrušit pár">
                                <i data-lucide="x"></i>
                            </button>
                        }
                    </div>
                }
            }
        </div>
    }

    <div class="exercise-actions">
        <button class="pill" @onclick="Reset"><i data-lucide="rotate-ccw"></i> Znovu</button>
        <button class="pill pill-on" @onclick="CheckSolution" disabled="@(_checking || _userPairs.Count != _allLeft.Count)">
            @if (_checking)
            {
                <i data-lucide="loader-2" class="spin-icon"></i>
            }
            Zkontrolovat
        </button>
        @if (_validationResult != null)
        {
            <span class="exercise-score @(_validationResult.IsCorrect ? "correct" : "incorrect")">@_validationResult.Feedback</span>
        }
        <span class="exercise-actions-spacer"></span>
        <div class="tooltip">
            <button class="help-btn" type="button" aria-label="Návod k ovládání"><i data-lucide="help-circle"></i></button>
            <span class="tooltip-text">Klikni na položku vlevo, potom na její pár vpravo. Klikni na křížek pro zrušení páru.</span>
        </div>
    </div>
</div>

<style>
    .matching-columns {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-4);
    }
    .matching-col {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
    .matching-col .chip {
        width: 100%;
    }
    .paired-section {
        display: flex;
        flex-direction: column;
        gap: 6px;
        padding-top: var(--space-2);
        border-top: 1px solid var(--color-divider);
    }
    .paired-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 16px;
        width: 100%;
        font-size: 15px;
        cursor: default;
    }
    .paired-text { flex: 1; }
    .paired-remove {
        background: transparent;
        border: 0;
        cursor: pointer;
        color: inherit;
        display: flex;
        opacity: 0.7;
        transition: opacity 0.2s;
    }
    .paired-remove:hover { opacity: 1; }
    @@media (max-width: 600px) {
        .matching-columns { grid-template-columns: 1fr; }
    }
</style>

@code {
    [Parameter]
    public InteractiveExerciseResponse? Exercise { get; set; }

    private List<MatchingItem> _allLeft = new();
    private List<MatchingItem> _allRight = new();
    private List<MatchingItem> _left => _allLeft.Where(l => !_userPairs.Any(p => p.LeftId == l.Id)).ToList();
    private List<MatchingItem> _right => _allRight.Where(r => !_userPairs.Any(p => p.RightId == r.Id)).ToList();
    private List<Pair> _userPairs = new();
    private string? SelectedLeft;
    private string? SelectedRight;
    private bool _checking = false;
    private ValidationResult? _validationResult;
    private Dictionary<string, bool> _pairResults = new();
    private int? _loadedExerciseId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("initLucide");
    }

    protected override void OnParametersSet()
    {
        if (_loadedExerciseId == Exercise?.Id) return;
        _loadedExerciseId = Exercise?.Id;
        LoadConfig();
        Reset();
    }

    private void LoadConfig()
    {
        _allLeft.Clear();
        _allRight.Clear();
        if (Exercise?.ConfigJson != null)
        {
            try
            {
                var doc = JsonDocument.Parse(Exercise.ConfigJson);
                if (doc.RootElement.TryGetProperty("left", out var leftArray))
                {
                    foreach (var item in leftArray.EnumerateArray())
                    {
                        _allLeft.Add(new MatchingItem { Id = item.GetProperty("id").GetString() ?? "", Text = item.GetProperty("text").GetString() ?? "" });
                    }
                }
                if (doc.RootElement.TryGetProperty("right", out var rightArray))
                {
                    foreach (var item in rightArray.EnumerateArray())
                    {
                        _allRight.Add(new MatchingItem { Id = item.GetProperty("id").GetString() ?? "", Text = item.GetProperty("text").GetString() ?? "" });
                    }
                }
                _allLeft = _allLeft.OrderBy(x => Guid.NewGuid()).ToList();
                _allRight = _allRight.OrderBy(x => Guid.NewGuid()).ToList();
            }
            catch { }
        }
    }

    private void SelectLeft(string id)
    {
        SelectedLeft = id;
        TryPair();
    }
    private void SelectRight(string id)
    {
        SelectedRight = id;
        TryPair();
    }
    private void TryPair()
    {
        if (!string.IsNullOrEmpty(SelectedLeft) && !string.IsNullOrEmpty(SelectedRight))
        {
            _userPairs.Add(new Pair { LeftId = SelectedLeft, RightId = SelectedRight });
            SelectedLeft = null;
            SelectedRight = null;
            _validationResult = null;
        }
    }
    private void RemovePair(string leftId, string rightId)
    {
        _userPairs.RemoveAll(p => p.LeftId == leftId && p.RightId == rightId);
        _validationResult = null;
    }
    private string GetPairClass(string leftId)
    {
        if (_pairResults.TryGetValue(leftId, out var ok))
            return ok ? "correct" : "incorrect";
        return string.Empty;
    }
    private void Reset()
    {
        _userPairs.Clear();
        SelectedLeft = null;
        SelectedRight = null;
        _validationResult = null;
        _pairResults.Clear();
    }
    private async Task CheckSolution()
    {
        if (Exercise == null) return;
        _checking = true;
        _validationResult = null;
        try
        {
            var request = new ValidateSolutionRequest
            {
                UserSolutionJson = JsonSerializer.Serialize(
                    new { pairs = _userPairs },
                    new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase })
            };
            var result = await ExerciseService.ValidateSolutionAsync(Exercise.Id, request);
            _validationResult = new ValidationResult
            {
                IsCorrect = result.IsCorrect,
                Score = result.Score,
                Feedback = result.Feedback,
                Explanation = result.Explanation ?? ""
            };
            _pairResults.Clear();
            if (result.DetailedResults != null)
            {
                foreach (var kv in result.DetailedResults)
                {
                    _pairResults[kv.Key] = kv.Value;
                }
            }
        }
        catch { }
        _checking = false;
    }

    private class MatchingItem
    {
        public string Id { get; set; } = "";
        public string Text { get; set; } = "";
    }
    private class Pair
    {
        public string LeftId { get; set; } = "";
        public string RightId { get; set; } = "";
    }
    private class ValidationResult
    {
        public bool IsCorrect { get; set; }
        public int Score { get; set; }
        public string Feedback { get; set; } = "";
        public string Explanation { get; set; } = "";
    }
}
