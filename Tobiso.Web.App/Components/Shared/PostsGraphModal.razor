@using Tobiso.Web.Shared.DTOs
@using Tobiso.Web.Shared.Interfaces
@using Microsoft.JSInterop
@using System.Text.Json
@rendermode InteractiveServer
@inject ITobisoAnonymApi Api
@inject Tobiso.Web.App.Services.IPreferenceService PreferenceService
@inject IJSRuntime Js
@implements IAsyncDisposable

<HeadContent>
    <script src="https://d3js.org/d3.v7.min.js"></script>
</HeadContent>

@if (_isVisible)
{
    <div class="posts-graph-modal-overlay" tabindex="-1" @onclick="Close">
        <div class="posts-graph-modal-content" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-label="Síť článků">
            <div class="posts-graph-header">
                <h3 class="posts-graph-title">
                    <i class="bi bi-diagram-3"></i> Síť článků
                </h3>
                <div class="posts-graph-controls">
                    <div class="posts-graph-switch-container">
                        <span class="posts-graph-switch-label @(!_showCategoryLinks ? "active" : "")">podle vazeb</span>
                        <label class="switch">
                            <input type="checkbox" @bind="_showCategoryLinks" @bind:after="OnToggleCategoryLinks" />
                            <span class="slider"></span>
                        </label>
                        <span class="posts-graph-switch-label @(_showCategoryLinks ? "active" : "")">podle kategorií</span>
                    </div>
                    <button type="button" class="posts-graph-close" @onclick="Close" aria-label="Zavřít">×</button>
                </div>
            </div>
            <div class="posts-graph-body">
                @if (_isLoading)
                {
                    <div class="posts-graph-loading">
                        <div class="loading-circle"></div>
                    </div>
                }
                else if (_error != null)
                {
                    <div class="alert alert-danger">
                        <strong>Chyba:</strong> @_error
                    </div>
                }
                else
                {
                    <div id="posts-graph-container" style="width: 100%; height: 100%;"></div>
                }
            </div>
        </div>
    </div>
    <div class="posts-graph-backdrop" tabindex="0" role="button" aria-label="Zavřít síť článků" @onclick="Close" @onkeydown="HandlePostsGraphBackdropKey"></div>
}

<style>
    .posts-graph-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 9999;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .posts-graph-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.8);
        z-index: 9998;
    }

    .posts-graph-modal-content {
        background-color: var(--modal-bg, #2a2a2a);
        border-radius: 8px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
        display: flex;
        flex-direction: column;
        max-height: 90vh;
        height: 90vh;
        width: 95vw;
        max-width: 95vw;
        overflow: hidden;
        z-index: 10000;
    }

    body.dark-mode .posts-graph-modal-content {
        background-color: #1a1a1a;
    }

    .posts-graph-header {
        padding: 1rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        background-color: rgba(0, 0, 0, 0.2);
    }

    .posts-graph-title {
        font-size: 1.5rem;
        font-weight: 600;
        margin: 0;
        color: var(--color-text, #fff);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    body.dark-mode .posts-graph-title {
        color: var(--color-text-dark, #fff);
    }

    .posts-graph-controls {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .posts-graph-switch-container {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .posts-graph-switch-label {
        color: rgba(255, 255, 255, 0.5);
        font-size: 0.875rem;
        font-weight: 500;
        transition: all 0.3s ease;
        white-space: nowrap;
    }

    .posts-graph-switch-label.active {
        color: var(--color-text, #fff);
        font-weight: 600;
    }

    body.dark-mode .posts-graph-switch-label.active {
        color: var(--color-text-dark, #fff);
    }

    .switch {
        position: relative;
        display: inline-block;
        width: 34px;
        height: 20px;
    }

    .switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: var(--color-toggle-bg);
        transition: 0.4s;
        border-radius: 34px;
    }

    .slider:before {
        position: absolute;
        content: "";
        height: 12px;
        width: 12px;
        left: 4px;
        bottom: 4px;
        background-color: white;
        transition: 0.4s;
        border-radius: 50%;
    }

    input:checked + .slider {
        background-color: var(--color-accent-dark);
    }

    input:checked + .slider:before {
        transform: translateX(14px);
    }

    .posts-graph-close {
        background: #dc3545;
        border: none;
        font-size: 28px;
        cursor: pointer;
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 4px;
        color: white;
        transition: all 0.2s ease;
        padding: 0;
        line-height: 1;
    }

    .posts-graph-close:hover {
        background-color: #c82333;
    }

    .posts-graph-body {
        flex: 1;
        overflow: hidden;
        position: relative;
    }

    .posts-graph-loading {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100%;
    }

</style>

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public EventCallback<bool> IsVisibleChanged { get; set; }

    private bool _isVisible;
    private bool _isLoading;
    private bool _dataLoaded;
    private string? _error;
    private bool _showCategoryLinks = false;
    private IJSObjectReference? _jsModule;

    private List<PostSummaryResponse>? _posts;
    private List<CategoryResponse>? _categories;
    private List<RelatedPostResponse>? _relatedPosts;

    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible != _isVisible)
        {
            _isVisible = IsVisible;

            if (_isVisible && !_dataLoaded)
            {
                await LoadGraphData();
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _isVisible)
        {
            // Add Escape key listener
            await Js.InvokeVoidAsync("eval", @"
                const escHandler = (e) => {
                    if (e.key === 'Escape' && document.querySelector('.posts-graph-modal-overlay')) {
                        const btn = document.querySelector('.posts-graph-close');
                        if (btn) btn.click();
                    }
                };
                document.addEventListener('keydown', escHandler);
                window.__postsGraphEscHandler = escHandler;
            ");
        }
        
        if (_isVisible && _dataLoaded && !_isLoading && _error == null)
        {
            await InitializeGraph();
        }
    }

    private async Task LoadGraphData()
    {
        _isLoading = true;
        _error = null;

        try
        {
            // Load all data in parallel
            var preferredGrade = await PreferenceService.GetPreferredGradeIdAsync();
            var postsTask = Api.GetPostSummaries();
            var categoriesTask = Api.GetAllCategories();
            var relatedPostsTask = Api.GetAllRelatedPosts();

            await Task.WhenAll(postsTask, categoriesTask, relatedPostsTask);

            _posts = postsTask.Result.ToList();
            _categories = categoriesTask.Result;
            _relatedPosts = relatedPostsTask.Result;

            _dataLoaded = true;
        }
        catch (Exception ex)
        {
            _error = $"Chyba při načítání dat: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task InitializeGraph()
    {
        if (_posts == null || _categories == null || _relatedPosts == null)
            return;

        try
        {
            // Import D3 module
            _jsModule ??= await Js.InvokeAsync<IJSObjectReference>("import", "/js/posts-graph.js");

            // Build graph data
            var graphData = BuildGraphData();

            // Serialize to JSON
            var jsonData = JsonSerializer.Serialize(graphData);

            // Initialize graph
            await _jsModule.InvokeVoidAsync("initGraph", "posts-graph-container", graphData);
        }
        catch (Exception ex)
        {
            _error = $"Chyba při inicializaci grafu: {ex.Message}";
            StateHasChanged();
        }
    }

    private object BuildGraphData()
    {
        if (_posts == null || _categories == null || _relatedPosts == null)
            return new { nodes = new object[0], links = new object[0] };

        // Create category lookup
        var categoryLookup = _categories.ToDictionary(c => c.Id, c => c.Name);

        // Build nodes - exclude posts without category and posts in "More" category
        var nodes = _posts
            .Where(p => p.CategoryId.HasValue && 
                        categoryLookup.ContainsKey(p.CategoryId.Value) &&
                        !string.Equals(categoryLookup[p.CategoryId.Value], "More", StringComparison.OrdinalIgnoreCase))
            .Select(p => new
            {
                id = p.Id,
                title = p.Title,
                categoryId = p.CategoryId,
                categoryName = categoryLookup[p.CategoryId!.Value]
            }).ToList();

        // Create set of valid post IDs for link filtering
        var validPostIds = new HashSet<int>(nodes.Select(n => n.id));

        // Build links from RelatedPosts (DB)
        var links = new List<object>();
        var processedPairs = new HashSet<string>();

        foreach (var rp in _relatedPosts)
        {
            // Only include links where both posts are valid (have category and not "More")
            if (!validPostIds.Contains(rp.PostId) || !validPostIds.Contains(rp.RelatedPostId))
                continue;
                
            // Create unique key for this pair (to avoid duplicates A->B and B->A)
            var key1 = $"{Math.Min(rp.PostId, rp.RelatedPostId)}-{Math.Max(rp.PostId, rp.RelatedPostId)}";
            
            if (!processedPairs.Contains(key1))
            {
                links.Add(new
                {
                    source = rp.PostId,
                    target = rp.RelatedPostId,
                    type = "related"
                });
                processedPairs.Add(key1);
            }
        }

        // Add category links (posts in same category)
        // Group posts by category - only include valid posts
        var postsByCategory = _posts
            .Where(p => p.CategoryId.HasValue && 
                        categoryLookup.ContainsKey(p.CategoryId.Value) &&
                        !string.Equals(categoryLookup[p.CategoryId.Value], "More", StringComparison.OrdinalIgnoreCase))
            .GroupBy(p => p.CategoryId!.Value)
            .Where(g => g.Count() > 1 && g.Count() <= 30) // Only categories with 2-30 posts
            .ToList();

        foreach (var categoryGroup in postsByCategory)
        {
            var categoryPosts = categoryGroup.ToList(); // All posts in category (full network)
            
            // Create links between posts in same category (full mesh)
            for (int i = 0; i < categoryPosts.Count; i++)
            {
                for (int j = i + 1; j < categoryPosts.Count; j++)
                {
                    var post1 = categoryPosts[i];
                    var post2 = categoryPosts[j];
                    
                    var key = $"{Math.Min(post1.Id, post2.Id)}-{Math.Max(post1.Id, post2.Id)}";
                    
                    // Don't add if already connected via RelatedPost
                    if (!processedPairs.Contains(key))
                    {
                        links.Add(new
                        {
                            source = post1.Id,
                            target = post2.Id,
                            type = "category"
                        });
                    }
                }
            }
        }

        return new { nodes, links };
    }

    private async Task OnToggleCategoryLinks()
    {
        if (_jsModule != null)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("setShowCategoryLinks", _showCategoryLinks);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error toggling category links: {ex.Message}");
            }
        }
    }

    private async Task Close()
    {
        // Clean up tooltip and popup before closing
        if (_jsModule != null)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("destroyGraph", "posts-graph-container");
            }
            catch
            {
                // Ignore errors during close
            }
        }
        
        _isVisible = false;
        await IsVisibleChanged.InvokeAsync(_isVisible);
    }

    private void HandlePostsGraphBackdropKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" || e.Key == "Enter" || e.Key == " " || e.Key == "Spacebar")
            _ = Close();
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsModule != null)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("destroyGraph", "posts-graph-container");
                await _jsModule.DisposeAsync();
            }
            catch
            {
                // Ignore disposal errors
            }
        }
        
        // Remove Escape key handler
        try
        {
            await Js.InvokeVoidAsync("eval", @"
                if (window.__postsGraphEscHandler) {
                    document.removeEventListener('keydown', window.__postsGraphEscHandler);
                    delete window.__postsGraphEscHandler;
                }
            ");
        }
        catch
        {
            // Ignore disposal errors
        }
    }
}
