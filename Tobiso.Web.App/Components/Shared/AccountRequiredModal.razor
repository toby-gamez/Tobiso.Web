@implements IDisposable
@using Tobiso.Web.App.Services
@inject AccountRequiredModalService Service
@inject NavigationManager Nav
@inject IJSRuntime JS

@if (_open)
{
    <div class="account-backdrop" @onclick="Close">
        <div class="account-dialog" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <button class="account-close" @onclick="Close" aria-label="Zavřít">
                <i data-lucide="x"></i>
            </button>
            <h3 class="account-title">Je potřeba účet</h3>
            <p class="account-message">@_message</p>
            <div class="account-actions">
                <button class="pill pill-on" @onclick="GoToLogin">Přihlásit se</button>
                <button class="pill" @onclick="Close">Zavřít</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _open;
    private string _message = "";

    protected override void OnInitialized() => Service.OnShowRequested += HandleShow;

    private void HandleShow(string message)
    {
        _message = message;
        _open = true;
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_open)
        {
            await JS.InvokeVoidAsync("initLucide");
        }
    }

    private void Close() => _open = false;

    private void GoToLogin()
    {
        _open = false;
        Nav.NavigateTo("/prihlaseni");
    }

    public void Dispose() => Service.OnShowRequested -= HandleShow;
}
