@inherits OwningComponentBase
@implements IAsyncDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS

@if (_open)
{
    <div class="search-backdrop" @onclick="Close">
        <div class="search-dialog" @onclick:stopPropagation="true">
            <div class="search-input-row">
                <i data-lucide="search"></i>
                <input class="search-input" placeholder="Hledej článek či oblast…" @bind="Query" @bind:event="oninput"
                       @onkeydown="OnKeyDown" @ref="_inputRef" />
                <kbd class="search-esc-hint">Esc</kbd>
                <button type="button" class="search-close-btn" aria-label="Zavřít" @onclick="Close">
                    <i data-lucide="x"></i>
                </button>
            </div>

            @{ var results = Results; }
            @if (_query.Trim().Length == 0)
            {
                <p class="search-hint">Piš a hledej napříč všemi články, oblastmi i textem uvnitř nich.</p>
            }
            else if (results.Count == 0 && !_contentSearching)
            {
                <p class="search-hint">Nic nenalezeno.</p>
            }
            else
            {
                var selected = SelectedIndexFor(results);
                <div class="search-results">
                    @for (var i = 0; i < results.Count; i++)
                    {
                        var item = results[i];
                        var isSelected = i == selected;
                        <button class="@(isSelected ? "search-result active lift" : "search-result lift")"
                                @onclick="@(() => Go(item))">
                            <span class="search-result-row">
                                <span class="search-result-main">
                                    <i data-lucide="@(item.IsCategory ? "folder-tree" : "file-text")"></i>
                                    <span class="search-result-title">@item.Title</span>
                                </span>
                                @if (item.Grades.Count > 0)
                                {
                                    <span class="search-result-grades">
                                        @foreach (var g in item.Grades)
                                        {
                                            <span class="grade-chip">@g</span>
                                        }
                                    </span>
                                }
                            </span>
                            @if (item.MatchWord is not null)
                            {
                                <span class="search-result-snippet">
                                    @if (item.WordBefore is not null)
                                    {
                                        <text>@item.WordBefore </text>
                                    }
                                    <mark>@item.MatchWord</mark>
                                    @if (item.WordAfter is not null)
                                    {
                                        <text> @item.WordAfter</text>
                                    }
                                </span>
                            }
                        </button>
                    }
                    @if (_contentSearching)
                    {
                        <p class="search-hint search-hint-loading">Hledám v textu…</p>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    private readonly record struct SearchItem(
        int Id, string Title, bool IsCategory, List<string> Grades,
        string? WordBefore = null, string? MatchWord = null, string? WordAfter = null);

    private bool _open;
    private string _query = "";
    private int _selectedIndex;
    private List<PostSummaryResponse> _posts = [];
    private List<CategoryResponse> _categories = [];
    private Dictionary<int, string> _categoryNames = [];
    private ElementReference _inputRef;
    private DotNetObjectReference<SearchModal>? _selfRef;
    private bool _pendingFocus;
    private IPostService? _postService;
    private List<PostSearchResultDto> _contentResults = [];
    private bool _contentSearching;
    private CancellationTokenSource? _searchCts;

    private const int MinContentSearchLength = 3;

    private string Query
    {
        get => _query;
        set
        {
            _query = value;
            _selectedIndex = 0;
            _ = DebouncedContentSearch(value);
        }
    }

    private List<SearchItem> Results
    {
        get
        {
            var q = _query.Trim();
            if (q.Length == 0) return [];

            var categoryMatches = _categories
                .Where(c => TextSearch.ContainsIgnoreDiacritics(c.Name, q))
                .Take(3)
                .Select(c => new SearchItem(c.Id, c.Name, true, []))
                .ToList();

            var postMatches = _posts
                .Where(p => TextSearch.ContainsIgnoreDiacritics(p.Title, q)
                            || (p.CategoryId.HasValue
                                && _categoryNames.TryGetValue(p.CategoryId.Value, out var categoryName)
                                && TextSearch.ContainsIgnoreDiacritics(categoryName, q)))
                .Take(8)
                .Select(p => new SearchItem(p.Id, p.Title, false, p.AvailableGradeNames))
                .ToList();

            var matchedPostIds = postMatches.Select(p => p.Id).ToHashSet();
            var contentMatches = _contentResults
                .Where(r => matchedPostIds.Add(r.PostId))
                .Select(r => new SearchItem(r.PostId, r.Title, false, [], r.WordBefore, r.MatchWord, r.WordAfter));

            return [.. categoryMatches, .. postMatches, .. contentMatches];
        }
    }

    private async Task DebouncedContentSearch(string query)
    {
        _searchCts?.Cancel();
        var cts = new CancellationTokenSource();
        _searchCts = cts;

        var trimmed = query.Trim();
        if (trimmed.Length < MinContentSearchLength)
        {
            _contentResults = [];
            _contentSearching = false;
            return;
        }

        try
        {
            await Task.Delay(300, cts.Token);
            if (cts.Token.IsCancellationRequested || _postService is null) return;

            _contentSearching = true;
            StateHasChanged();

            var results = await _postService.SearchContentAsync(trimmed);
            if (cts.Token.IsCancellationRequested) return;

            _contentResults = results;
            _contentSearching = false;
            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
        }
        catch (Exception) when (_disposed)
        {
        }
    }

    private int SelectedIndexFor(List<SearchItem> results) =>
        results.Count == 0 ? 0 : Math.Clamp(_selectedIndex, 0, results.Count - 1);

    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _postService = ScopedServices.GetRequiredService<IPostService>();
            _posts = await _postService.GetSummaries();
            _categories = await ScopedServices.GetRequiredService<ICategoryService>().GetAll();
            _categoryNames = _categories.ToDictionary(c => c.Id, c => c.Name);
        }
        catch (Exception) when (_disposed)
        {
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("registerSearchShortcut", _selfRef);
        }

        if (_open)
        {
            await JS.InvokeVoidAsync("initLucide");
            if (_pendingFocus)
            {
                _pendingFocus = false;
                try { await _inputRef.FocusAsync(); } catch { }
            }
        }
    }

    [JSInvokable]
    public Task ToggleFromJs()
    {
        if (_open) Close(); else OpenInternal();
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task CloseFromJs()
    {
        if (_open)
        {
            Close();
            StateHasChanged();
        }
        return Task.CompletedTask;
    }

    public void Open()
    {
        OpenInternal();
        StateHasChanged();
    }

    private void OpenInternal()
    {
        _open = true;
        _query = "";
        _contentResults = [];
        _contentSearching = false;
        _pendingFocus = true;
    }

    private void Close()
    {
        _open = false;
        _searchCts?.Cancel();
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        var results = Results;
        switch (e.Key)
        {
            case "Escape":
                Close();
                break;
            case "ArrowDown" when results.Count > 0:
                _selectedIndex = (SelectedIndexFor(results) + 1) % results.Count;
                break;
            case "ArrowUp" when results.Count > 0:
                _selectedIndex = (SelectedIndexFor(results) - 1 + results.Count) % results.Count;
                break;
            case "Enter" when results.Count > 0:
                Go(results[SelectedIndexFor(results)]);
                break;
        }
    }

    private void Go(SearchItem item)
    {
        _open = false;
        Nav.NavigateTo(item.IsCategory ? $"/categories/{item.Id}" : $"/post/{item.Id}");
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _searchCts?.Cancel();
        try { await JS.InvokeVoidAsync("unregisterSearchShortcut"); } catch { }
        _selfRef?.Dispose();
    }
}
