@using Tobiso.Web.App.Services
@using System.Threading
@using Markdig
@using Tobiso.Web.Domain.Entities
@implements IDisposable
@inject IAiService AiService
@inject IPostService PostService
@inject IAiChatHistoryService ChatHistory
@inject IAiUsageGuard UsageGuard
@inject IUserService UserService
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS

<div class="chat-box">
    @if (_messages.Count == 0)
    {
        <div class="chat-empty">
            <i data-lucide="sparkles" style="font-size:28px; color:var(--color-accent-600)"></i>
            <p class="chat-empty-title">@EmptyTitle</p>
            <div class="chat-suggestions">
                @foreach (var s in Suggestions)
                {
                    <button class="pill" @onclick="@(() => UseSuggestion(s))">@s</button>
                }
            </div>
        </div>
    }
    else
    {
        <div class="chat-thread">
            @foreach (var m in _messages)
            {
                <div class="chat-msg @(m.Role == "user" ? "chat-msg-user" : "chat-msg-ai")">
                    <div class="chat-bubble">
                        @if (m.Role == "user")
                        {
                            @m.Content
                        }
                        else
                        {
                            <div class="chat-markdown">@RenderMarkdown(m.Content)</div>
                        }
                    </div>
                </div>
            }
            @if (_streaming)
            {
                <div class="chat-msg chat-msg-ai">
                    <div class="chat-bubble">
                        @if (_pending.Length == 0)
                        {
                            <span class="chat-dots"><span></span><span></span><span></span></span>
                        }
                        else
                        {
                            <div class="chat-markdown">@RenderMarkdown(_pending.ToString())</div>
                        }
                    </div>
                </div>
            }
        </div>
    }

    @if (_error != null)
    {
        <div class="chat-error">
            @_error
            @if (_showRegisterCta)
            {
                <a class="pill pill-on" href="/registrace">Zaregistruj se zdarma</a>
            }
        </div>
    }

    @if (AllowAttachPosts && _attachedPosts.Count > 0 || !string.IsNullOrEmpty(PinnedPostTitle))
    {
        <div class="chat-attachments">
            @if (!string.IsNullOrEmpty(PinnedPostTitle))
            {
                <span class="chat-attachment-chip chat-attachment-pinned">
                    <i data-lucide="pin"></i>
                    <span class="chat-attachment-title">@PinnedPostTitle</span>
                </span>
            }
            @foreach (var p in _attachedPosts)
            {
                <span class="chat-attachment-chip">
                    <i data-lucide="file-text"></i>
                    <span class="chat-attachment-title">@p.Title</span>
                    <button type="button" class="chat-attachment-remove" @onclick="@(() => RemoveAttachment(p.Id))" aria-label="Odebrat článek">
                        <i data-lucide="x"></i>
                    </button>
                </span>
            }
        </div>
    }

    @if (AllowAttachPosts && _showAttachPicker)
    {
        <div class="chat-attach-picker">
            <input class="input" placeholder="Hledat článek…" @bind="_attachSearch" @bind:event="oninput" />
            <div class="chat-attach-results">
                @if (_attachPickerLoading)
                {
                    <div class="chat-attach-empty">Načítám…</div>
                }
                else if (FilteredAttachablePosts.Count == 0)
                {
                    <div class="chat-attach-empty">Nic nenalezeno</div>
                }
                else
                {
                    @foreach (var p in FilteredAttachablePosts.Take(8))
                    {
                        <button type="button" class="chat-attach-result" @onclick="@(() => AttachPost(p))">@p.Title</button>
                    }
                }
            </div>
        </div>
    }

    <div class="chat-input-row">
        @if (AllowAttachPosts)
        {
            <button class="chat-attach-btn @(_showAttachPicker ? "active" : "")" type="button"
                    @onclick="ToggleAttachPicker" disabled="@_streaming" aria-label="Připojit článek k otázce" title="Připojit článek k otázce">
                <i data-lucide="paperclip"></i>
            </button>
        }
        <input class="input" placeholder="@Placeholder" @bind="_draft" @bind:event="oninput"
               @onkeydown="OnKeyDown" disabled="@_streaming" />
        <button class="pill pill-on chat-send" @onclick="Send" disabled="@(_streaming || string.IsNullOrWhiteSpace(_draft))">
            <i data-lucide="send"></i>
        </button>
    </div>
</div>

@code {
    [Parameter] public int PostId { get; set; }
    /// <summary>Optional: load one specific past conversation instead of the most recent one for PostId. Used by the standalone /chat page's "new chat" / history navigation.</summary>
    [Parameter] public int? SessionId { get; set; }
    [Parameter] public bool SocraticMode { get; set; }
    [Parameter] public string? PinnedPostTitle { get; set; }
    /// <summary>When false (e.g. a chat embedded in an article page), hides the picker that attaches additional
    /// posts — the article itself is the only pinned context.</summary>
    [Parameter] public bool AllowAttachPosts { get; set; } = true;
    [Parameter] public string EmptyTitle { get; set; } = "Zeptej se na cokoliv z učiva.";
    [Parameter] public string Placeholder { get; set; } = "Napiš otázku…";
    [Parameter] public string[] Suggestions { get; set; } = ["Vysvětli mi to jednodušeji", "Dej mi příklad", "Na co se mě můžou zeptat?"];
    [Parameter] public EventCallback<string> OnAnswered { get; set; }

    private readonly List<AiMessage> _messages = [];
    private readonly System.Text.StringBuilder _pending = new();
    private readonly CancellationTokenSource _cts = new();
    private string _draft = "";
    private bool _streaming;
    private string? _error;
    private bool _showRegisterCta;

    private static readonly MarkdownPipeline _markdownPipeline =
        new MarkdownPipelineBuilder().UseAdvancedExtensions().DisableHtml().Build();

    private static MarkupString RenderMarkdown(string? content) =>
        (MarkupString)Markdown.ToHtml(content ?? string.Empty, _markdownPipeline);

    private readonly List<PostSummaryResponse> _attachedPosts = [];
    private List<PostSummaryResponse> _availablePosts = [];
    private bool _availablePostsLoaded;
    private bool _attachPickerLoading;
    private bool _showAttachPicker;
    private string _attachSearch = "";

    private List<PostSummaryResponse> FilteredAttachablePosts
    {
        get
        {
            var excluded = new HashSet<int>(_attachedPosts.Select(p => p.Id)) { PostId };
            IEnumerable<PostSummaryResponse> query = _availablePosts.Where(p => !excluded.Contains(p.Id));
            if (!string.IsNullOrWhiteSpace(_attachSearch))
                query = query.Where(p => p.Title.Contains(_attachSearch, StringComparison.OrdinalIgnoreCase));
            return query.ToList();
        }
    }

    private async Task ToggleAttachPicker()
    {
        if (!AllowAttachPosts) return;
        _showAttachPicker = !_showAttachPicker;
        if (_showAttachPicker && !_availablePostsLoaded)
        {
            _attachPickerLoading = true;
            try { _availablePosts = await PostService.GetSummaries(); }
            finally { _attachPickerLoading = false; _availablePostsLoaded = true; }
        }
    }

    private void AttachPost(PostSummaryResponse post)
    {
        if (_attachedPosts.Any(p => p.Id == post.Id)) return;
        _attachedPosts.Add(post);
        _attachSearch = "";
        _showAttachPicker = false;
    }

    private void RemoveAttachment(int postId) => _attachedPosts.RemoveAll(p => p.Id == postId);

    private bool _historyEverLoaded;
    private int _loadedForPostId;
    private int? _loadedForSessionId;
    private int? _userId;
    private int? _currentSessionId;
    private int? _activePostId;
    private bool _newChatResetPending;

    private int? ContextPostId => PostId > 0 ? PostId : null;

    /// <summary>The post whose content the current conversation is scoped to: either the box's own
    /// PostId, or the post pinned to a conversation loaded by SessionId on the standalone /chat page.</summary>
    private int? EffectivePostId => _activePostId ?? ContextPostId;

    protected override async Task OnParametersSetAsync()
    {
        // Blazor Server can reuse this component instance across route-parameter changes (e.g.
        // navigating from one post to another, or picking a different past conversation from the
        // history sidebar), so history has to reload whenever PostId/SessionId actually change
        // rather than only once at construction.
        if (_historyEverLoaded && PostId == _loadedForPostId && SessionId == _loadedForSessionId) return;

        if (_newChatResetPending)
        {
            // A "new chat" reset is in flight: the host page navigates right after resetting to
            // strip the ?session= query string. Until that parameter settles to null, don't reload
            // anything - otherwise the just-cleared conversation gets silently restored from the DB
            // (the re-entered OnParametersSetAsync would otherwise auto-load the most recent session).
            if (SessionId != null) return;
            _newChatResetPending = false;
            _loadedForPostId = PostId;
            _loadedForSessionId = null;
            return;
        }

        _historyEverLoaded = true;
        _loadedForPostId = PostId;
        _loadedForSessionId = SessionId;

        _messages.Clear();
        _userId = null;
        _currentSessionId = null;
        _activePostId = null;
        _attachedPosts.Clear();

        var auth = await AuthState.GetAuthenticationStateAsync();
        if (auth.User.Identity?.IsAuthenticated != true ||
            !int.TryParse(auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var uid))
            return;

        _userId = uid;

        AiChatSession? session;
        if (SessionId is { } sid)
        {
            session = await ChatHistory.GetSessionByIdAsync(sid, uid);
            // Ignore a session id that doesn't belong to this box's context (e.g. a stale/tampered
            // query string) rather than leaking a different conversation into view. A post-pinned
            // session is fair game on the standalone /chat page (PostId == 0, no context constraint).
            if (session != null && ContextPostId != null && session.PostId != ContextPostId) session = null;
        }
        else
        {
            session = await ChatHistory.FindSessionAsync(uid, ContextPostId);
        }

        if (session == null) return;

        _currentSessionId = session.Id;
        // When the conversation is pinned to a post (started from an article, or attached there),
        // keep that post as the AI context for follow-ups even on the standalone /chat page so the
        // model stays anchored to the article instead of answering from general knowledge.
        _activePostId = session.PostId;
        var history = await ChatHistory.GetSessionMessagesAsync(session.Id, uid);
        _messages.AddRange(history.Select(m => new AiMessage { Role = m.Role, Content = m.Content }));

        // Restore the extra posts the student attached earlier so follow-up questions keep sending
        // their content to the AI even after a reload or history navigation wiped the in-memory chips.
        var attachedPostIds = await ChatHistory.GetAttachedPostIdsAsync(session.Id, uid);
        if (attachedPostIds.Count > 0)
        {
            if (!_availablePostsLoaded)
            {
                _availablePosts = await PostService.GetSummaries();
                _availablePostsLoaded = true;
            }
            _attachedPosts.AddRange(_availablePosts.Where(p => attachedPostIds.Contains(p.Id)));
        }
    }

    /// <summary>Clears the visible conversation; the next question lazily starts a brand-new session. Used by the host page's "new chat" action.</summary>
    public void ResetConversation()
    {
        _messages.Clear();
        _currentSessionId = null;
        _activePostId = null;
        _attachedPosts.Clear();
        _error = null;
        _draft = "";

        // When a conversation is open the host also navigates to strip the ?session= query string,
        // which re-enters OnParametersSetAsync. Flag the reset so that re-entry swallows any
        // auto-load until the parameter has settled to null, instead of restoring the thread we
        // just cleared. When nothing was loaded (_loadedForSessionId is null) there is no
        // navigation-driven re-entry and the guard keeps the cleared state as-is.
        if (_loadedForSessionId != null)
            _newChatResetPending = true;

        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("initLucide");
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey) await Send();
    }

    private void UseSuggestion(string s)
    {
        _draft = s;
    }

    private async Task Send()
    {
        var question = _draft.Trim();
        if (question.Length == 0 || _streaming) return;

        _draft = "";
        _error = null;
        _showRegisterCta = false;

        // Pre-flight credit check before spending on a stream we can't retroactively un-send
        // once chunks start rendering live to the user.
        if (_userId is { } preflightUid)
        {
            var user = await UserService.GetByIdAsync(preflightUid);
            if ((user?.Credits ?? 0) < 1)
            {
                _error = "Nemáš dostatek kreditů.";
                StateHasChanged();
                return;
            }
        }

        var deviceId = await JS.InvokeAsync<string>("getDeviceId");
        var auth = await AuthState.GetAuthenticationStateAsync();
        var decision = await UsageGuard.TryConsumeAsync(auth.User, $"device:{deviceId}");
        if (!decision.Allowed)
        {
            _error = decision.DeniedMessage;
            _showRegisterCta = decision.AnonymousLimitReached;
            StateHasChanged();
            return;
        }

        _messages.Add(new AiMessage { Role = "user", Content = question });
        _pending.Clear();
        _streaming = true;
        StateHasChanged();

        var request = new AiChatRequest
        {
            PostId = EffectivePostId ?? 0,
            Question = question,
            SocraticMode = SocraticMode,
            ConversationHistory = [.. _messages.Take(_messages.Count - 1)],
            AttachedPostIds = _attachedPosts.Select(p => p.Id).ToList()
        };

        try
        {
            await foreach (var chunk in AiService.AskStreamAsync(request, _cts.Token))
            {
                _pending.Append(chunk);
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            // Component was disposed (e.g. user navigated away) while streaming; stop touching state.
            return;
        }
        catch (Exception ex)
        {
            _error = $"Odpověď se nepodařilo načíst: {ex.Message}";
        }

        var answer = _pending.ToString();
        _streaming = false;
        _pending.Clear();

        if (answer.Length > 0)
        {
            // Deducted after streaming (mirrors AiController.Ask/AskStream) rather than before,
            // since the answer's cost isn't known until the AI has actually responded. The
            // pre-flight check above makes a post-hoc failure here a rare race rather than the
            // common case, so the already-displayed answer is kept either way.
            var creditsUsed = 0;
            if (_userId is { } uid)
            {
                var deducted = await UserService.DeductCreditsAsync(uid, 1, "ai_ask");
                if (deducted) creditsUsed = 1;
            }

            _messages.Add(new AiMessage { Role = "assistant", Content = answer });
            // Save before notifying the host - Chat.razor's OnAnswered refreshes the history
            // sidebar from the DB, so it needs the new/updated session to already be written.
            await SaveHistoryAsync(question, answer, creditsUsed > 0 ? creditsUsed : null);
            if (OnAnswered.HasDelegate) await OnAnswered.InvokeAsync(answer);
        }
        else if (_error == null)
        {
            _error = "AI neodpověděla. Zkus to prosím znovu.";
        }

        StateHasChanged();
    }

    private async Task SaveHistoryAsync(string question, string answer, int? creditsUsed = null)
    {
        if (_userId is not { } uid) return;

        try
        {
            // Reuse the session this box is already showing; only create a new one the first time
            // (nothing loaded on init) or right after ResetConversation() cleared it for a "new chat".
            if (_currentSessionId is not { } sid)
            {
                var session = await ChatHistory.CreateSessionAsync(uid, ContextPostId);
                sid = session.Id;
                _currentSessionId = sid;
            }

            await ChatHistory.SaveMessageAsync(sid, "user", question);
            await ChatHistory.SaveMessageAsync(sid, "assistant", answer, creditsUsed);
            await ChatHistory.SaveAttachedPostsAsync(sid, _attachedPosts.Select(p => p.Id));
        }
        catch (Exception ex)
        {
            // History is a nice-to-have; don't surface a save failure as a chat error to the user.
            Serilog.Log.Warning(ex, "Failed to save AI chat history for user {UserId}", uid);
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
