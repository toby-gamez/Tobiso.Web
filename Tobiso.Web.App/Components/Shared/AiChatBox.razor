@using Tobiso.Web.Shared.DTOs
@inject System.Net.Http.HttpClient Http
@inject IJSRuntime Js
@inject NavigationManager Navigation

<div class="ai-chatbox">
    <div class="chat-messages" id="ai-chat-window">
        @foreach (var msg in _history)
        {
            var isUser = msg.Role?.ToLowerInvariant() == "user";
            if (isUser)
            {
                <div class="msg-user">
                    <span class="bubble-user">@msg.Content</span>
                </div>
            }
            else
            {
                <div class="msg-assistant">
                    <div class="assistant-text">@msg.Content</div>
                    <span class="ai-icon"><i class="bi bi-stars"></i></span>
                </div>
            }
        }
        @if (_loading)
        {
            <div class="msg-assistant">
                <div class="assistant-text typing-dots"><span></span><span></span><span></span></div>
            </div>
        }
        @if (_isTyping)
        {
            <div class="msg-assistant">
                <div class="assistant-text">@_typingText<span class="typing-cursor"></span></div>
                <span class="ai-icon"><i class="bi bi-stars"></i></span>
            </div>
        }
    </div>

    @if (_remaining <= 50)
    {
        <div class="remaining-info">Zbývá dotazů dnes: @_remaining</div>
    }

    <div class="chat-input-bar">
        <span class="input-ai-icon"><i class="bi bi-stars"></i></span>
        <textarea id="ai-input" value="@_question" maxlength="300" rows="1" placeholder="Napište dotaz…"
            @oninput="HandleInput" @onkeydown="HandleKeyDown"></textarea>
        <div class="input-bar-actions">
            <span class="char-count">@_remainingChars</span>
            <button class="send-btn" @onclick="Send" disabled="@(_loading || _remaining == 0 || string.IsNullOrWhiteSpace(_question))" title="Odeslat">
                <i class="bi bi-arrow-up"></i>
            </button>
        </div>
    </div>
</div>

<style>
.ai-chatbox {
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0;
    font-family: var(--font-family-sans);
}

/* Messages area — no border, no background box */
.chat-messages {
    padding: 8px 0 16px;
    display: flex;
    flex-direction: column;
    gap: 18px;
}

.chat-empty {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    text-align: left;
    padding: 8px 0;
}

/* User message — right-aligned pill bubble */
.msg-user {
    display: flex;
    justify-content: flex-end;
}

.bubble-user {
    background: var(--color-accent-strong);
    color: var(--color-white);
    padding: 10px 18px;
    border-radius: 22px;
    font-size: 0.95rem;
    line-height: 1.5;
    max-width: 72%;
    white-space: pre-wrap;
    word-break: break-word;
    box-shadow: 0 2px 8px rgba(195, 111, 154, 0.25);
}

/* Assistant message — left-aligned plain text */
.msg-assistant {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    max-width: 82%;
}

.assistant-text {
    font-size: 0.95rem;
    line-height: 1.6;
    white-space: pre-wrap;
    word-break: break-word;
}

.ai-icon {
    color: var(--color-accent);
    font-size: 1.3rem;
    line-height: 1;
}

/* Typing dots */
.typing-dots {
    display: flex;
    gap: 5px;
    align-items: center;
    height: 22px;
}
.typing-dots span {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
    animation: typing-bounce 1.2s infinite ease-in-out;
}
.typing-dots span:nth-child(2) { animation-delay: 0.2s; }
.typing-dots span:nth-child(3) { animation-delay: 0.4s; }
@@keyframes typing-bounce {
    0%, 80%, 100% { transform: translateY(0); opacity: 0.4; }
    40% { transform: translateY(-5px); opacity: 1; }
}

/* Blinking cursor during typewriter */
.typing-cursor {
    display: inline-block;
    width: 2px;
    height: 1em;
    background: var(--color-accent);
    margin-left: 2px;
    vertical-align: text-bottom;
    border-radius: 1px;
    animation: cursor-blink 0.7s steps(1) infinite;
}
@@keyframes cursor-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
}

/* Remaining quota notice */
.remaining-info {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-align: right;
    padding: 2px 0 6px;
}

/* Input bar */
.chat-input-bar {
    border: 1.5px solid var(--color-accent-2);
    border-radius: 20px;
    padding: 8px 10px 8px 14px;
    background: var(--color-bg);
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8px;
    transition: border-color 0.2s;
}

.chat-input-bar:focus-within {
    border-color: var(--color-accent);
}

.input-ai-icon {
    color: var(--color-accent);
    font-size: 1.15rem;
    flex-shrink: 0;
    line-height: 1;
}

.chat-input-bar textarea {
    flex: 1;
    min-width: 0;
    border: none;
    background: transparent;
    resize: none;
    outline: none;
    font-family: var(--font-family-sans);
    font-size: 0.95rem;
    color: var(--color-text);
    line-height: 1.5;
    min-height: 24px;
    max-height: 160px;
    overflow-y: hidden;
    padding: 0;
    margin: 0;
    box-shadow: none;
}

.chat-input-bar textarea::placeholder {
    color: var(--color-text-muted);
}

.input-bar-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
}

.char-count {
    font-size: 0.78rem;
    color: var(--color-text-muted);
}

.send-btn {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    font-size: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent-strong);
    color: var(--color-white);
    border: none;
    cursor: pointer;
    transition: background 0.2s, transform 0.15s;
    flex-shrink: 0;
    padding: 0;
}

.send-btn:hover:not([disabled]) {
    background: var(--color-accent-3);
    transform: scale(1.08);
}

.send-btn[disabled] {
    opacity: 0.35;
    cursor: default;
    transform: none;
}

/* Dark mode */
body.dark-mode .bubble-user {
    background: var(--color-accent-strong-dark);
    color: var(--color-text-dark);
    box-shadow: 0 2px 8px rgba(144, 60, 103, 0.35);
}
body.dark-mode .assistant-text {
    color: var(--color-text-muted-dark);
}
body.dark-mode .chat-input-bar {
    background: var(--color-bg-dark);
    border-color: var(--color-accent-2-dark);
}
body.dark-mode .chat-input-bar textarea {
    color: var(--color-text-dark);
}
body.dark-mode .send-btn {
    background: var(--color-accent-strong-dark);
    color: var(--color-text-dark);
}

@@media (max-width: 520px) {
    .bubble-user { max-width: 88%; }
    .msg-assistant { max-width: 96%; }
}
</style>

@code {
    [Parameter] public int PostId { get; set; }

    private List<AiMessage> _history = new();
    private string _question = string.Empty;
    private bool _loading = false;
    private bool _isTyping = false;
    private string _typingText = string.Empty;
    private int _remaining = 10;

    private int _remainingChars => Math.Max(0, 300 - (_question?.Length ?? 0));

    private async Task HandleInput(ChangeEventArgs e)
    {
        _question = e.Value?.ToString() ?? string.Empty;
        await Js.InvokeVoidAsync("eval",
            "var t=document.getElementById('ai-input');if(t){t.style.height='auto';t.style.height=t.scrollHeight+'px';}");
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await Send();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadRemainingAsync();
    }

    private async Task LoadRemainingAsync()
    {
        // Try lightweight probe by sending empty request to get remaining via server-side rate limit query endpoint (not implemented), fallback to 10
        _remaining = 10;
    }

    private async Task AnimateTypingAsync(string fullText)
    {
        _isTyping = true;
        _typingText = string.Empty;
        // Speed: cap at 8ms/char so long responses don't take forever
        var delay = Math.Max(8, Math.Min(20, 1200 / Math.Max(fullText.Length, 1)));
        foreach (var ch in fullText)
        {
            _typingText += ch;
            StateHasChanged();
            await Task.Delay(delay);
        }
        _isTyping = false;
        StateHasChanged();
    }

    private async Task Send()
    {
        if (string.IsNullOrWhiteSpace(_question)) return;
        _loading = true;
        var userMsg = new AiMessage { Role = "user", Content = _question };
        _history.Add(userMsg);

        var req = new AiChatRequest
        {
            PostId = PostId,
            Question = _question,
            ConversationHistory = _history.Select(h => h).ToList()
        };

        try
        {
            var absolute = new Uri(Navigation.BaseUri + "api/ai/ask");
            var res = await Http.PostAsJsonAsync(absolute, req);
            if (res.IsSuccessStatusCode)
            {
                var aiResp = await res.Content.ReadFromJsonAsync<AiChatResponse>();
                if (aiResp != null)
                {
                    _remaining = aiResp.RemainingQuestions;
                    _loading = false;
                    await AnimateTypingAsync(aiResp.Answer);
                    _history.Add(new AiMessage { Role = "assistant", Content = aiResp.Answer });
                }
                else
                {
                    _history.Add(new AiMessage { Role = "assistant", Content = "AI vrátila prázdnou odpověď." });
                }
            }
            else
            {
                var body = string.Empty;
                try
                {
                    body = await res.Content.ReadAsStringAsync();
                }
                catch { }

                if ((int)res.StatusCode == 429)
                {
                    _history.Add(new AiMessage { Role = "assistant", Content = "Dnešní limit dotazů byl vyčerpán." });
                    _remaining = 0;
                }
                else
                {
                    var snippet = string.IsNullOrEmpty(body) ? "(bez těla odpovědi)" : (body.Length > 300 ? body.Substring(0, 300) + "..." : body);
                    _history.Add(new AiMessage { Role = "assistant", Content = $"Chyba při dotazu na AI: {(int)res.StatusCode} {res.ReasonPhrase}. {snippet}" });
                }
            }
        }
        catch (Exception ex)
        {
            _history.Add(new AiMessage { Role = "assistant", Content = $"Chyba sítě: {ex.Message}" });
        }
        finally
        {
            _question = string.Empty;
            _loading = false;
            _isTyping = false;
            _typingText = string.Empty;
            StateHasChanged();
            await Js.InvokeVoidAsync("eval",
                "var t=document.getElementById('ai-input');if(t){t.style.height='auto';}");
        }
    }
}
