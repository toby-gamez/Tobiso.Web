@page "/zapomenute-heslo"
@layout AuthLayout
@inject IJSRuntime JS

<PageTitle>Zapomenuté heslo - Tobiso</PageTitle>

<div class="login-card">
    <div class="login-brand">
        <img src="/images/normal-logo.png" alt="Tobiso" class="brand-logo-img logo-light" />
        <img src="/images/white-logo.png" alt="Tobiso" class="brand-logo-img logo-dark" />
    </div>

    <div>
        <h1 class="login-title">Zapomenuté heslo</h1>
        <p class="login-sub">Pošleme ti odkaz, přes který si nastavíš nové heslo.</p>
    </div>

    @if (_sentMessage != null)
    {
        <p class="login-sub">@_sentMessage</p>
        <a class="pill pill-on" href="/prihlaseni">Na přihlášení</a>
    }
    else
    {
        <div class="field">
            <label for="forgot-mail">E-mail</label>
            <input id="forgot-mail" class="input" type="email" placeholder="tvuj@email.cz"
                   @bind="_email" @bind:event="oninput"
                   @onkeydown="@(async e => { if (e.Key == "Enter") await Submit(); })" />
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="login-error">@_error</div>
        }

        <button class="pill pill-on login-submit" @onclick="Submit" disabled="@_submitting">
            @if (_submitting) { <span>Odesílám…</span> } else { <span>Poslat odkaz</span> }
        </button>

        <p class="login-register">
            <a href="/prihlaseni">Zpět na přihlášení</a>
        </p>
    }
</div>

@code {
    private string _email = "";
    private string _error = "";
    private string? _sentMessage;
    private bool _submitting;

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_email) || !_email.Contains('@'))
        {
            _error = "Zadej platný e-mail.";
            return;
        }
        _submitting = true;
        _error = "";
        StateHasChanged();

        try
        {
            var result = await AuthApi.PostAsync(JS, "/api/auth/forgot-password", new { email = _email.Trim() });
            if (result.Ok)
                _sentMessage = result.Message ?? "Pokud k tomuto e-mailu existuje účet, poslali jsme na něj odkaz.";
            else
                _error = AuthApi.ErrorText(result, "Odeslání se nezdařilo. Zkus to prosím znovu.");
        }
        finally
        {
            _submitting = false;
        }
    }
}
