@page "/feedback"
@using Tobiso.Web.Shared.DTOs
@using Tobiso.Web.Domain.Entities
@inject Tobiso.Web.Api.Services.IFeedbackService FeedbackService
@inject NavigationManager NavigationManager

<PageTitle>Zpětná vazba - Tobiso</PageTitle>

<style>

    .success-message {
        color: #27ae60;
        font-weight: bold;
        margin-top: 15px;
        padding: 15px;
        background-color: #d4edda;
        border-radius: 4px;
    }

    .error-message {
        color: #e74c3c;
        font-weight: bold;
        margin-top: 15px;
        padding: 15px;
        background-color: #f8d7da;
        border-radius: 4px;
    }

    .feedback-type-selector {
        display: flex;
        gap: 10px;
        margin-bottom: 12px;
    }

    .type-btn {
        flex: 1;
        padding: 10px;
        border: 2px solid #ccc;
        border-radius: 6px;
        background: transparent;
        cursor: pointer;
        font-size: 1rem;
        transition: border-color 0.15s, background 0.15s;
    }

    .type-btn.active {
        border-color: #2980b9;
        background-color: #ebf5fb;
        font-weight: bold;
    }

    @@media only screen and (min-width: 1200px) {
    textarea {
        max-width: 60rem;
        max-height: 15rem;
        min-width: 50rem;
        min-height: 25rem;
    }
}
</style>

<div class="feedback-container">
    <h1 class="verybig">Zpětná vazba</h1>
    <p>
        Pokud najdete jakoukoli chybu v textu, můžete mi to tady napsat, pokud byste měli otázku, také mi to sem napište. Velmi mě zajímá Vaše zpětná vazba.
    </p>

    @if (!isSubmitted)
    {
    <div class="feedback-form">
            <div class="feedback-type-selector">
                <button type="button"
                        class="type-btn @(feedback.Type == FeedbackType.Bug ? "active" : "")"
                        @onclick="() => feedback.Type = FeedbackType.Bug">
                    🐛 Chyba
                </button>
                <button type="button"
                        class="type-btn @(feedback.Type == FeedbackType.FeatureRequest ? "active" : "")"
                        @onclick="() => feedback.Type = FeedbackType.FeatureRequest">
                    💡 Návrh
                </button>
            </div>

            <label for="feedback-name" class="visually-hidden">Vaše jméno</label>
            <input
                id="feedback-name"
                type="text"
                class="opinion-input"
                placeholder="Vaše jméno"
                @bind="feedback.Name"
                required
                aria-required="true"
            />

            <label for="feedback-title" class="visually-hidden">Krátký popis</label>
            <input
                id="feedback-title"
                type="text"
                class="opinion-input"
                placeholder="Krátký popis (co se stalo / co navrhujete)"
                @bind="feedback.Title"
                required
                aria-required="true"
            />

            <label for="feedback-email" class="visually-hidden">Váš e-mail</label>
            <input
                id="feedback-email"
                type="email"
                class="email-input"
                placeholder="Váš e-mail"
                @bind="feedback.Email"
                required
                aria-required="true"
            />

            <label for="feedback-message" class="visually-hidden">Zpráva</label>
            <textarea
                id="feedback-message"
                placeholder="Zde napište svou zpětnou vazbu"
                @bind="feedback.Message"
                required
                aria-required="true"
            ></textarea>

            <button type="button" @onclick="SubmitFeedback" disabled="@isSubmitting" aria-label="Odeslat zpětnou vazbu">
                @if (isSubmitting)
                {
                    <span>Odesílání...</span>
                }
                else
                {
                    <span>Odeslat zpětnou vazbu</span>
                }
            </button>
        </div>
    }

    @if (showSuccess)
    {
        <div class="success-message">
            Děkujeme! Vaše zpětná vazba byla úspěšně odeslána.
        </div>
    }

    @if (showError)
    {
        <div class="error-message">
            Při odesílání došlo k chybě. Prosím zkuste to znovu.
        </div>
    }
</div>

@code {
    private CreateFeedbackDto feedback = new CreateFeedbackDto { Platform = "Web", Type = FeedbackType.Bug };
    private bool isSubmitting = false;
    private bool isSubmitted = false;
    private bool showSuccess = false;
    private bool showError = false;

    private async Task SubmitFeedback()
    {
        if (string.IsNullOrWhiteSpace(feedback.Name) ||
            string.IsNullOrWhiteSpace(feedback.Email) ||
            string.IsNullOrWhiteSpace(feedback.Title) ||
            string.IsNullOrWhiteSpace(feedback.Message))
        {
            showError = true;
            StateHasChanged();
            await Task.Delay(3000);
            showError = false;
            StateHasChanged();
            return;
        }

        isSubmitting = true;
        showError = false;
        StateHasChanged();

        try
        {
            var result = await FeedbackService.Create(feedback);

            if (result != null)
            {
                isSubmitted = true;
                showSuccess = true;
                feedback = new CreateFeedbackDto { Platform = "Web", Type = FeedbackType.Bug };
            }
            else
            {
                showError = true;
                await Task.Delay(3000);
                showError = false;
            }
        }
        catch (Exception)
        {
            showError = true;
            await Task.Delay(3000);
            showError = false;
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }
}
