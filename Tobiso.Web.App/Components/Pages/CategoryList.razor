@page "/categories/{parentId:int?}"
@rendermode InteractiveServer
@using Tobiso.Web.Shared.DTOs
@inject Tobiso.Web.Shared.Interfaces.ITobisoAnonymApi Api
@inject Tobiso.Web.Shared.Interfaces.ITobisoAnonymApi AnonymApi
@inject Tobiso.Web.App.Services.IPreferenceService PreferenceService
@inject NavigationManager Navigation
<PageTitle>@GetCategoryTitle() - Tobiso</PageTitle>
<style>
.grade-badge-sm {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 600;
    padding: 1px 7px;
    border-radius: 999px;
    background: var(--color-accent, #4a90d9);
    color: #fff;
    margin-left: 4px;
    vertical-align: middle;
}
</style>



<h1 class="verybig">@GetCategoryTitle()</h1>
<style>
    section {
        text-align: center;
    }
</style>
@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-warning">@errorMessage</div>
}
else if (categories == null)
{
    <div class="loading-circle"></div>
}
else
{
    <div class="categories-list">
        @foreach (var category in GetFilteredCategories().Where(c => c.ParentId == parentId && (parentId != null || HasChildren(c.Id))))
        {
            <div class="category">
                <a href="@($"/categories/{category.Id}")">
                    <h5 style="margin: 0">@category.Name</h5>
                    <i class="bi bi-chevron-right"></i>
                </a>
            </div>
        }
    </div>
    @if (posts != null && posts.Any())
    {
        <div class="posts-list">
            @foreach (var post in posts)
            {
                <div class="post">
                    <a href="@($"/post/{SlugFromFilePath(post.FilePath)}")">
                        <h5 style="margin: 0">@post.Title</h5>
                        <div class="latest-muted">
                            <small>@DisplayDate(post)</small>
                            @{
                                var bestGrade = GetBestMatchGradeName(post);
                                if (!string.IsNullOrEmpty(bestGrade))
                                {
                                    <span class="grade-badge-sm">@bestGrade</span>
                                }
                                else
                                {
                                    @foreach (var grade in post.AvailableGradeNames)
                                    {
                                        <span class="grade-badge-sm">@grade</span>
                                    }
                                }
                            }
                        </div>
                    </a>
                </div>
            }
        </div>
    }
    @if (parentId != null)
    {
        <button class="btn btn-secondary mt-3" @onclick="BackToParent"><i class="bi bi-arrow-left"></i></button>
    }
}

@code {
    [Parameter]
    public int? parentId { get; set; }
    private List<CategoryResponse>? categories;
    private IList<PostSummaryResponse>? posts;
    private string? errorMessage;
    private List<GradeResponse>? grades;
    private int? selectedGradeId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Load categories and grades in parallel
            var catsTask = Api.GetAllCategories();
            var gradesTask = AnonymApi.GetGrades();

            categories = (await catsTask)?.ToList();
            grades = (await gradesTask)?.ToList();
            selectedGradeId = await PreferenceService.GetPreferredGradeIdAsync();

            await LoadPosts();
        }
        catch (System.Net.Http.HttpRequestException ex)
        {
            errorMessage = "Nemohu se připojit k backendu. Zkontroluj, že `Tobiso.Web.Api` běží (localhost:7270).";
            Console.WriteLine($"CategoryList: HTTP error: {ex.Message}");
        }
        catch (Exception ex)
        {
            errorMessage = "Došlo k chybě při načítání kategorií.";
            Console.WriteLine($"CategoryList: error: {ex.Message}");
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            if (categories == null)
                categories = await Api.GetAllCategories();
            if (grades == null)
                grades = (await AnonymApi.GetGrades())?.ToList();
            selectedGradeId = await PreferenceService.GetPreferredGradeIdAsync();
            await LoadPosts();
        }
        catch (System.Net.Http.HttpRequestException ex)
        {
            errorMessage = "Nemohu se připojit k backendu. Zkontroluj, že `Tobiso.Web.Api` běží (localhost:7270).";
            Console.WriteLine($"CategoryList: HTTP error: {ex.Message}");
        }
        catch (Exception ex)
        {
            errorMessage = "Došlo k chybě při načítání kategorií.";
            Console.WriteLine($"CategoryList: error: {ex.Message}");
        }
    }

    private async Task LoadPosts()
    {
        if (parentId != null)
        {
            try
            {
                var allPosts = await Api.GetPostSummaries();

                // only show posts from the direct category (not recursive)
                var filtered = allPosts.Where(p => p.CategoryId == parentId.Value).ToList();
                // Order by most-recent edit first. Fallback to LastFix, then minimal date.
                posts = filtered
                    .OrderByDescending(p => p.LastEdit ?? p.LastFix ?? DateTime.MinValue)
                    .ToList();
            }
            catch (System.Net.Http.HttpRequestException ex)
            {
                errorMessage = "Nemohu načíst příspěvky — backend nedostupný.";
                Console.WriteLine($"LoadPosts: HTTP error: {ex.Message}");
                posts = null;
            }
        }
        else
        {
            posts = null;
        }
    }

    private bool HasChildren(int id)
    {
        if (categories == null) return false;
        return categories.Any(c => c.ParentId == id);
    }

    private string GetCategoryTitle()
    {
        if (parentId == null || categories == null)
            return "Domů";
        var cat = categories.FirstOrDefault(c => c.Id == parentId);
        return cat?.Name ?? "Domů";
    }

    private IEnumerable<CategoryResponse> GetFilteredCategories()
    {
        return categories?.Where(c => c.Id != 42) ?? Enumerable.Empty<CategoryResponse>();
    }

    private void BackToParent()
    {
        var parent = categories?.FirstOrDefault(c => c.Id == parentId)?.ParentId;
        Navigation.NavigateTo(parent == null ? "/categories" : $"/categories/{parent}");
    }

    private string DisplayDate(PostSummaryResponse p)
    {
        if (p.LastEdit.HasValue) return p.LastEdit.Value.ToString("dd.MM.yyyy HH:mm");
        if (p.LastFix.HasValue) return p.LastFix.Value.ToString("dd.MM.yyyy HH:mm");
        return "-";
    }

    // Determine the best matching grade name for the post based on selectedGradeId
    private string? GetBestMatchGradeName(PostSummaryResponse post)
    {
        try
        {
            if (selectedGradeId == null || grades == null || post.AvailableGradeNames == null || !post.AvailableGradeNames.Any())
                return null;

            var selectedLevel = grades.FirstOrDefault(g => g.Id == selectedGradeId)?.Level;
            if (selectedLevel == null) return null;

            // Map available grade names to known grade levels when possible
            var gradeInfos = post.AvailableGradeNames
                .Select(name => new { Name = name, Level = grades.FirstOrDefault(g => g.Name == name)?.Level ?? -1 })
                .Where(g => g.Level >= 0)
                .ToList();

            if (!gradeInfos.Any()) return null;

            var best = gradeInfos.Where(g => g.Level <= selectedLevel).OrderByDescending(g => g.Level).FirstOrDefault()
                       ?? gradeInfos.OrderByDescending(g => g.Level).FirstOrDefault();
            return best?.Name;
        }
        catch
        {
            return null;
        }
    }

    private static string SlugFromFilePath(string? filePath)
    {
        if (string.IsNullOrEmpty(filePath)) return string.Empty;
        return System.IO.Path.GetFileNameWithoutExtension(filePath);
    }
}
