@page "/categories"
@page "/categories/{CategoryId:int}"
@using System.Threading
@implements IDisposable
@inject ICategoryService CategoryService
@inject IPostService PostService
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(_currentCategory?.Name ?? "Předměty") - Tobiso</PageTitle>

<div class="category-page">
    @if (_ancestors.Count > 0 || _currentCategory != null)
    {
        <nav class="breadcrumb">
            <a href="/categories">Předměty</a>
            @foreach (var anc in _ancestors.SkipLast(1))
            {
                <span class="breadcrumb-sep">/</span>
                <a href="/categories/@anc.Id">@anc.Name</a>
            }
            @if (_currentCategory != null)
            {
                <span class="breadcrumb-sep">/</span>
                <span>@_currentCategory.Name</span>
            }
        </nav>
    }

    <div>
        <h1>@(_currentCategory?.Name ?? "Předměty")</h1>
        @if (_currentCategory == null)
        {
            <p>Vyber si předmět nebo téma, které chceš studovat.</p>
        }
        else
        {
            <p>@(CzechPlural.Clanky(PostCountFor(_currentCategory!.Id)))@(_children.Count > 0 ? $" · {CzechPlural.Oblasti(_children.Count)}" : "").</p>
        }
    </div>

    @if (_children.Count > 0)
    {
        <div class="subcategory-grid">
            @foreach (var child in _children)
            {
                <a class="subcategory-card lift" href="/categories/@(child.Id)">
                    <span>
                        <span class="subcategory-name">@child.Name</span>
                        <span class="subcategory-count">@CategoryCountLabel(child.Id)</span>
                    </span>
                    <i data-lucide="chevron-right"></i>
                </a>
            }
        </div>
    }

    @if (_postsInCategory.Count > 0)
    {
        <div>
            @if (_children.Count > 0)
            {
                <h2>Články</h2>
            }
            <div class="post-list">
                @foreach (var post in _postsInCategory)
                {
                    <a class="post-row lift" href="@PostSlug.Url(post.Id, post.FilePath)">
                        <span class="post-row-main">
                            <span class="post-row-title">@post.Title</span>
                        </span>
                        <span class="post-row-grades">
                            @foreach (var g in post.AvailableGradeNames.Take(3))
                            {
                                <span class="grade-chip">@g</span>
                            }
                        </span>
                        <span class="post-row-date">@FormatDate(LastUpdated(post))</span>
                    </a>
                }
            </div>
        </div>
    }

    @if (_currentCategory == null && _rootCategories.Count > 0)
    {
        <div class="root-grid">
            @foreach (var root in _rootCategories)
            {
                <a class="subject-root-card lift" href="/categories/@(root.Id)">
                    <span class="subject-icon"><i data-lucide="@SubjectIcon(root.Name)"></i></span>
                    <span>
                        <span class="subcategory-name">@root.Name</span>
                        <span class="subcategory-count">@CategoryCountLabel(root.Id)</span>
                    </span>
                    <i data-lucide="chevron-right"></i>
                </a>
            }
        </div>
    }
</div>

@code {
    [Parameter] public int? CategoryId { get; set; }

    private bool _loading = true;
    private CategoryResponse? _currentCategory;
    private List<CategoryResponse> _ancestors = [];
    private List<CategoryResponse> _children = [];
    private List<PostSummaryResponse> _allPosts = [];
    private List<PostSummaryResponse> _postsInCategory = [];
    private List<CategoryResponse> _allCategories = [];
    private List<CategoryTreeResponse> _rootCategories = [];
    private Dictionary<int, string> _categoryPaths = [];

    // Blazor reuses this component instance across route-parameter changes, so navigating
    // again before a previous load finishes would otherwise run two loads concurrently
    // against the same circuit-scoped DbContext. Serialize loads and drop superseded ones.
    private readonly SemaphoreSlim _loadGate = new(1, 1);
    private int _loadGeneration;

    private bool _disposed;

    protected override async Task OnParametersSetAsync()
    {
        var myGeneration = ++_loadGeneration;
        try
        {
            await _loadGate.WaitAsync();
            try
            {
                if (myGeneration != _loadGeneration) return;
                _loading = true;
                await LoadData();
                if (myGeneration != _loadGeneration) return;
                _loading = false;
            }
            finally
            {
                _loadGate.Release();
            }
        }
        catch (Exception) when (_disposed)
        {
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _loadGate.Dispose();
    }

    private async Task LoadData()
    {
        _allCategories = await CategoryService.GetAll();
        _allPosts = await PostService.GetSummaries();

        // Build category path lookup
        foreach (var c in _allCategories)
        {
            var parent = _allCategories.FirstOrDefault(p => p.Id == c.ParentId);
            _categoryPaths[c.Id] = parent != null ? $"{parent.Name} · {c.Name}" : c.Name;
        }

        if (CategoryId.HasValue)
        {
            _currentCategory = _allCategories.FirstOrDefault(c => c.Id == CategoryId);
            _ancestors = await CategoryService.GetAncestors(CategoryId.Value);
            _children = [.. _allCategories.Where(c => c.ParentId == CategoryId.Value && !IsMore(c.Name))];
            _postsInCategory = [.. _allPosts
                .Where(p => p.CategoryId == CategoryId.Value)
                .OrderByDescending(LastUpdated)];
        }
        else
        {
            _rootCategories = [.. (await CategoryService.GetTree()).Where(c => !IsMore(c.Name))];
            _currentCategory = null;
            _ancestors = [];
            _children = [];
            _postsInCategory = [];
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("initLucide");
    }

    private static bool IsMore(string name) => string.Equals(name?.Trim(), "More", StringComparison.OrdinalIgnoreCase);

    // Recursively counts posts in this category and every descendant category.
    private int PostCountFor(int catId)
    {
        var direct = _allPosts.Count(p => p.CategoryId == catId);
        var childIds = _allCategories.Where(c => c.ParentId == catId).Select(c => c.Id);
        return direct + childIds.Sum(PostCountFor);
    }

    private int SubcategoryCountFor(int catId)
        => _allCategories.Count(c => c.ParentId == catId && !IsMore(c.Name));

    private string CategoryCountLabel(int catId)
    {
        var posts = CzechPlural.Clanky(PostCountFor(catId));
        var subCount = SubcategoryCountFor(catId);
        return subCount > 0 ? $"{posts} · {CzechPlural.Oblasti(subCount)}" : posts;
    }

    private static string SubjectIcon(string name)
    {
        var n = name.ToLower();
        if (n.Contains("mluvnic")) return "pen-line";
        if (n.Contains("literat")) return "book-open";
        if (n.Contains("sloh")) return "feather";
        if (n.Contains("hudeb")) return "music";
        if (n.Contains("matem")) return "calculator";
        if (n.Contains("chemi")) return "flask-conical";
        if (n.Contains("fyzik")) return "magnet";
        if (n.Contains("přírod") || n.Contains("biolog")) return "flower-2";
        if (n.Contains("země") || n.Contains("geog")) return "globe";
        return "book";
    }

    private string CategoryPath(int? id) => id.HasValue && _categoryPaths.TryGetValue(id.Value, out var p) ? p : "";

    private static DateTime? LastUpdated(PostSummaryResponse post)
        => post.LastEdit > post.LastFix ? post.LastEdit : post.LastFix;

    private static string FormatDate(DateTime? dt) => dt.HasValue
        ? dt.Value.ToString("d. M. yyyy")
        : "";
}
