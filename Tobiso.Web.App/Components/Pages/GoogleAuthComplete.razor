@page "/google-auth-complete"
@layout AuthLayout
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject StudentCredentialStore CredentialStore

<PageTitle>Přihlašuji… - Tobiso</PageTitle>

<div class="login-card" style="text-align:center; align-items:center">
    @if (_error)
    {
        <h1 class="login-title">Přihlášení přes Google se nezdařilo</h1>
        <p class="login-sub">Zkus to prosím znovu.</p>
        <a class="pill pill-on" href="/prihlaseni">Zpět na přihlášení</a>
    }
    else
    {
        <h1 class="login-title">Přihlašuji tě…</h1>
        <p class="login-sub">Chvilku strpení.</p>
    }
</div>

@code {
    private bool _error;
    private bool _done;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The token arrives in a one-time HttpOnly cookie (never the URL), redeemed through
        // JS interop - which only exists once the interactive circuit connects, so this can't
        // happen during static prerender.
        if (firstRender && !_done)
        {
            _done = true;
            var token = await JS.InvokeAsync<string?>("tobisoClaimGoogleToken");
            if (string.IsNullOrEmpty(token))
            {
                _error = true;
                StateHasChanged();
                return;
            }
            await CredentialStore.SetAsync(token, JS);
            Nav.NavigateTo("/", forceLoad: true);
        }
    }
}
