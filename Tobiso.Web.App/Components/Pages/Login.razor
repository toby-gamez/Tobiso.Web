@page "/prihlaseni"
@layout AuthLayout
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IUserService UserService
@inject StudentCredentialStore CredentialStore

<PageTitle>Přihlášení - Tobiso</PageTitle>

<div class="login-card">
    <div class="login-brand">
        <span class="brand-logo-sm">T</span>
        <span class="brand-name-sm">Tobiso</span>
    </div>

    <div>
        <h1 class="login-title">Přihlášení</h1>
        <p class="login-sub">Účet ti uloží záložky, poznámky a kredity na všech zařízeních.</p>
    </div>

    <div class="field">
        <label for="log-mail">E-mail</label>
        <input id="log-mail" class="input" type="email" placeholder="tvuj@email.cz"
               @bind="_email" @bind:event="oninput" />
    </div>

    <div class="field">
        <label for="log-pass">Heslo</label>
        <input id="log-pass" class="input" type="password" placeholder="••••••••"
               @bind="_password" @bind:event="oninput"
               @onkeydown="@(async e => { if (e.Key == "Enter") await Submit(); })" />
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="login-error">@_error</div>
    }

    <button class="pill pill-on login-submit" @onclick="Submit" disabled="@_submitting">
        @if (_submitting) { <span>Přihlašuji…</span> } else { <span>Přihlásit se</span> }
    </button>

    <div class="login-divider">
        <span class="divider-line"></span>
        <span>nebo</span>
        <span class="divider-line"></span>
    </div>

    <a href="/api/auth/google-login" class="pill login-google">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
            <path d="M17.64 9.205c0-.639-.057-1.252-.164-1.841H9v3.481h4.844a4.14 4.14 0 0 1-1.796 2.716v2.259h2.908c1.702-1.567 2.684-3.875 2.684-6.615Z" fill="#4285F4"/>
            <path d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18Z" fill="#34A853"/>
            <path d="M3.964 10.71A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.71V4.958H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.042l3.007-2.332Z" fill="#FBBC05"/>
            <path d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58Z" fill="#EA4335"/>
        </svg>
        Pokračovat přes Google
    </a>

    <p class="login-register">
        Nemáš účet?
        <a href="/registrace">Zaregistruj se</a> - dostaneš 20 kreditů.
    </p>
</div>

@code {
    private string _email = "";
    private string _password = "";
    private string _error = "";
    private bool _submitting;

    [Inject] private JwtTokenService JwtService { get; set; } = null!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await JS.InvokeVoidAsync("initLucide");
    }

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
        {
            _error = "Vyplň e-mail i heslo.";
            return;
        }
        _submitting = true;
        _error = "";
        StateHasChanged();

        try
        {
            var user = await UserService.LoginAsync(_email.Trim(), _password);
            if (user == null)
            {
                _error = "Nesprávný e-mail nebo heslo.";
            }
            else
            {
                var token = JwtService.GenerateStudentToken(user);
                await CredentialStore.SetAsync(token, JS);
                Nav.NavigateTo("/", forceLoad: true);
            }
        }
        catch
        {
            _error = "Přihlášení se nezdařilo. Zkus to prosím znovu.";
        }
        finally
        {
            _submitting = false;
        }
    }
}
