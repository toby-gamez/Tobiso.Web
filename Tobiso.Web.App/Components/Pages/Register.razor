@page "/registrace"
@layout AuthLayout
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IUserService UserService
@inject StudentCredentialStore CredentialStore
@inject JwtTokenService JwtService

<PageTitle>Registrace - Tobiso</PageTitle>

<div class="login-card">
    <div class="login-brand">
        <img src="/images/normal-logo.png" alt="Tobiso" class="brand-logo-img logo-light" />
        <img src="/images/white-logo.png" alt="Tobiso" class="brand-logo-img logo-dark" />
    </div>

    <div>
        <h1 class="login-title">Registrace</h1>
        <p class="login-sub">Vytvoř si účet zdarma a získej 20 kreditů na AI asistenta.</p>
    </div>

    <div class="field">
        <label for="reg-name">Jméno</label>
        <input id="reg-name" class="input" type="text" placeholder="Jak ti máme říkat?"
               @bind="_displayName" @bind:event="oninput" />
    </div>

    <div class="field">
        <label for="reg-mail">E-mail</label>
        <input id="reg-mail" class="input" type="email" placeholder="tvuj@email.cz"
               @bind="_email" @bind:event="oninput" />
    </div>

    <div class="field">
        <label for="reg-pass">Heslo</label>
        <input id="reg-pass" class="input" type="password" placeholder="Alespoň 10 znaků"
               @bind="_password" @bind:event="oninput" />
    </div>

    <div class="field">
        <label for="reg-pass2">Heslo znovu</label>
        <input id="reg-pass2" class="input" type="password" placeholder="••••••••"
               @bind="_password2" @bind:event="oninput"
               @onkeydown="@(async e => { if (e.Key == "Enter") await Submit(); })" />
    </div>

    <label class="consent">
        <input type="checkbox" @bind="_accepted" />
        <span>
            Souhlasím s <a href="/pravni-dokumenty" target="_blank" rel="noopener">Podmínkami použití a Zásadami ochrany osobních údajů</a>
            a potvrzuji, že mi je alespoň 15 let, nebo mám souhlas rodiče či zákonného zástupce.
        </span>
    </label>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="login-error">@_error</div>
    }

    <button class="pill pill-on login-submit" @onclick="Submit" disabled="@(_submitting || !_accepted)">
        @if (_submitting) { <span>Vytvářím účet…</span> } else { <span>Zaregistrovat se</span> }
    </button>

    <div class="login-divider">
        <span class="divider-line"></span>
        <span>nebo</span>
        <span class="divider-line"></span>
    </div>

    <a href="@(_accepted ? "/api/auth/google-login?terms=true" : null)" class="pill login-google @(_accepted ? "" : "is-disabled")"
       aria-disabled="@(_accepted ? "false" : "true")">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
            <path d="M17.64 9.205c0-.639-.057-1.252-.164-1.841H9v3.481h4.844a4.14 4.14 0 0 1-1.796 2.716v2.259h2.908c1.702-1.567 2.684-3.875 2.684-6.615Z" fill="#4285F4"/>
            <path d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18Z" fill="#34A853"/>
            <path d="M3.964 10.71A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.71V4.958H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.042l3.007-2.332Z" fill="#FBBC05"/>
            <path d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58Z" fill="#EA4335"/>
        </svg>
        Pokračovat přes Google
    </a>

    <p class="login-register">
        Už máš účet?
        <a href="/prihlaseni">Přihlas se</a>
    </p>
</div>

@code {
    private string _displayName = "";
    private string _email = "";
    private string _password = "";
    private string _password2 = "";
    private string _error = "";
    private bool _submitting;
    private bool _accepted;

    [Parameter]
    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorCode { get; set; }

    protected override void OnInitialized()
    {
        if (ErrorCode == "terms")
            _error = "Pro vytvoření účtu přes Google nejdřív potvrď souhlas s podmínkami.";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await JS.InvokeVoidAsync("initLucide");
    }

    private async Task Submit()
    {
        if (!_accepted)
        {
            _error = "Pro registraci musíš souhlasit s podmínkami.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
        {
            _error = "Vyplň e-mail i heslo.";
            return;
        }
        if (!_email.Contains('@'))
        {
            _error = "Zadej platný e-mail.";
            return;
        }
        if (_password.Length < 10)
        {
            _error = "Heslo musí mít alespoň 10 znaků.";
            return;
        }
        if (_password != _password2)
        {
            _error = "Hesla se neshodují.";
            return;
        }

        _submitting = true;
        _error = "";
        StateHasChanged();

        try
        {
            var email = _email.Trim();
            var name = string.IsNullOrWhiteSpace(_displayName) ? email : _displayName.Trim();
            var user = await UserService.RegisterAsync(email, name, _password, _accepted);
            if (user == null)
            {
                _error = "Tento e-mail je již zaregistrován.";
            }
            else
            {
                var token = JwtService.GenerateStudentToken(user);
                await CredentialStore.SetAsync(token, JS);
                Nav.NavigateTo("/", forceLoad: true);
            }
        }
        catch
        {
            _error = "Registrace se nezdařila. Zkus to prosím znovu.";
        }
        finally
        {
            _submitting = false;
        }
    }
}
