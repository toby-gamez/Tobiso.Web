@page "/profil"
@using Microsoft.AspNetCore.Components.Authorization
@using Tobiso.Web.App.Authentication
@using Tobiso.Web.Api.Services
@using Tobiso.Web.Shared.DTOs
@using System.Security.Claims
@inject StudentCredentialStore CredentialStore
@inject StudentAuthStateProvider AuthStateProvider
@inject IAiChatHistoryService ChatHistoryService
@inject IUserProgressService ProgressService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Můj profil – Tobiso</PageTitle>

<style>
.profile-streak {
    font-size: 1.1rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.4rem;
}
.profile-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
}
.profile-badge {
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 600;
    border: 1px solid transparent;
}
.profile-badge.badge-začátečník {
    background: #e8f4fd;
    color: #1a6fad;
    border-color: #b3d9f7;
}
.profile-badge.badge-pokročilý {
    background: #eaf6ea;
    color: #2a7a2a;
    border-color: #a8e0a8;
}
.profile-badge.badge-expert {
    background: #fff4e0;
    color: #b36200;
    border-color: #f5cc80;
}
body.dark-mode .profile-badge.badge-začátečník { background: #0d2d4a; color: #7ec8f5; border-color: #2a5a80; }
body.dark-mode .profile-badge.badge-pokročilý  { background: #0d2e0d; color: #7cd87c; border-color: #2a602a; }
body.dark-mode .profile-badge.badge-expert     { background: #2e1e00; color: #f5a832; border-color: #6e4500; }
.profile-subject-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--color-border, #eee);
    font-size: 0.93rem;
}
.profile-subject-count {
    color: var(--color-text-muted, #888);
    font-size: 0.85rem;
}
</style>

<AuthorizeView>
    <Authorized>
        <div class="profile-page">
            <div class="profile-header">
                <div class="profile-avatar">
                    @if (!string.IsNullOrEmpty(_avatarUrl))
                    {
                        <img class="profile-avatar-img" src="@_avatarUrl" alt="avatar" />
                    }
                    else
                    {
                        <i class="bi bi-person-circle"></i>
                    }
                </div>
                <div class="profile-info">
                    <h1>@context.User.FindFirst(ClaimTypes.Name)?.Value</h1>
                    <p class="profile-email">@context.User.FindFirst(ClaimTypes.Email)?.Value</p>
                    <CreditBadge Credits="@GetCredits(context.User)" />
                </div>
            </div>

            @if (_stats != null)
            {
                <div class="profile-section">
                    <h2>🔥 Série čtení</h2>
                    <p class="profile-streak">
                        @if (_stats.StreakDays > 0)
                        {
                            <span>@_stats.StreakDays dní v řadě</span>
                        }
                        else
                        {
                            <span>Zatím žádná série</span>
                        }
                        @if (_stats.TotalRead > 0)
                        {
                            <span style="font-weight:400;color:var(--color-text-muted,#888)">· @_stats.TotalRead článků přečteno</span>
                        }
                    </p>
                </div>

                @if (_stats.Badges.Any())
                {
                    <div class="profile-section">
                        <h2>Odznaky</h2>
                        <div class="profile-badges">
                            @foreach (var b in _stats.Badges)
                            {
                                <span class="profile-badge badge-@b.Level.ToLower()">@b.SubjectName · @b.Level</span>
                            }
                        </div>
                    </div>
                }

                @if (_stats.PerSubject.Any())
                {
                    <div class="profile-section">
                        <h2>Přečteno podle předmětu</h2>
                        @foreach (var s in _stats.PerSubject)
                        {
                            <div class="profile-subject-row">
                                <span>@s.SubjectName</span>
                                <span class="profile-subject-count">@s.Count @(s.Count == 1 ? "článek" : s.Count < 5 ? "články" : "článků")</span>
                            </div>
                        }
                    </div>
                }
            }

            <div class="profile-section">
                <h2>Historie AI chatů</h2>
                @if (sessions == null)
                {
                    <p class="profile-loading">Načítám...</p>
                }
                else if (sessions.Count == 0)
                {
                    <p class="profile-empty">Zatím žádné chaty.</p>
                }
                else
                {
                    <ul class="profile-sessions">
                        @foreach (var s in sessions)
                        {
                            <li>
                                <a href="post/@s.PostId">
                                    <i class="bi bi-chat-dots"></i>
                                    <span>@(s.Post?.Title ?? $"Článek #{s.PostId}")</span>
                                </a>
                                <span class="profile-session-date">@s.UpdatedAt.ToString("d. M. yyyy")</span>
                            </li>
                        }
                    </ul>
                }
            </div>

            <div class="profile-actions">
                <button class="secondary" @onclick="Logout">
                    <i class="bi bi-box-arrow-right"></i> Odhlásit se
                </button>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="auth-page">
            <div class="auth-card" style="text-align:center">
                <p>Pro zobrazení profilu se musíš přihlásit.</p>
                <a href="/prihlaseni">Přihlásit se</a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<Tobiso.Web.Domain.Entities.AiChatSession>? sessions;
    private UserStatsDto? _stats;

    private int GetCredits(ClaimsPrincipal user)
    {
        var c = user.FindFirst("credits")?.Value;
        return int.TryParse(c, out var n) ? n : 0;
    }

    private bool _initialized;
    private string? _avatarUrl;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            await CredentialStore.InitializeAsync(JSRuntime);

            _avatarUrl = GetTokenClaim("avatar");

            AuthStateProvider.NotifyStateChanged();

            var idStr = GetUserId();
            if (int.TryParse(idStr, out var userId))
            {
                sessions = await ChatHistoryService.GetUserSessionsAsync(userId);
                try { _stats = await ProgressService.GetStatsAsync(userId); }
                catch { }
            }
            else
            {
                sessions = [];
            }

            StateHasChanged();
        }
    }

    private string? GetUserId() => GetTokenClaim("sub");

    private string? GetTokenClaim(string claim)
    {
        var token = CredentialStore.GetToken();
        if (string.IsNullOrEmpty(token)) return null;
        try
        {
            var parts = token.Split('.');
            if (parts.Length != 3) return null;
            var padded = (parts[1].Length % 4) switch
            {
                2 => parts[1] + "==",
                3 => parts[1] + "=",
                _ => parts[1]
            };
            var json = System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(padded.Replace('-', '+').Replace('_', '/')));
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            return doc.RootElement.TryGetProperty(claim, out var val) ? val.GetString() : null;
        }
        catch { return null; }
    }

    private async Task Logout()
    {
        await CredentialStore.ClearAsync(JSRuntime);
        AuthStateProvider.NotifyStateChanged();
        NavigationManager.NavigateTo("/", forceLoad: false);
    }
}
