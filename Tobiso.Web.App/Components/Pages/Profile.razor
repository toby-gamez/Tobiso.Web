@page "/profil"
@implements IDisposable
@inject IUserProgressService UserProgressService
@inject IUserService UserService
@inject IUserDataExportService ExportService
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject StudentCredentialStore CredentialStore

<PageTitle>Profil - Tobiso</PageTitle>

<div class="profile-page">
    @if (!_isAuth)
    {
        <div class="soft" style="padding:var(--space-8); text-align:center">
            <h1 style="font-size:32px; margin:0 0 var(--space-3)">Profil</h1>
            <p>Pro zobrazení profilu se <a href="/prihlaseni">přihlas</a>.</p>
        </div>
    }
    else
    {
        <div class="profile-header soft">
            <div class="profile-avatar">@Initials</div>
            <div class="profile-identity">
                <h1>@_displayName</h1>
                <p>@_email</p>
            </div>
        </div>

        <div class="profile-stats">
            <div class="stat-card">
                <i data-lucide="flame" style="color:var(--color-accent-600)"></i>
                <span class="stat-value">@(_stats?.StreakDays ?? 0)</span>
                <span class="stat-label">Dní v řadě</span>
            </div>
            <div class="stat-card">
                <i data-lucide="book-open" style="color:var(--color-accent-600)"></i>
                <span class="stat-value">@(_stats?.TotalRead ?? 0)</span>
                <span class="stat-label">Přečteno</span>
            </div>
            <div class="stat-card">
                <i data-lucide="coins" style="color:var(--color-accent-600)"></i>
                <span class="stat-value">@_credits</span>
                <span class="stat-label">Kreditů</span>
            </div>
            <div class="stat-card">
                <i data-lucide="award" style="color:var(--color-accent-600)"></i>
                <span class="stat-value">@(_stats?.Badges.Count ?? 0)</span>
                <span class="stat-label">Odznaků</span>
            </div>
        </div>

        <div>
            <h2>Pokrok podle předmětů</h2>
            @if (_stats == null || _stats.PerSubject.Count == 0)
            {
                <p style="color:var(--color-neutral-600)">Zatím žádný pokrok - přečti si první článek.</p>
            }
            else
            {
                <div class="profile-subjects">
                    @foreach (var s in _stats.PerSubject.OrderByDescending(x => x.Count))
                    {
                        <div class="profile-subject">
                            <div class="profile-subject-row">
                                <span>@s.SubjectName</span>
                                <span style="color:var(--color-neutral-600)">@s.Count</span>
                            </div>
                            <div class="progress-bar">
                                <div class="progress-bar-fill" style="width:@(MaxSubject == 0 ? 0 : s.Count * 100 / MaxSubject)%"></div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div>
            <h2>Odznaky</h2>
            @if (_stats == null || _stats.Badges.Count == 0)
            {
                <p style="color:var(--color-neutral-600)">Zatím žádné odznaky.</p>
            }
            else
            {
                <div class="profile-badges">
                    @foreach (var b in _stats.Badges)
                    {
                        <div class="profile-badge">
                            <i data-lucide="award"></i>
                            <span class="profile-badge-name">@b.SubjectName</span>
                            <span class="profile-badge-level">@b.Level</span>
                        </div>
                    }
                </div>
            }
        </div>

        <div>
            <h2>Využití AI</h2>
            <div class="profile-ai-summary">
                <div class="soft stat-card">
                    <span class="stat-card-label">Otázek tento měsíc</span>
                    <span class="stat-card-value">@(_aiUsage?.QuestionsThisMonth ?? 0)</span>
                </div>
                <div class="soft stat-card">
                    <span class="stat-card-label">Kreditů utraceno tento měsíc</span>
                    <span class="stat-card-value">@(_aiUsage?.CreditsSpentThisMonth ?? 0)</span>
                </div>
            </div>

            @if (_aiUsage == null || _aiUsage.RecentActivity.Count == 0)
            {
                <p style="color:var(--color-neutral-600)">Zatím žádná aktivita.</p>
            }
            else
            {
                <div class="ai-usage-list">
                    @foreach (var entry in _aiUsage.RecentActivity)
                    {
                        <div class="ai-usage-row">
                            <i data-lucide="@(entry.Delta >= 0 ? "plus-circle" : "minus-circle")"
                               style="color:@(entry.Delta >= 0 ? "var(--color-accent-2-600)" : "var(--color-accent-600)")"></i>
                            <span class="ai-usage-reason">@ReasonLabel(entry.Reason)</span>
                            <span class="ai-usage-date">@entry.CreatedAt.ToLocalTime().ToString("d. M. yyyy HH:mm")</span>
                            <span class="ai-usage-delta" style="color:@(entry.Delta >= 0 ? "var(--color-accent-2-700)" : "var(--color-accent-700)")">
                                @(entry.Delta >= 0 ? "+" : "")@entry.Delta
                            </span>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="soft profile-export">
            <h2>Moje data</h2>
            <p>Stáhni si všechna data, která o tobě uchováváme (účet, záložky, poznámky, pokrok, kredity a historii AI chatů), ve formátu JSON.</p>
            @if (!string.IsNullOrEmpty(_exportError))
            {
                <p class="profile-danger-error">@_exportError</p>
            }
            <button class="pill" disabled="@_exporting" @onclick="ExportData">
                @(_exporting ? "Připravuji…" : "Stáhnout má data")
            </button>
        </div>

        <div class="soft profile-danger">
            <h2>Smazat účet</h2>
            <p>Smazáním účtu trvale odstraníš svůj profil, kredity, historii AI chatů, poznámky, záložky a pokrok. Tuto akci nelze vrátit.</p>
            @if (!_confirmingDelete)
            {
                <button class="pill" @onclick="() => _confirmingDelete = true">Smazat můj účet</button>
            }
            else
            {
                <div class="field">
                    <label for="delete-confirm">@(_hasPassword ? "Pro potvrzení zadej své heslo" : "Pro potvrzení zadej svůj e-mail (" + _email + ")")</label>
                    <input id="delete-confirm" class="input" autocomplete="off"
                           type="@(_hasPassword ? "password" : "text")"
                           @bind="_deleteConfirm" @bind:event="oninput" />
                </div>
                @if (!string.IsNullOrEmpty(_deleteError))
                {
                    <p class="profile-danger-error">@_deleteError</p>
                }
                <div class="profile-danger-actions">
                    <button class="pill pill-on" disabled="@(_deleting || string.IsNullOrWhiteSpace(_deleteConfirm))" @onclick="DeleteAccount">
                        @(_deleting ? "Mažu…" : "Trvale smazat účet")
                    </button>
                    <button class="pill" disabled="@_deleting" @onclick="CancelDelete">Zrušit</button>
                </div>
            }
        </div>
    }
</div>

@code {
    private bool _isAuth;
    private int _userId;
    private int _credits;
    private string _displayName = "";
    private string _email = "";
    private UserStatsDto? _stats;
    private AiUsageDto? _aiUsage;

    private int MaxSubject => _stats?.PerSubject.Count > 0 ? _stats.PerSubject.Max(s => s.Count) : 0;

    private string Initials
    {
        get
        {
            var parts = _displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length == 0) return "?";
            if (parts.Length == 1) return parts[0][..1].ToUpperInvariant();
            return $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant();
        }
    }

    private bool _disposed;
    private bool _hasPassword, _confirmingDelete, _deleting;
    private string _deleteConfirm = "", _deleteError = "";

    private bool _exporting;
    private string _exportError = "";

    private async Task ExportData()
    {
        _exporting = true;
        _exportError = "";
        try
        {
            var bytes = await ExportService.ExportAsync(_userId);
            if (bytes == null)
            {
                _exportError = "Účet se nepodařilo najít.";
                return;
            }
            using var stream = new MemoryStream(bytes);
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", $"tobiso-moje-data-{DateTime.UtcNow:yyyyMMdd}.json", streamRef);
        }
        catch
        {
            _exportError = "Export se nezdařil. Zkus to prosím znovu.";
        }
        finally { _exporting = false; }
    }

    private void CancelDelete()
    {
        _confirmingDelete = false;
        _deleteConfirm = _deleteError = "";
    }

    private async Task DeleteAccount()
    {
        _deleting = true;
        _deleteError = "";
        try
        {
            var result = await UserService.DeleteAccountAsync(
                _userId,
                _hasPassword ? _deleteConfirm : null,
                _hasPassword ? null : _deleteConfirm);

            switch (result)
            {
                case DeleteAccountResult.Deleted:
                case DeleteAccountResult.NotFound:
                    await CredentialStore.ClearAsync(JS);
                    Nav.NavigateTo("/", forceLoad: true);
                    break;
                default:
                    _deleteError = _hasPassword ? "Nesprávné heslo." : "E-mail se neshoduje.";
                    break;
            }
        }
        finally { _deleting = false; }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            _isAuth = auth.User.Identity?.IsAuthenticated == true;
            if (!_isAuth) return;

            _displayName = auth.User.FindFirst(ClaimTypes.Name)?.Value ?? "Student";
            if (!int.TryParse(auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out _userId)) return;

            _stats = await UserProgressService.GetStatsAsync(_userId);
            _aiUsage = await UserProgressService.GetAiUsageAsync(_userId);
            var user = await UserService.GetByIdAsync(_userId);
            _credits = user?.Credits ?? 0;
            _email = user?.Email ?? "";
            _hasPassword = !string.IsNullOrEmpty(user?.PasswordHash);
        }
        catch (Exception) when (_disposed)
        {
        }
    }

    public void Dispose() => _disposed = true;

    // Feature names match the "Více" AI tool identifiers in PostDetail.razor (AiToolTitle) -
    // DeductAiCreditIfLoggedInAsync there passes the tool name as the reason so usage history
    // can show which specific AI feature was used, not just a generic "AI otázka" for everything.
    private static string ReasonLabel(string reason) => reason switch
    {
        "ai_ask" => "AI chat",
        "flashcards" => "Kartičky",
        "practice" => "Procvičovací úlohy",
        "rewrite" => "Přepsat pro jiný ročník",
        "exam" => "Co může přijít v testu",
        "realworld" => "Reálné využití",
        "whatif" => "Co kdyby?",
        "feynman" => "Zkus to vysvětlit",
        "compare" => "Porovnat s…",
        "stepsolver" => "Krok za krokem",
        "facts" => "Věděl jsi, že…?",
        "daily_bonus" => "Denní bonus",
        "read_streak_bonus" => "Čtenářská odměna",
        "registration_bonus" => "Registrace",
        _ => reason
    };

    protected override async Task OnAfterRenderAsync(bool firstRender) =>
        await JS.InvokeVoidAsync("initLucide");
}
