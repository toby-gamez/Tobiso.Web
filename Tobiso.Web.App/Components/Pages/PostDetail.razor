    private string ProseClass
    {
        get
        {
            var parts = new List<string>();
            if (_readingFont == "serif") parts.Add("prose-serif");
            if (_readingFont == "mono") parts.Add("prose-mono");
            if (_readingSize == "sm") parts.Add("prose-sm");
            if (_readingSize == "lg") parts.Add("prose-lg");
            if (_readingWidth == "narrow") parts.Add("prose-narrow");
            if (_readingWidth == "wide") parts.Add("prose-wide");
            return string.Join(" ", parts);
        }
    }

    private DateTime? MostRecentEdit
    {
        get
        {
            var edit = _currentVersion?.LastEdit;
            var fix = _currentVersion?.LastFix;
            if (edit == null) return fix;
            if (fix == null) return edit;
            return edit >= fix ? edit : fix;
        }
    }

    private static string FormatDateTime(DateTime? dt) => dt.HasValue ? dt.Value.ToString("d. M. yyyy 'v' HH:mm") : "";

