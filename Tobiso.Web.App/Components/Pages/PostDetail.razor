@page "/post/{Id:int}"
@page "/post/{Slug}"
@implements IAsyncDisposable
@using System.Threading
@using Tobiso.Web.Shared.Interfaces
@inject IPostService PostService
@inject ICategoryService CategoryService
@inject IRelatedPostService RelatedPostService
@inject IQuestionService QuestionService
@inject IUserProgressService UserProgressService
@inject IInteractiveExerciseService ExerciseService
@inject IUserService UserService
@inject ITobisoAnonymApi AnonymApi
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject IAiService AiService
@inject Tobiso.Web.App.Services.IAiUsageGuard UsageGuard

<PageTitle>@(_post?.Title ?? "Článek") — Tobiso</PageTitle>

@if (_loading)
{
    <div style="display:flex; flex-direction:column; gap:var(--space-4); max-width:800px">
        <div class="skeleton" style="height:16px; width:200px"></div>
        <div class="skeleton" style="height:44px; width:70%"></div>
        <div class="skeleton" style="height:20px; width:300px"></div>
        <div class="skeleton" style="height:52px; border-radius:999px"></div>
        <div class="skeleton" style="height:300px; border-radius:var(--radius-lg)"></div>
    </div>
}
else if (_post == null)
{
    <div style="text-align:center; padding:var(--space-8)">
        <h1>Článek nenalezen</h1>
        <a href="/" class="pill" style="margin-top:var(--space-4)">Zpět domů</a>
    </div>
}
else
{
    <div class="post-detail-layout">
        <div class="post-body">
            <nav class="breadcrumb" style="margin-bottom:var(--space-4)">
                <a href="/categories">Předměty</a>
                @foreach (var anc in _ancestors)
                {
                    <span class="breadcrumb-sep">/</span>
                    <a href="/categories/@anc.Id">@anc.Name</a>
                }
                <span class="breadcrumb-sep">/</span>
                <span>@_post.Title</span>
            </nav>

            <div class="post-title-row">
                <h1 class="post-h1">@_post.Title</h1>
                <div class="grade-selector">
                    @if (_currentVersion != null)
                    {
                        <span class="grade-chip" style="font-size:13px; font-weight:600; padding:6px 14px">@(_currentVersion.GradeName ?? "—")</span>
                        @if (_versions.Count > 1)
                        {
                            <button class="icon-btn" @onclick="ToggleVersions" aria-label="Vybrat ročník">
                                <i data-lucide="chevron-down"></i>
                            </button>
                        }
                    }
                    @if (_versionsOpen)
                    {
                        <div class="version-dropdown">
                            @foreach (var v in _versions)
                            {
                                <button class="version-item @(v.Id == _currentVersion?.Id ? "active" : "")"
                                        @onclick="@(() => SelectVersion(v))">
                                    @v.GradeName
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="post-meta">
                <span><i data-lucide="book-open"></i> @CzechPlural.Slova(WordCount) · @ReadTime min čtení</span>
                <span style="opacity:.4">·</span>
                <span>Upraveno @FormatDateTime(MostRecentEdit)</span>
                @if (_currentVersion?.LastFix.HasValue == true)
                {
                    <span style="opacity:.4">·</span>
                    <span style="color:var(--color-accent-2-700)"><i data-lucide="check-circle-2"></i> Zkontrolováno</span>
                }
            </div>

            <div class="toolbar">
                <button class="toolbar-btn" @onclick="ScrollToQuiz">
                    <i data-lucide="file-check-2"></i> Ověř si porozumění
                </button>
                <button class="toolbar-btn @(_readingOpen ? "active" : "")" @onclick="ToggleReading">
                    <i data-lucide="type"></i> Čtení
                </button>
                <button class="toolbar-btn" @onclick="ScrollToExercises">
                    <i data-lucide="puzzle"></i> Cvičení
                </button>
                <button class="toolbar-btn" style="opacity:.5; cursor:not-allowed">
                    <i data-lucide="volume-2"></i> Poslech
                </button>
                <span style="flex:1"></span>
                <button class="icon-btn @(_bookmarked ? "bookmarked" : "")" @onclick="ToggleBookmark" aria-label="Záložka">
                    <i data-lucide="bookmark"></i>
                </button>
                <button class="pill pill-on" style="font-size:14px; padding:9px 16px" @onclick="ToggleMore">
                    <i data-lucide="sparkles"></i> Více
                </button>
            </div>

            @if (_readingOpen)
            {
                <div class="reading-panel">
                    <div>
                        <div class="panel-label">Písmo</div>
                        <div class="seg-control">
                            <button class="seg-btn @(_readingFont == "figtree" ? "active" : "")" @onclick='@(() => _readingFont = "figtree")'>Figtree</button>
                            <button class="seg-btn @(_readingFont == "serif" ? "active" : "")" @onclick='@(() => _readingFont = "serif")'>Serif</button>
                            <button class="seg-btn @(_readingFont == "mono" ? "active" : "")" @onclick='@(() => _readingFont = "mono")'>Mono</button>
                        </div>
                    </div>
                    <div>
                        <div class="panel-label">Velikost</div>
                        <div class="seg-control">
                            <button class="seg-btn @(_readingSize == "sm" ? "active" : "")" @onclick='@(() => _readingSize = "sm")' style="font-size:11px">A</button>
                            <button class="seg-btn @(_readingSize == "md" ? "active" : "")" @onclick='@(() => _readingSize = "md")'>A</button>
                            <button class="seg-btn @(_readingSize == "lg" ? "active" : "")" @onclick='@(() => _readingSize = "lg")' style="font-size:18px">A</button>
                        </div>
                    </div>
                    <div>
                        <div class="panel-label">Šířka sloupce</div>
                        <div class="seg-control">
                            <button class="seg-btn @(_readingWidth == "narrow" ? "active" : "")" @onclick='@(() => _readingWidth = "narrow")'>Úzká</button>
                            <button class="seg-btn @(_readingWidth == "mid" ? "active" : "")" @onclick='@(() => _readingWidth = "mid")'>Střední</button>
                            <button class="seg-btn @(_readingWidth == "wide" ? "active" : "")" @onclick='@(() => _readingWidth = "wide")'>Široká</button>
                        </div>
                    </div>
                </div>
            }

            @if (_moreOpen)
            {
                <div class="more-panel">
                    <div class="more-panel-label">Nástroje k článku</div>
                    <button class="more-item"><i data-lucide="layers" style="color:var(--color-accent-600)"></i> Kartičky</button>
                    <button class="more-item"><i data-lucide="pencil-line" style="color:var(--color-accent-600)"></i> Procvičovací úlohy</button>
                    <button class="more-item"><i data-lucide="users" style="color:var(--color-accent-600)"></i> Přepsat pro ročník</button>
                    <button class="more-item"><i data-lucide="help-circle" style="color:var(--color-accent-600)"></i> Co může přijít v testu</button>
                    <button class="more-item"><i data-lucide="globe-2" style="color:var(--color-accent-2-600)"></i> Reálné využití</button>
                    <button class="more-item"><i data-lucide="wand-2" style="color:var(--color-accent-2-600)"></i> Co kdyby?</button>
                    <button class="more-item"><i data-lucide="message-square-quote" style="color:var(--color-accent-2-600)"></i> Zkus to vysvětlit</button>
                    <button class="more-item"><i data-lucide="table-2" style="color:var(--color-accent-2-600)"></i> Porovnat s…</button>
                    <button class="more-item"><i data-lucide="list-ordered" style="color:var(--color-accent-2-600)"></i> Krok za krokem</button>
                    <div style="grid-column:1/-1; height:1px; background:var(--color-divider); margin:var(--space-1) 0"></div>
                    <button class="more-item"><i data-lucide="printer"></i> Vytisknout (PDF)</button>
                    <button class="more-item"><i data-lucide="file-text"></i> Tahák (PDF)</button>
                    <button class="more-item"><i data-lucide="alarm-clock"></i> Pomodoro</button>
                    <button class="more-item"><i data-lucide="notebook-pen"></i> Poznámky</button>
                </div>
            }

            <div id="article-prose" class="@ProseClass">
                @if (_currentVersion != null)
                {
                    <MarkdownContent Content="@_currentVersion.Content"
                                     AllPosts="@_allPosts"
                                     AllPeople="@_allPeople"
                                     OnHeadingsExtracted="OnHeadingsExtracted" />
                }
            </div>

            <button class="facts-toggle" @onclick="ToggleFacts">
                <span><i data-lucide="lightbulb" style="color:var(--color-accent-600)"></i> Věděl jsi, že…?</span>
                <i data-lucide="@(_factsOpen ? "chevron-up" : "chevron-down")"></i>
            </button>
            @if (_factsOpen)
            {
                <div class="facts-panel">
                    @if (_factsLoading)
                    {
                        <div class="skeleton" style="height:16px; width:80%"></div>
                        <div class="skeleton" style="height:16px; width:60%; margin-top:8px"></div>
                    }
                    else if (_factsError != null)
                    {
                        <span style="color:var(--color-neutral-600)">@_factsError</span>
                    }
                    else
                    {
                        <ul>
                            @foreach (var fact in _facts)
                            {
                                <li><span class="facts-bullet">✳</span> @fact</li>
                            }
                        </ul>
                    }
                </div>
            }

            @if (_exercises.Count > 0)
            {
                <div id="exercises-section" style="margin-top:var(--space-8)">
                    <div style="display:flex; align-items:center; justify-content:space-between; gap:var(--space-3); margin-bottom:var(--space-3)">
                        <h2 style="font-size:27px; margin:0"><i data-lucide="puzzle" style="color:var(--color-accent-2-600)"></i> Interaktivní cvičení</h2>
                        <span style="font-size:13px; color:var(--color-neutral-600)">@CzechPlural.Of(_exercises.Count, "cvičení", "cvičení", "cvičení")</span>
                    </div>
                    <div class="exercise-grid">
                        @foreach (var ex in _exercises)
                        {
                            <button class="exercise-card @(_openExerciseId == ex.Id ? "active" : "")" @onclick="@(() => ToggleExercise(ex.Id))">
                                <span class="exercise-kind"><i data-lucide="@ExerciseTypeDisplay.Icon(ex.Type)"></i> @ExerciseTypeDisplay.Label(ex.Type)</span>
                                <span class="exercise-title">@ex.Title</span>
                                @if (!string.IsNullOrWhiteSpace(ex.InstructionsMarkdown))
                                {
                                    <span class="exercise-desc">@ex.InstructionsMarkdown</span>
                                }
                            </button>
                        }
                    </div>
                    @if (_openExercise != null)
                    {
                        <div style="margin-top:var(--space-4)">
                            @if (_openExercise.Type == ExerciseTypeConstants.DragDrop)
                            {
                                <DragDropExercise Exercise="_openExercise" />
                            }
                            else if (_openExercise.Type == ExerciseTypeConstants.Matching)
                            {
                                <MatchingExercise Exercise="_openExercise" />
                            }
                            else if (_openExercise.Type == ExerciseTypeConstants.Timeline)
                            {
                                <TimelineExercise Exercise="_openExercise" />
                            }
                            else if (_openExercise.Type == ExerciseTypeConstants.Circuit)
                            {
                                <CircuitSimulator Exercise="_openExercise" />
                            }
                        </div>
                    }
                </div>
            }

            @if (_questions.Count > 0)
            {
                <div id="quiz-section" style="margin-top:var(--space-8)">
                    <h2 style="font-size:28px; margin-bottom:var(--space-4)">Ověř si porozumění</h2>
                    <a href="/practice/quiz/@_post.Id" class="pill pill-on" style="font-size:15px; padding:11px 22px">
                        Spustit kvíz (@CzechPlural.Otazky(_questions.Count)) <i data-lucide="arrow-right"></i>
                    </a>
                </div>
            }

            <div class="ai-ask-panel">
                <div class="ai-ask-header">
                    <span><i data-lucide="sparkles" style="color:var(--color-accent-600)"></i> Zeptej se na článek</span>
                    @if (_userId.HasValue)
                    {
                        <span class="grade-chip"><i data-lucide="coins"></i> @CzechPlural.Kredity(_credits)</span>
                    }
                </div>
                <AiChatBox PostId="@_post.Id"
                           EmptyTitle="Zeptej se na cokoliv z tohoto článku."
                           Placeholder="Např. Proč se neshodný přívlastek neskloňuje?"
                           Suggestions="@(new[] { "Vysvětli jednodušeji", "Dej mi tři příklady", "Zkoušej mě" })"
                           OnAnswered="OnAiAnswered" />
            </div>

            @if (_displayRelated.Count > 0)
            {
                <div style="margin-top:var(--space-8)">
                    <h2 style="font-size:26px; margin-bottom:var(--space-4)">Souvisí s tímto</h2>
                    <div class="related-grid">
                        @foreach (var rel in _displayRelated)
                        {
                            <a href="/post/@rel.PostId" class="related-card lift">
                                <span class="related-title">@rel.Title</span>
                                @if (!string.IsNullOrEmpty(rel.Text))
                                {
                                    <span class="related-desc">@rel.Text</span>
                                }
                            </a>
                        }
                    </div>
                </div>
            }

            <div style="margin-top:var(--space-8)">
                <div class="panel-label" style="margin-bottom:var(--space-3)">Jak těžký je tento článek?</div>
                @if (_myDifficultyVote.HasValue)
                {
                    <div style="display:flex; flex-direction:column; gap:var(--space-2); max-width:360px">
                        @foreach (var (label, value) in new[] { ("Snadné", 1), ("Střední", 2), ("Těžké", 3) })
                        {
                            <div style="display:flex; align-items:center; gap:var(--space-3)">
                                <span style="width:60px; font-size:13px; @(value == _myDifficultyVote ? "font-weight:700" : "")">@label</span>
                                <div class="progress-bar" style="flex:1"><div class="progress-bar-fill" style="width:@(DifficultyPercent(value))%"></div></div>
                                <span style="width:36px; font-size:13px; text-align:right; color:var(--color-neutral-600)">@(DifficultyPercent(value))%</span>
                            </div>
                        }
                    </div>
                    <div style="font-size:13px; color:var(--color-neutral-600); margin-top:var(--space-2)">
                        Děkujeme za hodnocení · @CzechPlural.Hlasy(_difficulty?.Total ?? 0)
                    </div>
                }
                else
                {
                    <div style="display:flex; gap:var(--space-2)">
                        <button class="pill" disabled="@_votingDifficulty" @onclick="@(() => RateDifficulty(1))">Snadné</button>
                        <button class="pill" disabled="@_votingDifficulty" @onclick="@(() => RateDifficulty(2))">Střední</button>
                        <button class="pill" disabled="@_votingDifficulty" @onclick="@(() => RateDifficulty(3))">Těžké</button>
                    </div>
                }
            </div>
        </div>

        <aside class="post-toc">
            @if (_tocHeaders.Count > 0)
            {
                <div class="panel-label" style="margin-bottom:var(--space-1)">Obsah</div>
                @foreach (var (text, anchor) in _tocHeaders)
                {
                    <a href="#@anchor" class="toc-link @(anchor == _activeAnchor ? "active" : "")"
                       @onclick="@(() => ScrollToHeading(anchor))" @onclick:preventDefault="true">@text</a>
                }
            }
            <div class="toc-progress">
                <div class="panel-label" style="margin-bottom:6px">Přečteno</div>
                <div class="progress-bar"><div class="progress-bar-fill" style="width:@(_readPercent)%"></div></div>
                <div style="font-size:13px; color:var(--color-neutral-600); margin-top:8px">@(_readPercent) %</div>
            </div>
        </aside>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public string? Slug { get; set; }
    [SupplyParameterFromQuery] public int? Exercise { get; set; }

    private bool _loading = true;
    private PostResponse? _post;
    private PostVersionResponse? _currentVersion;
    private List<PostVersionResponse> _versions = [];
    private List<CategoryResponse> _ancestors = [];
    private List<RelatedPostResponse> _relatedPosts = [];
    private List<DisplayRelatedPost> _displayRelated = [];
    private record DisplayRelatedPost(int PostId, string Title, string? Text);
    private List<QuestionResponse> _questions = [];
    private List<PostSummaryResponse> _allPosts = [];
    private List<PersonSummaryResponse> _allPeople = [];
    private List<InteractiveExerciseResponse> _exercises = [];
    private bool _versionsOpen, _readingOpen, _moreOpen, _factsOpen, _bookmarked;
    private string _readingFont = "figtree";
    private string _readingSize = "md";
    private string _readingWidth = "mid";
    private PostDifficultyResponse? _difficulty;
    private int? _myDifficultyVote;
    private bool _votingDifficulty;
    private bool _needsDifficultyCheck;
    private List<(string Text, string Anchor)> _tocHeaders = [];
    private string? _activeAnchor;
    private int _readPercent;
    private int _lastPersistedPercent = -1;
    private int? _userId;
    private int _credits;
    private bool _needsScrollInit;
    private DotNetObjectReference<PostDetail>? _selfRef;
    private List<string> _facts = [];
    private bool _factsLoading;
    private bool _factsLoaded;
    private string? _factsError;
    private int? _openExerciseId;
    private bool _needsExerciseScroll;

    private InteractiveExerciseResponse? _openExercise =>
        _exercises.FirstOrDefault(e => e.Id == _openExerciseId);

    // Blazor reuses this component instance across route-parameter changes, so navigating
    // again before a previous load finishes would otherwise run two loads concurrently
    // against the same circuit-scoped DbContext. Serialize loads and drop superseded ones.
    private readonly SemaphoreSlim _loadGate = new(1, 1);
    private int _loadGeneration;
    private bool _disposed;

    protected override async Task OnParametersSetAsync()
    {
        var myGeneration = ++_loadGeneration;
        try
        {
            await _loadGate.WaitAsync();
            try
            {
                if (myGeneration != _loadGeneration) return;
                _loading = true;
                await LoadData();
                if (myGeneration != _loadGeneration) return;
                _loading = false;
            }
            finally
            {
                _loadGate.Release();
            }
        }
        catch (Exception) when (_disposed)
        {
        }
    }

    private async Task LoadData()
    {
        // Load by int ID or slug
        PostResponse? post = null;
        if (Id > 0)
            post = await PostService.GetById(Id);
        else if (!string.IsNullOrEmpty(Slug) && int.TryParse(Slug, out int parsedId))
            post = await PostService.GetById(parsedId);

        if (post == null) return;
        _post = post;
        _versions = _post.Versions ?? [];
        _currentVersion = _versions.FirstOrDefault();

        var allCats = await CategoryService.GetAll();
        if (_post.CategoryId.HasValue)
            _ancestors = await CategoryService.GetAncestors(_post.CategoryId.Value);

        _relatedPosts = await RelatedPostService.GetByPostId(_post.Id);
        _questions = await QuestionService.GetByPostId(_post.Id);
        _allPosts = await PostService.GetSummaries();
        _exercises = await ExerciseService.GetByPostIdAsync(_post.Id);
        _openExerciseId = Exercise.HasValue && _exercises.Any(e => e.Id == Exercise.Value) ? Exercise.Value : null;
        _needsExerciseScroll = _openExerciseId.HasValue;

        await BuildDisplayRelated();

        _activeAnchor = null;
        _readPercent = 0;
        _lastPersistedPercent = -1;
        _needsScrollInit = true;
        _facts = [];
        _factsLoaded = false;
        _factsOpen = false;
        _factsError = null;

        _myDifficultyVote = null;
        _votingDifficulty = false;
        _needsDifficultyCheck = true;
        try { _difficulty = await AnonymApi.GetPostDifficulty(_post.Id); }
        catch { _difficulty = null; }

        var auth = await AuthState.GetAuthenticationStateAsync();
        if (auth.User.Identity?.IsAuthenticated == true &&
            int.TryParse(auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out int uid))
        {
            _userId = uid;
            var bookmarkIds = await UserProgressService.GetBookmarkIdsAsync(uid);
            _bookmarked = bookmarkIds.Contains(_post.Id);
            _credits = (await UserService.GetByIdAsync(uid))?.Credits ?? 0;
        }
        else
        {
            _userId = null;
        }


        // Fire-and-forget: person mentions are a progressive enhancement, don't block the render.
        _ = DetectPersonMentions(_loadGeneration);
    }

    private async Task DetectPersonMentions(int generation)
    {
        var content = _currentVersion?.Content;
        if (string.IsNullOrWhiteSpace(content))
        {
            _allPeople = [];
            return;
        }

        List<string> names;
        try
        {
            var deviceId = await JS.InvokeAsync<string>("getDeviceId");
            var auth = await AuthState.GetAuthenticationStateAsync();
            var decision = await UsageGuard.TryConsumeAsync(auth.User, $"device:{deviceId}");
            names = decision.Allowed ? await AiService.DetectPeopleInTextAsync(content) : [];
        }
        catch
        {
            names = [];
        }

        if (generation != _loadGeneration || _disposed) return;
        _allPeople = names.Select(n => new PersonSummaryResponse { Name = n }).ToList();
        try { await InvokeAsync(StateHasChanged); } catch (Exception) when (_disposed) { }
    }

    // "Souvisí s tímto" always aims for up to 6 entries: manually curated RelatedPosts first,
    // then AI-picked posts from the same category with a one-sentence connection (cached
    // server-side), and finally a plain category fallback if AI is unavailable/exhausted.
    private const int RelatedTarget = 6;

    private async Task BuildDisplayRelated()
    {
        if (_post == null) { _displayRelated = []; return; }

        var display = _relatedPosts
            .Select(r => new DisplayRelatedPost(r.RelatedPostId, r.RelatedPostTitle ?? "", r.Text))
            .Take(RelatedTarget)
            .ToList();

        var usedIds = new HashSet<int>(display.Select(d => d.PostId)) { _post.Id };
        var needed = RelatedTarget - display.Count;

        if (needed > 0 && _post.CategoryId.HasValue)
        {
            List<RelatedSuggestionItem> aiItems = [];
            try { aiItems = (await AnonymApi.GetRelatedSuggestions(_post.Id, needed)).Items; }
            catch { /* AI suggestions are a best-effort enhancement; fall back below */ }

            foreach (var item in aiItems)
            {
                if (needed <= 0) break;
                if (usedIds.Contains(item.PostId)) continue;
                var summary = _allPosts.FirstOrDefault(p => p.Id == item.PostId);
                if (summary == null) continue;

                display.Add(new DisplayRelatedPost(item.PostId, summary.Title, item.Text));
                usedIds.Add(item.PostId);
                needed--;
            }

            if (needed > 0)
            {
                var fallback = _allPosts
                    .Where(p => p.CategoryId == _post.CategoryId && !usedIds.Contains(p.Id))
                    .Take(needed);
                foreach (var p in fallback)
                {
                    display.Add(new DisplayRelatedPost(p.Id, p.Title, null));
                    usedIds.Add(p.Id);
                }
            }
        }

        _displayRelated = display;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("initLucide");

        if (_needsScrollInit && _currentVersion != null)
        {
            _needsScrollInit = false;
            _selfRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("initReadingProgress", _selfRef, "#article-prose");
        }

        if (_needsExerciseScroll && _exercises.Count > 0)
        {
            _needsExerciseScroll = false;
            await JS.InvokeVoidAsync("scrollToId", "exercises-section");
        }

        if (_needsDifficultyCheck && _post != null)
        {
            _needsDifficultyCheck = false;
            var stored = await JS.InvokeAsync<string?>("getDifficultyVote", _post.Id);
            if (int.TryParse(stored, out var vote))
            {
                _myDifficultyVote = vote;
                StateHasChanged();
            }
        }
    }

    private void OnHeadingsExtracted(List<(string Text, string Anchor)> headings)
    {
        _tocHeaders = headings;
        StateHasChanged();
    }

    // A plain href="#id" would resolve against <base href="/"> and navigate to "/#id"
    // (home) instead of scrolling the current page, so ToC links scroll via JS instead.
    private async Task ScrollToHeading(string anchor) => await JS.InvokeVoidAsync("scrollToId", anchor);

    [JSInvokable]
    public async Task OnReadingProgress(string? activeAnchor, int percent)
    {
        if (_disposed) return;
        try
        {
            _activeAnchor = activeAnchor;
            _readPercent = percent;
            StateHasChanged();

            if (_userId.HasValue && _post != null && percent >= _lastPersistedPercent + 5)
            {
                _lastPersistedPercent = percent;
                await UserProgressService.UpsertReadProgressAsync(_userId.Value, _post.Id, percent);
            }
        }
        catch (Exception) when (_disposed)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try { await JS.InvokeVoidAsync("disposeReadingProgress"); } catch { }
        _selfRef?.Dispose();
        _loadGate.Dispose();
    }

    private void SelectVersion(PostVersionResponse v)
    {
        _currentVersion = v;
        _versionsOpen = false;
        _needsScrollInit = true;
        _activeAnchor = null;
        _readPercent = 0;
        _lastPersistedPercent = -1;
        _allPeople = [];
        _ = DetectPersonMentions(_loadGeneration);
    }

    private void ToggleVersions() => _versionsOpen = !_versionsOpen;
    private void ToggleReading() => _readingOpen = !_readingOpen;
    private void ToggleMore() => _moreOpen = !_moreOpen;

    private async Task OnAiAnswered(string _)
    {
        if (_userId is not { } uid) return;
        _credits = (await UserService.GetByIdAsync(uid))?.Credits ?? 0;
        StateHasChanged();
    }

    private async Task ToggleBookmark()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        if (!auth.User.Identity?.IsAuthenticated == true || _post == null) return;
        if (!int.TryParse(auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out int uid)) return;

        if (_bookmarked)
            await UserProgressService.RemoveBookmarkAsync(uid, _post.Id);
        else
            await UserProgressService.AddBookmarkAsync(uid, _post.Id);
        _bookmarked = !_bookmarked;
    }

    private async Task RateDifficulty(int rating)
    {
        if (_post == null || _myDifficultyVote.HasValue || _votingDifficulty) return;
        _votingDifficulty = true;
        try
        {
            var deviceId = await JS.InvokeAsync<string>("getDeviceId");
            var result = await AnonymApi.RateDifficulty(_post.Id, new DifficultyRatingRequest { Rating = rating, DeviceId = deviceId });
            _myDifficultyVote = rating;
            await JS.InvokeVoidAsync("setDifficultyVote", _post.Id, rating);
            if (result.Message == "ok")
                _difficulty = await AnonymApi.GetPostDifficulty(_post.Id);
        }
        catch { /* best-effort; buttons just stay clickable again below */ }
        finally { _votingDifficulty = false; }
    }

    private int DifficultyPercent(int rating)
    {
        if (_difficulty == null || _difficulty.Total == 0) return 0;
        var count = rating switch { 1 => _difficulty.Easy, 2 => _difficulty.Ok, 3 => _difficulty.Hard, _ => 0 };
        return (int)Math.Round(count * 100.0 / _difficulty.Total);
    }

    private void ScrollToQuiz() => Nav.NavigateTo($"/practice/quiz/{_post?.Id}");

    private async Task ScrollToExercises()
    {
        if (_exercises.Count == 0) return;
        await JS.InvokeVoidAsync("scrollToId", "exercises-section");
    }

    private void ToggleExercise(int id) => _openExerciseId = _openExerciseId == id ? null : id;

    private async Task ToggleFacts()
    {
        _factsOpen = !_factsOpen;
        if (_factsOpen && !_factsLoaded && _post != null)
        {
            _factsLoading = true;
            try
            {
                var response = await AnonymApi.GetFunFacts(_post.Id);
                _facts = response.Facts;
                _factsLoaded = true;
            }
            catch
            {
                _factsError = "Zajímavosti se nepodařilo načíst. Zkus to prosím znovu později.";
            }
            finally
            {
                _factsLoading = false;
            }
        }
    }

    private int WordCount => _currentVersion == null ? 0 : _currentVersion.Content.Split(' ').Length;
    private int ReadTime => Math.Max(1, WordCount / 200);

    private string ProseClass
    {
        get
        {
            var parts = new List<string>();
            if (_readingFont == "serif") parts.Add("prose-serif");
            if (_readingFont == "mono") parts.Add("prose-mono");
            if (_readingSize == "sm") parts.Add("prose-sm");
            if (_readingSize == "lg") parts.Add("prose-lg");
            if (_readingWidth == "narrow") parts.Add("prose-narrow");
            if (_readingWidth == "wide") parts.Add("prose-wide");
            return string.Join(" ", parts);
        }
    }

    private DateTime? MostRecentEdit
    {
        get
        {
            var edit = _currentVersion?.LastEdit;
            var fix = _currentVersion?.LastFix;
            if (edit == null) return fix;
            if (fix == null) return edit;
            return edit >= fix ? edit : fix;
        }
    }

    private static string FormatDateTime(DateTime? dt) => dt.HasValue ? dt.Value.ToString("d. M. yyyy 'v' HH:mm") : "";

    [Inject] private IJSRuntime JS { get; set; } = null!;
}
