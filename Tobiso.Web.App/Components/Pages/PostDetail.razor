    private async Task ChangeFontSize(int delta)
    {
        _readingFontSizeStep = Math.Clamp(_readingFontSizeStep + delta, 0, _fontSizes.Length - 1);
        try { await Js.InvokeVoidAsync("localStorage.setItem", "readingFontSizeStep", _readingFontSizeStep.ToString()); } catch { }
        await ApplyReadingStylesAsync();
        StateHasChanged();
    }

    private async Task SetLineWidth(int step)
    {
        _readingLineWidthStep = Math.Clamp(step, 0, _lineWidths.Length - 1);
        try { await Js.InvokeVoidAsync("localStorage.setItem", "readingLineWidthStep", _readingLineWidthStep.ToString()); } catch { }
        await ApplyReadingStylesAsync();
        StateHasChanged();
    }

    private async Task ApplyReadingStylesAsync()
    {
        try
        {
            var font = _readingFont ?? string.Empty;
            var size = _fontSizes[Math.Clamp(_readingFontSizeStep, 0, _fontSizes.Length - 1)];
            var width = _lineWidths[Math.Clamp(_readingLineWidthStep, 0, _lineWidths.Length - 1)];
            var fontJs = System.Text.Json.JsonSerializer.Serialize(font);
            var widthJs = System.Text.Json.JsonSerializer.Serialize(width);
            // Simpler script: only set inline styles on the container element (#content).
            // We rely on CSS `inherit` for descendant font-size/family so this is robust
            // and avoids complex brace-escaping in interpolated verbatim strings.
            var script = $@"(function(){{
                var el = document.getElementById('content');
                if(!el) return;
                try {{
                    if({fontJs} !== "") el.style.setProperty('font-family', {fontJs}, 'important'); else el.style.setProperty('font-family', getComputedStyle(document.documentElement).getPropertyValue('--font-family-serif'), 'important');
                    el.style.setProperty('font-size', '{size}px', 'important');
                    if({widthJs} !== "") {{ el.style.setProperty('max-width', {widthJs}, 'important'); el.style.setProperty('margin-left', 'auto', 'important'); el.style.setProperty('margin-right', 'auto', 'important'); }} else {{ el.style.removeProperty('max-width'); el.style.removeProperty('margin-left'); el.style.removeProperty('margin-right'); }}
                }} catch(e) {{ console && console.log && console.log(e); }}
            }})();";
            await Js.InvokeVoidAsync("eval", script);
        }
        catch { /* ignore */ }
    }

    private async Task ToggleFocusMode()
    {
        _isFocusMode = !_isFocusMode;
        var script = _isFocusMode
            ? "document.body.classList.add('focus-mode'); try{ if(!document.fullscreenElement && document.documentElement.requestFullscreen){ document.documentElement.requestFullscreen(); } }catch(e){}"
            : "document.body.classList.remove('focus-mode'); try{ if(document.fullscreenElement && document.exitFullscreen){ document.exitFullscreen(); } }catch(e){}";
        await Js.InvokeVoidAsync("eval", script);
        StateHasChanged();
    }

    [JSInvokable]
    public Task OnExternalFullscreenExit()
    {
        if (_isFocusMode)
        {
            _isFocusMode = false;
            StateHasChanged();
