@page "/post/{Id:int}"
@using System.Text.RegularExpressions
@using Tobiso.Web.Shared.DTOs
@using Tobiso.Web.Shared.Interfaces
@using Microsoft.JSInterop
@using Tobiso.Web.App.Services
@inject ITobisoAnonymApi Api
@inject ITobisoWebApi WebApi
@inject IJSRuntime Js
@inject NavigationManager Navigation
@inject System.Net.Http.HttpClient Http
@inject AddendumModalService ModalService
@rendermode InteractiveServer
@implements IDisposable
<PageTitle>@(_post?.Title ?? "Blogový post") - Tobiso</PageTitle>
<style>
    section img {
        max-width: 16rem;
        max-height: 20rem;
        background-color: white;
    }
    .content {
        text-align: left;
    }
    .ribbon-6 {
        display: none;
    }
    .addendum-btn {
        margin: 0 4px;
        cursor: pointer;
    }
    /* Dotted underline for semantic headings (matching .verybig decoration style) */
h1,
h2,
h3,
h4,
h5,
h6 {
    text-decoration-line: underline;
    text-decoration-style: dotted;
    text-decoration-color: var(--color-accent-3);
    text-decoration-thickness: 3px;
    text-underline-offset: 9px;
    transition: text-decoration-color 0.2s ease;
}

/* Dark mode variant for headings */
body.dark-mode h1,
body.dark-mode h2,
body.dark-mode h3,
body.dark-mode h4,
body.dark-mode h5,
body.dark-mode h6 {
    text-decoration-color: var(--color-accent-3-dark);
}
.related-posts-div h5,
.intro h3 {
    text-decoration: none;
}
body.focus-mode .sidebar,
body.focus-mode .decorative-ribbons,
body.focus-mode .snowflake,
body.focus-mode footer  {
    display: none;
}
body.focus-mode main {
    margin: 0;
}
body.focus-mode .loading-bar-container {
    margin-left: 0;
    width: 100%;
}
body.focus-mode section {
    max-width: 1000px;
}

</style>
@if (_post == null)
{
    <p>Načítám...</p>
}
else
{
    <h1 class="verybig">@_post.Title</h1>
    
    @if (_breadcrumbCategories != null && _breadcrumbCategories.Any())
    {
        <nav class="breadcrumb-nav" aria-label="Breadcrumb">
            @foreach (var category in _breadcrumbCategories)
            {
                <a href="/categories/@category.Id">@category.Name</a>
                <span class="separator">></span>
            }
            <span class="current">@_post.Title</span>
        </nav>
    }
    
    <div class="tools">
        <div class="tool">
            @if (_post.UpdatedAt.HasValue)
            {
                <span>@_post.UpdatedAt.Value.ToString("d. M. yyyy")</span>
            }
        </div>
        <div class="tool">
            <button class="btn btn-secondary mb-3" title="Zpět" @onclick="BackHistory"><i class="bi bi-arrow-left"></i></button>
            @if (_hasQuestions)
            {
                <button class="btn btn-secondary mb-3" title="Prověrka" style="float: right" @onclick="ToQuestions"><i class="bi bi-person-walking"></i></button>
            }
            <button class="btn btn-secondary mb-3" title="Režim soustředění" @onclick="ToggleFocusMode">
                <i class="bi @(_isFocusMode ? "bi-fullscreen-exit" : "bi-arrows-fullscreen")"></i>
            </button>
            <button class="btn btn-secondary mb-3" title="Sdílet článek" @onclick="SharePost">
                <i class="bi @(_isShared ? "bi-check-lg" : "bi-share")"></i>
            </button>
            <button title="Vytisknout článek (PDF)" @onclick="GeneratePdf"><i class="bi bi-printer"></i></button>
        </div>
        <div class="tool">
            <span>@((MarkupString)GetWordCountInfo(_post.Content))</span>
        </div>
    </div>
    <div class="mb-4">
        @* Wrap rendered content in a container with class/id `content` so JS selector finds it *@
        <div id="content" class="content">
            @if (_fileSuffix == ".md")
            {
                @((MarkupString)TransformMarkdownContent(_post.Content))
            }
            else if (_fileSuffix == ".html")
            {
                @((MarkupString)(_post.Content))
            }
            else
            {
                @((MarkupString)(_post.Content))
            }
        </div>
    </div>
    <div class="tools">
        <div class="tool">
            @if (_post.UpdatedAt.HasValue)
            {
                <span>@_post.UpdatedAt.Value.ToString("d. M. yyyy")</span>
            }
        </div>
        <div class="tool">
            <button class="btn btn-secondary mb-3" title="Zpět" @onclick="BackHistory"><i class="bi bi-arrow-left"></i></button>
            @if (_hasQuestions)
            {
                <button class="btn btn-secondary mb-3" title="Prověrka" style="float: right" @onclick="ToQuestions"><i class="bi bi-person-walking"></i></button>
            }
            <button class="btn btn-secondary mb-3" title="Režim soustředění" @onclick="ToggleFocusMode">
                <i class="bi @(_isFocusMode ? "bi-fullscreen-exit" : "bi-arrows-fullscreen")"></i>
            </button>
            <button class="btn btn-secondary mb-3" title="Sdílet článek" @onclick="SharePost">
                <i class="bi @(_isShared ? "bi-check-lg" : "bi-share")"></i>
            </button>
            <button title="Vytisknout článek (PDF)" @onclick="GeneratePdf"><i class="bi bi-printer"></i></button>
        </div>
        <div class="tool">
            <span>@((MarkupString)GetWordCountInfo(_post.Content))</span>
        </div>
    </div>
    @if (_relatedPosts != null && _relatedPosts.Any())
    {
        <div class="intro related-posts">
            <h3 style="margin: 0">
                Související články
            </h3>

            <div class="">
                @foreach (var relatedPost in _relatedPosts)
                {
                    var relatedPostData = _allPosts?.FirstOrDefault(p => p.Id == relatedPost.RelatedPostId);
                    if (relatedPostData != null)
                    {
                        <a href="/post/@relatedPost.RelatedPostId">
                        <div class="related-posts-div">
                        
                            <h5 >
                                @relatedPostData.Title
                            </h5>
                            @if (!string.IsNullOrEmpty(relatedPost.Text))
                            {
                                <span class="related-posts-text">
                                    @relatedPost.Text
                                </span>
                            }
                        </div>
                        </a>
                    }
                }
            </div>
        </div>
    }
}

<AddendumModal IsVisible="@_showAddendumModal" IsVisibleChanged="@OnAddendumModalClose" AddendumId="@_selectedAddendumId" />

@* Hidden area for addendum buttons - rendered but not visible *@
<div style="display:none;">
    @foreach (var addendumId in _addendumIds)
    {
        <AddendumButton AddendumId="@addendumId" />
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }
    private PostResponse? _post;
    private List<PostResponse>? _allPosts;
    private List<RelatedPostResponse>? _relatedPosts;
    private List<CategoryResponse>? _allCategories;
    private List<CategoryResponse>? _breadcrumbCategories;
    private string? _returnUrl;
    private string? _fileSuffix;
    private bool _hasQuestions = false;
    private bool _isShared = false;
    private bool _showAddendumModal = false;
    private int? _selectedAddendumId = null;
    private DotNetObjectReference<PostDetail>? _dotNetRef;
    private List<int> _addendumIds = new();
    private bool _isFocusMode = false;

    protected override async Task OnInitializedAsync()
    {
        _post = await Api.GetPostById(Id);
        _allPosts = (await Api.GetAllPosts()).ToList();
        _allCategories = await Api.GetAllCategories();
        BuildBreadcrumb();
        SetFileSuffix();
        await CheckForQuestions();
        await LoadRelatedPosts();
    }

    protected override async Task OnParametersSetAsync()
    {
        var uri = new Uri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        _returnUrl = query.TryGetValue("returnUrl", out var val) ? val.ToString() : null;
        _post = await Api.GetPostById(Id);
        _allPosts = (await Api.GetAllPosts()).ToList();
        _allCategories = await Api.GetAllCategories();
        BuildBreadcrumb();
        SetFileSuffix();
        await CheckForQuestions();
        await LoadRelatedPosts();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await Js.InvokeVoidAsync("eval", @"
                window.requestAddendum = function(addendumId) {
                    DotNet.invokeMethodAsync('Tobiso.Web.App', 'TriggerAddendum', addendumId);
                };
                // Initialize instance bridge and fullscreen listener
                window.__initPostDetail = function(dotnet){
                    window.__postDetailRef = dotnet;
                    document.addEventListener('fullscreenchange', function(){
                        if (!document.fullscreenElement && window.__postDetailRef) {
                            // Ensure our custom focus styles are also removed
                            try{ document.body.classList.remove('focus-mode'); }catch(e){}
                            window.__postDetailRef.invokeMethodAsync('OnExternalFullscreenExit');
                        }
                    });
                    // Also react to ESC directly to clear our styles
                    document.addEventListener('keydown', function(e){
                        if (e && (e.key === 'Escape' || e.code === 'Escape')) {
                            if (document.body.classList.contains('focus-mode')) {
                                try{ document.body.classList.remove('focus-mode'); }catch(_){}
                                if (window.__postDetailRef) {
                                    window.__postDetailRef.invokeMethodAsync('OnExternalFullscreenExit');
                                }
                            }
                        }
                    });
                };
            ");
            // Pass DotNet object reference to JS to enable instance callbacks
            await Js.InvokeVoidAsync("__initPostDetail", _dotNetRef);
        }
    }

    [JSInvokable("TriggerAddendum")]
    public static void TriggerAddendum(int addendumId)
    {
        AddendumModalService.TriggerGlobalRequest(addendumId);
    }
    
    protected override void OnInitialized()
    {
        AddendumModalService.OnGlobalAddendumRequested += HandleAddendumRequest;
        ModalService.OnAddendumRequested += HandleAddendumRequest;
    }
    
    private void HandleAddendumRequest(int addendumId)
    {
        OpenAddendumModal(addendumId);
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AddendumModalService.OnGlobalAddendumRequested -= HandleAddendumRequest;
        ModalService.OnAddendumRequested -= HandleAddendumRequest;
        _dotNetRef?.Dispose();
    }

    private async Task ToggleFocusMode()
    {
        _isFocusMode = !_isFocusMode;
        var script = _isFocusMode
            ? "document.body.classList.add('focus-mode'); try{ if(!document.fullscreenElement && document.documentElement.requestFullscreen){ document.documentElement.requestFullscreen(); } }catch(e){}"
            : "document.body.classList.remove('focus-mode'); try{ if(document.fullscreenElement && document.exitFullscreen){ document.exitFullscreen(); } }catch(e){}";
        await Js.InvokeVoidAsync("eval", script);
        StateHasChanged();
    }

    [JSInvokable]
    public Task OnExternalFullscreenExit()
    {
        if (_isFocusMode)
        {
            _isFocusMode = false;
            StateHasChanged();
        }
        return Task.CompletedTask;
    }

    private void SetFileSuffix()
    {
        if (_post != null && !string.IsNullOrEmpty(_post.FilePath))
        {
            if (_post.FilePath.EndsWith(".md", StringComparison.OrdinalIgnoreCase))
                _fileSuffix = ".md";
            else if (_post.FilePath.EndsWith(".html", StringComparison.OrdinalIgnoreCase))
                _fileSuffix = ".html";
            else
                _fileSuffix = null;
        }
        else
        {
            _fileSuffix = null;
        }
    }

    private async Task CheckForQuestions()
    {
        try
        {
            if (_post?.Id != null)
            {
                var questions = await Api.GetQuestionsByPostId(_post.Id);
                _hasQuestions = questions?.Any() == true;
            }
        }
        catch (Exception)
        {
            _hasQuestions = false;
        }
    }

    private async Task LoadRelatedPosts()
    {
        try
        {
            if (_post?.Id != null)
            {
                _relatedPosts = (await Api.GetRelatedPostsByPostId(_post.Id)).ToList();
                
                // Přidat články ze stejné kategorie
                if (_post.CategoryId.HasValue && _allPosts != null)
                {
                    var categoryPosts = _allPosts
                        .Where(p => p.CategoryId == _post.CategoryId && p.Id != _post.Id)
                        .Take(5)
                        .Select(p => new RelatedPostResponse
                        {
                            PostId = _post.Id,
                            RelatedPostId = p.Id,
                            Text = "souvisí s tématem"
                        })
                        .ToList();
                    
                    // Vyfiltrovat články, které už jsou v _relatedPosts
                    var existingIds = _relatedPosts.Select(rp => rp.RelatedPostId).ToHashSet();
                    var newCategoryPosts = categoryPosts.Where(cp => !existingIds.Contains(cp.RelatedPostId)).ToList();
                    
                    _relatedPosts.AddRange(newCategoryPosts);
                }
            }
        }
        catch (Exception)
        {
            _relatedPosts = new List<RelatedPostResponse>();
        }
    }

    private void OpenAddendumModal(int addendumId)
    {
        _selectedAddendumId = addendumId;
        _showAddendumModal = true;
    }

    private void OnAddendumModalClose(bool isVisible)
    {
        _showAddendumModal = isVisible;
        if (!isVisible)
        {
            _selectedAddendumId = null;
        }
    }

    private string TransformMarkdownContent(string? content)
    {
        if (string.IsNullOrEmpty(content)) return string.Empty;
        // Pokud obsahuje Markdown-styl mailto odkazy, převedeme je na <a href="mailto:..."> před zpracováním,
        // protože někteří autoři mohou mít odkazy, které Markdig neparsuje (nebo obsah přijde již upravený).
        content = ReplaceMarkdownMailtoInText(content);
        
        var html = Markdig.Markdown.ToHtml(content);
        
        // Zpracování dodatků (--DOD-x--) PO konverzi na HTML
        _addendumIds.Clear();
        var addendumRegex = new Regex(@"\(--DOD-(\d+)--\)", RegexOptions.IgnoreCase);
        html = addendumRegex.Replace(html, match =>
        {
            var addendumId = int.Parse(match.Groups[1].Value);
            if (!_addendumIds.Contains(addendumId))
            {
                _addendumIds.Add(addendumId);
            }
            return $"<a class='addendum-btn' onclick='window.requestAddendum({addendumId})'><i class=\"bi bi-patch-question\"></i></a>";
        });
        
        // Oprav obrázky: přidej prefix k src u <img>
        var imgRegex = new Regex("<img\\s+[^>]*src=\\\"([^\\\"]+)\\\"", RegexOptions.IgnoreCase);
        html = imgRegex.Replace(html, match => {
            var origSrc = match.Groups[1].Value;
            if (origSrc.Contains("http")) return match.Value;
            if (origSrc.Contains("images"))
            {
                var fullSrc = origSrc.StartsWith("/") ? $"https://tobiso.com{origSrc}" : $"https://tobiso.com/{origSrc}";
                return match.Value.Replace(origSrc, fullSrc);
            }
            return match.Value;
        });
        
        // Zpracování odkazů
        var regex = new Regex("<a\\s+href=\\\"([^\\\"]+)\\\"(.*?)>(.*?)<\\/a>", RegexOptions.IgnoreCase);
        html = regex.Replace(html, match => {
            var origHref = match.Groups[1].Value;
            var attrs = match.Groups[2].Value;
            var linkText = match.Groups[3].Value;
            if (origHref.Contains("http"))
            {
                return $"<a href=\"{origHref}\" target=\"_blank\" rel=\"noopener noreferrer\"{attrs}>{linkText}</a>";
            }
            if (origHref.Contains("files"))
            {
                var fullUrl = origHref.StartsWith("/") ? $"https://tobiso.com{origHref}" : $"https://tobiso.com/{origHref}";
                return $"<a href=\"{fullUrl}\" target=\"_blank\" rel=\"noopener noreferrer\"{attrs}>{linkText}</a>";
            }
            if (origHref.StartsWith("mailto:", StringComparison.OrdinalIgnoreCase))
            {
                // Ensure mailto query parameters are URL-encoded (subjects, body, etc.)
                try
                {
                    var mailto = origHref.Substring("mailto:".Length);
                    var parts = mailto.Split('?', 2);
                    var address = parts[0] ?? "";
                    var encodedQuery = "";
                    if (parts.Length > 1 && !string.IsNullOrEmpty(parts[1]))
                    {
                        encodedQuery = string.Join("&",
                            parts[1].Split('&', StringSplitOptions.RemoveEmptyEntries)
                                .Select(p =>
                                {
                                    var kv = p.Split('=', 2);
                                    var k = kv[0];
                                    var v = kv.Length > 1 ? kv[1] : "";
                                    // Ensure value is properly encoded. If it is already encoded, Uri.EscapeDataString of UnescapeDataString keeps it safe.
                                    return $"{Uri.EscapeDataString(k)}={Uri.EscapeDataString(Uri.UnescapeDataString(v))}";
                                })
                        );
                    }
                    var href = "mailto:" + address + (string.IsNullOrEmpty(encodedQuery) ? "" : "?" + encodedQuery);
                    // Render a plain anchor with the encoded mailto href. Avoid JS onclick which can interfere in some environments.
                    return $"<a href=\"{href}\"{attrs}>{linkText}</a>";
                }
                catch
                {
                    // Fallback: render the original href if encoding fails for any reason
                    return $"<a href=\"{origHref}\"{attrs}>{linkText}</a>";
                }
            }
            var file = Regex.Replace(origHref, "^(ml-|l-|sl-|hv-|m-|ch-|f-|pr-|z-|li-|geo-)", "");
            file = file.Replace(".html", ".md");
            if (!file.StartsWith("/")) file = "/" + file;
            var postMatch = _allPosts?.FirstOrDefault(p => p.FilePath.EndsWith(file, StringComparison.OrdinalIgnoreCase));
            if (postMatch != null)
            {
                return $"<a href=\"/post/{postMatch.Id}\"{attrs}>{linkText}</a>";
            }
            return $"<span style=\"color:gray; text-decoration:line-through;\">{linkText}</span>";
        });
        
        // Zabal text v tečkách do divu s class intro
        var dotsRegex = new Regex(@"(\.\.\.\s*)(.*?)(\s*\.\.\.)", RegexOptions.Singleline);
        html = dotsRegex.Replace(html, m => $"<div class=\"intro\">{m.Groups[2].Value}</div>");
        var singleDotsRegex = new Regex(@"<p>\s*\.\.\.\s*<\/p>", RegexOptions.Singleline);
        html = singleDotsRegex.Replace(html, "");
        html = html.Replace("...", "");
        html = ConvertMarkdownTablesToHtml(html);
        return html;
    }

    private string ReplaceMarkdownMailtoInText(string input)
    {
        if (string.IsNullOrEmpty(input) || !input.Contains("mailto:", StringComparison.OrdinalIgnoreCase))
            return input ?? string.Empty;

        var mdMailtoRegex = new Regex(@"\[([^\]]+)\]\((mailto:([^\)\s]+)(\?[^\)]*)?)\)", RegexOptions.IgnoreCase);
        return mdMailtoRegex.Replace(input, match =>
        {
            try
            {
                var linkText = match.Groups[1].Value;
                var full = match.Groups[2].Value; // mailto:address?query
                var mailto = full.Substring("mailto:".Length);
                var parts = mailto.Split('?', 2);
                var address = parts[0] ?? "";
                var encodedQuery = "";
                if (parts.Length > 1 && !string.IsNullOrEmpty(parts[1]))
                {
                    encodedQuery = string.Join("&",
                        parts[1].Split('&', StringSplitOptions.RemoveEmptyEntries)
                            .Select(p =>
                            {
                                var kv = p.Split('=', 2);
                                var k = kv[0];
                                var v = kv.Length > 1 ? kv[1] : "";
                                return $"{Uri.EscapeDataString(k)}={Uri.EscapeDataString(Uri.UnescapeDataString(v))}";
                            })
                    );
                }
                var href = "mailto:" + address + (string.IsNullOrEmpty(encodedQuery) ? "" : "?" + encodedQuery);
                return $"<a href=\"{href}\">{linkText}</a>";
            }
            catch
            {
                return match.Value; // fallback to original
            }
        });
    }

    private string ConvertMarkdownTablesToHtml(string html)
    {
        // Tento vylepšený regex hledá <p> tag, který obsahuje text s pipe znaky (|) a <br> tagy,
        // což je typický výsledek, když Markdig nerozpozná Markdown tabulku.
        var tableRegex = new Regex(@"<p>(\s*\|.*(?:<br\s*/?>\s*\|.*)+)</p>", RegexOptions.Singleline);

        html = tableRegex.Replace(html, match =>
        {
            var tableContent = match.Groups[1].Value.Trim();

            // Rozdělíme obsah na jednotlivé řádky podle <br> tagů.
            var lines = Regex.Split(tableContent, @"<br\s*/?>")
                             .Select(l => l.Trim())
                             .Where(l => !string.IsNullOrEmpty(l) && l.Contains("|"))
                             .ToList();

            if (lines.Count < 2) return match.Value; // Není dost řádků pro záhlaví a tělo.

            // Najdeme oddělovací řádek (např. |---|---|).
            int separatorIndex = lines.FindIndex(line => Regex.IsMatch(line, @"^\|?(\s*:?-+:?\s*\|)+\s*:?-+:?\s*\|?$"));

            // Pokud oddělovač chybí nebo je hned na prvním řádku, není to standardní tabulka.
            if (separatorIndex < 1) return match.Value;

            var headerLine = lines[separatorIndex - 1];
            var bodyLines = lines.Skip(separatorIndex + 1).ToList();

            var headerCells = ParseConcatenatedRow(headerLine);

            var sb = new System.Text.StringBuilder();
            sb.Append("<table class=\"md-table\">");

            // --- ZÁHLAVÍ ---
            sb.Append("<thead><tr>");
            foreach (var cellContent in headerCells)
            {
                sb.Append($"<th>{cellContent}</th>");
            }
            sb.Append("</tr></thead>");

            // --- TĚLO TABULKY ---
            sb.Append("<tbody>");
            foreach (var bodyLine in bodyLines)
            {
                var bodyCells = ParseConcatenatedRow(bodyLine);
                sb.Append("<tr>");
                // Každý řádek má přesně tolik buněk jako záhlaví (přebytečné ignorujeme, chybějící doplníme prázdnými)
                for (int i = 0; i < headerCells.Count; i++)
                {
                    var cellContent = i < bodyCells.Count ? bodyCells[i] : "";
                    sb.Append($"<td>{cellContent}</td>");
                }
                sb.Append("</tr>");
            }
            sb.Append("</tbody></table>");

            return sb.ToString();
        });

        // Univerzální detekce tabulky v <p>...</p> (řádky oddělené \n nebo <br>)
        var universalTableRegex = new Regex(@"<p>((?:\|[^\n]+\n)+\|[^\n]+)</p>", RegexOptions.Singleline);
        html = universalTableRegex.Replace(html, match =>
        {
            var tableContent = match.Groups[1].Value.Trim();
            // Rozdělit na řádky podle \n nebo <br>
            var lines = Regex.Split(tableContent, @"\r?\n|<br\s*/?>")
                .Select(l => l.Trim())
                .Where(l => !string.IsNullOrEmpty(l) && l.Contains("|"))
                .ToList();
            if (lines.Count < 2) return match.Value;
            int separatorIndex = lines.FindIndex(line => Regex.IsMatch(line, @"^\|?([\-: ]+\|)+[\-: ]*\|?$"));
            if (separatorIndex < 1) return match.Value;
            var headerLine = lines[separatorIndex - 1];
            var bodyLines = lines.Skip(separatorIndex + 1).ToList();
            var headerCells = ParseConcatenatedRow(headerLine);
            var sb = new System.Text.StringBuilder();
            sb.Append("<table class=\"md-table\">");
            sb.Append("<thead><tr>");
            foreach (var cellContent in headerCells)
                sb.Append($"<th>{cellContent}</th>");
            sb.Append("</tr></thead>");
            sb.Append("<tbody>");
            foreach (var bodyLine in bodyLines)
            {
                var bodyCells = ParseConcatenatedRow(bodyLine);
                sb.Append("<tr>");
                for (int i = 0; i < headerCells.Count; i++)
                {
                    var cellContent = i < bodyCells.Count ? bodyCells[i] : "";
                    sb.Append($"<td>{cellContent}</td>");
                }
                sb.Append("</tr>");
            }
            sb.Append("</tbody></table>");
            return sb.ToString();
        });
        return html;
    }

    private List<string> ParseConcatenatedRow(string rowText)
    {
        // Odstraníme svislice na začátku a na konci řádku, ale neztrácíme prázdné buňky.
        var cleanRowText = rowText;
        if (cleanRowText.StartsWith("|")) cleanRowText = cleanRowText.Substring(1);
        if (cleanRowText.EndsWith("|")) cleanRowText = cleanRowText.Substring(0, cleanRowText.Length - 1);

        // Rozdělíme řádek na buňky podle svislic, zachováme prázdné buňky.
        return cleanRowText.Split('|', StringSplitOptions.None)
            .Select(s => s.Trim())
            .ToList();
    }
    
    private async Task BackHistory()
    {
        if (!string.IsNullOrEmpty(_returnUrl))
        {
            await Js.InvokeVoidAsync("eval", $"window.location.href='{_returnUrl}'");
        }
        else
        {
            Navigation.NavigateTo("/categories", forceLoad: true);
        }
    }
    private void ToQuestions()
    {
        Navigation.NavigateTo($"/questions/{Id}", forceLoad: true);
    }

    private async Task SharePost()
    {
        if (_post == null) return;
        
        var url = $"https://www.tobiso.com/post/{_post.Id}";
        await Js.InvokeVoidAsync("navigator.clipboard.writeText", url);
        _isShared = true;
        StateHasChanged();
        
        await Task.Delay(1000);
        _isShared = false;
        StateHasChanged();
    }

    private async Task GeneratePdf()
    {
        if (_post == null) return;

        // Prefer a simple GET that returns the PDF file so browser handles download (no JS interop needed)
        var title = _post.Title ?? "post";
        var safe = Regex.Replace(title.ToLowerInvariant(), "[^a-z0-9-_ ]", "");
        safe = Regex.Replace(safe, "\\s+", "_");
        var filename = $"{safe}_{DateTime.Now:yyyyMMdd}.pdf";

        try
        {
            // Navigate to the PDF generation endpoint which returns a File result
            var url = $"/api/pdf/generate/post/{_post.Id}?fileName={Uri.EscapeDataString(filename)}";
            Navigation.NavigateTo(url, forceLoad: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"PDF generation failed: {ex.Message}");
        }
    }

    private string GetWordCountInfo(string? content)
    {
        if (string.IsNullOrWhiteSpace(content)) return "";
        var wordCount = Regex.Matches(content, "\\w+").Count;
        var minutes = Math.Max(1, (int)Math.Ceiling(wordCount / 180.0));
        return $"{wordCount} slov | <i class=\"bi bi-eye\"></i> {minutes} min";
    }

    private void BuildBreadcrumb()
    {
        _breadcrumbCategories = new List<CategoryResponse>();
        
        if (_post?.CategoryId == null || _allCategories == null) return;

        var currentCategoryId = _post.CategoryId.Value;
        var visited = new HashSet<int>();

        while (currentCategoryId > 0)
        {
            if (visited.Contains(currentCategoryId)) break;
            visited.Add(currentCategoryId);

            var category = _allCategories.FirstOrDefault(c => c.Id == currentCategoryId);
            if (category == null) break;

            _breadcrumbCategories.Insert(0, category);
            currentCategoryId = category.ParentId ?? 0;
        }
    }
}