    private void CloseAiTool() => _activeAiTool = null;

    // Toggles the panel to `tool` (or closes it if already open) and clears any error left over
    // from a previously opened tool, which would otherwise incorrectly render for this one too
    // since the panel dispatches on _aiToolError before it dispatches on _activeAiTool.
    // Returns true when the panel is now open on `tool` (i.e. the caller should load its data).
    private bool SwitchAiTool(string tool)
    {
        _activeAiTool = _activeAiTool == tool ? null : tool;
        _aiToolError = null;
        return _activeAiTool == tool;
    }

    // Every "Více" tool shares the same free-tier quota AND the same per-student credit cost
    // as AiChatBox and the raw HTTP AI endpoints (see IAiUsageGuard / AiController.Ask) - calling
    // AiService directly from Blazor bypasses AiController, so this component must enforce both
    // itself, or a logged-in student could use every tool here for free while the chat still
    // charges credits. Returns the denial message rather than writing to a shared field, since
    // callers store it in different per-tool error fields.
    private async Task<(bool Allowed, string? Message)> TryConsumeAiUsageAsync()
    {
        // Pre-flight credit check, mirroring AiChatBox.Send: cheaper to fail before spending
        // an OpenAI call than after. The actual deduction happens post-hoc via
        // DeductAiCreditIfLoggedInAsync, once the call has actually produced something.
        if (_userId is { } uid)
        {
            var user = await UserService.GetByIdAsync(uid);
            if ((user?.Credits ?? 0) < 1)
                return (false, "Nemáš dostatek kreditů.");
        }

        try
        {
            var deviceId = await JS.InvokeAsync<string>("getDeviceId");
            var auth = await AuthState.GetAuthenticationStateAsync();
            var decision = await UsageGuard.TryConsumeAsync(auth.User, $"device:{deviceId}");
            return decision.Allowed ? (true, null) : (false, decision.DeniedMessage ?? "Denní limit dotazů byl vyčerpán.");
        }
        catch
        {
            return (false, "Nepodařilo se ověřit denní limit dotazů.");
        }
    }

    // Deducts 1 credit for a logged-in student after a successful generation (mirrors
    // AiChatBox.Send / AiController.Ask, which deduct post-hoc once the answer exists rather
    // than before). Best-effort: if the deduction fails (e.g. a concurrent request already
    // spent the last credit), the already-generated result is kept either way.
    private async Task DeductAiCreditIfLoggedInAsync()
    {
        if (_userId is not { } uid) return;
        if (await UserService.DeductCreditsAsync(uid, 1, "ai_ask"))
            _credits = (await UserService.GetByIdAsync(uid))?.Credits ?? 0;
    }

    private async Task ToggleFlashcards()
    {
        if (!SwitchAiTool("flashcards") || _flashcardsLoaded || _post == null) return;

        _aiToolLoading = true;
        try
        {
            var (allowed, message) = await TryConsumeAiUsageAsync();
            if (!allowed) { _aiToolError = message; return; }
            var resp = await AiService.GenerateFlashcardsAsync(_post.Id);
            await DeductAiCreditIfLoggedInAsync();
            _flashcards = resp.Cards;
            _flashcardIndex = 0;
            _flashcardFlipped = false;
            _flashcardsLoaded = true;
        }
        catch
        {
            _aiToolError = "Kartičky se nepodařilo vygenerovat. Zkus to prosím znovu později.";
        }
        finally
        {
            _aiToolLoading = false;
        }
    }

    private double FlashcardProgress => _flashcards.Count == 0 ? 0 : (double)(_flashcardIndex + 1) / _flashcards.Count * 100;

    private const int FlashcardFlipTransitionMs = 400;

    // Ephemeral AI flashcards aren't tied to QuestionAttempt progress tracking like
    // /practice/flashcards, so "knewIt" has no server-side effect - instead, "Musím zopakovat"
    // requeues the card at the end of the deck (list length stays constant) so it comes back
    // around for review, while "Umím" advances past it for good.
    private async Task AdvanceFlashcard(bool knewIt)
    {
        var current = _flashcards[_flashcardIndex];
        _flashcardFlipped = false;
        StateHasChanged();
        await Task.Delay(FlashcardFlipTransitionMs);
        if (_disposed) return;

        if (knewIt)
        {
            _flashcardIndex++;
        }
        else
        {
            _flashcards.RemoveAt(_flashcardIndex);
            _flashcards.Add(current);
        }
        StateHasChanged();
    }

    private void RestartFlashcards()
    {
        _flashcardIndex = 0;
        _flashcardFlipped = false;
    }

