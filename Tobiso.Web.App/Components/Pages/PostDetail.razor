@page "/post/{Id:int}"
@using System.Text.RegularExpressions
@using Tobiso.Web.Shared.DTOs
@using Tobiso.Web.Shared.Interfaces
@using Microsoft.JSInterop
@using Tobiso.Web.App.Services
@inject ITobisoAnonymApi Api
@inject ITobisoWebApi WebApi
@inject IInteractiveExerciseService ExerciseService
@inject IJSRuntime Js
@inject NavigationManager Navigation
@inject System.Net.Http.HttpClient Http
@inject AddendumModalService ModalService
@rendermode InteractiveServer
@implements IDisposable
<PageTitle>@(_post?.Title ?? "Blogový post") - Tobiso</PageTitle>
<style>
    section img {
        max-width: 16rem;
        max-height: 20rem;
        background-color: white;
    }
    .content {
        text-align: left;
    }
    /* Article-scoped base typography: applies only inside #content so it wins over global rules.
       Use the reading-size CSS variable so the reading panel still works. */
    #content p,
    #content li,
    #content ul,
    #content ol,
    #content blockquote,
    #content .description-text,
    #content .intro {
        /* inherit the container font-family so the reading panel's inline
           font-family on #content takes effect for normal text */
        font-family: inherit;
        font-weight: 450;
        color: var(--color-text);
        /* inherit so container's inline font-size (set by JS) controls body text */
        font-size: inherit;
        line-height: 1.4;
    }
    /* Dark-mode overrides for article content */
    body.dark-mode #content,
    body.dark-mode #content p,
    body.dark-mode #content li,
    body.dark-mode #content ul,
    body.dark-mode #content ol,
    body.dark-mode #content blockquote,
    body.dark-mode #content .description-text,
    body.dark-mode #content .intro {
        color: var(--color-text-dark);
    }

    /* Links inside article should also adapt to dark-mode accents */
    #content a { color: var(--color-accent-strong); }
    body.dark-mode #content a { color: var(--color-accent-strong-dark); }
    .ribbon-6 {
        display: none;
    }
    .addendum-btn {
        margin: 0 4px;
        cursor: pointer;
    }
    /* Dotted underline for semantic headings (matching .verybig decoration style) */
h1,
h2,
h3,
h4,
h5,
h6 {
    text-decoration-line: underline;
    text-decoration-style: dotted;
    text-decoration-color: var(--color-accent-3);
    text-decoration-thickness: 3px;
    text-underline-offset: 9px;
    transition: text-decoration-color 0.2s ease;
}

/* Dark mode variant for headings */
body.dark-mode h1,
body.dark-mode h2,
body.dark-mode h3,
body.dark-mode h4,
body.dark-mode h5,
body.dark-mode h6 {
    text-decoration-color: var(--color-accent-3-dark);
}
.related-posts-div h5,
.intro h3 {
    text-decoration: none;
}
body.focus-mode .sidebar,
body.focus-mode .decorative-ribbons,
body.focus-mode .snowflake,
body.focus-mode footer  {
    display: none;
}
body.focus-mode main {
    margin: 0;
}
body.focus-mode .loading-bar-container {
    margin-left: 0;
    width: 100%;
}
body.focus-mode section {
    max-width: 1000px;
}
.tobiso-source {
    font-size: 13px;
    opacity: 0.5;
    font-style: italic;
    font-weight: 300;
    margin-top: 2px;
    margin-bottom: 2px;
}
</style>
@if (_post == null)
{
    <p>Načítám...</p>
}
else
{
    <h1 class="verybig">@_post.Title</h1>
    
    @if (_breadcrumbCategories != null && _breadcrumbCategories.Any())
    {
        <nav class="breadcrumb-nav" aria-label="Breadcrumb">
            @foreach (var category in _breadcrumbCategories)
            {
                <a href="/categories/@category.Id">@category.Name</a>
                <span class="separator"><i class="bi bi-arrow-right-short"></i></span>
            }
            <span class="current">@_post.Title</span>
        </nav>
    }
    
    <div class="tools">
        <div class="tool">
            @if (GetLatestEditDate() != null)
            {
                <span>@GetLatestEditDateDisplay()</span>
            }
        </div>
            <div class="tool">
                <button class="btn btn-secondary mb-3" title="Zpět" @onclick="BackHistory"><i class="bi bi-arrow-left"></i></button>
                @if (_hasQuestions)
                {
                    <button class="btn btn-secondary mb-3" title="Prověrka" style="float: right" @onclick="ToQuestions"><i class="bi bi-person-walking"></i></button>
                }
                <button class="btn btn-secondary mb-3" title="Režim soustředění" @onclick="ToggleFocusMode">
                    <i class="bi @(_isFocusMode ? "bi-fullscreen-exit" : "bi-arrows-fullscreen")"></i>
                </button>
                <button class="btn btn-secondary mb-3" title="Nastavení čtení" @onclick="ToggleReadingPanel"><i class="bi bi-type"></i></button>
                @if (_exercises != null && _exercises.Any())
                {
                    <button class="btn btn-secondary mb-3" title="Interaktivní cvičení" @onclick="ScrollToExercises">
                        <i class="bi bi-puzzle"></i>
                    </button>
                }
                <button class="btn btn-secondary mb-3" title="Sdílet článek" @onclick="SharePost">
                    <i class="bi @(_isShared ? "bi-check-lg" : "bi-share")"></i>
                </button>
                <button title="Vytisknout článek (PDF)" @onclick="GeneratePdf"><i class="bi bi-printer"></i></button>
            </div>
        <div class="tool">
            <span>@((MarkupString)GetWordCountInfo(_post.Content))</span>
        </div>
    </div>
    @if (_showReadingPanel)
    {
        <div class="reading-panel" role="region" aria-label="Nastavení čtení">
            <div class="reading-section">
                <label>Písmo</label>
                <button class="reading-option @(string.IsNullOrEmpty(_readingFont) ? "active" : "")" @onclick="() => SetReadingFont(string.Empty)">Výchozí</button>
                <button class="reading-option @(_readingFont == FontGeorgia ? "active" : "")" @onclick="() => SetReadingFont(FontGeorgia)">Georgia</button>
                <button class="reading-option @(_readingFont == FontArial ? "active" : "")" @onclick="() => SetReadingFont(FontArial)">Arial</button>
                <button class="reading-option @(_readingFont == FontMono ? "active" : "")" @onclick="() => SetReadingFont(FontMono)">Monospace</button>
            </div>
            <div class="reading-section">
                <label>Velikost</label>
                <button class="reading-option" @onclick="() => ChangeFontSize(-1)">A−</button>
                <div style="min-width:48px;text-align:center">@($"{_fontSizes[_readingFontSizeStep]}px")</div>
                <button class="reading-option" @onclick="() => ChangeFontSize(1)">A+</button>
            </div>
            <div class="reading-section">
                <label>Šířka</label>
                <button class="reading-option @(_readingLineWidthStep==0 ? "active":"")" @onclick="() => SetLineWidth(0)">55ch</button>
                <button class="reading-option @(_readingLineWidthStep==1 ? "active":"")" @onclick="() => SetLineWidth(1)">75ch</button>
                <button class="reading-option @(_readingLineWidthStep==2 ? "active":"")" @onclick="() => SetLineWidth(2)">100ch</button>
                <button class="reading-option @(_readingLineWidthStep==3 ? "active":"")" @onclick="() => SetLineWidth(3)">140ch</button>
                <button class="reading-option @(_readingLineWidthStep==4 ? "active":"")" @onclick="() => SetLineWidth(4)">Žádná</button>
            </div>
        </div>
    }
    <div class="mb-4">
        @* Wrap rendered content in a container with class/id `content` so JS selector finds it *@
        <div id="content" class="content" style="@GetContentStyle()">
            @if (_fileSuffix == ".md")
            {
                @((MarkupString)TransformMarkdownContent(_post.Content))
            }
            else if (_fileSuffix == ".html")
            {
                @((MarkupString)(_post.Content))
            }
            else
            {
                @((MarkupString)(_post.Content))
            }
        </div>
    </div>
    <div class="tools">
        <div class="tool">
            @if (GetLatestEditDate() != null)
            {
                <span>@GetLatestEditDateDisplay()</span>
            }
        </div>
        <div class="tool">
            <button class="btn btn-secondary mb-3" title="Zpět" @onclick="BackHistory"><i class="bi bi-arrow-left"></i></button>
            @if (_hasQuestions)
            {
                <button class="btn btn-secondary mb-3" title="Prověrka" style="float: right" @onclick="ToQuestions"><i class="bi bi-person-walking"></i></button>
            }
            <button class="btn btn-secondary mb-3" title="Režim soustředění" @onclick="ToggleFocusMode">
                <i class="bi @(_isFocusMode ? "bi-fullscreen-exit" : "bi-arrows-fullscreen")"></i>
            </button>
            <button class="btn btn-secondary mb-3" title="Nastavení čtení" @onclick="ToggleReadingPanel"><i class="bi bi-type"></i></button>
            @if (_exercises != null && _exercises.Any())
            {
                <button class="btn btn-secondary mb-3" title="Interaktivní cvičení" @onclick="ScrollToExercises">
                    <i class="bi bi-puzzle"></i>
                </button>
            }
            <button class="btn btn-secondary mb-3" title="Sdílet článek" @onclick="SharePost">
                <i class="bi @(_isShared ? "bi-check-lg" : "bi-share")"></i>
            </button>
            <button title="Vytisknout článek (PDF)" @onclick="GeneratePdf"><i class="bi bi-printer"></i></button>
        </div>
        <div class="tool">
            <span>@((MarkupString)GetWordCountInfo(_post.Content))</span>
        </div>
    </div>
    @if (_showReadingPanel)
    {
        <div class="reading-panel" role="region" aria-label="Nastavení čtení">
            <div class="reading-section">
                <label>Písmo</label>
                <button class="reading-option @(string.IsNullOrEmpty(_readingFont) ? "active" : "")" @onclick="() => SetReadingFont(string.Empty)">Výchozí</button>
                <button class="reading-option @(_readingFont == FontGeorgia ? "active" : "")" @onclick="() => SetReadingFont(FontGeorgia)">Georgia</button>
                <button class="reading-option @(_readingFont == FontArial ? "active" : "")" @onclick="() => SetReadingFont(FontArial)">Arial</button>
                <button class="reading-option @(_readingFont == FontMono ? "active" : "")" @onclick="() => SetReadingFont(FontMono)">Monospace</button>
            </div>
            <div class="reading-section">
                <label>Velikost</label>
                <button class="reading-option" @onclick="() => ChangeFontSize(-1)">A−</button>
                <div style="min-width:48px;text-align:center">@($"{_fontSizes[_readingFontSizeStep]}px")</div>
                <button class="reading-option" @onclick="() => ChangeFontSize(1)">A+</button>
            </div>
            <div class="reading-section">
                <label>Šířka</label>
                <button class="reading-option @(_readingLineWidthStep==0 ? "active":"")" @onclick="() => SetLineWidth(0)">55ch</button>
                <button class="reading-option @(_readingLineWidthStep==1 ? "active":"")" @onclick="() => SetLineWidth(1)">75ch</button>
                <button class="reading-option @(_readingLineWidthStep==2 ? "active":"")" @onclick="() => SetLineWidth(2)">100ch</button>
                <button class="reading-option @(_readingLineWidthStep==3 ? "active":"")" @onclick="() => SetLineWidth(3)">140ch</button>
                <button class="reading-option @(_readingLineWidthStep==4 ? "active":"")" @onclick="() => SetLineWidth(4)">Žádná</button>
            </div>
        </div>
    }
    
    @* Interaktivní cvičení *@
    @if (_exercises != null && _exercises.Any())
    {
        <section id="interaktivni-cviceni">
            <div class="mt-5 mb-4">
            <h2>
                <i class="bi bi-puzzle"></i> Interaktivní cvičení
            </h2>
            
            @foreach (var exercise in _exercises)
            {
                <div class="card mb-4 shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0">
                            <i class="bi bi-@GetExerciseIcon(exercise.Type)"></i> @exercise.Title
                        </h4>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(exercise.InstructionsMarkdown))
                        {
                            <div class="alert alert-info">
                                @((MarkupString)Markdig.Markdown.ToHtml(exercise.InstructionsMarkdown))
                            </div>
                        }
                        
                        <div class="exercise-content bg-light p-4 rounded">
                            @switch (exercise.Type)
                            {
                                case "circuit":
                                    <CircuitSimulator Exercise="exercise" />
                                    break;
                                case "timeline":
                                    <TimelineExercise Exercise="exercise" />
                                    break;
                                case "drag-drop":
                                    <DragDropExercise Exercise="exercise" />
                                    break;
                                case "matching":
                                    <MatchingExercise Exercise="exercise" />
                                    break;
                                case "molecule":
                                default:
                                    <div class="alert alert-warning">
                                        <i class="bi bi-tools"></i> 
                                        <strong>Vývoj probíhá:</strong> Interaktivní komponenta pro typ "@exercise.Type" bude brzy dostupná.
                                    </div>
                                    break;
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
        </section>
    }
    
    <h3 style="text-decoration: none;"><i class="bi bi-stars"></i> AI Chat o článku</h3>

    <AiChatBox PostId="@Id" ShowEmptyPrompt="false" />

    @if (_relatedPosts != null && _relatedPosts.Any())
    {
        <div class="intro related-posts">
            <h3 style="margin: 0">
                Související články
            </h3>

            <div class="">
                @foreach (var relatedPost in _relatedPosts)
                {
                    var relatedPostData = _allPosts?.FirstOrDefault(p => p.Id == relatedPost.RelatedPostId);
                    if (relatedPostData != null)
                    {
                        <a href="/post/@relatedPost.RelatedPostId">
                        <div class="related-posts-div">
                        
                            <h5 >
                                @relatedPostData.Title
                            </h5>
                            @if (!string.IsNullOrEmpty(relatedPost.Text))
                            {
                                <span class="related-posts-text">
                                    @relatedPost.Text
                                </span>
                            }
                        </div>
                        </a>
                    }
                }
            </div>
        </div>
    }
}

<AddendumModal IsVisible="@_showAddendumModal" IsVisibleChanged="@OnAddendumModalClose" AddendumId="@_selectedAddendumId" />

@* Hidden area for addendum buttons - rendered but not visible *@
<div style="display:none;">
    @foreach (var addendumId in _addendumIds)
    {
        <AddendumButton AddendumId="@addendumId" />
    }
</div>

@using Tobiso.Web.App.Components.Shared
@code {
    [Parameter]
    public int Id { get; set; }
    private PostResponse? _post;
    private List<PostResponse>? _allPosts;
    private List<RelatedPostResponse>? _relatedPosts;
    private List<CategoryResponse>? _allCategories;
    private List<CategoryResponse>? _breadcrumbCategories;
    private string? _returnUrl;
    private string? _fileSuffix;
    private bool _hasQuestions = false;
    private bool _isShared = false;
    private bool _showAddendumModal = false;
    private int? _selectedAddendumId = null;
    private DotNetObjectReference<PostDetail>? _dotNetRef;
    private List<int> _addendumIds = new();
    private bool _isFocusMode = false;
    // Reading preferences state
    private bool _showReadingPanel = false;
    private string _readingFont = string.Empty;
    private int _readingFontSizeStep = 4; // default index -> 20px
    private int _readingLineWidthStep = 3; // default -> no limit (new index after adding 140ch)
    private readonly int[] _fontSizes = new[] { 14, 17, 20, 22, 24, 26, 28 };
    private readonly string[] _lineWidths = new[] { "55ch", "75ch", "100ch", "140ch", "" };
    private readonly string FontGeorgia = "Georgia, 'Times New Roman', serif";
    private readonly string FontArial = "Arial, Helvetica, sans-serif";
    private readonly string FontMono = "'Courier New', Courier, monospace";
    private List<InteractiveExerciseResponse>? _exercises;
    private IJSObjectReference? _jsModule;

    protected override async Task OnInitializedAsync()
    {
        _post = await Api.GetPostById(Id);
        _allPosts = (await Api.GetAllPosts()).ToList();
        _allCategories = await Api.GetAllCategories();
        BuildBreadcrumb();
        SetFileSuffix();
        await CheckForQuestions();
        await LoadRelatedPosts();
        await LoadExercises();
    }

    protected override async Task OnParametersSetAsync()
    {
        var uri = new Uri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        _returnUrl = query.TryGetValue("returnUrl", out var val) ? val.ToString() : null;
        _post = await Api.GetPostById(Id);
        _allPosts = (await Api.GetAllPosts()).ToList();
        _allCategories = await Api.GetAllCategories();
        BuildBreadcrumb();
        SetFileSuffix();
        await CheckForQuestions();
        await LoadRelatedPosts();
        await LoadExercises();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await Js.InvokeVoidAsync("eval", @"
                window.requestAddendum = function(addendumId) {
                    DotNet.invokeMethodAsync('Tobiso.Web.App', 'TriggerAddendum', addendumId);
                };
                // Initialize instance bridge and fullscreen listener
                window.__initPostDetail = function(dotnet){
                    window.__postDetailRef = dotnet;
                    document.addEventListener('fullscreenchange', function(){
                        if (!document.fullscreenElement && window.__postDetailRef) {
                            // Ensure our custom focus styles are also removed
                            try{ document.body.classList.remove('focus-mode'); }catch(e){}
                            window.__postDetailRef.invokeMethodAsync('OnExternalFullscreenExit');
                        }
                    });
                    // Also react to ESC directly to clear our styles
                    document.addEventListener('keydown', function(e){
                        if (e && (e.key === 'Escape' || e.code === 'Escape')) {
                            if (document.body.classList.contains('focus-mode')) {
                                try{ document.body.classList.remove('focus-mode'); }catch(_){}
                                if (window.__postDetailRef) {
                                    window.__postDetailRef.invokeMethodAsync('OnExternalFullscreenExit');
                                }
                            }
                        }
                    });
                };
            ");
            // Pass DotNet object reference to JS to enable instance callbacks
            await Js.InvokeVoidAsync("__initPostDetail", _dotNetRef);
            // Load persisted reading preferences from localStorage (if present)
            try
            {
                var font = await Js.InvokeAsync<string>("localStorage.getItem", "readingFont");
                if (!string.IsNullOrEmpty(font)) _readingFont = font;
                var sz = await Js.InvokeAsync<string>("localStorage.getItem", "readingFontSizeStep");
                if (int.TryParse(sz, out var s)) _readingFontSizeStep = Math.Clamp(s, 0, _fontSizes.Length - 1);
                var lw = await Js.InvokeAsync<string>("localStorage.getItem", "readingLineWidthStep");
                if (int.TryParse(lw, out var w)) _readingLineWidthStep = Math.Clamp(w, 0, _lineWidths.Length - 1);
                // Always apply reading styles so default font (set in OnInitialized)
                // takes effect even when no persisted preferences exist.
                await ApplyReadingStylesAsync();
                StateHasChanged();
            }
            catch { }
            // Dynamically load KaTeX (CSS + JS) and auto-render so inline $...$ is converted to math
            await Js.InvokeVoidAsync("eval", @"
                (function(){
                    if (window.__katexLoaded) {
                        // already loaded, just render
                        try{ renderMathInElement(document.getElementById('content'), {delimiters: [{left:'$$', right:'$$', display:true},{left:'$', right:'$', display:false}]}); }catch(e){}
                        return;
                    }
                    window.__katexLoaded = true;
                    try{
                        var link = document.createElement('link');
                        link.rel = 'stylesheet';
                        link.href = 'https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css';
                        document.head.appendChild(link);

                        var s1 = document.createElement('script');
                        s1.src = 'https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.js';
                        s1.defer = true;
                        document.head.appendChild(s1);

                        var s2 = document.createElement('script');
                        s2.src = 'https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/contrib/auto-render.min.js';
                        s2.defer = true;
                        s2.onload = function(){
                            try{
                                renderMathInElement(document.getElementById('content'), {delimiters: [{left:'$$', right:'$$', display:true},{left:'$', right:'$', display:false}]});
                            }catch(e){}
                            // Additionally render any placeholders with data-math using katex.render
                            try{
                                document.querySelectorAll('[data-math]').forEach(function(el){
                                    try{
                                        var math = el.getAttribute('data-math');
                                        if(math && window.katex && typeof window.katex.render === 'function'){
                                            katex.render(math, el, {throwOnError:false, displayMode:false});
                                        }
                                    }catch(_){ }
                                });
                            }catch(_){ }
                        };
                        document.head.appendChild(s2);
                    }catch(e){}
                })();
            ");
        }
            else
            {
                // On subsequent renders, attempt to render math if KaTeX is available
                await Js.InvokeVoidAsync("eval", @"try{ if(window.renderMathInElement){ renderMathInElement(document.getElementById('content'), {delimiters: [{left:'$$', right:'$$', display:true},{left:'$', right:'$', display:false}]}); } 
                    try{ document.querySelectorAll('[data-math]').forEach(function(el){ try{ var math = el.getAttribute('data-math'); if(math && window.katex && typeof window.katex.render === 'function'){ katex.render(math, el, {throwOnError:false, displayMode:false}); } }catch(_){} }); }catch(_){} }catch(e){}");
            }

        // Initialize lightbox for images in content (after every render so newly loaded images get handlers)
        try
        {
            _jsModule ??= await Js.InvokeAsync<IJSObjectReference>("import", "/js/blazor-utils.js?v=8");
            await _jsModule.InvokeVoidAsync("initImageLightbox", "content");
        }
        catch { /* ignore */ }
    }

    [JSInvokable("TriggerAddendum")]
    public static void TriggerAddendum(int addendumId)
    {
        AddendumModalService.TriggerGlobalRequest(addendumId);
    }
    
    protected override void OnInitialized()
    {
        AddendumModalService.OnGlobalAddendumRequested += HandleAddendumRequest;
        ModalService.OnAddendumRequested += HandleAddendumRequest;

        // Default reading font for article text (applies immediately on render)
        if (string.IsNullOrEmpty(_readingFont))
        {
            _readingFont = FontGeorgia;
        }
    }
    
    private void HandleAddendumRequest(int addendumId)
    {
        OpenAddendumModal(addendumId);
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AddendumModalService.OnGlobalAddendumRequested -= HandleAddendumRequest;
        ModalService.OnAddendumRequested -= HandleAddendumRequest;
        _dotNetRef?.Dispose();
        if (_jsModule != null) _ = _jsModule.DisposeAsync().AsTask();
    }

    // --- Reading preferences handlers ---
    private string GetContentStyle()
    {
        try
        {
            var sb = new System.Text.StringBuilder();
            if (!string.IsNullOrEmpty(_readingFont))
                sb.Append($"font-family: {_readingFont} !important;");
            else
                sb.Append($"font-family: var(--font-family-serif) !important;");
            var size = _fontSizes[Math.Clamp(_readingFontSizeStep, 0, _fontSizes.Length - 1)];
            // Expose base size via CSS variable so headings can scale relative to it
            sb.Append($"--reading-font-size: {size}px; ");
            // Also set the container font-size directly so body text (which inherits)
            // updates immediately even if JS hasn't executed.
            sb.Append($"font-size: {size}px;");
            var width = _lineWidths[Math.Clamp(_readingLineWidthStep, 0, _lineWidths.Length - 1)];
            if (!string.IsNullOrEmpty(width))
            {
                sb.Append($"max-width: {width}; margin-left: auto; margin-right: auto; width: 100%;");
            }
            return sb.ToString();
        }
        catch { return string.Empty; }
    }

    private Task ToggleReadingPanel()
    {
        _showReadingPanel = !_showReadingPanel;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task SetReadingFont(string font)
    {
        _readingFont = font ?? string.Empty;
        try { await Js.InvokeVoidAsync("localStorage.setItem", "readingFont", _readingFont); } catch { }
        await ApplyReadingStylesAsync();
        StateHasChanged();
    }

    private async Task ChangeFontSize(int delta)
    {
        _readingFontSizeStep = Math.Clamp(_readingFontSizeStep + delta, 0, _fontSizes.Length - 1);
        try { await Js.InvokeVoidAsync("localStorage.setItem", "readingFontSizeStep", _readingFontSizeStep.ToString()); } catch { }
        await ApplyReadingStylesAsync();
        StateHasChanged();
    }

    private async Task SetLineWidth(int step)
    {
        _readingLineWidthStep = Math.Clamp(step, 0, _lineWidths.Length - 1);
        try { await Js.InvokeVoidAsync("localStorage.setItem", "readingLineWidthStep", _readingLineWidthStep.ToString()); } catch { }
        await ApplyReadingStylesAsync();
        StateHasChanged();
    }

    private async Task ApplyReadingStylesAsync()
    {
        try
        {
            var font = _readingFont ?? string.Empty;
            var size = _fontSizes[Math.Clamp(_readingFontSizeStep, 0, _fontSizes.Length - 1)];
            var width = _lineWidths[Math.Clamp(_readingLineWidthStep, 0, _lineWidths.Length - 1)];
            var fontJs = System.Text.Json.JsonSerializer.Serialize(font);
            var widthJs = System.Text.Json.JsonSerializer.Serialize(width);
            // Simpler script: only set inline styles on the container element (#content).
            // We rely on CSS `inherit` for descendant font-size/family so this is robust
            // and avoids complex brace-escaping in interpolated verbatim strings.
            var script = $@"(function(){{
                var el = document.getElementById('content');
                if(!el) return;
                try {{
                    if({fontJs} !== "") el.style.setProperty('font-family', {fontJs}, 'important'); else el.style.setProperty('font-family', getComputedStyle(document.documentElement).getPropertyValue('--font-family-serif'), 'important');
                    el.style.setProperty('font-size', '{size}px', 'important');
                    if({widthJs} !== "") {{ el.style.setProperty('max-width', {widthJs}, 'important'); el.style.setProperty('margin-left', 'auto', 'important'); el.style.setProperty('margin-right', 'auto', 'important'); }} else {{ el.style.removeProperty('max-width'); el.style.removeProperty('margin-left'); el.style.removeProperty('margin-right'); }}
                }} catch(e) {{ console && console.log && console.log(e); }}
            }})();";
            await Js.InvokeVoidAsync("eval", script);
        }
        catch { /* ignore */ }
    }

    private async Task ToggleFocusMode()
    {
        _isFocusMode = !_isFocusMode;
        var script = _isFocusMode
            ? "document.body.classList.add('focus-mode'); try{ if(!document.fullscreenElement && document.documentElement.requestFullscreen){ document.documentElement.requestFullscreen(); } }catch(e){}"
            : "document.body.classList.remove('focus-mode'); try{ if(document.fullscreenElement && document.exitFullscreen){ document.exitFullscreen(); } }catch(e){}";
        await Js.InvokeVoidAsync("eval", script);
        StateHasChanged();
    }

    [JSInvokable]
    public Task OnExternalFullscreenExit()
    {
        if (_isFocusMode)
        {
            _isFocusMode = false;
            StateHasChanged();
        }
        return Task.CompletedTask;
    }

    private void SetFileSuffix()
    {
        if (_post != null && !string.IsNullOrEmpty(_post.FilePath))
        {
            if (_post.FilePath.EndsWith(".md", StringComparison.OrdinalIgnoreCase))
                _fileSuffix = ".md";
            else if (_post.FilePath.EndsWith(".html", StringComparison.OrdinalIgnoreCase))
                _fileSuffix = ".html";
            else
                _fileSuffix = null;
        }
        else
        {
            _fileSuffix = null;
        }
    }

    private async Task CheckForQuestions()
    {
        try
        {
            if (_post?.Id != null)
            {
                var questions = await Api.GetQuestionsByPostId(_post.Id);
                _hasQuestions = questions?.Any() == true;
            }
        }
        catch (Exception)
        {
            _hasQuestions = false;
        }
    }

    private async Task LoadRelatedPosts()
    {
        try
        {
            if (_post?.Id != null)
            {
                _relatedPosts = (await Api.GetRelatedPostsByPostId(_post.Id)).ToList();
                
                // Přidat články ze stejné kategorie
                if (_post.CategoryId.HasValue && _allPosts != null)
                {
                    var categoryPosts = _allPosts
                        .Where(p => p.CategoryId == _post.CategoryId && p.Id != _post.Id)
                        .Take(5)
                        .Select(p => new RelatedPostResponse
                        {
                            PostId = _post.Id,
                            RelatedPostId = p.Id,
                            Text = "souvisí s tématem"
                        })
                        .ToList();
                    
                    // Vyfiltrovat články, které už jsou v _relatedPosts
                    var existingIds = _relatedPosts.Select(rp => rp.RelatedPostId).ToHashSet();
                    var newCategoryPosts = categoryPosts.Where(cp => !existingIds.Contains(cp.RelatedPostId)).ToList();
                    
                    _relatedPosts.AddRange(newCategoryPosts);
                }
            }
        }
        catch (Exception)
        {
            _relatedPosts = new List<RelatedPostResponse>();
        }
    }

