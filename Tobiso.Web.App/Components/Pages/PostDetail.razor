    [JSInvokable]
    public Task ReceiveTocItems(object headings)
    {
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(headings);
            var arr = System.Text.Json.JsonSerializer.Deserialize<List<Dictionary<string, object>>>(json);
            if (arr == null) return Task.CompletedTask;
            var newTocs = arr.Select(d => new TocItem(d.TryGetValue("id", out var i) ? i?.ToString() ?? string.Empty : string.Empty,
                                                    d.TryGetValue("text", out var t) ? t?.ToString() ?? string.Empty : string.Empty,
                                                    d.TryGetValue("level", out var l) && int.TryParse(l?.ToString(), out var lv) ? lv : 2)).ToList();
            var hash = string.Join("|", newTocs.Select(t => t.Id + ":" + t.Text));
            if (hash != _lastExtractedContentHash)
            {
                _tocItems = newTocs;
                _lastExtractedContentHash = hash;
                InvokeAsync(StateHasChanged);
                // re-init observer
                _ = Task.Run(async () =>
                {
                    try { if (_jsModule != null) await _jsModule.InvokeVoidAsync("initTocObserver", _dotNetRef, _tocItems.Select(t => t.Id).ToArray()); } catch { }
                });
            }
        }
        catch { }
        return Task.CompletedTask;
    }

