@page "/post/{Id:int}"
@using System.Text.RegularExpressions
@using Tobiso.Web.Shared.DTOs
@using Tobiso.Web.Shared.Interfaces
@using Microsoft.JSInterop
@using Tobiso.Web.App.Services
@inject ITobisoAnonymApi Api
@inject ITobisoWebApi WebApi
@inject IInteractiveExerciseService ExerciseService
@inject IJSRuntime Js
@inject NavigationManager Navigation
@inject System.Net.Http.HttpClient Http
@inject AddendumModalService ModalService
@inject Tobiso.Web.App.Services.IPreferenceService PreferenceService
@rendermode InteractiveServer
@implements IDisposable
<PageTitle>@(_post?.Title ?? "Blogový post") - Tobiso</PageTitle>
    <style>
    section img {
        max-width: 16rem;
        max-height: 20rem;
        background-color: white;
    }
    .content {
        text-align: left;
    }

    .content p,
.content li,
.content ul,
.content ol,
.content blockquote,
.content .description-text,
.content .intro {
    font-family: inherit;
    /* inherit the font-size from the #content container so JS-applied inline
       font-size (reading controls) affects normal paragraphs */
    font-size: inherit;
    line-height: inherit;
}

/* Headings scale relative to reading base size so A+/A- affects them too */

.content h2,
.content h3,
.content h4,
.content h5,
.content h6 {
    font-family: inherit;
}
    /* Article-scoped base typography: applies only inside #content so it wins over global rules.
       Use the reading-size CSS variable so the reading panel still works. */
    #content p,
    #content li,
    #content ul,
    #content ol,
    #content blockquote,
    #content .description-text,
    #content .intro {
        /* inherit the container font-family so the reading panel's inline
           font-family on #content takes effect for normal text */
        font-family: inherit;
        font-weight: 450;
        color: var(--color-text);
        /* inherit so container's inline font-size (set by JS) controls body text */
        font-size: inherit;
        line-height: 1.4;
    }
    /* Dark-mode overrides for article content */
    body.dark-mode #content,
    body.dark-mode #content p,
    body.dark-mode #content li,
    body.dark-mode #content ul,
    body.dark-mode #content ol,
    body.dark-mode #content blockquote,
    body.dark-mode #content .description-text,
    body.dark-mode #content .intro {
        color: var(--color-text-dark);
    }

    .verybig {
        margin-bottom: 5px;
    }

    /* Links inside article should also adapt to dark-mode accents */
    #content a { color: var(--color-accent-strong); }
    body.dark-mode #content a { color: var(--color-accent-strong-dark); }
    .ribbon-6 {
        display: none;
    }
    .addendum-btn {
        margin: 0 4px;
        cursor: pointer;
    }
    .tool-btn {
        position: relative;
    }
    .tool-btn span.tool-label {
        display: none;
    }
    .tool-btn:hover span.tool-label {
        display: block;
        position: absolute;
        bottom: calc(100% + 4px);
        left: 50%;
        transform: translateX(-50%);
        background: var(--color-accent-5, #eee);
        color: var(--color-text);
        padding: 0.14rem 0.35rem;
        border-radius: 6px;
        font-size: 0.68rem;
        white-space: nowrap;
        box-shadow: 0 6px 14px rgba(0,0,0,0.08);
        z-index: 3000;
        pointer-events: none;
    }

/* Dark mode variant for headings */
body.dark-mode h1,
body.dark-mode h2,
body.dark-mode h3,
body.dark-mode h4,
body.dark-mode h5,
body.dark-mode h6 {
    text-decoration-color: var(--color-accent-3-dark);
}
.related-posts-div h5,
.intro h3 {
    text-decoration: none;
}
body.focus-mode .sidebar,
body.focus-mode .decorative-ribbons,
body.focus-mode .snowflake,
body.focus-mode footer  {
    display: none;
}
body.focus-mode main {
    margin: 0;
}
body.focus-mode .loading-bar-container {
    margin-left: 0;
    width: 100%;
}
body.focus-mode section {
    max-width: 1000px;
}
.tobiso-source {
    font-size: 13px;
    opacity: 0.5;
    font-style: italic;
    font-weight: 300;
    margin-top: 2px;
    margin-bottom: 2px;
}
    .grade-badge {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--color-accent, #4a90d9);
    color: #fff;
    margin-bottom: 0.75rem;
    vertical-align: middle;
}

    /* Wiki-style Table of Contents (TOC) */
    .wiki-toc {
        position: fixed;
        left: calc(285px + 16px);
        top: 80px;
        width: 210px;
        max-height: calc(100vh - 120px);
        overflow-y: auto;
        font-size: 13px;
        line-height: 1.4;
        padding: 8px 10px;
        background: rgba(255,255,255,0.02);
        border-radius: 6px;
        box-shadow: 0 1px 6px rgba(0,0,0,0.06);
    }
    /* Adjust when left nav collapsed */
    body:has(#MyNavBar.collapsed) .wiki-toc { left: calc(60px + 16px); }
    @@media (max-width: 1200px) { .wiki-toc { display: none; } }
    body.focus-mode .wiki-toc { display: none; }

    .wiki-toc-title { font-weight: 700; margin-bottom: 8px; }
    .wiki-toc-item { display: block; cursor: pointer; color: inherit; text-decoration: none; padding: 4px 0; }
    .wiki-toc-item.level-2 { padding-left: 0; }
    .wiki-toc-item.level-3 { padding-left: 10px; }
    .wiki-toc-item.level-4 { padding-left: 18px; }
    .wiki-toc-item.level-5 { padding-left: 26px; }
    .wiki-toc-item.level-6 { padding-left: 34px; }
    .wiki-toc-item.active { font-weight: 700; }
body.dark-mode .grade-badge {
    background: var(--color-accent-dark, #2d6db5);
}
</style>
@if (_post == null)
{
    <p>Načítám...</p>
}
else
{
    <h1 class="verybig">@_post.Title</h1>
    @if (ActiveVersion != null)
    {
        <span class="grade-badge">@(ActiveVersion.GradeName ?? $"Ročník {ActiveVersion.GradeLevel}")</span>
    }

    @if (_breadcrumbCategories != null && _breadcrumbCategories.Any())
    {
        <nav class="breadcrumb-nav" aria-label="Breadcrumb">
            @foreach (var category in _breadcrumbCategories)
            {
                <a href="/categories/@category.Id">@category.Name</a>
                <span class="separator"><i class="bi bi-arrow-right-short"></i></span>
            }
            <span class="current">@_post.Title</span>
        </nav>
    }

    @* Wiki-style Table of Contents for Markdown posts *@
    @if (_fileSuffix == ".md" && _tocItems != null && _tocItems.Any())
    {
        <nav class="wiki-toc" aria-label="Obsah">
            <div class="wiki-toc-title">Obsah</div>
            @foreach (var item in _tocItems)
            {
                <a href="#@item.Id" class="wiki-toc-item level-@item.Level @( _activeTocId == item.Id ? "active" : "")" @onclick="() => ScrollToHeading(item.Id)" @onclick:preventDefault="true">@item.Text</a>
            }
        </nav>
    }
    else
    {
        // debug aid: if URL contains ?tocdebug=1, show placeholder so we can see placement
        var uri = new Uri(Navigation.Uri);
        var dbg = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("tocdebug", out var _dbg) && _dbg == "1";
        if (dbg)
        {
            <nav class="wiki-toc" aria-label="Obsah (debug)">
                <div class="wiki-toc-title">Obsah (debug)</div>
                <div style="opacity:0.6">No headings found or not a markdown post.</div>
            </nav>
        }
    }

    <div class="tools">
        <div class="tool">
            @if (GetLatestEditDate() != null)
            {
                <span>@GetLatestEditDateDisplay()</span>
            }
        </div>
            <div class="tool">
                <button class="btn btn-secondary mb-3 tool-btn" aria-label="Zpět" @onclick="BackHistory"><i class="bi bi-arrow-left"></i><span class="tool-label">Zpět</span></button>
                @if (_hasQuestions)
                {
                    <button class="btn btn-secondary mb-3 tool-btn" aria-label="Prověrka" style="float: right" @onclick="ToQuestions"><i class="bi bi-person-walking"></i><span class="tool-label">Prověrka</span></button>
                }
                <button class="btn btn-secondary mb-3 tool-btn" aria-label="Režim soustředění" @onclick="ToggleFocusMode">
                    <i class="bi @(_isFocusMode ? "bi-fullscreen-exit" : "bi-arrows-fullscreen")"></i><span class="tool-label">Režim soustředění</span>
                </button>
                <button class="btn btn-secondary mb-3 tool-btn" aria-label="Nastavení čtení" @onclick="ToggleReadingPanel"><i class="bi bi-type"></i><span class="tool-label">Nastavení čtení</span></button>
                @if (_exercises != null && _exercises.Any())
                {
                    <button class="btn btn-secondary mb-3 tool-btn" aria-label="Interaktivní cvičení" @onclick="ScrollToExercises">
                        <i class="bi bi-puzzle"></i><span class="tool-label">Interaktivní cvičení</span>
                    </button>
                }
                <button class="btn btn-secondary mb-3 tool-btn" aria-label="Sdílet článek" @onclick="SharePost">
                    <i class="bi @(_isShared ? "bi-check-lg" : "bi-share")"></i><span class="tool-label">Sdílet článek</span>
                </button>
                <button class="tool-btn" aria-label="Vytisknout článek (PDF)" @onclick="GeneratePdf"><i class="bi bi-printer"></i><span class="tool-label">Vytisknout (PDF)</span></button>
            </div>
        <div class="tool">
            <span>@((MarkupString)GetWordCountInfo(ActiveVersion?.Content))</span>
        </div>
    </div>
    @if (_showReadingPanel)
    {
        <div class="reading-panel" role="region" aria-label="Nastavení čtení">
            <div class="reading-section">
                <label>Písmo</label>
                <button class="reading-option @(string.IsNullOrEmpty(_readingFont) ? "active" : "")" @onclick="() => SetReadingFont(string.Empty)">Výchozí</button>
                <button class="reading-option @(_readingFont == FontGeorgia ? "active" : "")" @onclick="() => SetReadingFont(FontGeorgia)">Georgia</button>
                <button class="reading-option @(_readingFont == FontArial ? "active" : "")" @onclick="() => SetReadingFont(FontArial)">Arial</button>
                <button class="reading-option @(_readingFont == FontMono ? "active" : "")" @onclick="() => SetReadingFont(FontMono)">Monospace</button>
            </div>
            <div class="reading-section">
                <label>Velikost</label>
                <button class="reading-option" @onclick="() => ChangeFontSize(-1)">A−</button>
                <div style="min-width:48px;text-align:center">@($"{_fontSizes[_readingFontSizeStep]}px")</div>
                <button class="reading-option" @onclick="() => ChangeFontSize(1)">A+</button>
            </div>
            <div class="reading-section">
                <label>Šířka</label>
                <button class="reading-option @(_readingLineWidthStep==0 ? "active":"")" @onclick="() => SetLineWidth(0)">55ch</button>
                <button class="reading-option @(_readingLineWidthStep==1 ? "active":"")" @onclick="() => SetLineWidth(1)">75ch</button>
                <button class="reading-option @(_readingLineWidthStep==2 ? "active":"")" @onclick="() => SetLineWidth(2)">100ch</button>
                <button class="reading-option @(_readingLineWidthStep==3 ? "active":"")" @onclick="() => SetLineWidth(3)">140ch</button>
                <button class="reading-option @(_readingLineWidthStep==4 ? "active":"")" @onclick="() => SetLineWidth(4)">Žádná</button>
            </div>
        </div>
    }
    <div class="content">
        @* Wrap rendered content in a container with class/id `content` so JS selector finds it *@
        <div id="content" class="content" style="@GetContentStyle()">
            @if (_fileSuffix == ".md")
            {
                <MarkdownContent Content="@(ActiveVersion?.Content ?? string.Empty)" AllPosts="@_allPosts" AllPeople="@_allPeople" ContainerId="content" />
                @if (!_aiAvailable)
                {
                    <div class="alert alert-warning mt-3">
                        AI detection is currently unavailable locally. Post will use existing person summaries. <br />
                        @if (!string.IsNullOrEmpty(_aiDiagError)) { <small>@_aiDiagError</small> }
                    </div>
                }
            }
            else
            {
                @((MarkupString)(ActiveVersion?.Content ?? string.Empty))
            }
        </div>
    </div>
    <div class="tools">
        <div class="tool">
            @if (GetLatestEditDate() != null)
            {
                <span>@GetLatestEditDateDisplay()</span>
            }
        </div>
        <div class="tool">
            <button class="btn btn-secondary mb-3 tool-btn" aria-label="Zpět" @onclick="BackHistory"><i class="bi bi-arrow-left"></i><span class="tool-label">Zpět</span></button>
            @if (_hasQuestions)
            {
                <button class="btn btn-secondary mb-3 tool-btn" aria-label="Prověrka" style="float: right" @onclick="ToQuestions"><i class="bi bi-person-walking"></i><span class="tool-label">Prověrka</span></button>
            }
            <button class="btn btn-secondary mb-3 tool-btn" aria-label="Režim soustředění" @onclick="ToggleFocusMode">
                <i class="bi @(_isFocusMode ? "bi-fullscreen-exit" : "bi-arrows-fullscreen")"></i><span class="tool-label">Režim soustředění</span>
            </button>
            <button class="btn btn-secondary mb-3 tool-btn" aria-label="Nastavení čtení" @onclick="ToggleReadingPanel"><i class="bi bi-type"></i><span class="tool-label">Nastavení čtení</span></button>
            @if (_exercises != null && _exercises.Any())
            {
                <button class="btn btn-secondary mb-3 tool-btn" aria-label="Interaktivní cvičení" @onclick="ScrollToExercises">
                    <i class="bi bi-puzzle"></i><span class="tool-label">Interaktivní cvičení</span>
                </button>
            }
            <button class="btn btn-secondary mb-3 tool-btn" aria-label="Sdílet článek" @onclick="SharePost">
                <i class="bi @(_isShared ? "bi-check-lg" : "bi-share")"></i><span class="tool-label">Sdílet článek</span>
            </button>
            <button class="tool-btn" aria-label="Vytisknout článek (PDF)" @onclick="GeneratePdf"><i class="bi bi-printer"></i><span class="tool-label">Vytisknout (PDF)</span></button>
        </div>
        <div class="tool">
            <span>@((MarkupString)GetWordCountInfo(ActiveVersion?.Content))</span>
        </div>
    </div>
    @if (_showReadingPanel)
    {
        <div class="reading-panel" role="region" aria-label="Nastavení čtení">
            <div class="reading-section">
                <label>Písmo</label>
                <button class="reading-option @(string.IsNullOrEmpty(_readingFont) ? "active" : "")" @onclick="() => SetReadingFont(string.Empty)">Výchozí</button>
                <button class="reading-option @(_readingFont == FontGeorgia ? "active" : "")" @onclick="() => SetReadingFont(FontGeorgia)">Georgia</button>
                <button class="reading-option @(_readingFont == FontArial ? "active" : "")" @onclick="() => SetReadingFont(FontArial)">Arial</button>
                <button class="reading-option @(_readingFont == FontMono ? "active" : "")" @onclick="() => SetReadingFont(FontMono)">Monospace</button>
            </div>
            <div class="reading-section">
                <label>Velikost</label>
                <button class="reading-option" @onclick="() => ChangeFontSize(-1)">A−</button>
                <div style="min-width:48px;text-align:center">@($"{_fontSizes[_readingFontSizeStep]}px")</div>
                <button class="reading-option" @onclick="() => ChangeFontSize(1)">A+</button>
            </div>
            <div class="reading-section">
                <label>Šířka</label>
                <button class="reading-option @(_readingLineWidthStep==0 ? "active":"")" @onclick="() => SetLineWidth(0)">55ch</button>
                <button class="reading-option @(_readingLineWidthStep==1 ? "active":"")" @onclick="() => SetLineWidth(1)">75ch</button>
                <button class="reading-option @(_readingLineWidthStep==2 ? "active":"")" @onclick="() => SetLineWidth(2)">100ch</button>
                <button class="reading-option @(_readingLineWidthStep==3 ? "active":"")" @onclick="() => SetLineWidth(3)">140ch</button>
                <button class="reading-option @(_readingLineWidthStep==4 ? "active":"")" @onclick="() => SetLineWidth(4)">Žádná</button>
            </div>
        </div>
    }

    @* Interaktivní cvičení *@
    @if (_exercises != null && _exercises.Any())
    {
        <section id="interaktivni-cviceni">
            <div class="mt-5 mb-4">
            <h2>
                <i class="bi bi-puzzle"></i> Interaktivní cvičení
            </h2>

            @foreach (var exercise in _exercises)
            {
                <div class="card mb-4 shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0">
                            <i class="bi bi-@GetExerciseIcon(exercise.Type)"></i> @exercise.Title
                        </h4>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(exercise.InstructionsMarkdown))
                        {
                            <div class="alert alert-info">
                                @((MarkupString)Markdig.Markdown.ToHtml(exercise.InstructionsMarkdown))
                            </div>
                        }

                        <div class="exercise-content bg-light p-4 rounded">
                            @switch (exercise.Type)
                            {
                                case "circuit":
                                    <CircuitSimulator Exercise="exercise" />
                                    break;
                                case "timeline":
                                    <TimelineExercise Exercise="exercise" />
                                    break;
                                case "drag-drop":
                                    <DragDropExercise Exercise="exercise" />
                                    break;
                                case "matching":
                                    <MatchingExercise Exercise="exercise" />
                                    break;
                                case "molecule":
                                default:
                                    <div class="alert alert-warning">
                                        <i class="bi bi-tools"></i>
                                        <strong>Vývoj probíhá:</strong> Interaktivní komponenta pro typ "@exercise.Type" bude brzy dostupná.
                                    </div>
                                    break;
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
        </section>
    }

    <div class="ai-box">
        <h3 style="text-decoration: none;"><i class="bi bi-stars"></i> AI Chat o článku</h3>

        <AiChatBox PostId="@Id" ShowEmptyPrompt="false" PostTitle="@(_post?.Title ?? string.Empty)" />
    </div>

    @if (_relatedPosts != null && _relatedPosts.Any())
    {
        <div class="intro related-posts">
            <h3 style="margin: 0">
                Související články
            </h3>

            <div class="">
                @foreach (var relatedPost in _relatedPosts)
                {
                    var relatedPostData = _allPosts?.FirstOrDefault(p => p.Id == relatedPost.RelatedPostId);
                    if (relatedPostData != null)
                    {
                        <a href="/post/@relatedPost.RelatedPostId">
                        <div class="related-posts-div">

                            <h5 >
                                @relatedPostData.Title
                            </h5>
                            @if (!string.IsNullOrEmpty(relatedPost.Text))
                            {
                                <span class="related-posts-text">
                                    @relatedPost.Text
                                </span>
                            }
                        </div>
                        </a>
                    }
                }
            </div>
        </div>
    }
}

<AddendumModal IsVisible="@_showAddendumModal" IsVisibleChanged="@OnAddendumModalClose" AddendumId="@_selectedAddendumId" />
<PersonModal IsVisible="@_showPersonModal" IsVisibleChanged="@OnPersonModalClose" PersonName="@_personNameForModal" />

@using Tobiso.Web.App.Components.Shared
@code {
    [Parameter]
    public int Id { get; set; }
    private PostResponse? _post;
    /// <summary>The version selected by the server (Versions[0] when gradeId was passed, or highest grade otherwise).</summary>
    private PostVersionResponse? ActiveVersion => _post?.Versions?.FirstOrDefault();
    private List<PostSummaryResponse>? _allPosts;
    private List<PersonSummaryResponse>? _allPeople;
    private List<RelatedPostResponse>? _relatedPosts;
    private List<CategoryResponse>? _breadcrumbCategories;
    private string? _returnUrl;
    private string? _fileSuffix;
    private bool _hasQuestions = false;
    private bool _isShared = false;
    private bool _showAddendumModal = false;
    private int? _selectedAddendumId = null;
    private DotNetObjectReference<PostDetail>? _dotNetRef;
    private bool _isFocusMode = false;
    // Reading preferences state
    private bool _showReadingPanel = false;
    private string _readingFont = string.Empty;
    private int _readingFontSizeStep = 2; // default index -> 20px
    private int _readingLineWidthStep = 4; // default -> no limit (new index after adding 140ch)
    private readonly int[] _fontSizes = new[] { 14, 17, 20, 22, 24, 26, 28 };
    private readonly string[] _lineWidths = new[] { "55ch", "75ch", "100ch", "140ch", "" };
    private readonly string FontGeorgia = "Georgia, 'Times New Roman', serif";
    private readonly string FontArial = "Arial, Helvetica, sans-serif";
    private readonly string FontMono = "'Courier New', Courier, monospace";
    private List<InteractiveExerciseResponse>? _exercises;
    private IJSObjectReference? _jsModule;
    private bool _aiAvailable = true;
    private string? _aiDiagError = null;
    // Table of Contents state
    private record TocItem(string Id, string Text, int Level);
    private List<TocItem> _tocItems = new();
    private string? _activeTocId = null;
    private string? _lastExtractedContentHash = null;

    protected override async Task OnInitializedAsync()
    {
        var preferredGrade = await PreferenceService.GetPreferredGradeIdAsync();
        // Pass gradeId to API so server picks best matching version (BestMatch logic).
        // No client-side version selection needed.
        _post = await Api.GetPostById(Id, preferredGrade);
        _allPosts = (await Api.GetPostSummaries()).ToList();

        // Check AI availability (runs against App's /api/ai/diag endpoint)
            try
            {
                var diag = await Http.GetAsync(new Uri(Navigation.BaseUri + "api/ai/diag"));
                if (diag.IsSuccessStatusCode)
                {
                    _aiAvailable = true;
                    _aiDiagError = null;
                    try
                    {
                        var names = await Http.GetFromJsonAsync<List<string>>(new Uri(Navigation.BaseUri + $"api/ai/detect-persons/{Id}"));
                        _allPeople = (names ?? new List<string>()).Select(n => new PersonSummaryResponse { Id = 0, Name = n, Slug = null, Aliases = null }).ToList();
                    }
                    catch
                    {
                        _allPeople = new List<PersonSummaryResponse>();
                    }
                }
                else
                {
                    _aiAvailable = false;
                    var body = await diag.Content.ReadAsStringAsync();
                    _aiDiagError = body;
                    // Fallback to empty list if AI detection isn't available
                    _allPeople = new List<PersonSummaryResponse>();
                }
            }
            catch (Exception ex)
            {
                _aiAvailable = false;
                _aiDiagError = ex.Message;
                _allPeople = new List<PersonSummaryResponse>();
            }
        await LoadBreadcrumb();
        SetFileSuffix();
        await CheckForQuestions();
        await LoadRelatedPosts();
        await LoadExercises();
    }

    protected override async Task OnParametersSetAsync()
    {
        var uri = new Uri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        _returnUrl = query.TryGetValue("returnUrl", out var val) ? val.ToString() : null;
        var preferredGrade2 = await PreferenceService.GetPreferredGradeIdAsync();
        // Pass gradeId to API so server picks best matching version.
        _post = await Api.GetPostById(Id, preferredGrade2);
        _allPosts = (await Api.GetPostSummaries()).ToList();
        await LoadBreadcrumb();
        SetFileSuffix();
        await CheckForQuestions();
        await LoadRelatedPosts();
        await LoadExercises();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await Js.InvokeVoidAsync("eval", @"
                window.requestAddendum = function(addendumId) {
                    DotNet.invokeMethodAsync('Tobiso.Web.App', 'TriggerAddendum', addendumId);
                };
                window.openPersonCard = function(personId) {
                    DotNet.invokeMethodAsync('Tobiso.Web.App', 'TriggerPerson', personId);
                };
                window.openPersonByName = function(name){
                    DotNet.invokeMethodAsync('Tobiso.Web.App', 'TriggerPersonByName', name);
                };
                // Delegated click handler for person links (a[data-person-name]) so clicks on
                // dynamically rendered content trigger the Blazor modal. Uses closest() to
                // handle clicks on inner <i> elements.
                document.addEventListener('click', function(e){
                    try {
                        var tgt = e.target;
                        if (!tgt || !tgt.closest) return;
                        var a = tgt.closest('a[data-person-name]');
                        if (!a) return;
                        e.preventDefault();
                        var name = a.getAttribute('data-person-name') || (a.dataset && a.dataset.personName) || '';
                        if (!name) return;
                        if (window.openPersonByName) {
                            window.openPersonByName(name);
                        } else if (window.__postDetailRef) {
                            window.__postDetailRef.invokeMethodAsync('TriggerPersonByName', name);
                        } else {
                            try { DotNet.invokeMethodAsync('Tobiso.Web.App', 'TriggerPersonByName', name); } catch(_){}
                        }
                    } catch (err) { /* ignore */ }
                }, false);
                // Initialize instance bridge and fullscreen listener
                window.__initPostDetail = function(dotnet){
                    window.__postDetailRef = dotnet;
                    document.addEventListener('fullscreenchange', function(){
                        if (!document.fullscreenElement && window.__postDetailRef) {
                            // Ensure our custom focus styles are also removed
                            try{ document.body.classList.remove('focus-mode'); }catch(e){}
                            window.__postDetailRef.invokeMethodAsync('OnExternalFullscreenExit');
                        }
                    });
                    // Also react to ESC directly to clear our styles
                    document.addEventListener('keydown', function(e){
                        if (e && (e.key === 'Escape' || e.code === 'Escape')) {
                            if (document.body.classList.contains('focus-mode')) {
                                try{ document.body.classList.remove('focus-mode'); }catch(_){}
                                if (window.__postDetailRef) {
                                    window.__postDetailRef.invokeMethodAsync('OnExternalFullscreenExit');
                                }
                            }
                        }
                    });
                };
            ");
            // Pass DotNet object reference to JS to enable instance callbacks
            await Js.InvokeVoidAsync("__initPostDetail", _dotNetRef);
            // Import our JS module and initialize delegated handlers (person links, lightbox).
            try
            {
                _jsModule ??= await Js.InvokeAsync<IJSObjectReference>("import", "/js/blazor-utils.js?v=10");
                try { await _jsModule.InvokeVoidAsync("initPersonLinkHandler", _dotNetRef); } catch { }
                try { await _jsModule.InvokeVoidAsync("initImageLightbox", "content"); } catch { }
            }
            catch { /* ignore */ }
            // Load persisted reading preferences from localStorage (if present)
            try
            {
                var font = await Js.InvokeAsync<string>("localStorage.getItem", "readingFont");
                if (!string.IsNullOrEmpty(font)) _readingFont = font;
                var sz = await Js.InvokeAsync<string>("localStorage.getItem", "readingFontSizeStep");
                if (int.TryParse(sz, out var s)) _readingFontSizeStep = Math.Clamp(s, 0, _fontSizes.Length - 1);
                var lw = await Js.InvokeAsync<string>("localStorage.getItem", "readingLineWidthStep");
                if (int.TryParse(lw, out var w)) _readingLineWidthStep = Math.Clamp(w, 0, _lineWidths.Length - 1);
                // Always apply reading styles so default font (set in OnInitialized)
                // takes effect even when no persisted preferences exist.
                await ApplyReadingStylesAsync();
                StateHasChanged();
            }
            catch { }
        }

            // Re-run module initialization in case module wasn't available earlier; keep non-fatal.
            try
            {
            _jsModule ??= await Js.InvokeAsync<IJSObjectReference>("import", "/js/blazor-utils.js?v=10");
                await _jsModule.InvokeVoidAsync("initPersonLinkHandler", _dotNetRef);
                await _jsModule.InvokeVoidAsync("initImageLightbox", "content");
                // If markdown content, extract headings and initialize TOC observer
                try
                {
                    if (_fileSuffix == ".md")
                    {
                        var headings = await _jsModule.InvokeAsync<object[]>("extractHeadings", "content");
                        var newTocs = new List<TocItem>();
                        if (headings != null)
                        {
                            foreach (var h in headings)
                            {
                                // h is a JsonElement-ish object; deserialize via System.Text.Json
                                try
                                {
                                    var json = System.Text.Json.JsonSerializer.Serialize(h);
                                    var parsed = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(json);
                                    if (parsed != null && parsed.ContainsKey("id") && parsed.ContainsKey("text") && parsed.ContainsKey("level"))
                                    {
                                        var id = parsed["id"]?.ToString() ?? string.Empty;
                                        var text = parsed["text"]?.ToString() ?? string.Empty;
                                        var level = int.TryParse(parsed["level"]?.ToString(), out var lv) ? lv : 2;
                                        newTocs.Add(new TocItem(id, text, level));
                                    }
                                }
                                catch { }
                            }
                        }

                        // compute a simple hash to detect content changes (avoid reinit loop)
                        var hash = string.Join("|", newTocs.Select(t => t.Id + ":" + t.Text));
                        if (hash != _lastExtractedContentHash)
                        {
                            _tocItems = newTocs;
                            _lastExtractedContentHash = hash;
                            StateHasChanged();
                        }

                        // Initialize observer with ids
                        try
                        {
                            var ids = _tocItems.Select(t => t.Id).ToArray();
                            await _jsModule.InvokeVoidAsync("initTocObserver", _dotNetRef, ids);
                            // Also ask JS to emit headings back to this DotNet instance after any delayed DOM changes
                            await _jsModule.InvokeVoidAsync("emitHeadingsToDotNet", "content", _dotNetRef);
                        }
                        catch { }
                    }
                }
                catch { }
            }
            catch { /* ignore */ }
    }

