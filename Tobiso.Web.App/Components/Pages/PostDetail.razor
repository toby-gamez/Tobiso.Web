@page "/post/{Id:int}"
@page "/post/{Slug}"
@implements IAsyncDisposable
@using System.Threading
@using Tobiso.Web.Shared.Interfaces
@inject IPostService PostService
@inject ICategoryService CategoryService
@inject IRelatedPostService RelatedPostService
@inject IQuestionService QuestionService
@inject IUserProgressService UserProgressService
@inject IInteractiveExerciseService ExerciseService
@inject IUserService UserService
@inject ITobisoAnonymApi AnonymApi
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject IAiService AiService
@inject Tobiso.Web.App.Services.IAiUsageGuard UsageGuard

<PageTitle>@(_post?.Title ?? "Článek") - Tobiso</PageTitle>

@if (_loading)
{
    <div style="display:flex; flex-direction:column; gap:var(--space-4); max-width:800px">
        <div class="skeleton" style="height:16px; width:200px"></div>
        <div class="skeleton" style="height:44px; width:70%"></div>
        <div class="skeleton" style="height:20px; width:300px"></div>
        <div class="skeleton" style="height:52px; border-radius:999px"></div>
        <div class="skeleton" style="height:300px; border-radius:var(--radius-lg)"></div>
    </div>
}
else if (_post == null)
{
    <div style="text-align:center; padding:var(--space-8)">
        <h1>Článek nenalezen</h1>
        <a href="/" class="pill" style="margin-top:var(--space-4)">Zpět domů</a>
    </div>
}
else
{
    <div class="post-detail-layout">
        <div class="post-body">
            <nav class="breadcrumb" style="margin-bottom:var(--space-4)">
                <a href="/categories">Předměty</a>
                @foreach (var anc in _ancestors)
                {
                    <span class="breadcrumb-sep">/</span>
                    <a href="/categories/@anc.Id">@anc.Name</a>
                }
                <span class="breadcrumb-sep">/</span>
                <span>@_post.Title</span>
            </nav>

            <div class="post-title-row">
                <h1 class="post-h1">@_post.Title</h1>
                <div class="grade-selector">
                    @if (_currentVersion != null)
                    {
                        <span class="grade-chip" style="font-size:13px; font-weight:600; padding:6px 14px">@(_currentVersion.GradeName ?? "-")</span>
                        <button class="icon-btn" @onclick="ToggleVersions" aria-label="Vybrat ročník">
                            <i data-lucide="chevron-down"></i>
                        </button>
                    }
                    @if (_versionsOpen)
                    {
                        <div class="version-dropdown">
                            @foreach (var v in _versions)
                            {
                                <button class="version-item @(v.Id == _currentVersion?.Id ? "active" : "")"
                                        @onclick="@(() => SelectVersion(v))">
                                    @v.GradeName
                                </button>
                            }
                            @if (_versions.Count > 1)
                            {
                                <div class="version-dropdown-divider"></div>
                            }
                            <button class="version-item ai-rewrite-trigger @(_activeAiTool == "rewrite" ? "active" : "")" @onclick="OpenRewriteFromDropdown" title="@AiToolDescription("rewrite")">
                                <i data-lucide="sparkles"></i> Jiný ročník
                            </button>
                        </div>
                    }
                </div>
            </div>

            <div class="post-meta">
                <span><i data-lucide="book-open"></i> @CzechPlural.Slova(WordCount) · @ReadTime min čtení</span>
                <span style="opacity:.4">·</span>
                <span>Upraveno @FormatDateTime(MostRecentEdit)</span>
                @if (_currentVersion?.LastFix.HasValue == true)
                {
                    <span style="opacity:.4">·</span>
                    <span style="color:var(--color-accent-2-700)"><i data-lucide="check-circle-2"></i> Zkontrolováno</span>
                }
            </div>

            <div class="toolbar">
                <button class="toolbar-btn" @onclick="ScrollToQuiz">
                    <i data-lucide="file-check-2"></i> Ověř si porozumění
                </button>
                <button class="toolbar-btn @(_readingOpen ? "active" : "")" @onclick="ToggleReading">
                    <i data-lucide="type"></i> Čtení
                </button>
                @if (_exercises.Count > 0)
                {
                    <button class="toolbar-btn" @onclick="ScrollToExercises">
                        <i data-lucide="puzzle"></i> Cvičení
                    </button>
                }
                <button class="toolbar-btn" style="opacity:.5; cursor:not-allowed">
                    <i data-lucide="volume-2"></i> Poslech
                </button>
                <span style="flex:1"></span>
                <button class="icon-btn @(_bookmarked ? "bookmarked" : "")" @onclick="ToggleBookmark" aria-label="Záložka">
                    <i data-lucide="bookmark"></i>
                </button>
                <button class="pill pill-on" style="font-size:14px; padding:9px 16px" @onclick="ToggleMore">
                    <i data-lucide="sparkles"></i> Více
                </button>
            </div>

            @if (_notesOpen)
            {
                <div class="notes-panel">
                    @if (!_userId.HasValue)
                    {
                        <p style="margin:0; font-size:14px; color:var(--color-neutral-600)">
                            Pro poznámky se musíš <a href="/prihlaseni">přihlásit</a>.
                        </p>
                    }
                    else
                    {
                        <div class="panel-label"><i data-lucide="notebook-pen"></i> Moje poznámky k článku</div>
                        <textarea class="notes-textarea" placeholder="Piš si sem poznámky k tomuto článku…"
                                  @bind="_noteContent" @bind:event="oninput" @onblur="SaveNote"></textarea>
                        <div class="notes-footer">
                            <button class="pill pill-on" style="font-size:13px; padding:8px 16px" disabled="@_noteSaving" @onclick="SaveNoteAndClose">
                                @(_noteSaving ? "Ukládám…" : "Uložit")
                            </button>
                            @if (_noteSavedAt.HasValue)
                            {
                                <span style="font-size:13px; color:var(--color-neutral-600)">Uloženo @_noteSavedAt.Value.ToString("HH:mm")</span>
                            }
                        </div>
                    }
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(_noteContent))
            {
                <button class="notes-preview" @onclick="ToggleNotes">
                    <i data-lucide="notebook-pen"></i>
                    <span class="notes-preview-text">@_noteContent</span>
                </button>
            }

            @if (_readingOpen)
            {
                <div class="reading-panel">
                    <div>
                        <div class="panel-label">Písmo</div>
                        <div class="seg-control">
                            <button class="seg-btn @(_readingFont == "figtree" ? "active" : "")" @onclick='@(() => _readingFont = "figtree")'>Figtree</button>
                            <button class="seg-btn @(_readingFont == "serif" ? "active" : "")" @onclick='@(() => _readingFont = "serif")'>Serif</button>
                            <button class="seg-btn @(_readingFont == "mono" ? "active" : "")" @onclick='@(() => _readingFont = "mono")'>Mono</button>
                        </div>
                    </div>
                    <div>
                        <div class="panel-label">Velikost</div>
                        <div class="seg-control">
                            <button class="seg-btn @(_readingSize == "sm" ? "active" : "")" @onclick='@(() => _readingSize = "sm")' style="font-size:11px">A</button>
                            <button class="seg-btn @(_readingSize == "md" ? "active" : "")" @onclick='@(() => _readingSize = "md")'>A</button>
                            <button class="seg-btn @(_readingSize == "lg" ? "active" : "")" @onclick='@(() => _readingSize = "lg")' style="font-size:18px">A</button>
                        </div>
                    </div>
                    <div>
                        <div class="panel-label">Šířka sloupce</div>
                        <div class="seg-control">
                            <button class="seg-btn @(_readingWidth == "narrow" ? "active" : "")" @onclick='@(() => _readingWidth = "narrow")'>Úzká</button>
                            <button class="seg-btn @(_readingWidth == "mid" ? "active" : "")" @onclick='@(() => _readingWidth = "mid")'>Střední</button>
                            <button class="seg-btn @(_readingWidth == "wide" ? "active" : "")" @onclick='@(() => _readingWidth = "wide")'>Široká</button>
                        </div>
                    </div>
                </div>
            }

            @if (_moreOpen)
            {
                <div class="more-panel">
                    <div class="more-panel-label">Nástroje k článku</div>
                    <button class="more-item @(_activeAiTool == "flashcards" ? "active" : "")" @onclick="ToggleFlashcards">
                        <i data-lucide="layers" style="color:var(--color-accent-600)"></i> <span style="flex:1">Kartičky</span>
                        <span class="more-item-help" title="@AiToolDescription("flashcards")"><i data-lucide="info"></i></span>
                    </button>
                    <button class="more-item @(_activeAiTool == "practice" ? "active" : "")" @onclick="TogglePractice">
                        <i data-lucide="pencil-line" style="color:var(--color-accent-600)"></i> <span style="flex:1">Procvičovací úlohy</span>
                        <span class="more-item-help" title="@AiToolDescription("practice")"><i data-lucide="info"></i></span>
                    </button>
                    <button class="more-item @(_activeAiTool == "exam" ? "active" : "")" @onclick="ToggleExam">
                        <i data-lucide="help-circle" style="color:var(--color-accent-600)"></i> <span style="flex:1">Co může přijít v testu</span>
                        <span class="more-item-help" title="@AiToolDescription("exam")"><i data-lucide="info"></i></span>
                    </button>
                    <button class="more-item @(_activeAiTool == "realworld" ? "active" : "")" @onclick="ToggleRealWorld">
                        <i data-lucide="globe-2" style="color:var(--color-accent-2-600)"></i> <span style="flex:1">Reálné využití</span>
                        <span class="more-item-help" title="@AiToolDescription("realworld")"><i data-lucide="info"></i></span>
                    </button>
                    <button class="more-item @(_activeAiTool == "whatif" ? "active" : "")" @onclick="ToggleWhatIf">
                        <i data-lucide="wand-2" style="color:var(--color-accent-2-600)"></i> <span style="flex:1">Co kdyby?</span>
                        <span class="more-item-help" title="@AiToolDescription("whatif")"><i data-lucide="info"></i></span>
                    </button>
                    <button class="more-item @(_activeAiTool == "feynman" ? "active" : "")" @onclick="ToggleFeynman">
                        <i data-lucide="message-square-quote" style="color:var(--color-accent-2-600)"></i> <span style="flex:1">Zkus to vysvětlit</span>
                        <span class="more-item-help" title="@AiToolDescription("feynman")"><i data-lucide="info"></i></span>
                    </button>
                    <button class="more-item @(_activeAiTool == "compare" ? "active" : "")" @onclick="ToggleCompare">
                        <i data-lucide="table-2" style="color:var(--color-accent-2-600)"></i> <span style="flex:1">Porovnat s…</span>
                        <span class="more-item-help" title="@AiToolDescription("compare")"><i data-lucide="info"></i></span>
                    </button>
                    <button class="more-item @(_activeAiTool == "stepsolver" ? "active" : "")" @onclick="ToggleStepSolver">
                        <i data-lucide="list-ordered" style="color:var(--color-accent-2-600)"></i> <span style="flex:1">Krok za krokem</span>
                        <span class="more-item-help" title="@AiToolDescription("stepsolver")"><i data-lucide="info"></i></span>
                    </button>
                    <div style="grid-column:1/-1; height:1px; background:var(--color-divider); margin:var(--space-1) 0"></div>
                    <button class="more-item" @onclick="PrintPost"><i data-lucide="printer"></i> Vytisknout (PDF)</button>
                    <button class="more-item" @onclick="DownloadCheatSheet"><i data-lucide="file-text"></i> Tahák (PDF)</button>
                    <button class="more-item" @onclick="TogglePomodoro"><i data-lucide="alarm-clock"></i> Pomodoro</button>
                    <button class="more-item @(_notesOpen ? "active" : "")" @onclick="ToggleNotes"><i data-lucide="notebook-pen"></i> Poznámky</button>
                </div>
            }

            @if (_activeAiTool != null)
            {
                <div class="ai-tool-panel" id="ai-tool-panel">
                    <div class="ai-tool-header">
                        <span class="ai-tool-title">
                            <i data-lucide="@AiToolIcon(_activeAiTool)"></i> @AiToolTitle(_activeAiTool)
                            <span class="more-item-help" title="@AiToolDescription(_activeAiTool)"><i data-lucide="info"></i></span>
                        </span>
                        <button class="icon-btn" @onclick="CloseAiTool" aria-label="Zavřít">
                            <i data-lucide="x"></i>
                        </button>
                    </div>

                    @if (_aiToolLoading)
                    {
                        <div style="display:flex; flex-direction:column; gap:8px">
                            <div class="skeleton" style="height:16px; width:70%"></div>
                            <div class="skeleton" style="height:16px; width:50%"></div>
                            <div class="skeleton" style="height:16px; width:60%"></div>
                        </div>
                    }
                    else if (_aiToolError != null)
                    {
                        <p style="margin:0; font-size:14px; color:var(--color-neutral-600)">@_aiToolError</p>
                    }
                    else if (_activeAiTool == "flashcards")
                    {
                        @if (_flashcards.Count == 0)
                        {
                            <p style="margin:0; font-size:14px; color:var(--color-neutral-600)">Pro tento článek se nepodařilo vytvořit kartičky.</p>
                        }
                        else if (_flashcardIndex >= _flashcards.Count)
                        {
                            <div class="ai-flashcard-done">
                                <i data-lucide="check-circle-2"></i>
                                <h3 style="margin:0">Hotovo!</h3>
                                <p style="margin:0; color:var(--color-neutral-600)">Prošel/prošla jsi @_flashcards.Count kartiček.</p>
                                <button class="pill pill-on" @onclick="RestartFlashcards"><i data-lucide="rotate-cw"></i> Projít znovu</button>
                            </div>
                        }
                        else
                        {
                            var card = _flashcards[_flashcardIndex];
                            <div class="quiz-progress-label">
                                <span>Kartičky</span>
                                <span>@(_flashcardIndex + 1) z @_flashcards.Count</span>
                            </div>
                            <div class="progress-bar"><div class="progress-bar-fill" style="width:@(FlashcardProgress)%"></div></div>

                            <button class="flashcard @(_flashcardFlipped ? "flipped" : "")" @onclick="@(() => _flashcardFlipped = !_flashcardFlipped)">
                                <div class="flashcard-face flashcard-front">
                                    <span>@card.Term</span>
                                    <span class="flashcard-hint">Klikni pro odpověď</span>
                                </div>
                                <div class="flashcard-face flashcard-back">
                                    <span>@card.Definition</span>
                                </div>
                            </button>

                            @if (_flashcardFlipped)
                            {
                                <div style="display:flex; gap:var(--space-2)">
                                    <button class="pill" style="flex:1; justify-content:center" @onclick="@(() => AdvanceFlashcard(false))">
                                        <i data-lucide="rotate-ccw"></i> Musím zopakovat
                                    </button>
                                    <button class="pill pill-on" style="flex:1; justify-content:center" @onclick="@(() => AdvanceFlashcard(true))">
                                        <i data-lucide="check"></i> Umím
                                    </button>
                                </div>
                            }
                        }
                    }
                    else if (_activeAiTool == "practice")
                    {
                        @if (_practiceProblems.Count == 0)
                        {
                            <p style="margin:0; font-size:14px; color:var(--color-neutral-600)">Procvičovací úlohy se nepodařilo vygenerovat.</p>
                        }
                        else
                        {
                            <div class="ai-tool-list">
                                @foreach (var (p, i) in _practiceProblems.Select((p, i) => (p, i)))
                                {
                                    <div class="ai-tool-item">
                                        <div class="ai-tool-item-header">
                                            <span class="ai-tool-index">@(i + 1)</span>
                                            <span style="flex:1">@p.ProblemText</span>
                                            @if (!string.IsNullOrWhiteSpace(p.Difficulty))
                                            {
                                                <span class="grade-chip">@p.Difficulty</span>
                                            }
                                        </div>
                                        @if (_practiceRevealed.Contains(i))
                                        {
                                            <div class="ai-tool-solution">@p.Solution</div>
                                        }
                                        else
                                        {
                                            <button class="pill" style="font-size:13px; padding:7px 14px; align-self:flex-start" @onclick="@(() => { _practiceRevealed.Add(i); })">Zobrazit řešení</button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                    else if (_activeAiTool == "rewrite")
                    {
                        @if (_grades.Count == 0)
                        {
                            <p style="margin:0; font-size:14px; color:var(--color-neutral-600)">Ročníky se nepodařilo načíst.</p>
                        }
                        else
                        {
                            <p style="margin:0 0 var(--space-1); font-size:14px; color:var(--color-neutral-600)">
                                Vyber ročník - AI přepíše celý text článku níže na stránce.
                            </p>
                            <div class="seg-control" style="flex-wrap:wrap">
                                @foreach (var g in _grades.OrderBy(g => g.Level))
                                {
                                    <button class="seg-btn @(_rewriteGradeId == g.Id ? "active" : "")" disabled="@_rewriteLoading" @onclick="@(() => SelectRewriteGrade(g))">@g.Name</button>
                                }
                            </div>
                            @if (_rewriteLoading)
                            {
                                <div style="display:flex; flex-direction:column; gap:8px; margin-top:var(--space-3)">
                                    <div class="skeleton" style="height:14px; width:90%"></div>
                                    <div class="skeleton" style="height:14px; width:75%"></div>
                                </div>
                            }
                            else if (_rewriteError != null)
                            {
                                <p class="ai-tool-error">@_rewriteError</p>
                            }
                        }
                    }
                    else if (_activeAiTool == "exam")
                    {
                        @if (string.IsNullOrWhiteSpace(_examSummary))
                        {
                            <p style="margin:0; font-size:14px; color:var(--color-neutral-600)">Shrnutí se nepodařilo vygenerovat.</p>
                        }
                        else
                        {
                            <div class="ai-tool-markdown ai-tool-exam-summary">
                                <MarkdownContent Content="@_examSummary" ContainerId="ai-exam-summary" DetectLead="false" />
                            </div>
                            <button class="pill" style="align-self:flex-start" @onclick="GeneratePracticeFromExam">
                                <i data-lucide="pencil-line"></i> Vygenerovat procvičovací úlohy
                            </button>
                        }
                    }
                    else if (_activeAiTool == "realworld")
                    {
                        @if (_realWorldApps.Count == 0)
                        {
                            <p style="margin:0; font-size:14px; color:var(--color-neutral-600)">Příklady se nepodařilo najít.</p>
                        }
                        else
                        {
                            <ul class="ai-tool-bullets">
                                @foreach (var app in _realWorldApps)
                                {
                                    <li><span class="facts-bullet">✳</span> @app</li>
                                }
                            </ul>
                        }
                    }
                    else if (_activeAiTool == "whatif")
                    {
                        @if (_whatIfResult != null)
                        {
                            <div class="ai-tool-result">
                                <div class="ai-tool-result-title">@_whatIfResult.Scenario</div>
                                <p style="margin:8px 0 0">@_whatIfResult.Explanation</p>
                            </div>
                        }
                        @if (_whatIfError != null)
                        {
                            <p class="ai-tool-error">@_whatIfError</p>
                        }
                        <div class="ai-tool-followup">
                            <input class="input" @bind="_whatIfQuestion" @bind:event="oninput" @onkeydown="HandleWhatIfKeydown"
                                   placeholder="Zeptej se na vlastní otázku „co kdyby…”" disabled="@_whatIfLoading" />
                            <button class="icon-btn ai-tool-send" disabled="@_whatIfLoading" @onclick="AskWhatIf" aria-label="Zeptat se">
                                <i data-lucide="send"></i>
                            </button>
                        </div>
                        <button class="ai-tool-linklike" disabled="@_whatIfLoading" @onclick="AskWhatIfRandom">
                            <i data-lucide="shuffle"></i> @(_whatIfLoading ? "Přemýšlím…" : "Jiná náhodná otázka")
                        </button>
                    }
                    else if (_activeAiTool == "feynman")
                    {
                        <div class="field">
                            <label>Vysvětli tuto látku vlastními slovy</label>
                            <textarea class="input notes-textarea" style="min-height:120px" @bind="_feynmanExplanation" @bind:event="oninput"
                                      placeholder="Zkus vysvětlit, jako bys to učil mladšího spolužáka…"></textarea>
                        </div>
                        <button class="pill pill-on" style="font-size:14px; padding:9px 16px; margin-top:var(--space-3)"
                                disabled="@(_feynmanLoading || string.IsNullOrWhiteSpace(_feynmanExplanation))" @onclick="SubmitFeynman">
                            @(_feynmanLoading ? "Hodnotím…" : "Ohodnotit")
                        </button>
                        @if (_feynmanError != null)
                        {
                            <p class="ai-tool-error">@_feynmanError</p>
                        }
                        @if (_feynmanResult != null)
                        {
                            <div class="ai-tool-result">
                                <div style="display:flex; align-items:center; gap:10px">
                                    <span class="grade-chip">@_feynmanResult.Score / 10</span>
                                    <span>@_feynmanResult.Feedback</span>
                                </div>
                                @if (_feynmanResult.StrongPoints.Count > 0)
                                {
                                    <div class="panel-label" style="margin-top:12px">Co ti šlo</div>
                                    <ul class="ai-tool-bullets">
                                        @foreach (var s in _feynmanResult.StrongPoints)
                                        {
                                            <li><span class="facts-bullet">✓</span> @s</li>
                                        }
                                    </ul>
                                }
                                @if (_feynmanResult.MissingPoints.Count > 0)
                                {
                                    <div class="panel-label" style="margin-top:12px">Co ti uniklo</div>
                                    <ul class="ai-tool-bullets">
                                        @foreach (var m in _feynmanResult.MissingPoints)
                                        {
                                            <li><span class="facts-bullet">＋</span> @m</li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                    }
                    else if (_activeAiTool == "compare")
                    {
                        <div class="field">
                            <label>Porovnat s</label>
                            <input class="input" @bind="_compareTerm" @bind:event="oninput" @onkeydown="HandleCompareKeydown" placeholder="Např. mitóza" />
                        </div>
                        <button class="pill pill-on" style="font-size:14px; padding:9px 16px; margin-top:var(--space-3)"
                                disabled="@(_compareLoading || string.IsNullOrWhiteSpace(_compareTerm))" @onclick="SubmitCompare">
                            @(_compareLoading ? "Porovnávám…" : "Porovnat")
                        </button>
                        @if (_compareError != null)
                        {
                            <p class="ai-tool-error">@_compareError</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(_compareMarkdown))
                        {
                            <div class="ai-tool-markdown ai-tool-compare-table">
                                <MarkdownContent Content="@_compareMarkdown" ContainerId="ai-compare-table" DetectLead="false" />
                            </div>
                        }
                    }
                    else if (_activeAiTool == "stepsolver")
                    {
                        @if (_stepSolverSteps.Count == 0)
                        {
                            <p style="margin:0; font-size:14px; color:var(--color-neutral-600)">Postup se nepodařilo vygenerovat.</p>
                        }
                        else
                        {
                            <ol class="ai-tool-steps">
                                @foreach (var s in _stepSolverSteps)
                                {
                                    <li><strong>@s.Step</strong><span>@s.Explanation</span></li>
                                }
                            </ol>
                        }
                    }
                </div>
            }

            @if (_rewrittenContent != null)
            {
                <div class="ai-rewrite-banner">
                    <span><i data-lucide="sparkles"></i> Text níže byl přepsán pomocí AI pro @_rewrittenGradeName.</span>
                    <button class="pill" style="font-size:13px; padding:7px 14px" @onclick="RevertRewrite">
                        <i data-lucide="undo-2"></i> Zpět na originál
                    </button>
                </div>
            }

            <div id="article-prose" class="@ProseClass">
                @if (_rewrittenContent != null)
                {
                    <MarkdownContent Content="@_rewrittenContent"
                                     ContainerId="article-prose"
                                     DetectLead="false"
                                     OnHeadingsExtracted="OnHeadingsExtracted" />
                }
                else if (_currentVersion != null)
                {
                    <MarkdownContent Content="@_currentVersion.Content"
                                     AllPosts="@_allPosts"
                                     AllPeople="@_allPeople"
                                     ContainerId="article-prose"
                                     OnHeadingsExtracted="OnHeadingsExtracted" />
                }
            </div>

            <button class="facts-toggle" @onclick="ToggleFacts">
                <span><i data-lucide="lightbulb" style="color:var(--color-accent-600)"></i> Věděl jsi, že…?</span>
                <i data-lucide="@(_factsOpen ? "chevron-up" : "chevron-down")"></i>
            </button>
            @if (_factsOpen)
            {
                <div class="facts-panel">
                    @if (_factsLoading)
                    {
                        <div class="skeleton" style="height:16px; width:80%"></div>
                        <div class="skeleton" style="height:16px; width:60%; margin-top:8px"></div>
                    }
                    else if (_factsError != null)
                    {
                        <span style="color:var(--color-neutral-600)">@_factsError</span>
                    }
                    else
                    {
                        <ul>
                            @foreach (var fact in _facts)
                            {
                                <li><span class="facts-bullet">✳</span> @fact</li>
                            }
                        </ul>
                    }
                </div>
            }

            @if (_exercises.Count > 0)
            {
                <div id="exercises-section" style="margin-top:var(--space-8)">
                    <div style="display:flex; align-items:center; justify-content:space-between; gap:var(--space-3); margin-bottom:var(--space-3)">
                        <h2 style="font-size:27px; margin:0"><i data-lucide="puzzle" style="color:var(--color-accent-2-600)"></i> Interaktivní cvičení</h2>
                        <span style="font-size:13px; color:var(--color-neutral-600)">@CzechPlural.Of(_exercises.Count, "cvičení", "cvičení", "cvičení")</span>
                    </div>
                    <div class="exercise-grid">
                        @foreach (var ex in _exercises)
                        {
                            <button class="exercise-card @(_openExerciseId == ex.Id ? "active" : "")" @onclick="@(() => ToggleExercise(ex.Id))">
                                <span class="exercise-kind"><i data-lucide="@ExerciseTypeDisplay.Icon(ex.Type)"></i> @ExerciseTypeDisplay.Label(ex.Type)</span>
                                <span class="exercise-title">@ex.Title</span>
                                @if (!string.IsNullOrWhiteSpace(ex.InstructionsMarkdown))
                                {
                                    <span class="exercise-desc">@ex.InstructionsMarkdown</span>
                                }
                            </button>
                        }
                    </div>
                    @if (_openExercise != null)
                    {
                        <div style="margin-top:var(--space-4)">
                            @if (_openExercise.Type == ExerciseTypeConstants.DragDrop)
                            {
                                <DragDropExercise Exercise="_openExercise" />
                            }
                            else if (_openExercise.Type == ExerciseTypeConstants.Matching)
                            {
                                <MatchingExercise Exercise="_openExercise" />
                            }
                            else if (_openExercise.Type == ExerciseTypeConstants.Timeline)
                            {
                                <TimelineExercise Exercise="_openExercise" />
                            }
                            else if (_openExercise.Type == ExerciseTypeConstants.Circuit)
                            {
                                <CircuitSimulator Exercise="_openExercise" />
                            }
                        </div>
                    }
                </div>
            }

            @if (_questions.Count > 0)
            {
                <div id="quiz-section" class="quiz-cta">
                    <div class="quiz-cta-text">
                        <span class="quiz-cta-icon"><i data-lucide="file-check-2"></i></span>
                        <div>
                            <h2>Ověř si porozumění</h2>
                            <p>Zjisti, jak dobře látku ovládáš (@CzechPlural.Otazky(_questions.Count)).</p>
                        </div>
                    </div>
                    <a href="/practice/quiz/@_post.Id" class="pill pill-on" style="font-size:15px; padding:11px 22px; flex-shrink:0">
                        Spustit kvíz <i data-lucide="arrow-right"></i>
                    </a>
                </div>
            }

            <div class="ai-ask-panel">
                <div class="ai-ask-header">
                    <span><i data-lucide="sparkles" style="color:var(--color-accent-600)"></i> Zeptej se na článek</span>
                    @if (_userId.HasValue)
                    {
                        <span class="grade-chip"><i data-lucide="coins"></i> @CzechPlural.Kredity(_credits)</span>
                    }
                </div>
                <AiChatBox PostId="@_post.Id"
                           AllowAttachPosts="false"
                           PinnedPostTitle="@_post.Title"
                           EmptyTitle="Zeptej se na cokoliv z tohoto článku."
                           Placeholder="Např. Proč se neshodný přívlastek neskloňuje?"
                           Suggestions="@(new[] { "Vysvětli jednodušeji", "Dej mi tři příklady", "Zkoušej mě" })"
                           OnAnswered="OnAiAnswered" />
            </div>

            @if (_displayRelated.Count > 0)
            {
                <div style="margin-top:var(--space-8)">
                    <h2 style="font-size:26px; margin-bottom:var(--space-4)">Souvisí s tímto</h2>
                    <div class="related-grid">
                        @foreach (var rel in _displayRelated)
                        {
                            <a href="@PostSlug.Url(rel.PostId, rel.FilePath)" class="related-card lift">
                                <span class="related-title">@rel.Title</span>
                                @if (!string.IsNullOrEmpty(rel.Text))
                                {
                                    <span class="related-desc">@rel.Text</span>
                                }
                            </a>
                        }
                    </div>
                </div>
            }

            <div style="margin-top:var(--space-8)">
                <div class="panel-label" style="margin-bottom:var(--space-3)">Jak těžký je tento článek?</div>
                @if (_myDifficultyVote.HasValue)
                {
                    <div style="display:flex; flex-direction:column; gap:var(--space-2); max-width:360px">
                        @foreach (var (label, value) in new[] { ("Snadné", 1), ("Střední", 2), ("Těžké", 3) })
                        {
                            <div style="display:flex; align-items:center; gap:var(--space-3)">
                                <span style="width:60px; font-size:13px; @(value == _myDifficultyVote ? "font-weight:700" : "")">@label</span>
                                <div class="progress-bar" style="flex:1"><div class="progress-bar-fill" style="width:@(DifficultyPercent(value))%"></div></div>
                                <span style="width:36px; font-size:13px; text-align:right; color:var(--color-neutral-600)">@(DifficultyPercent(value))%</span>
                            </div>
                        }
                    </div>
                    <div style="font-size:13px; color:var(--color-neutral-600); margin-top:var(--space-2)">
                        Děkujeme za hodnocení · @CzechPlural.Hlasy(_difficulty?.Total ?? 0)
                    </div>
                }
                else
                {
                    <div style="display:flex; gap:var(--space-2)">
                        <button class="pill" disabled="@_votingDifficulty" @onclick="@(() => RateDifficulty(1))">Snadné</button>
                        <button class="pill" disabled="@_votingDifficulty" @onclick="@(() => RateDifficulty(2))">Střední</button>
                        <button class="pill" disabled="@_votingDifficulty" @onclick="@(() => RateDifficulty(3))">Těžké</button>
                    </div>
                }
            </div>
        </div>

        <aside class="post-toc">
            @if (_tocHeaders.Count > 0)
            {
                <div class="panel-label" style="margin-bottom:var(--space-1)">Obsah</div>
                @foreach (var (text, anchor) in _tocHeaders)
                {
                    <a href="#@anchor" class="toc-link @(anchor == _activeAnchor ? "active" : "")"
                       @onclick="@(() => ScrollToHeading(anchor))" @onclick:preventDefault="true">@text</a>
                }
            }
            <div class="toc-progress">
                <div class="panel-label" style="margin-bottom:6px">Přečteno</div>
                <div class="progress-bar"><div class="progress-bar-fill" style="width:@(_readPercent)%"></div></div>
                <div style="font-size:13px; color:var(--color-neutral-600); margin-top:8px">@(_readPercent) %</div>
            </div>
        </aside>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public string? Slug { get; set; }
    [SupplyParameterFromQuery] public int? Exercise { get; set; }

    private bool _loading = true;
    private PostResponse? _post;
    private PostVersionResponse? _currentVersion;
    private List<PostVersionResponse> _versions = [];
    private List<CategoryResponse> _ancestors = [];
    private List<RelatedPostResponse> _relatedPosts = [];
    private List<DisplayRelatedPost> _displayRelated = [];
    private record DisplayRelatedPost(int PostId, string Title, string? Text, string? FilePath);
    private List<QuestionResponse> _questions = [];
    private List<PostSummaryResponse> _allPosts = [];
    private List<PersonSummaryResponse> _allPeople = [];
    private List<InteractiveExerciseResponse> _exercises = [];
    private bool _versionsOpen, _readingOpen, _moreOpen, _factsOpen, _bookmarked, _notesOpen;
    private string _noteContent = "";
    private bool _noteSaving;
    private bool _noteLoaded;
    private DateTime? _noteSavedAt;
    private string _readingFont = "figtree";
    private string _readingSize = "md";
    private string _readingWidth = "mid";
    private PostDifficultyResponse? _difficulty;
    private int? _myDifficultyVote;
    private bool _votingDifficulty;
    private bool _needsDifficultyCheck;
    private List<(string Text, string Anchor)> _tocHeaders = [];
    private string? _activeAnchor;
    private int _readPercent;
    private int _lastPersistedPercent = -1;
    private int? _userId;
    private int _credits;
    private bool _needsScrollInit;
    private DotNetObjectReference<PostDetail>? _selfRef;
    private List<string> _facts = [];
    private bool _factsLoading;
    private bool _factsLoaded;
    private string? _factsError;
    private int? _openExerciseId;
    private bool _needsExerciseScroll;
    private IJSObjectReference? _lightboxModule;

    // "Více" AI tools (Kartičky, Procvičovací úlohy, Přepsat pro ročník, ...)
    private string? _activeAiTool;
    private bool _aiToolLoading;
    private string? _aiToolError;

    private List<FlashcardCard> _flashcards = [];
    private bool _flashcardsLoaded;
    private int _flashcardIndex;
    private bool _flashcardFlipped;

    private List<PracticeProblem> _practiceProblems = [];
    private bool _practiceLoaded;
    private readonly HashSet<int> _practiceRevealed = [];

    private List<GradeResponse> _grades = [];
    private int? _rewriteGradeId;
    private bool _rewriteLoading;
    private string? _rewriteError;
    // The AI rewrite replaces the real article body (#article-prose) rather than showing in a
    // separate box, so these live outside the "Více" tool state - they persist even after the
    // rewrite panel is closed, until reverted or the post/grade version changes.
    private string? _rewrittenContent;
    private string? _rewrittenGradeName;

    private string? _examSummary;
    private bool _examLoaded;

    private List<string> _realWorldApps = [];
    private bool _realWorldLoaded;

    private string _whatIfQuestion = "";
    private bool _whatIfLoading;
    private bool _whatIfLoaded;
    private string? _whatIfError;
    private WhatIfResponse? _whatIfResult;

    private string _feynmanExplanation = "";
    private bool _feynmanLoading;
    private string? _feynmanError;
    private EvaluateComprehensionResponse? _feynmanResult;

    private string _compareTerm = "";
    private bool _compareLoading;
    private string? _compareError;
    private string? _compareMarkdown;

    private List<SolverStep> _stepSolverSteps = [];
    private bool _stepSolverLoaded;

    private InteractiveExerciseResponse? _openExercise =>
        _exercises.FirstOrDefault(e => e.Id == _openExerciseId);

    // Blazor reuses this component instance across route-parameter changes, so navigating
    // again before a previous load finishes would otherwise run two loads concurrently
    // against the same circuit-scoped DbContext. Serialize loads and drop superseded ones.
    private readonly SemaphoreSlim _loadGate = new(1, 1);
    private int _loadGeneration;
    private bool _disposed;

    protected override async Task OnParametersSetAsync()
    {
        var myGeneration = ++_loadGeneration;
        try
        {
            await _loadGate.WaitAsync();
            try
            {
                if (myGeneration != _loadGeneration) return;
                _loading = true;
                await LoadData();
                if (myGeneration != _loadGeneration) return;
                _loading = false;
            }
            finally
            {
                _loadGate.Release();
            }
        }
        catch (Exception) when (_disposed)
        {
        }
    }

    private async Task LoadData()
    {
        // Load by int ID or slug (a purely numeric slug segment is still treated as an id,
        // since links generated before a post had a resolvable slug used the bare id).
        PostResponse? post = null;
        if (Id > 0)
            post = await PostService.GetById(Id);
        else if (!string.IsNullOrEmpty(Slug))
            post = int.TryParse(Slug, out int parsedId)
                ? await PostService.GetById(parsedId)
                : await PostService.GetBySlug(Slug);

        if (post == null) return;
        _post = post;
        _versions = _post.Versions ?? [];
        _currentVersion = _versions.FirstOrDefault();

        var allCats = await CategoryService.GetAll();
        if (_post.CategoryId.HasValue)
            _ancestors = await CategoryService.GetAncestors(_post.CategoryId.Value);

        _relatedPosts = await RelatedPostService.GetByPostId(_post.Id);
        _questions = await QuestionService.GetByPostId(_post.Id);
        _allPosts = await PostService.GetSummaries();
        _exercises = await ExerciseService.GetByPostIdAsync(_post.Id);
        _openExerciseId = Exercise.HasValue && _exercises.Any(e => e.Id == Exercise.Value) ? Exercise.Value : null;
        _needsExerciseScroll = _openExerciseId.HasValue;

        await BuildDisplayRelated();

        _activeAnchor = null;
        _readPercent = 0;
        _lastPersistedPercent = -1;
        _needsScrollInit = true;
        _facts = [];
        _factsLoaded = false;
        _factsOpen = false;
        _factsError = null;

        _myDifficultyVote = null;
        _votingDifficulty = false;
        _needsDifficultyCheck = true;
        _notesOpen = false;
        _noteLoaded = false;
        _noteContent = "";
        _noteSavedAt = null;

        _activeAiTool = null;
        _aiToolLoading = false;
        _aiToolError = null;
        _flashcards = [];
        _flashcardsLoaded = false;
        _flashcardIndex = 0;
        _flashcardFlipped = false;
        _practiceProblems = [];
        _practiceLoaded = false;
        _practiceRevealed.Clear();
        _grades = [];
        _rewriteGradeId = null;
        _rewriteError = null;
        _rewrittenContent = null;
        _rewrittenGradeName = null;
        _examSummary = null;
        _examLoaded = false;
        _realWorldApps = [];
        _realWorldLoaded = false;
        _whatIfQuestion = "";
        _whatIfLoaded = false;
        _whatIfResult = null;
        _whatIfError = null;
        _feynmanExplanation = "";
        _feynmanResult = null;
        _feynmanError = null;
        _compareTerm = "";
        _compareMarkdown = null;
        _compareError = null;
        _stepSolverSteps = [];
        _stepSolverLoaded = false;
        try { _difficulty = await AnonymApi.GetPostDifficulty(_post.Id); }
        catch { _difficulty = null; }

        var auth = await AuthState.GetAuthenticationStateAsync();
        if (auth.User.Identity?.IsAuthenticated == true &&
            int.TryParse(auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out int uid))
        {
            _userId = uid;
            var bookmarkIds = await UserProgressService.GetBookmarkIdsAsync(uid);
            _bookmarked = bookmarkIds.Contains(_post.Id);
            _credits = (await UserService.GetByIdAsync(uid))?.Credits ?? 0;

            _noteContent = await UserProgressService.GetNoteAsync(uid, _post.Id) ?? "";
            _noteLoaded = true;
        }
        else
        {
            _userId = null;
        }


        // Fire-and-forget: person mentions are a progressive enhancement, don't block the render.
        _ = DetectPersonMentions(_loadGeneration);
    }

    private async Task DetectPersonMentions(int generation)
    {
        var content = _currentVersion?.Content;
        if (string.IsNullOrWhiteSpace(content))
        {
            _allPeople = [];
            return;
        }

        List<string> names;
        try
        {
            var deviceId = await JS.InvokeAsync<string>("getDeviceId");
            var auth = await AuthState.GetAuthenticationStateAsync();
            var decision = await UsageGuard.TryConsumeAsync(auth.User, $"device:{deviceId}");
            names = decision.Allowed ? await AiService.DetectPeopleInTextAsync(content) : [];
        }
        catch
        {
            names = [];
        }

        if (generation != _loadGeneration || _disposed) return;
        _allPeople = names.Select(n => new PersonSummaryResponse { Name = n }).ToList();
        try { await InvokeAsync(StateHasChanged); } catch (Exception) when (_disposed) { }
    }

    // "Souvisí s tímto" always aims for up to 6 entries: manually curated RelatedPosts first,
    // then AI-picked posts from the same category with a one-sentence connection (cached
    // server-side), and finally a plain category fallback if AI is unavailable/exhausted.
    private const int RelatedTarget = 6;

    private async Task BuildDisplayRelated()
    {
        if (_post == null) { _displayRelated = []; return; }

        var display = _relatedPosts
            .Select(r => new DisplayRelatedPost(r.RelatedPostId, r.RelatedPostTitle ?? "", r.Text,
                _allPosts.FirstOrDefault(p => p.Id == r.RelatedPostId)?.FilePath))
            .Take(RelatedTarget)
            .ToList();

        var usedIds = new HashSet<int>(display.Select(d => d.PostId)) { _post.Id };
        var needed = RelatedTarget - display.Count;

        if (needed > 0 && _post.CategoryId.HasValue)
        {
            List<RelatedSuggestionItem> aiItems = [];
            try { aiItems = (await AnonymApi.GetRelatedSuggestions(_post.Id, needed)).Items; }
            catch { /* AI suggestions are a best-effort enhancement; fall back below */ }

            foreach (var item in aiItems)
            {
                if (needed <= 0) break;
                if (usedIds.Contains(item.PostId)) continue;
                var summary = _allPosts.FirstOrDefault(p => p.Id == item.PostId);
                if (summary == null) continue;

                display.Add(new DisplayRelatedPost(item.PostId, summary.Title, item.Text, summary.FilePath));
                usedIds.Add(item.PostId);
                needed--;
            }

            if (needed > 0)
            {
                var fallback = _allPosts
                    .Where(p => p.CategoryId == _post.CategoryId && !usedIds.Contains(p.Id))
                    .Take(needed);
                foreach (var p in fallback)
                {
                    display.Add(new DisplayRelatedPost(p.Id, p.Title, null, p.FilePath));
                    usedIds.Add(p.Id);
                }
            }
        }

        _displayRelated = display;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("initLucide");

        if (_needsScrollInit && _currentVersion != null)
        {
            _needsScrollInit = false;
            _selfRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("initReadingProgress", _selfRef, "#article-prose");
        }

        if (_needsExerciseScroll && _exercises.Count > 0)
        {
            _needsExerciseScroll = false;
            await JS.InvokeVoidAsync("scrollToId", "exercises-section");
        }

        if (_needsDifficultyCheck && _post != null)
        {
            _needsDifficultyCheck = false;
            var stored = await JS.InvokeAsync<string?>("getDifficultyVote", _post.Id);
            if (int.TryParse(stored, out var vote))
            {
                _myDifficultyVote = vote;
                StateHasChanged();
            }
        }

        // Re-bind on every render (not just first) so images that appear after a grade
        // switch or the async person-mention pass get click-to-enlarge too.
        if (_currentVersion != null)
        {
            try
            {
                _lightboxModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/image-lightbox.js");
                await _lightboxModule.InvokeVoidAsync("initImageLightbox", "article-prose");
            }
            catch { /* progressive enhancement only */ }
        }
    }

    private void OnHeadingsExtracted(List<(string Text, string Anchor)> headings)
    {
        _tocHeaders = headings;
        StateHasChanged();
    }

    // A plain href="#id" would resolve against <base href="/"> and navigate to "/#id"
    // (home) instead of scrolling the current page, so ToC links scroll via JS instead.
    private async Task ScrollToHeading(string anchor) => await JS.InvokeVoidAsync("scrollToId", anchor);

    [JSInvokable]
    public async Task OnReadingProgress(string? activeAnchor, int percent)
    {
        if (_disposed) return;
        try
        {
            _activeAnchor = activeAnchor;
            _readPercent = percent;
            StateHasChanged();

            if (_userId.HasValue && _post != null && percent >= _lastPersistedPercent + 5)
            {
                _lastPersistedPercent = percent;
                await UserProgressService.UpsertReadProgressAsync(_userId.Value, _post.Id, percent);
            }
        }
        catch (Exception) when (_disposed)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try { await JS.InvokeVoidAsync("disposeReadingProgress"); } catch { }
        if (_lightboxModule != null) { try { await _lightboxModule.DisposeAsync(); } catch { } }
        _selfRef?.Dispose();
        _loadGate.Dispose();
    }

    private void SelectVersion(PostVersionResponse v)
    {
        _currentVersion = v;
        _versionsOpen = false;
        _needsScrollInit = true;
        _activeAnchor = null;
        _readPercent = 0;
        _lastPersistedPercent = -1;
        _allPeople = [];
        _rewrittenContent = null;
        _rewrittenGradeName = null;
        _ = DetectPersonMentions(_loadGeneration);
    }

    private void RevertRewrite()
    {
        _rewrittenContent = null;
        _rewrittenGradeName = null;
    }

    private void ToggleVersions() => _versionsOpen = !_versionsOpen;
    private void ToggleReading() => _readingOpen = !_readingOpen;
    private void ToggleMore() => _moreOpen = !_moreOpen;

    private async Task OnAiAnswered(string _)
    {
        if (_userId is not { } uid) return;
        _credits = (await UserService.GetByIdAsync(uid))?.Credits ?? 0;
        StateHasChanged();
    }

    private async Task ToggleBookmark()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        if (!auth.User.Identity?.IsAuthenticated == true || _post == null) return;
        if (!int.TryParse(auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out int uid)) return;

        if (_bookmarked)
            await UserProgressService.RemoveBookmarkAsync(uid, _post.Id);
        else
            await UserProgressService.AddBookmarkAsync(uid, _post.Id);
        _bookmarked = !_bookmarked;
    }

    private async Task ToggleNotes()
    {
        _notesOpen = !_notesOpen;
        if (_notesOpen && _userId.HasValue && !_noteLoaded && _post != null)
        {
            _noteLoaded = true;
            _noteContent = await UserProgressService.GetNoteAsync(_userId.Value, _post.Id) ?? "";
        }
    }

    // Blur-triggered autosave (leaving the textarea) persists silently without closing the
    // panel. The Uložit button below always closes on click, deliberately not sharing the
    // _noteSaving guard for that part: a blur fired by the button's own mousedown can still be
    // in flight when the click is dispatched, and gating the close on _noteSaving would make it
    // unreliable depending on exactly how that race resolves.
    private async Task SaveNote()
    {
        if (!_userId.HasValue || _post == null || _noteSaving) return;
        _noteSaving = true;
        try
        {
            await UserProgressService.SaveNoteAsync(_userId.Value, _post.Id, _noteContent);
            _noteSavedAt = DateTime.Now;
        }
        finally
        {
            _noteSaving = false;
        }
    }

    private async Task SaveNoteAndClose()
    {
        await SaveNote();
        _notesOpen = false;
    }

    // ── "Více" AI tools ─────────────────────────────────────────────────

    private static string AiToolIcon(string tool) => tool switch
    {
        "flashcards" => "layers",
        "practice" => "pencil-line",
        "rewrite" => "sparkles",
        "exam" => "help-circle",
        "realworld" => "globe-2",
        "whatif" => "wand-2",
        "feynman" => "message-square-quote",
        "compare" => "table-2",
        "stepsolver" => "list-ordered",
        _ => "sparkles",
    };

    private static string AiToolTitle(string tool) => tool switch
    {
        "flashcards" => "Kartičky",
        "practice" => "Procvičovací úlohy",
        "rewrite" => "Přepsat pro jiný ročník",
        "exam" => "Co může přijít v testu",
        "realworld" => "Reálné využití",
        "whatif" => "Co kdyby?",
        "feynman" => "Zkus to vysvětlit",
        "compare" => "Porovnat s…",
        "stepsolver" => "Krok za krokem",
