@using Tobiso.Web.App.Components.Shared
@code {
    [CascadingParameter]
    private MainLayout? Layout { get; set; }

    [Parameter]
    public int Id { get; set; }
    [Parameter]
    public string? Slug { get; set; }
    private PostResponse? _post;
    private int? _selectedVersionGradeId = null;
    private List<PostVersionResponse>? _allVersions;
    private PostVersionResponse? ActiveVersion =>
        _selectedVersionGradeId.HasValue
            ? (_allVersions?.FirstOrDefault(v => v.GradeId == _selectedVersionGradeId) ?? _post?.Versions?.FirstOrDefault())
            : _post?.Versions?.FirstOrDefault();
    private List<PostSummaryResponse>? _allPosts;
    private List<PersonSummaryResponse>? _allPeople;
    private List<RelatedPostResponse>? _relatedPosts;
    private List<CategoryResponse>? _breadcrumbCategories;

    private string? _fileSuffix;
    private bool _hasQuestions = false;
    private bool _isShared = false;
    private bool _showAddendumModal = false;
    private int? _selectedAddendumId = null;
    private DotNetObjectReference<PostDetail>? _dotNetRef;
    private bool _isFocusMode = false;
    // Reading preferences state
    private bool _showReadingPanel = false;
    private string _readingFont = string.Empty;
    private int _readingFontSizeStep = 2; // default index -> 20px
    private int _readingLineWidthStep = 4; // default -> no limit (new index after adding 140ch)
    private readonly int[] _fontSizes = new[] { 14, 17, 20, 22, 24, 26, 28 };
    private readonly string[] _lineWidths = new[] { "55ch", "75ch", "100ch", "140ch", "" };
    private readonly string FontGeorgia = "Georgia, 'Times New Roman', serif";
    private readonly string FontArial = "Arial, Helvetica, sans-serif";
    private readonly string FontMono = "'Courier New', Courier, monospace";
    private List<InteractiveExerciseResponse>? _exercises;
    private IJSObjectReference? _jsModule;
    private bool _aiAvailable = true;
    private string? _aiDiagError = null;
    // Table of Contents state
    private record TocItem(string Id, string Text, int Level);
    private List<TocItem> _tocItems = new();
    private string? _activeTocId = null;
    private string? _lastExtractedContentHash = null;

    protected override async Task OnInitializedAsync()
    {
        var preferredGrade = await PreferenceService.GetPreferredGradeIdAsync();
        if (!string.IsNullOrEmpty(Slug))
        {
            // Route: /post/{slug} — resolve by filename, then load by id
            _allPosts = (await Api.GetPostSummaries()).ToList();
            var matched = _allPosts.FirstOrDefault(p =>
                SlugFromFilePath(p.FilePath).Equals(Slug, StringComparison.OrdinalIgnoreCase));
            if (matched != null)
            {
                _post = await Api.GetPostById(matched.Id, preferredGrade);
                await LoadAllVersions(matched.Id);
            }
        }
        else
        {
            // Route: /post/{id:int}
            _post = await Api.GetPostById(Id, preferredGrade);
            _allPosts = (await Api.GetPostSummaries()).ToList();
            await LoadAllVersions(Id);
        }

        // Check AI availability (runs against App's /api/ai/diag endpoint)
            try
            {
                var diag = await Http.GetAsync(new Uri(Navigation.BaseUri + "api/ai/diag"));
                if (diag.IsSuccessStatusCode)
                {
                    _aiAvailable = true;
                    _aiDiagError = null;
                    try
                    {
                        var names = await Http.GetFromJsonAsync<List<string>>(new Uri(Navigation.BaseUri + $"api/ai/detect-persons/{Id}"));
                        _allPeople = (names ?? new List<string>()).Select(n => new PersonSummaryResponse { Id = 0, Name = n, Slug = null, Aliases = null }).ToList();
                    }
                    catch (Exception ex)
                    {
                        Logger.LogWarning(ex, "AI person detection failed for post {PostId}", Id);
                        _allPeople = new List<PersonSummaryResponse>();
                    }
                }
                else
                {
                    _aiAvailable = false;
                    var body = await diag.Content.ReadAsStringAsync();
                    _aiDiagError = body;
                    // Fallback to empty list if AI detection isn't available
                    _allPeople = new List<PersonSummaryResponse>();
                }
            }
            catch (Exception ex)
            {
                _aiAvailable = false;
                _aiDiagError = ex.Message;
                _allPeople = new List<PersonSummaryResponse>();
            }
        await LoadBreadcrumb();
        SetFileSuffix();
        await CheckForQuestions();
        await LoadRelatedPosts();
        await LoadExercises();
    }

    protected override async Task OnParametersSetAsync()
    {
        var preferredGrade2 = await PreferenceService.GetPreferredGradeIdAsync();
        if (!string.IsNullOrEmpty(Slug))
        {
            // Route: /post/{slug} — resolve by filename
            if (_allPosts == null || _allPosts.Count == 0)
                _allPosts = (await Api.GetPostSummaries()).ToList();
            var matched = _allPosts.FirstOrDefault(p =>
                SlugFromFilePath(p.FilePath).Equals(Slug, StringComparison.OrdinalIgnoreCase));
            if (matched != null)
            {
                _post = await Api.GetPostById(matched.Id, preferredGrade2);
                _selectedVersionGradeId = null;
                await LoadAllVersions(matched.Id);
            }
        }
        else
        {
            // Route: /post/{id:int}
            _post = await Api.GetPostById(Id, preferredGrade2);
            _allPosts = (await Api.GetPostSummaries()).ToList();
            _selectedVersionGradeId = null;
            await LoadAllVersions(Id);
        }
        await LoadBreadcrumb();
        SetFileSuffix();
        await CheckForQuestions();
        await LoadRelatedPosts();
        await LoadExercises();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Ensure the JS module is loaded before any interop calls.
        if (_jsModule == null)
        {
            try
            {
                _jsModule = await Js.InvokeAsync<IJSObjectReference>("import", "/js/blazor-utils.js?v=11");
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to import blazor-utils.js module");
            }
        }

        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);

            if (_jsModule != null)
            {
                // Set up global window callbacks and event listeners for this component instance.
                try { await _jsModule.InvokeVoidAsync("initPostDetail", _dotNetRef); }
                catch (Exception ex) { Logger.LogWarning(ex, "initPostDetail failed"); }

                try { await _jsModule.InvokeVoidAsync("initPersonLinkHandler", _dotNetRef); }
                catch (Exception ex) { Logger.LogWarning(ex, "initPersonLinkHandler failed"); }

                try { await _jsModule.InvokeVoidAsync("initImageLightbox", "content"); }
                catch (Exception ex) { Logger.LogWarning(ex, "initImageLightbox failed"); }
            }

            // Load persisted reading preferences from localStorage.
            try
            {
                var font = await Js.InvokeAsync<string>("localStorage.getItem", "readingFont");
                if (!string.IsNullOrEmpty(font)) _readingFont = font;
                var sz = await Js.InvokeAsync<string>("localStorage.getItem", "readingFontSizeStep");
                if (int.TryParse(sz, out var s)) _readingFontSizeStep = Math.Clamp(s, 0, _fontSizes.Length - 1);
                var lw = await Js.InvokeAsync<string>("localStorage.getItem", "readingLineWidthStep");
                if (int.TryParse(lw, out var w)) _readingLineWidthStep = Math.Clamp(w, 0, _lineWidths.Length - 1);
                await ApplyReadingStylesAsync();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to load reading preferences from localStorage");
            }

            // If navigated by numeric ID, silently update address bar to the slug URL.
            if (string.IsNullOrEmpty(Slug) && _post?.FilePath != null && _jsModule != null)
            {
                var slugForUrl = SlugFromFilePath(_post.FilePath);
                if (!string.IsNullOrEmpty(slugForUrl))
                {
                    try { await _jsModule.InvokeVoidAsync("replaceUrl", $"/post/{slugForUrl}"); }
                    catch (Exception ex) { Logger.LogWarning(ex, "replaceUrl failed"); }
                }
            }
        }

        // Re-run module initialization on every render to keep handlers and lightbox fresh.
        if (_jsModule != null)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("initPersonLinkHandler", _dotNetRef);
                await _jsModule.InvokeVoidAsync("initImageLightbox", "content");

                if (_fileSuffix == ".md")
                {
                    var headings = await _jsModule.InvokeAsync<object[]>("extractHeadings", "content");
                    var newTocs = new List<TocItem>();
                    if (headings != null)
                    {
                        foreach (var h in headings)
                        {
                            try
                            {
                                var json = System.Text.Json.JsonSerializer.Serialize(h);
                                var parsed = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(json);
                                if (parsed != null && parsed.ContainsKey("id") && parsed.ContainsKey("text") && parsed.ContainsKey("level"))
                                {
                                    var id = parsed["id"]?.ToString() ?? string.Empty;
                                    var text = parsed["text"]?.ToString() ?? string.Empty;
                                    var level = int.TryParse(parsed["level"]?.ToString(), out var lv) ? lv : 2;
                                    newTocs.Add(new TocItem(id, text, level));
                                }
                            }
                            catch (Exception ex)
                            {
                                Logger.LogDebug(ex, "Failed to parse a TOC heading entry");
                            }
                        }
                    }

                    var hash = string.Join("|", newTocs.Select(t => t.Id + ":" + t.Text));
                    if (hash != _lastExtractedContentHash)
                    {
                        _tocItems = newTocs;
                        _lastExtractedContentHash = hash;
                        StateHasChanged();
                    }

                    try
                    {
                        var ids = _tocItems.Select(t => t.Id).ToArray();
                        await _jsModule.InvokeVoidAsync("initTocObserver", _dotNetRef, ids);
                        await _jsModule.InvokeVoidAsync("emitHeadingsToDotNet", "content", _dotNetRef);
                    }
                    catch (Exception ex)
                    {
                        Logger.LogWarning(ex, "Failed to initialize TOC observer");
                    }
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Post-render JS module initialization failed");
            }
        }
    }

    [JSInvokable("TriggerAddendum")]
    public static void TriggerAddendum(int addendumId)
    {
        AddendumModalService.TriggerGlobalRequest(addendumId);
    }

    [JSInvokable("TriggerPerson")]
    public static void TriggerPerson(int personId)
    {
        // Preserve backwards compatibility: numbers are not used anymore; convert to string
        PersonModalService.TriggerGlobalRequest(personId.ToString());
    }

    [JSInvokable("TriggerPersonByName")]
    public static void TriggerPersonByName(string name)
    {
        PersonModalService.TriggerGlobalRequest(name);
    }

    [JSInvokable("OpenPersonByName")]
    public void OpenPersonByName(string name)
    {
        HandlePersonRequestByName(name);
    }

    protected override void OnInitialized()
    {
        AddendumModalService.OnGlobalAddendumRequested += HandleAddendumRequest;
        ModalService.OnAddendumRequested += HandleAddendumRequest;
        // PersonModalService now uses names (string) for AI-generated persons
        PersonModalService.OnGlobalPersonRequested += HandlePersonRequestByName;
        ModalService.OnAddendumRequested += HandleAddendumRequest;
    }

    private bool _showPersonModal = false;
    private void OnPersonModalClose(bool isVisible)
    {
        _showPersonModal = isVisible;
        if (!isVisible) _personNameForModal = null;
    }

    private void HandleAddendumRequest(int addendumId)
    {
        OpenAddendumModal(addendumId);
        InvokeAsync(StateHasChanged);
    }

    private void HandlePersonRequestByName(string name)
    {
        // When person name requested, open modal and use PersonName parameter
        _showPersonModal = true;
        // Pass name to modal via PersonModalService? Simpler: store in a field and bind
        _personNameForModal = name;
        InvokeAsync(StateHasChanged);
    }

    private string? _personNameForModal = null;

    public void Dispose()
    {
        AddendumModalService.OnGlobalAddendumRequested -= HandleAddendumRequest;
        ModalService.OnAddendumRequested -= HandleAddendumRequest;
        PersonModalService.OnGlobalPersonRequested -= HandlePersonRequestByName;
        _dotNetRef?.Dispose();
        if (_jsModule != null) _ = _jsModule.DisposeAsync().AsTask();
    }

    private async Task LoadAllVersions(int postId)
    {
        try
        {
            var all = await Api.GetPostById(postId);
            _allVersions = all?.Versions;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load all versions for post {PostId}", postId);
            _allVersions = _post?.Versions;
        }
    }

    private bool _showVersionPicker = false;

    private void ToggleVersionPicker() => _showVersionPicker = !_showVersionPicker;

    private void SelectVersion(int gradeId)
    {
        _selectedVersionGradeId = gradeId;
        _showVersionPicker = false;
    }

    // --- Reading preferences handlers ---
    private string GetContentStyle()
    {
        try
        {
            var sb = new System.Text.StringBuilder();
            if (!string.IsNullOrEmpty(_readingFont))
                sb.Append($"font-family: {_readingFont} !important;");
            else
                sb.Append($"font-family: var(--font-family-serif) !important;");
            var size = _fontSizes[Math.Clamp(_readingFontSizeStep, 0, _fontSizes.Length - 1)];
            // Expose base size via CSS variable so headings can scale relative to it
            sb.Append($"--reading-font-size: {size}px; ");
            // Also set the container font-size directly so body text (which inherits)
            // updates immediately even if JS hasn't executed.
            sb.Append($"font-size: {size}px;");
            var width = _lineWidths[Math.Clamp(_readingLineWidthStep, 0, _lineWidths.Length - 1)];
            if (!string.IsNullOrEmpty(width))
            {
                sb.Append($"max-width: {width}; margin-left: auto; margin-right: auto; width: 100%;");
            }
            return sb.ToString();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "GetContentStyle failed, returning empty style");
            return string.Empty;
        }
    }

    private Task ToggleReadingPanel()
    {
        _showReadingPanel = !_showReadingPanel;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task SetReadingFont(string font)
    {
        _readingFont = font ?? string.Empty;
        try { await Js.InvokeVoidAsync("localStorage.setItem", "readingFont", _readingFont); }
        catch (Exception ex) { Logger.LogWarning(ex, "Failed to persist readingFont to localStorage"); }
        await ApplyReadingStylesAsync();
        StateHasChanged();
    }

    private async Task ChangeFontSize(int delta)
    {
        _readingFontSizeStep = Math.Clamp(_readingFontSizeStep + delta, 0, _fontSizes.Length - 1);
        try { await Js.InvokeVoidAsync("localStorage.setItem", "readingFontSizeStep", _readingFontSizeStep.ToString()); }
        catch (Exception ex) { Logger.LogWarning(ex, "Failed to persist readingFontSizeStep to localStorage"); }
        await ApplyReadingStylesAsync();
        StateHasChanged();
    }

    private async Task SetLineWidth(int step)
    {
        _readingLineWidthStep = Math.Clamp(step, 0, _lineWidths.Length - 1);
        try { await Js.InvokeVoidAsync("localStorage.setItem", "readingLineWidthStep", _readingLineWidthStep.ToString()); }
        catch (Exception ex) { Logger.LogWarning(ex, "Failed to persist readingLineWidthStep to localStorage"); }
        await ApplyReadingStylesAsync();
        StateHasChanged();
    }

    private async Task ApplyReadingStylesAsync()
    {
        if (_jsModule == null) return;
        try
        {
            var font = _readingFont ?? string.Empty;
            var size = _fontSizes[Math.Clamp(_readingFontSizeStep, 0, _fontSizes.Length - 1)];
            var width = _lineWidths[Math.Clamp(_readingLineWidthStep, 0, _lineWidths.Length - 1)];
            await _jsModule.InvokeVoidAsync("applyReadingStyles", font, size, width);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to apply reading styles");
        }
    }

    private async Task ToggleFocusMode()
    {
        _isFocusMode = !_isFocusMode;
        if (_jsModule != null)
        {
            try { await _jsModule.InvokeVoidAsync("setFocusMode", _isFocusMode); }
            catch (Exception ex) { Logger.LogWarning(ex, "setFocusMode JS call failed"); }
        }
        StateHasChanged();
    }

    [JSInvokable]
    public Task OnExternalFullscreenExit()
    {
        if (_isFocusMode)
        {
            _isFocusMode = false;
            StateHasChanged();
        }
        return Task.CompletedTask;
    }

    private void SetFileSuffix()
    {
        if (_post != null && !string.IsNullOrEmpty(_post.FilePath))
        {
            if (_post.FilePath.EndsWith(".md", StringComparison.OrdinalIgnoreCase))
                _fileSuffix = ".md";
            else if (_post.FilePath.EndsWith(".html", StringComparison.OrdinalIgnoreCase))
                _fileSuffix = ".html";
            else
                _fileSuffix = null;
        }
        else
        {
            _fileSuffix = null;
        }
    }

    private async Task CheckForQuestions()
    {
        try
        {
            if (_post?.Id != null)
            {
                var questions = await Api.GetQuestionsByPostId(_post.Id);
                _hasQuestions = questions?.Any() == true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to check for questions for post {PostId}", _post?.Id);
            _hasQuestions = false;
        }
    }

    private async Task LoadRelatedPosts()
    {
        try
        {
            if (_post?.Id != null)
            {
                _relatedPosts = (await Api.GetRelatedPostsByPostId(_post.Id)).ToList();

                // Přidat články ze stejné kategorie
                if (_post.CategoryId.HasValue && _allPosts != null)
                {
                    var categoryPosts = _allPosts
                        .Where(p => p.CategoryId == _post.CategoryId && p.Id != _post.Id)
                        .Take(5)
                        .Select(p => new RelatedPostResponse
                        {
                            PostId = _post.Id,
                            RelatedPostId = p.Id,
                            Text = "souvisí s tématem"
                        })
                        .ToList();

                    // Vyfiltrovat články, které už jsou v _relatedPosts
                    var existingIds = _relatedPosts.Select(rp => rp.RelatedPostId).ToHashSet();
                    var newCategoryPosts = categoryPosts.Where(cp => !existingIds.Contains(cp.RelatedPostId)).ToList();

                    _relatedPosts.AddRange(newCategoryPosts);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load related posts for post {PostId}", _post?.Id);
            _relatedPosts = new List<RelatedPostResponse>();
        }
    }

    private void OpenAddendumModal(int addendumId)
    {
        _selectedAddendumId = addendumId;
        _showAddendumModal = true;
    }

    private void OnAddendumModalClose(bool isVisible)
    {
        _showAddendumModal = isVisible;
        if (!isVisible)
        {
            _selectedAddendumId = null;
        }
    }

    private async Task BackHistory()
    {
        await Js.InvokeVoidAsync("eval", "if(history.length > 1) history.back(); else window.location.href='/categories'");
    }
    private void ToQuestions()
    {
        Navigation.NavigateTo($"/questions/{_post?.Id ?? Id}", forceLoad: true);
    }

    private async Task SharePost()
    {
        if (_post == null) return;

        var slug = SlugFromFilePath(_post.FilePath);
        var url = !string.IsNullOrEmpty(slug)
            ? $"https://www.tobiso.com/post/{slug}"
            : $"https://www.tobiso.com/post/{_post.Id}";
        await Js.InvokeVoidAsync("navigator.clipboard.writeText", url);
        _isShared = true;
        StateHasChanged();

        await Task.Delay(1000);
        _isShared = false;
        StateHasChanged();
    }

    private async Task GeneratePdf()
    {
        if (_post == null) return;

        // Prefer a simple GET that returns the PDF file so browser handles download (no JS interop needed)
        var title = _post.Title ?? "post";
        var safe = Regex.Replace(title.ToLowerInvariant(), "[^a-z0-9-_ ]", "");
        safe = Regex.Replace(safe, "\\s+", "_");
        var filename = $"{safe}_{DateTime.Now:yyyyMMdd}.pdf";

        try
        {
            // Navigate to the PDF generation endpoint which returns a File result
            var url = $"/api/pdf/generate/post/{_post.Id}?fileName={Uri.EscapeDataString(filename)}";
            Navigation.NavigateTo(url, forceLoad: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "PDF generation navigation failed for post {PostId}", _post?.Id);
        }
    }

    private bool _showCheatSheetModal = false;
    private bool _isGeneratingCheatSheet = false;

    private void OpenCheatSheetModal()
    {
        _showCheatSheetModal = true;
    }

    private void CloseCheatSheetModal()
    {
        if (!_isGeneratingCheatSheet)
            _showCheatSheetModal = false;
    }

    private async Task GenerateCheatSheet(string ratio)
    {
        if (_post == null || _isGeneratingCheatSheet) return;

        _isGeneratingCheatSheet = true;
        StateHasChanged();

        try
        {
            var url = $"/api/pdf/cheatsheet/{_post.Id}?ratio={ratio}";
            Navigation.NavigateTo(url, forceLoad: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Cheat sheet generation navigation failed for post {PostId}", _post?.Id);
        }
        finally
        {
            await Task.Delay(3000);
            _isGeneratingCheatSheet = false;
            _showCheatSheetModal = false;
            StateHasChanged();
        }
    }

    private async Task ScrollToExercises()
    {
        if (_jsModule == null) return;
        try
        {
            await _jsModule.InvokeVoidAsync("scrollToElementById", "interaktivni-cviceni");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "ScrollToExercises failed");
        }
    }

    private string GetWordCountInfo(string? content)
    {
        if (string.IsNullOrWhiteSpace(content)) return "";
        var wordCount = Regex.Matches(content, "\\w+").Count;
        var minutes = Math.Max(1, (int)Math.Ceiling(wordCount / 180.0));
        return $"{wordCount} slov | <i class=\"bi bi-book\"></i> {minutes} min";
    }

    private DateTime? GetLatestEditDate()
    {
        if (_post == null) return null;
        var e = ActiveVersion?.LastEdit;
        var f = ActiveVersion?.LastFix;
        if (e.HasValue && f.HasValue) return e > f ? e : f;
        return e ?? f;
    }

    private string GetLatestEditDateDisplay()
    {
        var d = GetLatestEditDate();
        return d?.ToString("d. M. yyyy") ?? string.Empty;
    }

    private async Task LoadBreadcrumb()
    {
        _breadcrumbCategories = new List<CategoryResponse>();
        try
        {
            if (_post?.CategoryId != null)
            {
                var ancestors = await Api.GetCategoryAncestors(_post.CategoryId.Value);
                _breadcrumbCategories = ancestors ?? new List<CategoryResponse>();
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load breadcrumb for category {CategoryId}", _post?.CategoryId);
            _breadcrumbCategories = new List<CategoryResponse>();
        }
    }

    private async Task LoadExercises()
    {
        try
        {
            if (_post?.Id != null)
            {
                _exercises = await ExerciseService.GetByPostIdAsync(_post.Id, includeInactive: false);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load exercises for post {PostId}", _post?.Id);
            _exercises = new List<InteractiveExerciseResponse>();
        }
    }

    private string GetExerciseIcon(string type)
    {
        return type switch
        {
            "circuit" => "lightning-charge",
            "timeline" => "arrow-right",
            "drag-drop" => "box-arrow-in-down",
            "molecule" => "diagram-3",
            "matching" => "link-45deg",
            _ => "puzzle"
        };
    }

    private string GetExerciseTypeLabel(string type)
    {
        return type switch
        {
            "circuit" => "Fyzikální obvod",
            "timeline" => "Časová osa",
            "drag-drop" => "Přetahování do kategorií",
            "molecule" => "Chemická molekula",
            "matching" => "Párování",
            _ => type
        };
    }

    [JSInvokable]
    public Task SetActiveTocId(string id)
    {
        if (string.IsNullOrEmpty(id)) return Task.CompletedTask;
        if (_activeTocId != id)
        {
            _activeTocId = id;
            InvokeAsync(StateHasChanged);
        }
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task ReceiveTocItems(object headings)
    {
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(headings);
            var arr = System.Text.Json.JsonSerializer.Deserialize<List<Dictionary<string, object>>>(json);
            if (arr == null) return Task.CompletedTask;
            var newTocs = arr.Select(d => new TocItem(d.TryGetValue("id", out var i) ? i?.ToString() ?? string.Empty : string.Empty,
                                                    d.TryGetValue("text", out var t) ? t?.ToString() ?? string.Empty : string.Empty,
                                                    d.TryGetValue("level", out var l) && int.TryParse(l?.ToString(), out var lv) ? lv : 2)).ToList();
            var hash = string.Join("|", newTocs.Select(t => t.Id + ":" + t.Text));
            if (hash != _lastExtractedContentHash)
            {
                _tocItems = newTocs;
                _lastExtractedContentHash = hash;
                InvokeAsync(StateHasChanged);
                // re-init observer
                _ = Task.Run(async () =>
                {
                    try { if (_jsModule != null) await _jsModule.InvokeVoidAsync("initTocObserver", _dotNetRef, _tocItems.Select(t => t.Id).ToArray()); } catch { }
                });
            }
        }
        catch { }
        return Task.CompletedTask;
    }

    private async Task ScrollToHeading(string id)
    {
        if (string.IsNullOrEmpty(id) || _jsModule == null) return;
        try
        {
            await _jsModule.InvokeVoidAsync("scrollToElementById", id);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "ScrollToHeading failed for id {HeadingId}", id);
        }
    }

    /// <summary>Returns the URL slug derived from a post FilePath by stripping the file extension.</summary>
    private static string SlugFromFilePath(string? filePath)
    {
        if (string.IsNullOrEmpty(filePath)) return string.Empty;
        return System.IO.Path.GetFileNameWithoutExtension(filePath);
    }
