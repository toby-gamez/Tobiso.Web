    private string TransformMarkdownContent(string? content)
    {
        if (string.IsNullOrEmpty(content)) return string.Empty;
        // Pokud obsahuje Markdown-styl mailto odkazy, převedeme je na <a href="mailto:..."> před zpracováním,
        // protože někteří autoři mohou mít odkazy, které Markdig neparsuje (nebo obsah přijde již upravený).
        content = ReplaceMarkdownMailtoInText(content);

        // Převeď jednoduché zápisy zlomků (1/2, 1/x, 5,5/y, x/y, -x/r, -4/7) na inline LaTeX math
        // Např. 1/2 -> $\frac{1}{2}$; vynecháme případy jako "ano/ne"
        content = ReplaceFractionsInText(content);
        
        // Náhrada -> za ikonu šipky PŘED konverzí do HTML
        content = content.Replace(" -> ", " <i class=\"bi bi-arrow-right-short\"></i> ");
        content = content.Replace("->", "<i class=\"bi bi-arrow-right-short\"></i>");

        // Seskup obrázky s popisky a zdrojem PŘED konverzí, kdy je struktura odstavců jasná
        content = PreprocessImageGroups(content);

        var html = Markdig.Markdown.ToHtml(content);
        
        // Zpracování dodatků (--DOD-x--) PO konverzi na HTML
        _addendumIds.Clear();
        var addendumRegex = new Regex(@"\(--DOD-(\d+)--\)", RegexOptions.IgnoreCase);
        html = addendumRegex.Replace(html, match =>
        {
            var addendumId = int.Parse(match.Groups[1].Value);
            if (!_addendumIds.Contains(addendumId))
            {
                _addendumIds.Add(addendumId);
            }
            return $"<a class='addendum-btn' onclick='window.requestAddendum({addendumId})'><i class=\"bi bi-patch-question\"></i></a>";
        });
        
        // Oprav obrázky: přidej prefix k src u <img>
        var imgRegex = new Regex("<img\\s+[^>]*src=\\\"([^\\\"]+)\\\"", RegexOptions.IgnoreCase);
        html = imgRegex.Replace(html, match => {
            var origSrc = match.Groups[1].Value;
            if (origSrc.Contains("http")) return match.Value;
            if (origSrc.Contains("images"))
            {
                var fullSrc = origSrc.StartsWith("/") ? $"https://files.tobiso.com{origSrc}" : $"https://files.tobiso.com/{origSrc}";
                return match.Value.Replace(origSrc, fullSrc);
            }
            return match.Value;
        });
        
        // Zpracování odkazů
        var regex = new Regex("<a\\s+href=\\\"([^\\\"]+)\\\"(.*?)>(.*?)<\\/a>", RegexOptions.IgnoreCase);
        html = regex.Replace(html, match => {
            var origHref = match.Groups[1].Value;
            var attrs = match.Groups[2].Value;
            var linkText = match.Groups[3].Value;
            if (origHref.Contains("http"))
            {
                return $"<a href=\"{origHref}\" target=\"_blank\" rel=\"noopener noreferrer\"{attrs}>{linkText}</a>";
            }
            if (origHref.Contains("files"))
            {
                var fullUrl = origHref.StartsWith("/") ? $"https://files.tobiso.com{origHref}" : $"https://files.tobiso.com/{origHref}";
                return $"<a href=\"{fullUrl}\" target=\"_blank\" rel=\"noopener noreferrer\"{attrs}>{linkText}</a>";
            }
            if (origHref.StartsWith("mailto:", StringComparison.OrdinalIgnoreCase))
            {
                // Ensure mailto query parameters are URL-encoded (subjects, body, etc.)
                try
                {
                    var mailto = origHref.Substring("mailto:".Length);
                    var parts = mailto.Split('?', 2);
                    var address = parts[0] ?? "";
                    var encodedQuery = "";
                    if (parts.Length > 1 && !string.IsNullOrEmpty(parts[1]))
                    {
                        encodedQuery = string.Join("&",
                            parts[1].Split('&', StringSplitOptions.RemoveEmptyEntries)
                                .Select(p =>
                                {
                                    var kv = p.Split('=', 2);
                                    var k = kv[0];
                                    var v = kv.Length > 1 ? kv[1] : "";
                                    // Ensure value is properly encoded. If it is already encoded, Uri.EscapeDataString of UnescapeDataString keeps it safe.
                                    return $"{Uri.EscapeDataString(k)}={Uri.EscapeDataString(Uri.UnescapeDataString(v))}";
                                })
                        );
                    }
                    var href = "mailto:" + address + (string.IsNullOrEmpty(encodedQuery) ? "" : "?" + encodedQuery);
                    // Render a plain anchor with the encoded mailto href. Avoid JS onclick which can interfere in some environments.
                    return $"<a href=\"{href}\"{attrs}>{linkText}</a>";
                }
                catch
                {
                    // Fallback: render the original href if encoding fails for any reason
                    return $"<a href=\"{origHref}\"{attrs}>{linkText}</a>";
                }
            }
            var file = Regex.Replace(origHref, "^(ml-|l-|sl-|hv-|m-|ch-|f-|pr-|z-|li-|geo-)", "");
            file = file.Replace(".html", ".md");
            if (!file.StartsWith("/")) file = "/" + file;
            var postMatch = _allPosts?.FirstOrDefault(p => p.FilePath.EndsWith(file, StringComparison.OrdinalIgnoreCase));
            if (postMatch != null)
            {
                return $"<a href=\"/post/{postMatch.Id}\"{attrs}>{linkText}</a>";
            }
            return $"<span style=\"color:gray; text-decoration:line-through;\">{linkText}</span>";
        });
        
        // Zabal text v tečkách do divu s class intro
        var dotsRegex = new Regex(@"(\.\.\.\s*)(.*?)(\s*\.\.\.)", RegexOptions.Singleline);
        html = dotsRegex.Replace(html, m => $"<div class=\"intro\">{m.Groups[2].Value}</div>", 1);
        var singleDotsRegex = new Regex(@"<p>\s*\.\.\.\s*<\/p>", RegexOptions.Singleline);
        html = singleDotsRegex.Replace(html, "");
        html = html.Replace("...", "");
        // If there are math placeholders present inside HTML-escaped <code> blocks, unescape
        // their contents so KaTeX auto-render can find and render them. We only unescape
        // when the code block contains a math placeholder to avoid altering other code.
        try
        {
            var codeRx = new Regex("<code([^>]*)>(.*?)</code>", RegexOptions.Singleline | RegexOptions.IgnoreCase);
            html = codeRx.Replace(html, m =>
            {
                var attrs = m.Groups[1].Value;
                var inner = m.Groups[2].Value;
                if (inner.Contains("data-math") || inner.IndexOf("&lt;span", StringComparison.OrdinalIgnoreCase) >= 0)
                {
                    // HTML-decode the inner content so any inserted <span data-math> becomes real DOM
                    var decoded = System.Net.WebUtility.HtmlDecode(inner);
                    return $"<code{attrs}>{decoded}</code>";
                }
                return m.Value;
            });
        }
        catch { }

        html = ConvertMarkdownTablesToHtml(html);
        return html;
    }

    private string PreprocessImageGroups(string content)
    {
        if (string.IsNullOrEmpty(content)) return content;

        // Rozděl na odstavce (oddělené 2+ prázdnými řádky)
        var paras = Regex.Split(content, @"\r?\n[ \t]*\r?\n")
                         .Select(p => p.Trim('\r', '\n', ' ', '\t'))
                         .ToList();

        // Obrázek jako celý odstavec: ![alt](src)
        var imgRx = new Regex(@"^!\[([^\]]*)\]\(([^)]+)\)\s*$");

        var result = new List<string>();
        int i = 0;

        while (i < paras.Count)
        {
            var para = paras[i];
            if (string.IsNullOrWhiteSpace(para)) { i++; continue; }

            var imgM = imgRx.Match(para);
            if (!imgM.Success) { result.Add(para); i++; continue; }

            // ── nalezen obrázek ──
            // Hledáme Zdroj/Autor v následujících max. 3 odstavcích
            int srcIdx = -1;
            for (int j = i + 1; j < paras.Count && j <= i + 3; j++)
            {
                if (string.IsNullOrWhiteSpace(paras[j])) continue;
                if (paras[j].StartsWith("Zdroj") ||
                    paras[j].StartsWith("Autor"))
                { srcIdx = j; break; }
            }

            var imgSrc = imgM.Groups[2].Value;
            var imgAlt = System.Net.WebUtility.HtmlEncode(imgM.Groups[1].Value);

            if (srcIdx < 0)
            {
                // Žádný zdroj – obrázek sám v .blog-image
                result.Add($"<div class=\"blog-image\"><img src=\"{imgSrc}\" alt=\"{imgAlt}\" /></div>");
                i++;
                continue;
            }

            bool isTobiso = paras[srcIdx].Contains("Tobiso", StringComparison.OrdinalIgnoreCase);

            // Collect intermediate caption paragraphs (between image and source)
            var captionParts = new List<string>();
            for (int j = i + 1; j < srcIdx; j++)
            {
                if (!string.IsNullOrWhiteSpace(paras[j]))
                    captionParts.Add(paras[j].Trim());
            }
            var captionText = string.Join(" ", captionParts);
            var sourceText = paras[srcIdx].Trim();

            // Encode values for HTML attribute
            var captionAttr = System.Net.WebUtility.HtmlEncode(captionText);
            var sourceAttr = System.Net.WebUtility.HtmlEncode(sourceText);

            if (isTobiso)
            {
                // Obrázek zůstane jako Markdown, popisky/zdroj dostanou CSS třídu
                // Inject data attrs via raw HTML img instead of markdown syntax
                var imgHtml = $"<img src=\"{imgSrc}\" alt=\"{imgAlt}\" data-caption=\"{captionAttr}\" data-source=\"{sourceAttr}\" />";
                result.Add(imgHtml);
                for (int j = i + 1; j <= srcIdx; j++)
                {
                    if (string.IsNullOrWhiteSpace(paras[j])) continue;
                    var ph = Markdig.Markdown.ToHtml(paras[j]).Trim();
                    if (ph.StartsWith("<p>") && ph.EndsWith("</p>"))
                        ph = "<p class=\"tobiso-source\">" + ph.Substring(3, ph.Length - 7) + "</p>";
                    result.Add(ph);
                }
            }
            else
            {
                // Obrázek + popisky + zdroj zabalíme do <div class="blog-image">
                var sb = new System.Text.StringBuilder();
                sb.Append($"<div class=\"blog-image\"><img src=\"{imgSrc}\" alt=\"{imgAlt}\" data-caption=\"{captionAttr}\" data-source=\"{sourceAttr}\" />");
                for (int j = i + 1; j <= srcIdx; j++)
                {
                    if (string.IsNullOrWhiteSpace(paras[j])) continue;
                    // Převedeme Markdown odstavec (může obsahovat odkazy) na HTML
                    var ph = Markdig.Markdown.ToHtml(paras[j]).Trim();
                    sb.Append(ph);
                }
                sb.Append("</div>");
                result.Add(sb.ToString());
            }

            i = srcIdx + 1;
        }

        return string.Join("\n\n", result.Where(p => !string.IsNullOrWhiteSpace(p)));
    }

    private string ReplaceFractionsInText(string input)
    {
        if (string.IsNullOrEmpty(input)) return string.Empty;
        // Temporarily protect code regions (fenced code blocks and inline backticks)
        // so we don't convert fractions that are part of code samples. Note: we DO NOT
        // protect HTML <code>...</code> here so fractions inside <code> tags can be
        // converted to math (desired behavior).
        var (protectedText, regions) = ProtectCodeRegions(input);

        // Numerator/denominator: either a number (with optional comma decimals) or a single letter (to represent variables).
        // This avoids converting multi-letter words like "ano/ne" or "zvětší/změnší" into fractions.
        // Rozšířený regex: podporuje buď jednoduché tokeny (číslo nebo 1 písmeno)
        // nebo výrazy v složených závorkách jako {n + 1}/{n - 1}.
        var fracRegex = new Regex(@"(?<![\w/\-])(?:(\{([^}]+)\})|(-?(?:\d+(?:,\d+)?|\p{L})))\s*/\s*(?:(\{([^}]+)\})|(-?(?:\d+(?:,\d+)?|\p{L})))(?![\w/])",
            RegexOptions.CultureInvariant);

        var replaced = fracRegex.Replace(protectedText, match =>
        {
            try
            {
                // Pokud byl použit zápis s { ... }, skupiny 2 a 5 obsahují výraz bez závorek.
                // Jinak použijeme skupiny 3 a 6 (jednotlivé tokeny jako číslo nebo písmeno).
                var num = match.Groups[2].Success ? match.Groups[2].Value : match.Groups[3].Value;
                var den = match.Groups[5].Success ? match.Groups[5].Value : match.Groups[6].Value;

                // Explicitně vynecháme "ano"/"ne" a podobné slovní páry
                if (string.Equals(num, "ano", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(den, "ano", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(num, "ne", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(den, "ne", StringComparison.OrdinalIgnoreCase))
                {
                    return match.Value;
                }

                // Trim a normalizace desetinné čárky na tečku pro LaTeX
                num = num.Trim();
                den = den.Trim();
                var numNorm = num.Replace(',', '.');
                var denNorm = den.Replace(',', '.');

                // Vyrenderujeme jako inline math s \frac{num}{den}
                var math = $"\\frac{{{numNorm}}}{{{denNorm}}}";
                return $"<span class='math-inline' data-math=\"{System.Net.WebUtility.HtmlEncode(math)}\"></span>";
            }
            catch
            {
                return match.Value;
            }
        });

        // Restore protected code regions back into the text
        return RestoreCodeRegions(replaced, regions);
    }

    private (string, Dictionary<string, string>) ProtectCodeRegions(string input)
    {
        var regions = new Dictionary<string, string>();
        if (string.IsNullOrEmpty(input)) return (string.Empty, regions);

        int counter = 0;
        // Match only fenced code blocks (```...```) so inline backticks and HTML
        // <code> elements are NOT protected and thus remain eligible for fraction
        // replacement (desired: convert fractions even inside inline code or <code> tags).
        var pattern = @"(?ms)(```.*?```)";
        var rx = new Regex(pattern, RegexOptions.Singleline);
        var result = rx.Replace(input, m =>
        {
            var key = $"__PROTECTED_CODE_{counter}__";
            regions[key] = m.Value;
            counter++;
            return key;
        });

        return (result, regions);
    }

    private string RestoreCodeRegions(string input, Dictionary<string, string> regions)
    {
        if (regions == null || regions.Count == 0) return input;
        var result = input;
        foreach (var kv in regions)
        {
            result = result.Replace(kv.Key, kv.Value);
        }
        return result;
    }

    private string ReplaceMarkdownMailtoInText(string input)
    {
        if (string.IsNullOrEmpty(input) || !input.Contains("mailto:", StringComparison.OrdinalIgnoreCase))
            return input ?? string.Empty;

        var mdMailtoRegex = new Regex(@"\[([^\]]+)\]\((mailto:([^\)\s]+)(\?[^\)]*)?)\)", RegexOptions.IgnoreCase);
        return mdMailtoRegex.Replace(input, match =>
        {
            try
            {
                var linkText = match.Groups[1].Value;
                var full = match.Groups[2].Value; // mailto:address?query
                var mailto = full.Substring("mailto:".Length);
                var parts = mailto.Split('?', 2);
                var address = parts[0] ?? "";
                var encodedQuery = "";
                if (parts.Length > 1 && !string.IsNullOrEmpty(parts[1]))
                {
                    encodedQuery = string.Join("&",
                        parts[1].Split('&', StringSplitOptions.RemoveEmptyEntries)
                            .Select(p =>
                            {
                                var kv = p.Split('=', 2);
                                var k = kv[0];
                                var v = kv.Length > 1 ? kv[1] : "";
                                return $"{Uri.EscapeDataString(k)}={Uri.EscapeDataString(Uri.UnescapeDataString(v))}";
                            })
                    );
                }
                var href = "mailto:" + address + (string.IsNullOrEmpty(encodedQuery) ? "" : "?" + encodedQuery);
                return $"<a href=\"{href}\">{linkText}</a>";
            }
            catch
            {
                return match.Value; // fallback to original
            }
        });
    }

    private string ConvertMarkdownTablesToHtml(string html)
    {
        // Tento vylepšený regex hledá <p> tag, který obsahuje text s pipe znaky (|) a <br> tagy,
        // což je typický výsledek, když Markdig nerozpozná Markdown tabulku.
        var tableRegex = new Regex(@"<p>(\s*\|.*(?:<br\s*/?>\s*\|.*)+)</p>", RegexOptions.Singleline);

        html = tableRegex.Replace(html, match =>
        {
            var tableContent = match.Groups[1].Value.Trim();

            // Rozdělíme obsah na jednotlivé řádky podle <br> tagů.
            var lines = Regex.Split(tableContent, @"<br\s*/?>")
                             .Select(l => l.Trim())
                             .Where(l => !string.IsNullOrEmpty(l) && l.Contains("|"))
                             .ToList();

            if (lines.Count < 2) return match.Value; // Není dost řádků pro záhlaví a tělo.

            // Najdeme oddělovací řádek (např. |---|---|).
            int separatorIndex = lines.FindIndex(line => Regex.IsMatch(line, @"^\|?(\s*:?-+:?\s*\|)+\s*:?-+:?\s*\|?$"));

            // Pokud oddělovač chybí nebo je hned na prvním řádku, není to standardní tabulka.
            if (separatorIndex < 1) return match.Value;

            var headerLine = lines[separatorIndex - 1];
            var bodyLines = lines.Skip(separatorIndex + 1).ToList();

            var headerCells = ParseConcatenatedRow(headerLine);

            var sb = new System.Text.StringBuilder();
            sb.Append("<table class=\"md-table\">");

            // --- ZÁHLAVÍ ---
            sb.Append("<thead><tr>");
            foreach (var cellContent in headerCells)
            {
                sb.Append($"<th>{cellContent}</th>");
            }
            sb.Append("</tr></thead>");

            // --- TĚLO TABULKY ---
            sb.Append("<tbody>");
            foreach (var bodyLine in bodyLines)
            {
                var bodyCells = ParseConcatenatedRow(bodyLine);
                sb.Append("<tr>");
                // Každý řádek má přesně tolik buněk jako záhlaví (přebytečné ignorujeme, chybějící doplníme prázdnými)
                for (int i = 0; i < headerCells.Count; i++)
                {
                    var cellContent = i < bodyCells.Count ? bodyCells[i] : "";
                    sb.Append($"<td>{cellContent}</td>");
                }
                sb.Append("</tr>");
            }
            sb.Append("</tbody></table>");

            return sb.ToString();
        });

        // Univerzální detekce tabulky v <p>...</p> (řádky oddělené \n nebo <br>)
        var universalTableRegex = new Regex(@"<p>((?:\|[^\n]+\n)+\|[^\n]+)</p>", RegexOptions.Singleline);
        html = universalTableRegex.Replace(html, match =>
        {
            var tableContent = match.Groups[1].Value.Trim();
            // Rozdělit na řádky podle \n nebo <br>
            var lines = Regex.Split(tableContent, @"\r?\n|<br\s*/?>")
                .Select(l => l.Trim())
                .Where(l => !string.IsNullOrEmpty(l) && l.Contains("|"))
                .ToList();
            if (lines.Count < 2) return match.Value;
            int separatorIndex = lines.FindIndex(line => Regex.IsMatch(line, @"^\|?([\-: ]+\|)+[\-: ]*\|?$"));
            if (separatorIndex < 1) return match.Value;
            var headerLine = lines[separatorIndex - 1];
            var bodyLines = lines.Skip(separatorIndex + 1).ToList();
            var headerCells = ParseConcatenatedRow(headerLine);
            var sb = new System.Text.StringBuilder();
            sb.Append("<table class=\"md-table\">");
            sb.Append("<thead><tr>");
            foreach (var cellContent in headerCells)
                sb.Append($"<th>{cellContent}</th>");
            sb.Append("</tr></thead>");
            sb.Append("<tbody>");
            foreach (var bodyLine in bodyLines)
            {
                var bodyCells = ParseConcatenatedRow(bodyLine);
                sb.Append("<tr>");
                for (int i = 0; i < headerCells.Count; i++)
                {
                    var cellContent = i < bodyCells.Count ? bodyCells[i] : "";
                    sb.Append($"<td>{cellContent}</td>");
                }
                sb.Append("</tr>");
            }
            sb.Append("</tbody></table>");
            return sb.ToString();
        });
        return html;
    }

    private List<string> ParseConcatenatedRow(string rowText)
    {
        // Odstraníme svislice na začátku a na konci řádku, ale neztrácíme prázdné buňky.
        var cleanRowText = rowText;
        if (cleanRowText.StartsWith("|")) cleanRowText = cleanRowText.Substring(1);
        if (cleanRowText.EndsWith("|")) cleanRowText = cleanRowText.Substring(0, cleanRowText.Length - 1);

        // Rozdělíme řádek na buňky podle svislic, zachováme prázdné buňky.
        return cleanRowText.Split('|', StringSplitOptions.None)
            .Select(s => s.Trim())
            .ToList();
    }
    
