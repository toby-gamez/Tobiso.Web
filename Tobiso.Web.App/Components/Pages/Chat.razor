@page "/chat"
@implements IDisposable
@inject IAiChatHistoryService ChatHistory
@inject IPostService PostService
@inject IUserService UserService
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>AI chat — Tobiso</PageTitle>

<div class="chat-page">
    <div class="chat-main">
        <div class="chat-header">
            <div>
                <h1>AI chat</h1>
                <p>Zeptej se na cokoliv z učiva. Odpovídá v češtině a drží se látky.</p>
            </div>
            <div class="chat-header-actions">
                @if (_isAuth)
                {
                    <span class="grade-chip"><i data-lucide="coins"></i> @CzechPlural.Kredity(_credits)</span>
                }
                <button class="pill new-chat-btn" @onclick="StartNewChat">
                    <i data-lucide="plus"></i> Nový chat
                </button>
            </div>
        </div>

        <div class="chat-panel soft">
            <AiChatBox @ref="_chatBox"
                       PostId="0"
                       SessionId="@SessionId"
                       EmptyTitle="Na co se dnes podíváme?"
                       Suggestions="@(new[] { "Vysvětli mi Pythagorovu větu", "Jak funguje fotosyntéza?", "Dej mi příklad na zlomky" })"
                       OnAnswered="OnAnswered" />
        </div>
    </div>

    <aside class="chat-history">
        <h2>Historie</h2>
        @if (!_isAuth)
        {
            <p class="chat-history-empty">Historie se ukládá po <a href="/prihlaseni">přihlášení</a>.</p>
        }
        else if (_sessions.Count == 0)
        {
            <p class="chat-history-empty">Zatím žádné konverzace.</p>
        }
        else
        {
            <div class="chat-history-list">
                @foreach (var s in _sessions)
                {
                    <a class="chat-history-item lift @(IsActive(s) ? "active" : "")"
                       href="@(s.PostId.HasValue ? $"/post/{s.PostId}" : $"/chat?session={s.Id}")">
                        <span class="chat-history-title">@SessionTitle(s)</span>
                        <span class="chat-history-date">@s.UpdatedAt.ToLocalTime().ToString("d. M. yyyy")</span>
                    </a>
                }
            </div>
        }
    </aside>
</div>

@code {
    [SupplyParameterFromQuery(Name = "session")]
    public int? SessionId { get; set; }

    private AiChatBox? _chatBox;
    private bool _isAuth;
    private int _userId;
    private int _credits;
    private List<Tobiso.Web.Domain.Entities.AiChatSession> _sessions = [];
    private Dictionary<int, string> _postTitles = [];

    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            _isAuth = auth.User.Identity?.IsAuthenticated == true;
            if (!_isAuth) return;

            if (!int.TryParse(auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out _userId)) return;

            await LoadSessions();
            var summaries = await PostService.GetSummaries();
            foreach (var p in summaries) _postTitles[p.Id] = p.Title;
            _credits = (await UserService.GetByIdAsync(_userId))?.Credits ?? 0;
        }
        catch (Exception) when (_disposed)
        {
        }
    }

    private async Task LoadSessions() => _sessions = await ChatHistory.GetUserSessionsAsync(_userId);

    // Refreshes the sidebar right after an answer so a freshly-started "new chat" session shows up
    // immediately instead of only after the next full page load.
    private async Task OnAnswered(string _)
    {
        if (!_isAuth) return;
        await LoadSessions();
        _credits = (await UserService.GetByIdAsync(_userId))?.Credits ?? 0;
        StateHasChanged();
    }

    private void StartNewChat()
    {
        _chatBox?.ResetConversation();
        if (SessionId.HasValue) Nav.NavigateTo("/chat");
    }

    private bool IsActive(Tobiso.Web.Domain.Entities.AiChatSession s) =>
        !s.PostId.HasValue && SessionId == s.Id;

    public void Dispose() => _disposed = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await JS.InvokeVoidAsync("initLucide");
    }

    // Post-tied sessions show the article's title; general sessions show their stored, question-derived
    // title, falling back to "Obecná konverzace" only for legacy rows saved before Title existed.
    private string SessionTitle(Tobiso.Web.Domain.Entities.AiChatSession s)
    {
        if (s.PostId.HasValue)
            return _postTitles.TryGetValue(s.PostId.Value, out var t) ? t : "Obecná konverzace";

        return !string.IsNullOrWhiteSpace(s.Title) ? s.Title! : "Obecná konverzace";
    }
}
