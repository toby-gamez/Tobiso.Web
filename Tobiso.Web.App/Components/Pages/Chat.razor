@page "/chat"
@using Tobiso.Web.Shared.DTOs
@using Tobiso.Web.Shared.Interfaces
@using Tobiso.Web.App.Components.Shared
@inject ITobisoAnonymApi Api
@inject ILogger<Chat> Logger
@rendermode InteractiveServer
<PageTitle>AI Chat - Tobiso</PageTitle>

<style>
    section {
        width: 100%;
        align-self: stretch;
    }

    /* ── Chat view ── */
    .chat-back-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 20px;
        font-size: 0.9rem;
        cursor: pointer;
        color: var(--color-accent);
        background: none;
        border: none;
        padding: 0;
    }

    .chat-back-btn:hover {
        text-decoration: underline;
    }

    .chat-post-header {
        margin-bottom: 22px;
    }

    .chat-post-header h2 {
        font-size: 1.15rem;
        margin: 0 0 4px;
        text-decoration-line: underline;
        text-decoration-style: dotted;
        text-decoration-color: var(--color-accent-3);
        text-decoration-thickness: 3px;
        text-underline-offset: 9px;
    }

    .chat-post-header small {
        color: var(--color-text-muted);
        font-size: 0.80rem;
    }

    /* ── Post list search input ── */
    .chat-search-wrap {
        margin-bottom: 10px;
    }

    .chat-search-wrap input[type=search] {
        width: 100%;
        padding: 8px 12px;
        font-size: 0.95rem;
        border: 2px solid var(--color-accent-2);
        border-radius: 12px;
        background: var(--color-bg);
        color: var(--color-text);
        /* focus styling is provided by focus-accessibility.css (:focus-visible) */
        transition: border-color 0.2s;
    }

    .chat-search-wrap input[type=search]:focus {
        border-color: var(--color-accent);
    }

    body.dark-mode .chat-search-wrap input[type=search] {
        border-color: var(--color-accent-2-dark);
        background: var(--color-bg-dark);
        color: var(--color-text-dark);
    }

    body.dark-mode .chat-search-wrap input[type=search]:focus {
        border-color: var(--color-accent);
    }

    .latest-item {
        cursor: pointer;
    }

    /* ── Full-height chat layout — no fixed pixels, scales to any screen ── */

    /* Propagate flex chain down to the chat only when .chat-page-wrap exists in DOM */
    body:has(.chat-page-wrap) > .page {
        flex: 1;
        display: flex;
        min-height: 0;
        overflow: hidden;
    }
    body:has(.chat-page-wrap) main {
        justify-content: flex-start;
        min-height: 0;
        overflow: hidden;
    }
    body:has(.chat-page-wrap) section {
        min-height: 0;
        overflow: hidden;
    }
    body:has(.chat-page-wrap) article {
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .chat-page-wrap {
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }

    .chat-page-wrap .chat-post-header {
        flex-shrink: 0;
    }

    .chat-page-wrap .ai-chatbox {
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }

    .chat-page-wrap .chat-messages {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        padding-bottom: 12px;
    }

    .chat-page-wrap .chat-composer {
        flex-shrink: 0;
        margin-top: 8px;
    }

    .chat-page-wrap .remaining-info {
        flex-shrink: 0;
    }
</style>

<h1 class="verybig">AI Chat</h1>

@if (_selectedPost == null)
{
    <div class="chat-search-wrap">
        <input type="search" placeholder="Hledat článek…"
               @bind="_search" @bind:event="oninput" />
    </div>

    @if (_loading)
    {
        <div class="loading-circle"></div>
    }
    else if (_error != null)
    {
        <p>@_error</p>
    }
    else
    {
        var visible = FilteredPosts();
        @if (!visible.Any())
        {
            <p>Žádné články neodpovídají hledání.</p>
        }
        else
        {
            <div class="posts-list">
                @foreach (var post in visible)
                {
                    <div class="post" tabindex="0" role="button" @onclick="() => SelectPost(post)" @onkeydown="@( (KeyboardEventArgs e) => HandleSelectPostKey(e, post) )">
                        <div style="display:flex;flex-direction:row;align-items:center;justify-content:space-between;">
                            <h5 style="margin: 0">@post.Title</h5>
                            <div class="latest-muted">
                                @if (CategoryName(post.CategoryId) is string cat && !string.IsNullOrEmpty(cat))
                                {
                                    <small class="text-muted">@cat</small>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
}
else
{
    <div class="chat-page-wrap">
        <button @onclick="GoBack" style="width: auto; align-self: flex-start;">
            <i class="bi bi-arrow-left"></i> Zpět na výběr článku
        </button>

        <AiChatBox PostId="@_selectedPost.Id" PostTitle="@_selectedPost.Title" />
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "postId")]
    public int? PostIdQuery { get; set; }

    private List<PostSummaryResponse> _posts = new();
    private Dictionary<int, string> _categoryNames = new();

    private PostSummaryResponse? _selectedPost;
    private string _search = string.Empty;
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var postsTask = Api.GetPostSummaries();
            var catsTask = Api.GetAllCategories();
            await Task.WhenAll(postsTask, catsTask);

            var allCats = catsTask.Result ?? new List<CategoryResponse>();
            _categoryNames = allCats.ToDictionary(c => c.Id, c => c.Name);

            _posts = (postsTask.Result ?? new List<PostSummaryResponse>())
                .Where(p => p.CategoryId == null
                            || !string.Equals(CategoryName(p.CategoryId), "More", StringComparison.OrdinalIgnoreCase))
                .OrderBy(p => p.Title)
                .ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Logger.LogError(ex, "Error loading posts for chat");
        }
        finally
        {
            _loading = false;
            if (PostIdQuery.HasValue && PostIdQuery.Value > 0)
            {
                _selectedPost = _posts.FirstOrDefault(p => p.Id == PostIdQuery.Value);
            }
        }
    }

    private List<PostSummaryResponse> FilteredPosts()
    {
        var q = _search.Trim();
        if (string.IsNullOrEmpty(q)) return _posts;
        return _posts.Where(p => p.Title.Contains(q, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private void SelectPost(PostSummaryResponse post)
    {
        _selectedPost = post;
        _search = string.Empty;
    }

    private void HandleSelectPostKey(KeyboardEventArgs e, PostSummaryResponse post)
    {
        if (e.Key == "Enter" || e.Key == " " || e.Key == "Spacebar")
            SelectPost(post);
    }

    private void GoBack()
    {
        _selectedPost = null;
    }

    private string CategoryName(int? id)
    {
        if (!id.HasValue) return string.Empty;
        return _categoryNames.TryGetValue(id.Value, out var n) ? n : string.Empty;
    }
}
