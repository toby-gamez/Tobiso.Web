@page "/obnova-hesla"
@layout AuthLayout
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Nové heslo - Tobiso</PageTitle>

<div class="login-card">
    <div class="login-brand">
        <img src="/images/normal-logo.png" alt="Tobiso" class="brand-logo-img logo-light" />
        <img src="/images/white-logo.png" alt="Tobiso" class="brand-logo-img logo-dark" />
    </div>

    <div>
        <h1 class="login-title">Nové heslo</h1>
        <p class="login-sub">Po uložení tě odhlásíme ze všech ostatních zařízení.</p>
    </div>

    @if (string.IsNullOrEmpty(Token))
    {
        <div class="login-error">Odkaz je neúplný. Otevři ho prosím znovu z e-mailu.</div>
        <a class="pill pill-on" href="/zapomenute-heslo">Poslat nový odkaz</a>
    }
    else
    {
        <div class="field">
            <label for="reset-pass">Nové heslo</label>
            <input id="reset-pass" class="input" type="password" placeholder="Alespoň 10 znaků"
                   @bind="_password" @bind:event="oninput" />
        </div>

        <div class="field">
            <label for="reset-pass2">Heslo znovu</label>
            <input id="reset-pass2" class="input" type="password" placeholder="••••••••"
                   @bind="_password2" @bind:event="oninput"
                   @onkeydown="@(async e => { if (e.Key == "Enter") await Submit(); })" />
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="login-error">@_error</div>
        }

        <button class="pill pill-on login-submit" @onclick="Submit" disabled="@_submitting">
            @if (_submitting) { <span>Ukládám…</span> } else { <span>Uložit heslo</span> }
        </button>

        <p class="login-register">
            <a href="/zapomenute-heslo">Poslat nový odkaz</a>
        </p>
    }
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private string _password = "";
    private string _password2 = "";
    private string _error = "";
    private bool _submitting;

    private async Task Submit()
    {
        if (_password.Length < 10)
        {
            _error = "Heslo musí mít alespoň 10 znaků.";
            return;
        }
        if (_password != _password2)
        {
            _error = "Hesla se neshodují.";
            return;
        }
        _submitting = true;
        _error = "";
        StateHasChanged();

        try
        {
            // Signs this browser in (HttpOnly cookie) once the new password is saved.
            var result = await AuthApi.PostAsync(JS, "/api/auth/reset-password", new { token = Token, password = _password });
            if (result.Ok)
            {
                Nav.NavigateTo("/", forceLoad: true);
                return;
            }
            _error = AuthApi.ErrorText(result, "Uložení se nezdařilo. Zkus to prosím znovu.");
        }
        finally
        {
            _submitting = false;
        }
    }
}
