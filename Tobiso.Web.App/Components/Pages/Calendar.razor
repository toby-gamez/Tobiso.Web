@page "/calendar"
@page "/kalendar"
@using System.Threading
@implements IDisposable
@inject IEventService EventService
@inject IJSRuntime JS

<PageTitle>Kalendář - Tobiso</PageTitle>

<div class="calendar-page">
    <div class="calendar-header">
        <div>
            <h1>@MonthLabel</h1>
            <p>Kalendář různých událostí, kdy se nechodí do školy.</p>
        </div>
        <div class="calendar-nav">
            <button class="pill calendar-nav-btn" @onclick="PrevMonth" aria-label="Předchozí měsíc"><i data-lucide="chevron-left"></i></button>
            <button class="pill calendar-nav-btn" @onclick="NextMonth" aria-label="Další měsíc"><i data-lucide="chevron-right"></i></button>
        </div>
    </div>

    <div class="calendar-grid-wrap">
        <div class="calendar-weekdays">
            @foreach (var d in Weekdays)
            {
                <span>@d</span>
            }
        </div>
        <div class="calendar-grid">
            @foreach (var cell in Cells)
            {
                var dayEvents = EventsOn(cell.Date);
                var primary = dayEvents.FirstOrDefault();
                var isWeekend = cell.Date.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;
                var cellClass = !cell.InMonth ? "calendar-cell-muted" : primary is null && isWeekend ? "calendar-cell-weekend" : "";
                <div class="calendar-cell @cellClass @(cell.Date.Date == DateTime.Today ? "calendar-cell-today" : "")"
                     style="@(primary is not null ? $"background:color-mix(in srgb, {primary.Color} 22%, var(--color-neutral-100))" : "")">
                    <span class="calendar-daynum" style="@(primary is not null ? $"color:color-mix(in srgb, {primary.Color} 65%, black)" : "")">@cell.Date.Day</span>
                    @foreach (var e in dayEvents.Take(2))
                    {
                        <span class="calendar-event" style="color:color-mix(in srgb, @e.Color 65%, black)" title="@e.Title">@e.Title</span>
                    }
                    @if (dayEvents.Count > 2)
                    {
                        <span class="calendar-more">+@(dayEvents.Count - 2)</span>
                    }
                </div>
            }
        </div>
    </div>

    <div>
        <h2>Nejbližší</h2>
        @if (Upcoming.Count == 0)
        {
            <p style="color:var(--color-neutral-600)">Žádné nadcházející události.</p>
        }
        else
        {
            <div class="calendar-upcoming">
                @foreach (var e in Upcoming)
                {
                    <div class="soft calendar-upcoming-row">
                        <span class="calendar-datebadge" style="background:color-mix(in srgb, @e.Color 22%, var(--color-surface)); color:color-mix(in srgb, @e.Color 70%, black)">
                            <span class="calendar-datebadge-day">@e.StartDate.Day</span>
                            <span class="calendar-datebadge-month">@MonthAbbrev(e.StartDate.Month)</span>
                        </span>
                        <span class="calendar-upcoming-text">
                            <span class="calendar-upcoming-title">@e.Title</span>
                            @if (!string.IsNullOrWhiteSpace(e.Description))
                            {
                                <span class="calendar-upcoming-sub">@e.Description</span>
                            }
                            @if (string.IsNullOrWhiteSpace(e.Description) || IsMultiDay(e))
                            {
                                <span class="calendar-upcoming-sub">@FormatRange(e)</span>
                            }
                        </span>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private static readonly string[] Weekdays = ["Po", "Út", "St", "Čt", "Pá", "So", "Ne"];

    private DateTime _month = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private List<EventResponse> _events = [];

    private record Cell(DateTime Date, bool InMonth);

    // Clicking the month-nav buttons fires another async load before the previous one
    // finishes; both would otherwise run concurrently against the same circuit-scoped
    // DbContext. Serialize loads and drop superseded ones.
    private readonly SemaphoreSlim _loadGate = new(1, 1);
    private int _loadGeneration;

    protected override async Task OnInitializedAsync() => await LoadMonth();

    protected override async Task OnAfterRenderAsync(bool firstRender) =>
        await JS.InvokeVoidAsync("initLucide");

    private bool _disposed;

    private async Task LoadMonth()
    {
        var myGeneration = ++_loadGeneration;
        try
        {
            await _loadGate.WaitAsync();
            try
            {
                if (myGeneration != _loadGeneration) return;
                var events = await EventService.GetByDateRange(_month.AddMonths(-1), _month.AddMonths(2));
                if (myGeneration != _loadGeneration) return;
                _events = events;
            }
            finally
            {
                _loadGate.Release();
            }
        }
        catch (Exception) when (_disposed)
        {
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _loadGate.Dispose();
    }

    private async Task PrevMonth() { _month = _month.AddMonths(-1); await LoadMonth(); }
    private async Task NextMonth() { _month = _month.AddMonths(1); await LoadMonth(); }

    private string MonthLabel => _month.ToString("MMMM yyyy", new System.Globalization.CultureInfo("cs-CZ"));

    private static readonly string[] MonthAbbrevs =
        ["led", "úno", "bře", "dub", "kvě", "čvn", "čvc", "srp", "zář", "říj", "lis", "pro"];

    private static string MonthAbbrev(int month) => MonthAbbrevs[month - 1];

    private List<Cell> Cells
    {
        get
        {
            var offset = ((int)_month.DayOfWeek + 6) % 7;
            var start = _month.AddDays(-offset);
            return [.. Enumerable.Range(0, 42)
                .Select(i => start.AddDays(i))
                .Select(d => new Cell(d, d.Month == _month.Month && d.Year == _month.Year))];
        }
    }

    private List<EventResponse> EventsOn(DateTime day) =>
        [.. _events.Where(e => e.StartDate.Date <= day.Date && (e.EndDate?.Date ?? e.StartDate.Date) >= day.Date)];

    private List<EventResponse> Upcoming =>
        [.. _events.Where(e => (e.EndDate?.Date ?? e.StartDate.Date) >= DateTime.Today)
            .OrderBy(e => e.StartDate)
            .Take(6)];

    private static bool IsMultiDay(EventResponse e) =>
        e.EndDate.HasValue && e.EndDate.Value.Date != e.StartDate.Date;

    private static string FormatRange(EventResponse e) =>
        IsMultiDay(e)
            ? $"{e.StartDate:d. M.} – {e.EndDate!.Value:d. M. yyyy}"
            : e.StartDate.ToString("d. M. yyyy");
}
