@page "/all-questions"
@using Tobiso.Web.Shared.DTOs
@using Tobiso.Web.Shared.Interfaces
@using Microsoft.AspNetCore.Components
@using System.Linq
@inject ITobisoAnonymApi Api
@inject NavigationManager Navigation
@inject ILogger<AllQuestions> Logger
@rendermode InteractiveServer

<PageTitle>Procvičování - Tobiso</PageTitle>

<style>
    @@import url('/css/variables.css');

    strong {
        color: var(--text-color);
        text-decoration: none;
    }
    body.dark-mode strong {
        color: var(--text-color-dark);
    }
    /* Mobile Responsive Styles */
    @@media (max-width: 1024px) {
        .container {
            padding: 0 1rem;
        }
    }
    
    @@media (max-width: 768px) {
        /* Mobile layout adjustments */
        .verybig {
            font-size: 2rem !important;
            text-align: center;
            margin-bottom: 1rem;
        }
        
        /* Filter toggle button for mobile */
        .mobile-filter-toggle {
            display: block;
            width: 100%;
            padding: 0.75rem;
            margin-bottom: 1rem;
            background-color: var(--color-accent);
            border: 2px solid #220b00;
            border-radius: 8px;
            color: #220b00;
            font-family: "Poppins", sans-serif;
            font-weight: 500;
            font-size: 16px;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .mobile-filter-toggle:hover {
            background-color: var(--color-accent-3);
        }
        
        .mobile-filter-toggle i {
            transition: transform 0.3s ease;
        }
        
        .mobile-filter-toggle.collapsed i {
            transform: rotate(-180deg);
        }
        
        body.dark-mode .mobile-filter-toggle {
            background-color: var(--color-accent-dark);
            border-color: #fcede9;
            color: #fcede9;
        }
        
        body.dark-mode .mobile-filter-toggle:hover {
            background-color: var(--color-accent-3-dark);
        }
        
        /* Mobile filter panel */
        .mobile-filter-wrapper {
            margin-bottom: 1rem;
        }
        
        .mobile-filter-wrapper.collapsed .filter-panel {
            display: none;
        }
        
        /* Mobile cards instead of table */
        .table-responsive {
            display: none;
        }
        
        .mobile-questions-list {
            display: block;
        }
        
        .mobile-question-card {
            background-color: var(--color-accent-2);
            border-radius: 10px;
            margin-bottom: 1rem;
            padding: 1rem;
            box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
            border: 2px solid transparent;
            transition: all 0.3s ease;
        }
        
        .mobile-question-card:hover {
            border-color: #220b00;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
        }
        
        .mobile-question-card.expanded {
            border-color: var(--text-color);
            background-color: var(--color-accent-4);
        }
        
        .mobile-question-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 0.75rem;
            cursor: pointer;
        }
        
        .mobile-question-id {
            font-weight: 600;
            font-size: 18px;
            color: var(--text-color);
            margin-right: 1rem;
            min-width: fit-content;
        }
        
        .mobile-question-text {
            flex: 1;
            color: var(--text-color);
            line-height: 1.4;
        }
        
        .mobile-question-text.expanded {
            font-weight: 600;
        }
        
        .mobile-question-meta {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 0.75rem;
            flex-wrap: wrap;
        }
        
        .mobile-meta-badge {
            padding: 0.25rem 0.5rem;
            border-radius: 15px;
            font-size: 12px;
            font-weight: 500;
        }
        
        .mobile-meta-badge.answers {
            background-color: var(--color-accent-2);
            color: var(--text-color);
        }
        
        .mobile-meta-badge.explanations {
            background-color: var(--color-accent-4);
            color: var(--text-color);
        }
        
        .mobile-question-actions {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }
        
        .mobile-question-actions {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }
        
        /* Mobile detail content */
        .mobile-question-detail {
            margin-top: 1rem;
            padding-top: 1rem;
            border-top: 2px solid var(--color-accent-2);
        }
        
        /* Touch-friendly improvements */
        .category-item, .post-item {
            min-height: 44px;
            padding: 0.75rem;
        }
        
        .expand-toggle {
            min-width: 44px;
            min-height: 44px;
        }
        
        /* Mobile info display improvements */
        .mobile-filter-info {
            background-color: var(--color-accent-4);
            padding: 1rem;
            border-radius: 8px;
            margin-bottom: 1rem;
            text-align: center;
        }
        
        .mobile-filter-info .intro {
            margin: 0;
            font-size: 16px;
        }
        
        .mobile-practice-button {
            width: 100%;
            margin-top: 0.75rem;
            padding: 0.75rem;
            min-height: 50px;
        }
        
        /* Dark mode mobile styles */
        body.dark-mode .mobile-question-card {
            background-color: var(--color-accent-dark);
        }
        
        body.dark-mode .mobile-question-card:hover {
            border-color: var(--color-white);
        }
        
        body.dark-mode .mobile-question-card.expanded {
            border-color: var(--color-white);
            background-color: var(--color-accent-3-dark);
        }
        
        body.dark-mode .mobile-question-id,
        body.dark-mode .mobile-question-text {
            color: var(--color-white);
        }
        
        body.dark-mode .mobile-question-detail {
            border-top-color: var(--color-accent-2);
        }
        
        body.dark-mode .mobile-filter-info {
            background-color: var(--color-accent-3-dark);
        }
        

        
        /* Dark mode mobile badge styles */
        body.dark-mode .mobile-meta-badge.answers {
            background-color: var(--color-accent-2);
            color: var(--color-white);
        }
        
        body.dark-mode .mobile-meta-badge.explanations {
            background-color: var(--color-accent-3-dark);
            color: var(--color-white);
        }
    }
    
    @@media (max-width: 480px) {
        .container {
            padding: 0 0.5rem;
        }
        
        .verybig {
            font-size: 1.75rem !important;
            margin-bottom: 0.75rem;
        }
        
        .filter-panel {
            padding: 0.75rem;
        }
        
        .mobile-question-card {
            padding: 0.75rem;
            margin-bottom: 0.75rem;
        }
        
        .category-children {
            margin-left: 0.75rem;
            padding-left: 0.5rem;
        }
        
        .mobile-question-actions {
            justify-content: stretch;
        }
        
        .mobile-question-id {
            font-size: 16px;
        }
        
        .mobile-question-text {
            font-size: 15px;
        }
        
        .mobile-meta-badge {
            font-size: 11px;
        }
        
        .mobile-filter-toggle {
            font-size: 15px;
            padding: 0.625rem;
        }
        
        .detail-section {
            padding: 0.5rem;
            min-height: 100px;
        }
        
        .detail-section h6 {
            font-size: 13px;
            margin-bottom: 0.4rem;
        }
        
        .answer-item, .explanation-item {
            font-size: 14px;
            padding: 0.375rem 0.5rem;
        }
    }
    
    /* Hide mobile elements on desktop */
    @@media (min-width: 769px) {
        .mobile-filter-toggle,
        .mobile-questions-list,
        .mobile-filter-info,
        .mobile-filter-wrapper {
            display: none !important;
        }
        
        .d-none.d-md-block {
            display: block !important;
        }
    }
    
    /* Hide desktop elements on mobile */
    @@media (max-width: 768px) {
        .d-none.d-md-block {
            display: none !important;
        }
    }
</style>

<div class="container">
    <h1 class="verybig">Procvičování</h1>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-box">
            <strong>Chyba:</strong> @errorMessage
        </div>
    }

    @if (questions == null)
    {
        <div class="text-center">
            <p class="">Načítám otázky...</p>
        </div>
    }
    else if (!questions.Any())
    {
        <div class="text-center">
            <h2>Žádné otázky</h2>
            <p class="intro">V systému nejsou k dispozici žádné otázky.</p>
        </div>
    }
    else
    {
        <!-- Mobile Filter Toggle -->
        <button type="button" class="mobile-filter-toggle @(mobileFilterCollapsed ? "collapsed" : "")" @onclick="ToggleMobileFilter">
            <i class="bi bi-funnel me-2"></i>
            Filtrovat téma
            <i class="bi bi-chevron-up ms-auto"></i>
        </button>

        <!-- Mobile Filter Info -->
        <div class="mobile-filter-info">
            <div class="intro">
                <i class="bi bi-question-circle"></i> 
                <strong>Zobrazeno: @(filteredQuestions?.Count ?? 0) z @(questions?.Count ?? 0) otázek</strong>
                @if (selectedCategoryId.HasValue || selectedPostId.HasValue)
                {
                    <br><small class="text-muted">
                        Filtr: @GetCurrentFilterName()
                        <button type="button" class="btn-danger" @onclick="ClearFilter">
                            <i class="bi bi-x-circle"></i> Zrušit
                        </button>
                    </small>
                }
                @if (filteredQuestions != null && filteredQuestions.Any())
                {
                    <div class="practice-controls">
                        <button type="button" class="btn-success mobile-practice-button" @onclick="StartPractice">
                            <i class="bi bi-play-circle"></i> Procvičovat (@(filteredQuestions.Count))
                        </button>
                    </div>
                }
            </div>
        </div>

        <!-- Mobile Filter Panel -->
        <div class="mobile-filter-wrapper @(mobileFilterCollapsed ? "collapsed" : "")">
            <div class="filter-panel">
                <h6 class="filter-header">
                    <i class="bi bi-funnel"></i> Filtrovat téma
                </h6>
                <div class="category-tree">
                    @if (categories != null)
                    {
                        @foreach (var category in categories.Where(c => c.ParentId == null).OrderBy(c => c.Name))
                        {
                            @RenderCategoryNode(category)
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Desktop Layout -->
        <div class="mb-4 d-none d-md-block">
            <div class="row">
                <div class="col-md-4">
                    <div class="filter-panel">
                        <h6 class="filter-header">
                            <i class="bi bi-funnel"></i> Filtrovat téma
                        </h6>
                        <div class="category-tree">
                            @if (categories != null)
                            {
                                @foreach (var category in categories.Where(c => c.ParentId == null).OrderBy(c => c.Name))
                                {
                                    @RenderCategoryNode(category)
                                }
                            }
                        </div>
                    </div>
                </div>
                <div class="col-md-8">
                    <div class="mb-3 intro" style="margin-top: 5px;">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="intro">
                                <i class="bi bi-question-circle"></i> 
                                <strong>Zobrazeno: @(filteredQuestions?.Count ?? 0) z @(questions?.Count ?? 0) otázek</strong>
                                @if (selectedCategoryId.HasValue || selectedPostId.HasValue)
                                {
                                    <br><small class="text-muted">
                                        Filtr: @GetCurrentFilterName()
                                        <button type="button" class="btn-danger" @onclick="ClearFilter" style="font-size: 12px;">
                                            <i class="bi bi-x-circle"></i> Zrušit
                                        </button>
                                    </small>
                                }
                                @if (filteredQuestions != null && filteredQuestions.Any())
                                {
                                    <div class="practice-controls" style="margin-top: 0.75rem;">
                                        <button type="button" class="btn-success" @onclick="StartPractice">
                                            <i class="bi bi-play-circle"></i> Procvičovat (@(filteredQuestions.Count))
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Desktop Table View -->
        <div class="table-responsive">
            <table class="questions-table table">
                <thead>
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">Otázka</th>
                        <th scope="col">Odpovědi</th>
                        <th scope="col">Vysvětlení</th>
                        <th scope="col">Akce</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var question in filteredQuestions ?? Enumerable.Empty<QuestionResponse>())
                    {
                        <tr style="cursor: pointer;" @onclick="() => ToggleQuestionDetail(question.Id)" class="@(expandedQuestionId == question.Id ? "table-active" : "")">
                            <td><strong>@question.Id</strong></td>
                            <td>
                                <div title="@question.QuestionText">
                                    @if (expandedQuestionId == question.Id)
                                    {
                                        <span class="question-text-full">@question.QuestionText</span>
                                    }
                                    else
                                    {
                                        @(question.QuestionText.Length > 60 ? question.QuestionText.Substring(0, 60) + "..." : question.QuestionText)
                                    }
                                </div>
                            </td>
                            <td class="text-center"><span class="badge bg-primary">@question.Answers.Count</span></td>
                            <td class="text-center"><span class="badge bg-info">@question.Explanations.Count</span></td>
                            <td>
                                <button @onclick="() => GoToPost(question.PostId)" @onclick:stopPropagation="true">
                                    <i class="bi bi-arrow-right"></i> Post
                                </button>
                                @if (expandedQuestionId == question.Id)
                                {
                                    <button class="btn-danger" @onclick="() => CloseDetail()" @onclick:stopPropagation="true">
                                        <i class="bi bi-x"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                        
                        @if (expandedQuestionId == question.Id)
                        {
                            <tr class="question-detail-row">
                                <td colspan="5" class="p-0">
                                    <div class="question-detail-content">
                                        <div class="question-detail-row-flex">
                                            <div class="detail-col">
                                                <div class="detail-section">
                                                    @if (question.Answers.Any())
                                                    {
                                                        <h6><i class="bi bi-list-check"></i> Odpovědi:</h6>
                                                        <div class="answers-list">
                                                            @foreach (var answer in question.Answers)
                                                            {
                                                                <div class="answer-item @(answer.Correct == 1 ? "correct-answer" : "")">
                                                                    @if (answer.Correct == 1)
                                                                    {
                                                                        <i class="bi bi-check-circle-fill me-1"></i>
                                                                    }
                                                                    else
                                                                    {
                                                                        <i class="bi bi-circle me-1"></i>
                                                                    }
                                                                    @answer.AnswerText
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <h6><i class="bi bi-list-check"></i> Odpovědi:</h6>
                                                        <p style="color: #666; font-style: italic;">Žádné odpovědi</p>
                                                    }
                                                </div>
                                            </div>
                                            
                                            <div class="detail-col">
                                                <div class="detail-section">
                                                    @if (question.Explanations.Any())
                                                    {
                                                        <h6><i class="bi bi-lightbulb"></i> Vysvětlení:</h6>
                                                        <div class="explanations-list">
                                                            @foreach (var explanation in question.Explanations)
                                                            {
                                                                <div class="explanation-item">
                                                                    <i class="bi bi-info-circle me-1"></i>
                                                                    @explanation.Text
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <h6><i class="bi bi-lightbulb"></i> Vysvětlení:</h6>
                                                        <p style="color: #666; font-style: italic;">Žádná vysvětlení</p>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div class="text-center mt-2">
                                            <small class="text-muted">
                                                <i class="bi bi-file-text"></i> @GetPostTitle(question.PostId)
                                                <span class="text-muted">(ID: @question.PostId)</span>
                                            </small>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Mobile Cards View -->
        <div class="mobile-questions-list">
            @foreach (var question in filteredQuestions ?? Enumerable.Empty<QuestionResponse>())
            {
                <div class="mobile-question-card @(expandedQuestionId == question.Id ? "expanded" : "")">
                    <div class="mobile-question-header" @onclick="() => ToggleQuestionDetail(question.Id)">
                        <div class="mobile-question-id">#@question.Id</div>
                        <div class="mobile-question-text @(expandedQuestionId == question.Id ? "expanded" : "")">
                            @if (expandedQuestionId == question.Id)
                            {
                                @question.QuestionText
                            }
                            else
                            {
                                @(question.QuestionText.Length > 80 ? question.QuestionText.Substring(0, 80) + "..." : question.QuestionText)
                            }
                        </div>
                    </div>
                    
                    <div class="mobile-question-meta">
                        <span class="mobile-meta-badge answers">
                            <i class="bi bi-list-check"></i> @question.Answers.Count odpovědi
                        </span>
                        <span class="mobile-meta-badge explanations">
                            <i class="bi bi-lightbulb"></i> @question.Explanations.Count vysvětlení
                        </span>
                    </div>
                    
                    <div class="mobile-question-actions">
                        <button type="button" @onclick="() => GoToPost(question.PostId)">
                            <i class="bi bi-arrow-right"></i> Jít na článek
                        </button>
                        @if (expandedQuestionId == question.Id)
                        {
                            <button type="button" class="btn-danger" @onclick="() => CloseDetail()">
                                <i class="bi bi-x"></i> Zavřít
                            </button>
                        }
                    </div>
                    
                    @if (expandedQuestionId == question.Id)
                    {
                        <div class="mobile-question-detail">
                            <div class="question-detail-row-flex">
                                <div class="detail-col">
                                    <div class="detail-section">
                                        @if (question.Answers.Any())
                                        {
                                            <h6><i class="bi bi-list-check"></i> Odpovědi:</h6>
                                            <div class="answers-list">
                                                @foreach (var answer in question.Answers)
                                                {
                                                    <div class="answer-item @(answer.Correct == 1 ? "correct-answer" : "")">
                                                        @if (answer.Correct == 1)
                                                        {
                                                            <i class="bi bi-check-circle-fill me-1"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-circle me-1"></i>
                                                        }
                                                        @answer.AnswerText
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <h6><i class="bi bi-list-check"></i> Odpovědi:</h6>
                                            <p style="color: #666; font-style: italic;">Žádné odpovědi</p>
                                        }
                                    </div>
                                </div>
                                
                                <div class="detail-col">
                                    <div class="detail-section">
                                        @if (question.Explanations.Any())
                                        {
                                            <h6><i class="bi bi-lightbulb"></i> Vysvětlení:</h6>
                                            <div class="explanations-list">
                                                @foreach (var explanation in question.Explanations)
                                                {
                                                    <div class="explanation-item">
                                                        <i class="bi bi-info-circle me-1"></i>
                                                        @explanation.Text
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <h6><i class="bi bi-lightbulb"></i> Vysvětlení:</h6>
                                            <p style="color: #666; font-style: italic;">Žádná vysvětlení</p>
                                        }
                                    </div>
                                </div>
                            </div>
                            
                            <div class="text-center mt-2">
                                <small class="text-muted">
                                    <i class="bi bi-file-text"></i> @GetPostTitle(question.PostId)
                                    <span class="text-muted">(ID: @question.PostId)</span>
                                </small>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }


</div>

@code {
    private List<QuestionResponse>? questions;
    private List<QuestionResponse>? filteredQuestions;
    private List<CategoryResponse>? categories;
    private List<PostResponse>? posts;
    private Dictionary<int, string> postTitles = new();
    private Dictionary<int, string> postCategories = new();
    private int? expandedQuestionId;
    private string? errorMessage;
    private int? selectedCategoryId;
    private int? selectedPostId;
    private HashSet<int> expandedCategoryIds = new();
    private bool mobileFilterCollapsed = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadAllData();
    }

    private async Task LoadAllData()
    {
        try
        {
            // Načtení všech dat paralelně
            var questionsTask = Api.GetAllQuestions();
            var categoriesTask = Api.GetAllCategories();
            var postsTask = Api.GetAllPosts();

            await Task.WhenAll(questionsTask, categoriesTask, postsTask);

            questions = questionsTask.Result;
            categories = categoriesTask.Result;
            posts = postsTask.Result.ToList();

            await LoadPostTitles();
            BuildPostCategoriesMapping();
            FilterCategoriesToOnlyThoseWithQuestions();
            ApplyFilter();
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba při načítání dat: {ex.Message}";
            Logger.LogError(ex, "Chyba při načítání dat pro otázky");
            questions = new List<QuestionResponse>();
            filteredQuestions = new List<QuestionResponse>();
            categories = new List<CategoryResponse>();
            posts = new List<PostResponse>();
        }
    }

    private async Task LoadPostTitles()
    {
        try
        {
            if (questions == null) return;
            
            var uniquePostIds = questions.Select(q => q.PostId).Distinct().ToList();
            
            foreach (var postId in uniquePostIds)
            {
                try
                {
                    var post = await Api.GetPostById(postId);
                    postTitles[postId] = post.Title;
                }
                catch
                {
                    postTitles[postId] = $"Post {postId}";
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Chyba při načítání názvů postů");
        }
    }

    private string GetPostTitle(int postId)
    {
        return postTitles.ContainsKey(postId) ? postTitles[postId] : $"Post {postId}";
    }

    private void ToggleQuestionDetail(int questionId)
    {
        if (expandedQuestionId == questionId)
        {
            expandedQuestionId = null;
        }
        else
        {
            expandedQuestionId = questionId;
        }
        StateHasChanged();
    }

    private void CloseDetail()
    {
        expandedQuestionId = null;
        StateHasChanged();
    }

    private void GoToPost(int postId)
    {
        Navigation.NavigateTo($"/post/{postId}");
    }

    private void BuildPostCategoriesMapping()
    {
        if (posts == null || categories == null) return;

        foreach (var post in posts)
        {
            if (post.CategoryId.HasValue)
            {
                var category = categories.FirstOrDefault(c => c.Id == post.CategoryId.Value);
                if (category != null)
                {
                    postCategories[post.Id] = GetCategoryFullPath(category);
                }
            }
        }
    }

    private string GetCategoryFullPath(CategoryResponse category)
    {
        if (categories == null) return category.Name;

        var path = new List<string>();
        var current = category;
        
        while (current != null)
        {
            path.Insert(0, current.Name);
            current = current.ParentId.HasValue 
                ? categories.FirstOrDefault(c => c.Id == current.ParentId.Value)
                : null;
        }
        
        return string.Join(" > ", path);
    }

    private void FilterCategoriesToOnlyThoseWithQuestions()
    {
        if (categories == null || questions == null || posts == null) return;

        // Získáme ID postů, které mají otázky
        var postIdsWithQuestions = questions.Select(q => q.PostId).Distinct().ToHashSet();
        
        // Získáme kategorie těchto postů
        var categoryIdsWithQuestions = posts
            .Where(p => postIdsWithQuestions.Contains(p.Id) && p.CategoryId.HasValue)
            .Select(p => p.CategoryId!.Value)
            .Distinct()
            .ToHashSet();

        // Přidáme i rodičovské kategorie
        var allRelevantCategoryIds = new HashSet<int>(categoryIdsWithQuestions);
        foreach (var categoryId in categoryIdsWithQuestions)
        {
            var category = categories.FirstOrDefault(c => c.Id == categoryId);
            while (category?.ParentId.HasValue == true)
            {
                allRelevantCategoryIds.Add(category.ParentId.Value);
                category = categories.FirstOrDefault(c => c.Id == category.ParentId.Value);
            }
        }

        // Filtrujeme kategorie pouze na ty relevantní
        categories = categories.Where(c => allRelevantCategoryIds.Contains(c.Id)).ToList();
    }

    private void ApplyFilter()
    {
        if (questions == null)
        {
            filteredQuestions = new List<QuestionResponse>();
            return;
        }

        // Filtr podle konkrétního postu
        if (selectedPostId.HasValue)
        {
            filteredQuestions = questions.Where(q => q.PostId == selectedPostId.Value).ToList();
            return;
        }

        // Filtr podle kategorie
        if (selectedCategoryId.HasValue)
        {
            if (posts == null)
            {
                filteredQuestions = new List<QuestionResponse>();
                return;
            }

            // Získáme všechny podkategorie vybrané kategorie
            var relevantCategoryIds = GetAllSubcategoryIds(selectedCategoryId.Value);
            
            // Filtrujeme posty podle kategorií
            var relevantPostIds = posts
                .Where(p => p.CategoryId.HasValue && relevantCategoryIds.Contains(p.CategoryId.Value))
                .Select(p => p.Id)
                .ToHashSet();

            // Filtrujeme otázky podle postů
            filteredQuestions = questions
                .Where(q => relevantPostIds.Contains(q.PostId))
                .ToList();
            return;
        }

        // Žádný filtr - zobraz vše
        filteredQuestions = questions.ToList();
    }

    private HashSet<int> GetAllSubcategoryIds(int categoryId)
    {
        if (categories == null) return new HashSet<int> { categoryId };

        var result = new HashSet<int> { categoryId };
        var subcategories = categories.Where(c => c.ParentId == categoryId);
        
        foreach (var subcategory in subcategories)
        {
            var subIds = GetAllSubcategoryIds(subcategory.Id);
            foreach (var id in subIds)
            {
                result.Add(id);
            }
        }
        
        return result;
    }

    private void OnCategoryFilterChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var categoryId))
        {
            selectedCategoryId = categoryId;
        }
        else
        {
            selectedCategoryId = null;
        }
        
        ApplyFilter();
        StateHasChanged();
    }

    private string GetSelectedCategoryName()
    {
        if (!selectedCategoryId.HasValue || categories == null) return "";
        
        var category = categories.FirstOrDefault(c => c.Id == selectedCategoryId.Value);
        return category != null ? GetCategoryFullPath(category) : "";
    }

    private RenderFragment RenderCategoryOption(CategoryResponse category, int level) => __builder =>
    {
        var prefix = GetCategoryPrefix(category.Id, level);
        
        <option value="@category.Id">@(prefix + category.Name)</option>
        
        if (categories != null)
        {
            foreach (var subcategory in categories.Where(c => c.ParentId == category.Id).OrderBy(c => c.Name))
            {
                @RenderCategoryOption(subcategory, level + 1)
            }
        }
    };

    private string GetCategoryPrefix(int categoryId, int level)
    {
        if (level == 0) return "";
        if (categories == null) return "";

        var category = categories.FirstOrDefault(c => c.Id == categoryId);
        if (category?.ParentId == null) return "";

        var siblings = categories.Where(c => c.ParentId == category.ParentId).OrderBy(c => c.Name).ToList();
        var isLast = siblings.Last().Id == categoryId;
        
        var parentPrefix = "";
        if (level > 1)
        {
            parentPrefix = GetParentPrefix(category.ParentId.Value, level - 1);
        }
        
        var currentPrefix = isLast ? "└─ " : "├─ ";
        
        return parentPrefix + currentPrefix;
    }

    private string GetParentPrefix(int parentId, int level)
    {
        if (level == 0) return "";
        if (categories == null) return "";
        
        var parentCategory = categories.FirstOrDefault(c => c.Id == parentId);
        if (parentCategory?.ParentId == null) return "│  ";
        
        var parentSiblings = categories.Where(c => c.ParentId == parentCategory.ParentId).OrderBy(c => c.Name).ToList();
        var parentIsLast = parentSiblings.Last().Id == parentId;
        
        var grandParentPrefix = "";
        if (level > 1)
        {
            grandParentPrefix = GetParentPrefix(parentCategory.ParentId.Value, level - 1);
        }
        
        var currentPrefix = parentIsLast ? "   " : "│  ";
        
        return grandParentPrefix + currentPrefix;
    }

    private List<CategoryResponse> GetOrderedCategories()
    {
        if (categories == null) return new List<CategoryResponse>();
        
        var result = new List<CategoryResponse>();
        var rootCategories = categories.Where(c => c.ParentId == null).OrderBy(c => c.Name);
        
        foreach (var rootCategory in rootCategories)
        {
            AddCategoryAndChildrenToList(rootCategory, result);
        }
        
        return result;
    }

    private void AddCategoryAndChildrenToList(CategoryResponse category, List<CategoryResponse> result)
    {
        if (categories == null) return;
        
        result.Add(category);
        
        var children = categories.Where(c => c.ParentId == category.Id).OrderBy(c => c.Name);
        foreach (var child in children)
        {
            AddCategoryAndChildrenToList(child, result);
        }
    }

    private RenderFragment RenderCategoryOptionFlat(CategoryResponse category) => __builder =>
    {
        var level = GetCategoryLevel(category.Id);
        var prefix = GetCategoryPrefixForLevel(category.Id, level);
        
        <option value="@category.Id">@(prefix + category.Name)</option>
    };

    private int GetCategoryLevel(int categoryId)
    {
        if (categories == null) return 0;
        
        var category = categories.FirstOrDefault(c => c.Id == categoryId);
        if (category?.ParentId == null) return 0;
        
        return 1 + GetCategoryLevel(category.ParentId.Value);
    }

    private string GetCategoryPrefixForLevel(int categoryId, int level)
    {
        if (level == 0) return "";
        if (categories == null) return "";

        var category = categories.FirstOrDefault(c => c.Id == categoryId);
        if (category?.ParentId == null) return "";

        // Zjistíme, jestli je to poslední sourozenec
        var siblings = categories.Where(c => c.ParentId == category.ParentId).OrderBy(c => c.Name).ToList();
        var isLast = siblings.Last().Id == categoryId;
        
        // Sestavíme prefix podle všech nadřazených úrovní
        var prefixParts = new List<string>();
        var currentCat = category;
        var currentLevel = level;
        
        while (currentCat?.ParentId != null && currentLevel > 0)
        {
            var currentSiblings = categories.Where(c => c.ParentId == currentCat.ParentId).OrderBy(c => c.Name).ToList();
            var currentIsLast = currentSiblings.Last().Id == currentCat.Id;
            
            if (currentLevel == 1)
            {
                prefixParts.Insert(0, currentIsLast ? "└─ " : "├─ ");
            }
            else
            {
                prefixParts.Insert(0, currentIsLast ? "   " : "│  ");
            }
            
            currentCat = categories.FirstOrDefault(c => c.Id == currentCat.ParentId);
            currentLevel--;
        }
        
        return string.Join("", prefixParts);
    }

    private RenderFragment RenderCategoryNode(CategoryResponse category) => __builder =>
    {
        var hasChildren = categories?.Any(c => c.ParentId == category.Id) == true;
        var hasPostsWithQuestions = GetPostsWithQuestionsInCategory(category.Id).Any();
        var isExpanded = expandedCategoryIds.Contains(category.Id);
        var isSelected = selectedCategoryId == category.Id;
        
        <div class="category-node">
            <div class="category-item @(isSelected ? "selected" : "") @(hasChildren ? "has-children" : "")" 
                 @onclick="() => OnCategoryClick(category.Id)">
                @if (hasChildren)
                {
                    <button type="button" class="expand-toggle" @onclick="() => ToggleCategoryExpansion(category.Id)" @onclick:stopPropagation="true">
                        <i class="bi @(isExpanded ? "bi-chevron-down" : "bi-chevron-right")"></i>
                    </button>
                }
                else
                {
                    <span class="expand-toggle"></span>
                }
                <i class="bi bi-folder me-2"></i>
                @category.Name
                @{
                    var questionCount = GetQuestionCountInCategory(category.Id);
                }
                <span class="question-count">(@questionCount)</span>
            </div>
            
            @if ((isExpanded && hasChildren) || (!hasChildren && hasPostsWithQuestions))
            {
                <div class="category-children">
                    @if (categories != null && hasChildren)
                    {
                        @foreach (var child in categories.Where(c => c.ParentId == category.Id).OrderBy(c => c.Name))
                        {
                            @RenderCategoryNode(child)
                        }
                    }
                    
                    @* Zobrazit posty v této kategorii *@
                    @foreach (var post in GetPostsWithQuestionsInCategory(category.Id))
                    {
                        @RenderPostNode(post)
                    }
                </div>
            }
        </div>
    };

    private RenderFragment RenderPostNode(PostResponse post) => __builder =>
    {
        var questionCount = questions?.Count(q => q.PostId == post.Id) ?? 0;
        var isSelected = selectedPostId == post.Id;
        
        <div class="post-item @(isSelected ? "selected" : "")" @onclick="() => OnPostClick(post.Id)">
            <i class="bi bi-file-earmark-text post-icon"></i>
            @post.Title
            <span class="question-count">(@questionCount)</span>
        </div>
    };

    private void ClearFilter()
    {
        selectedCategoryId = null;
        selectedPostId = null;
        ApplyFilter();
        StateHasChanged();
    }

    private void OnCategoryClick(int categoryId)
    {
        if (selectedCategoryId == categoryId)
        {
            // Zrušit výběr pokud kliknu na stejnou kategorii
            selectedCategoryId = null;
        }
        else
        {
            selectedCategoryId = categoryId;
            selectedPostId = null; // Zrušit výběr postu
        }
        
        ApplyFilter();
        StateHasChanged();
    }

    private void OnPostClick(int postId)
    {
        if (selectedPostId == postId)
        {
            // Zrušit výběr pokud kliknu na stejný post
            selectedPostId = null;
        }
        else
        {
            selectedPostId = postId;
            selectedCategoryId = null; // Zrušit výběr kategorie
        }
        
        ApplyFilter();
        StateHasChanged();
    }

    private void ToggleCategoryExpansion(int categoryId)
    {
        if (expandedCategoryIds.Contains(categoryId))
        {
            expandedCategoryIds.Remove(categoryId);
        }
        else
        {
            expandedCategoryIds.Add(categoryId);
        }
        StateHasChanged();
    }

    private List<PostResponse> GetPostsWithQuestionsInCategory(int categoryId)
    {
        if (posts == null || questions == null) return new List<PostResponse>();
        
        var postsWithQuestions = posts
            .Where(p => p.CategoryId == categoryId)
            .Where(p => questions.Any(q => q.PostId == p.Id))
            .OrderBy(p => p.Title)
            .ToList();
        
        return postsWithQuestions;
    }

    private int GetQuestionCountInCategory(int categoryId)
    {
        if (posts == null || questions == null) return 0;
        
        var relevantCategoryIds = GetAllSubcategoryIds(categoryId);
        var postIds = posts
            .Where(p => p.CategoryId.HasValue && relevantCategoryIds.Contains(p.CategoryId.Value))
            .Select(p => p.Id)
            .ToHashSet();
        
        return questions.Count(q => postIds.Contains(q.PostId));
    }

    private string GetCurrentFilterName()
    {
        if (selectedPostId.HasValue)
        {
            var post = posts?.FirstOrDefault(p => p.Id == selectedPostId.Value);
            return post != null ? $"Článek: {post.Title}" : "Neznámý článek";
        }
        
        if (selectedCategoryId.HasValue)
        {
            var category = categories?.FirstOrDefault(c => c.Id == selectedCategoryId.Value);
            return category != null ? $"Kategorie: {GetCategoryFullPath(category)}" : "Neznámá kategorie";
        }
        
        return "";
    }

    private void StartPractice()
    {
        if (filteredQuestions == null || !filteredQuestions.Any())
        {
            return;
        }

        // Uložíme filtrované otázky do session storage nebo jiného úložiště
        // Pro jednoduchost použijeme query parametry s IDs otázek
        var questionIds = string.Join(",", filteredQuestions.Select(q => q.Id));
        
        // Přesměrujeme na novou stránku pro procvičování s vybranými otázkami
        Navigation.NavigateTo($"/practice?questions={questionIds}");
    }

    private void ToggleMobileFilter()
    {
        mobileFilterCollapsed = !mobileFilterCollapsed;
        StateHasChanged();
    }
}