@page "/"
@using Tobiso.Web.App.Services
@inject IPostService PostService
@inject ICategoryService CategoryService
@inject IUserProgressService UserProgressService
@inject IUserService UserService
@inject IAnonymousUsageService AnonymousUsage
@inject IAiRateLimitService AiRateLimit
@inject IConfiguration Configuration
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Domů - Tobiso</PageTitle>

<div class="home-page">
    <div class="home-greeting">
        <h1>@_greeting, @(_userName ?? "studente").</h1>
        <p>@_subtitle</p>
    </div>

    @if (_stats != null || _loading)
    {
        <div class="stats-row">
            <div class="soft stat-card">
                <span class="stat-card-label">Série</span>
                <span class="stat-card-value">@CzechPlural.Dny(_stats?.StreakDays ?? 0)</span>
                <span class="stat-card-sub">Přečti dnes jeden článek a série pokračuje.</span>
            </div>
            <div class="soft stat-card">
                <span class="stat-card-label">Přečteno celkem</span>
                <span class="stat-card-value">@(_stats?.TotalRead ?? 0)</span>
                <span class="stat-card-sub">@TopSubjectText()</span>
            </div>
            <div class="stat-card credits-card">
                <span class="stat-card-label" style="color:var(--color-accent-800)">AI kredity</span>
                <span class="stat-card-value" style="color:var(--color-accent-800)">@(_credits)</span>
                <span class="stat-card-sub" style="color:var(--color-accent-800)">Jedna otázka = 1 kredit.</span>
            </div>
        </div>
    }
    <div class="home-cards">
        @if (_continueReading != null)
        {
            <a class="home-card-continue lift" href="@PostSlug.Url(_continueReading.PostId, _continueReading.FilePath)">
                <span class="home-card-tag">
                    <i data-lucide="rotate-cw"></i> Pokračovat ve čtení
                </span>
                <span class="home-card-title">@_continueReading.Title</span>
                <span class="home-card-sub">
                    @(_continueReading.CategoryPath != null ? $"{_continueReading.CategoryPath} · " : "")@(_continueReading.ScrollPercent) % přečteno
                </span>
                <div class="progress-bar" style="margin-top:var(--space-2)"><div class="progress-bar-fill" style="width:@(_continueReading.ScrollPercent)%"></div></div>
            </a>
        }
        @if (_articleOfDay != null)
        {
            <a class="home-card-artofday sage-tint" href="@PostSlug.Url(_articleOfDay.Id, _articleOfDay.FilePath)">
                <span class="home-card-tag">
                    <i data-lucide="sun"></i> Článek dne
                </span>
                <span class="home-card-title">@_articleOfDay.Title</span>
                <span class="pill pill-on home-card-artofday-btn">
                    Přejít na článek <i data-lucide="arrow-right"></i>
                </span>
            </a>
        }
        @if (_anonCreditsRemaining is int remaining)
        {
            <div class="stat-card credits-card home-card-credits">
                <span class="stat-card-label" style="color:var(--color-accent-800)">AI dotazy zdarma</span>
                <span class="stat-card-value" style="color:var(--color-accent-800)">@remaining / @_anonCreditsLimit</span>
                @if (remaining > 0)
                {
                    <span class="stat-card-sub" style="color:var(--color-accent-800)">Dnešní zdarma dotazy na AI. Obnoví se zítra.</span>
                }
                else
                {
                    <span class="stat-card-sub" style="color:var(--color-accent-800)">
                        Dnešní dotazy zdarma jsou vyčerpané. <a href="/registrace">Zaregistruj se</a> a získej víc kreditů.
                    </span>
                }
            </div>
        }
    </div>

    <div class="subject-section">
        <h2>Předměty</h2>
        <div class="subject-grid">
            @foreach (var cat in _rootCategories)
            {
                <a class="subject-card lift" href="/categories/@(cat.Id)">
                    <span class="subject-icon"><i data-lucide="@SubjectIcon(cat.Name)"></i></span>
                    <span class="subject-name">@cat.Name</span>
                    <span class="subject-count">@CategoryCountLabel(cat)</span>
                </a>
            }
        </div>
    </div>
</div>

@code {
    private bool _loading = true;
    private UserStatsDto? _stats;
    private int _credits;
    private int? _anonCreditsRemaining;
    private int _anonCreditsLimit = 20;
    private bool _anonCreditsLoaded;
    private PostLinkResponse? _articleOfDay;
    private ContinueReadingDto? _continueReading;
    private List<CategoryTreeResponse> _rootCategories = [];
    private List<PostSummaryResponse> _summaries = [];
    private string? _userName;
    private string _greeting = "Dobrý den";
    private string _subtitle = "";

    private bool _disposed;

    // Home's injected services (PostService, CategoryService, UserProgressService,
    // UserService) share one scoped DbContext for the whole circuit. OnInitializedAsync
    // and OnAuthStateChanged are two independent async entry points into this
    // component, so without serializing them a NotifyStateChanged firing mid-load
    // races the initial load on the same DbContext (EF's ConcurrencyDetector throws
    // "A second operation was started on this context instance...").
    private readonly SemaphoreSlim _dbLock = new(1, 1);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Subscribe before the first await: on a fresh circuit (e.g. right after
            // login's forceLoad redirect) the JWT isn't restored from localStorage yet
            // when this runs, so we'd otherwise render as anonymous and never recover.
            AuthState.AuthenticationStateChanged += OnAuthStateChanged;

            var auth = await AuthState.GetAuthenticationStateAsync();

            await _dbLock.WaitAsync();
            try
            {
                await LoadForUser(auth.User);

                _greeting = GetGreeting();

                _articleOfDay = await PostService.GetArticleOfTheDayAsync();
                _rootCategories = [.. (await CategoryService.GetTree()).Where(c => !IsMore(c.Name))];
                _summaries = await PostService.GetSummaries();

                _subtitle = _articleOfDay != null
                    ? $"Dnes tě čeká článek: {_articleOfDay.Title}."
                    : "Vyber si téma a začni studovat.";

                _loading = false;
            }
            finally
            {
                _dbLock.Release();
            }
        }
        catch (Exception) when (_disposed)
        {
        }
    }

    private async Task LoadForUser(ClaimsPrincipal user)
    {
        if (user.Identity?.IsAuthenticated == true)
        {
            _userName = user.FindFirst(ClaimTypes.Name)?.Value;
            if (int.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out int uid))
            {
                _stats = await UserProgressService.GetStatsAsync(uid);
                _credits = (await UserService.GetByIdAsync(uid))?.Credits ?? 0;
                _continueReading = await UserProgressService.GetContinueReadingAsync(uid);
            }
        }
        else
        {
            _userName = null;
            _stats = null;
            _credits = 0;
            _continueReading = null;
        }
    }

    private async void OnAuthStateChanged(Task<AuthenticationState> task)
    {
        try
        {
            var auth = await task;

            await _dbLock.WaitAsync();
            try
            {
                await LoadForUser(auth.User);
            }
            finally
            {
                _dbLock.Release();
            }

            if (!_disposed)
                await InvokeAsync(StateHasChanged);
        }
        catch (Exception) when (_disposed)
        {
        }
    }

    public void Dispose()
    {
        _disposed = true;
        AuthState.AuthenticationStateChanged -= OnAuthStateChanged;
        _dbLock.Dispose();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Not gated on firstRender: the actual first paint happens before the
        // awaited data (_rootCategories, _articleOfDay) loads, so the icons that
        // depend on it only exist in the DOM from the second render onward.
        try
        {
            await JS.InvokeVoidAsync("initLucide");

            // Anonymous visitors' remaining AI quota lives in a browser-persisted device id
            // (not available until the circuit is interactive), so it's fetched here rather than
            // in OnInitializedAsync. Gated on _loading rather than firstRender: the first render
            // can happen before LoadForUser resolves, same reasoning as initLucide above.
            if (!_loading && _stats == null && !_anonCreditsLoaded)
            {
                _anonCreditsLoaded = true;
                await LoadAnonymousCreditsAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // Circuit disconnected (e.g. navigating away) while this call was in
            // flight - nothing to recover from, UI is being torn down regardless.
        }
    }

    private async Task LoadAnonymousCreditsAsync()
    {
        var deviceId = await JS.InvokeAsync<string>("getDeviceId");
        var key = $"device:{deviceId}";
        var baseLimit = int.TryParse(Configuration["OpenAI:AnonymousDailyRequests"], out var al) ? al : 20;
        _anonCreditsLimit = baseLimit + AiRateLimit.GetBonusTotal(key);

        // AnonymousUsage shares the same scoped TobisoDbContext as PostService/UserProgressService/
        // etc. used elsewhere in this component, so this needs the same _dbLock as LoadForUser -
        // otherwise this can race OnInitializedAsync/OnAuthStateChanged on that DbContext instance.
        await _dbLock.WaitAsync();
        try
        {
            _anonCreditsRemaining = await AnonymousUsage.GetRemainingAsync(key, _anonCreditsLimit);
        }
        finally
        {
            _dbLock.Release();
        }

        if (!_disposed)
            StateHasChanged();
    }

    private static bool IsMore(string name) => string.Equals(name?.Trim(), "More", StringComparison.OrdinalIgnoreCase);

    private int PostCountForCategory(CategoryTreeResponse cat)
    {
        var direct = _summaries.Count(s => s.CategoryId == cat.Id);
        return direct + cat.Children.Sum(PostCountForCategory);
    }

    private string CategoryCountLabel(CategoryTreeResponse cat)
    {
        var posts = CzechPlural.Clanky(PostCountForCategory(cat));
        var subCount = cat.Children.Count(c => !IsMore(c.Name));
        return subCount > 0 ? $"{posts} · {CzechPlural.Oblasti(subCount)}" : posts;
    }

    private string TopSubjectText()
    {
        if (_stats?.PerSubject?.Any() == true)
        {
            var top = _stats.PerSubject.OrderByDescending(s => s.Count).First();
            return $"Nejvíc v {top.SubjectName} - {CzechPlural.Clanky(top.Count)}.";
        }
        return "Začni číst první článek!";
    }

    private static string GetGreeting()
    {
        var h = DateTime.Now.Hour;
        if (h < 12) return "Dobré ráno";
        if (h < 17) return "Dobré odpoledne";
        return "Dobrý večer";
    }

    public static string SubjectIcon(string name)
    {
        var n = name.ToLower();
        if (n.Contains("mluvnic")) return "pen-line";
        if (n.Contains("literat")) return "book-open";
        if (n.Contains("sloh")) return "feather";
        if (n.Contains("hudeb")) return "music";
        if (n.Contains("matem")) return "calculator";
        if (n.Contains("chemi")) return "flask-conical";
        if (n.Contains("fyzik")) return "magnet";
        if (n.Contains("přírod") || n.Contains("biolog")) return "flower-2";
        if (n.Contains("země") || n.Contains("geog")) return "globe";
        return "book";
    }
}
