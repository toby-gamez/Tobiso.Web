{
  "ConnectionStrings": {
    "DefaultConnection": "server=YOUR_SERVER;user=YOUR_USER;password=YOUR_PASSWORD;database=YOUR_DATABASE;Encrypt=False;TrustServerCertificate=False"
  },
  "Auth": {
    "Basic": {
      "Username": "YOUR_USERNAME",
      "Password": "YOUR_PASSWORD",
      "UserId": "YOUR_USER_ID"
    },
    "Jwt": {
      "Secret": "YOUR_JWT_SECRET_MIN_32_CHARACTERS_LONG",
      "Issuer": "tobiso",
      "Audience": "tobiso"
    }
  },
  "Api": {
    "BaseAddress": "https://www.yourdomain.com",
    "FilesBaseAddress": "https://files.yourdomain.com"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenAI": {
    "ApiKey": "YOUR_OPENAI_API_KEY",
    "Model": "gpt-4o-mini",
    "SystemPrompt": "YOUR_SYSTEM_PROMPT",
    "PersonSystemPrompt": "Jsi asistent pro faktické informace, který generuje informační karty o osobách. Odpovídej POUZE v podobě nezpracovaného objektu JSON – bez formátování Markdown, bez volného textu, bez bloků kódu. Poskytuj přesné a stručné faktické informace. U polí, u nichž si nejsi jistý, zadej hodnotu null u číselných polí a prázdný řetězec u textových polí. Nevymýšlej si ani nespekuluj.",
    "MaxDailyRequests": "10",
    "ClientLimits": {},
    "CheatSheetSystemPrompt": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/yourapp.log",
          "rollingInterval": "Day",
          "shared": true
        }
      }
    ]
  }
}
