@using System.Text.Json
@using Tobiso.Web.Shared.DTOs
@inject IJSRuntime JS

<div class="timeline-editor">
    <div class="panel">
        <div class="panel-header"><i data-lucide="arrow-right"></i> Editor časové osy</div>
        <div class="panel-body">
            <div class="range-fields">
                <div class="field">
                    <label>Začátek časové osy (rok)</label>
                    <input type="number" class="input" @bind="_timeRangeStart" @bind:event="oninput" @bind:after="GenerateJson" />
                </div>
                <div class="field">
                    <label>Konec časové osy (rok)</label>
                    <input type="number" class="input" @bind="_timeRangeEnd" @bind:event="oninput" @bind:after="GenerateJson" />
                </div>
            </div>

            <div class="events-section">
                <div class="events-heading">
                    <h6>Události</h6>
                    <button type="button" class="btn btn-primary btn-sm" @onclick="AddEvent"><i data-lucide="plus"></i> Přidat událost</button>
                </div>

                @if (!_events.Any())
                {
                    <div class="callout-tip">
                        <i data-lucide="info"></i> Zatím nebyly přidány žádné události. Klikněte na tlačítko výše pro přidání první události.
                    </div>
                }
                else
                {
                    <div class="timeline-preview">
                        <div class="timeline-range-label timeline-range-start">@_timeRangeStart</div>
                        <div class="timeline-range-label timeline-range-end">@_timeRangeEnd</div>

                        @foreach (var evt in _events.OrderBy(e => e.Year))
                        {
                            var position = GetTimelinePosition(evt.Year);
                            <div class="timeline-marker-wrap" style="left: @(position)%;">
                                <div class="timeline-event-marker" aria-label="@evt.Label (@evt.Year)" role="button" tabindex="0">
                                    <span class="timeline-dot" aria-hidden="true"></span>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="data-table-wrap">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th style="width: 80px;">Pořadí</th>
                                    <th>Událost</th>
                                    <th style="width: 110px;">Rok</th>
                                    <th style="width: 60px;">Akce</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{int index = 0;}
                                @foreach (var evt in _events)
                                {
                                    var currentIndex = index++;
                                    <tr>
                                        <td>
                                            <div class="reorder-buttons">
                                                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => MoveUp(currentIndex)" disabled="@(currentIndex == 0)">
                                                    <i data-lucide="arrow-up"></i>
                                                </button>
                                                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => MoveDown(currentIndex)" disabled="@(currentIndex == _events.Count - 1)">
                                                    <i data-lucide="arrow-down"></i>
                                                </button>
                                            </div>
                                        </td>
                                        <td>
                                            <input type="text" class="input" @bind="evt.Label" @bind:after="GenerateJson" placeholder="Název události" />
                                        </td>
                                        <td>
                                            <input type="number" class="input" @bind="evt.Year" @bind:after="GenerateJson" />
                                        </td>
                                        <td>
                                            <button type="button" class="btn btn-ghost btn-sm" @onclick="() => RemoveEvent(currentIndex)">
                                                <i data-lucide="trash-2"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="editor-actions">
                <button type="button" class="btn btn-secondary" @onclick="GenerateJson">
                    <i data-lucide="code-2"></i> Aktualizovat JSON
                </button>
                <button type="button" class="btn btn-danger" @onclick="ClearAll">
                    <i data-lucide="x-circle"></i> Vymazat vše
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string ConfigJson { get; set; } = "{}";

    [Parameter]
    public EventCallback<string> ConfigJsonChanged { get; set; }

    [Parameter]
    public string SolutionJson { get; set; } = "{}";

    [Parameter]
    public EventCallback<string> SolutionJsonChanged { get; set; }

    private List<TimelineEvent> _events = new();
    private int _timeRangeStart = 1300;
    private int _timeRangeEnd = 1700;
    private int _eventCounter = 0;

    protected override void OnInitialized()
    {
        LoadFromJson();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("initLucide");
    }

    private void LoadFromJson()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(ConfigJson) || ConfigJson == "{}") return;

            var doc = JsonDocument.Parse(ConfigJson);

            if (doc.RootElement.TryGetProperty("timeRange", out var timeRange))
            {
                if (timeRange.TryGetProperty("start", out var start))
                    _timeRangeStart = start.GetInt32();
                if (timeRange.TryGetProperty("end", out var end))
                    _timeRangeEnd = end.GetInt32();
            }

            if (doc.RootElement.TryGetProperty("events", out var eventsArray))
            {
                _events.Clear();
                foreach (var item in eventsArray.EnumerateArray())
                {
                    _events.Add(new TimelineEvent
                    {
                        Id = item.GetProperty("id").GetString() ?? "",
                        Label = item.GetProperty("label").GetString() ?? "",
                        Year = item.GetProperty("year").GetInt32()
                    });
                }
            }
        }
        catch
        {
            // Ignorovat chyby parsování
        }
    }

    private void AddEvent()
    {
        var id = $"event-{++_eventCounter}";
        _events.Add(new TimelineEvent
        {
            Id = id,
            Label = $"Nová událost {_eventCounter}",
            Year = _timeRangeStart + ((_timeRangeEnd - _timeRangeStart) / 2)
        });
        GenerateJson();
    }

    private void RemoveEvent(int index)
    {
        _events.RemoveAt(index);
        GenerateJson();
    }

    private void MoveUp(int index)
    {
        if (index > 0)
        {
            var temp = _events[index];
            _events[index] = _events[index - 1];
            _events[index - 1] = temp;
            GenerateJson();
        }
    }

    private void MoveDown(int index)
    {
        if (index < _events.Count - 1)
        {
            var temp = _events[index];
            _events[index] = _events[index + 1];
            _events[index + 1] = temp;
            GenerateJson();
        }
    }

    private void ClearAll()
    {
        _events.Clear();
        _eventCounter = 0;
        _timeRangeStart = 1300;
        _timeRangeEnd = 1700;
        GenerateJson();
    }

    private double GetTimelinePosition(int year)
    {
        var range = _timeRangeEnd - _timeRangeStart;
        if (range <= 0) return 50;

        var position = ((year - _timeRangeStart) / (double)range) * 80 + 10; // 10% margin on each side
        return Math.Max(10, Math.Min(90, position));
    }

    private void GenerateJson()
    {
        // Config JSON
        var config = new
        {
            type = "timeline",
            events = _events.Select(e => new
            {
                id = e.Id,
                label = e.Label,
                year = e.Year
            }),
            timeRange = new
            {
                start = _timeRangeStart,
                end = _timeRangeEnd
            }
        };

        var configJson = JsonSerializer.Serialize(config, new JsonSerializerOptions { WriteIndented = true });
        ConfigJsonChanged.InvokeAsync(configJson);

        // Solution JSON (správné chronologické pořadí)
        var solution = new
        {
            correctOrder = _events.OrderBy(e => e.Year).Select(e => e.Id).ToArray(),
            explanation = "Správné chronologické pořadí událostí"
        };

        var solutionJson = JsonSerializer.Serialize(solution, new JsonSerializerOptions { WriteIndented = true });
        SolutionJsonChanged.InvokeAsync(solutionJson);
    }

    private class TimelineEvent
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
        public int Year { get; set; }
    }
}
