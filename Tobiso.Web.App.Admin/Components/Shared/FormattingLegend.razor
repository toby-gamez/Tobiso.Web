@* Reference modal listing every Markdown + custom syntax token the public renderer
   (Tobiso.Web.App/Components/MarkdownContent.razor) understands, so authors don't
   have to read the source to remember them. *@

@inject IJSRuntime JS

@if (Visible)
{
    <div class="modal-backdrop" @onclick="Close">
        <div class="modal-panel modal-panel--lg" @onclick:stopPropagation>
            <div class="modal-header">
                <h3><i data-lucide="info"></i> Nápověda k formátování obsahu</h3>
                <button type="button" class="modal-close" aria-label="Zavřít" @onclick="Close"><i data-lucide="x"></i></button>
            </div>
            <div class="modal-body">

                <section class="fl-section">
                    <h6>Základní Markdown</h6>
                    <table class="fl-table">
                        <tbody>
                            <tr><td><code># Text</code> … <code>###### Text</code></td><td>Nadpisy úrovně 1–6</td></tr>
                            <tr><td><code>**tučně**</code></td><td>Tučný text</td></tr>
                            <tr><td><code>*kurzíva*</code></td><td>Kurzíva</td></tr>
                            <tr><td><code>- položka</code> / <code>1. položka</code></td><td>Odrážkový / číslovaný seznam</td></tr>
                            <tr><td><code>[text](https://…)</code></td><td>Odkaz</td></tr>
                            <tr><td><code>&gt; citace</code></td><td>Citační blok</td></tr>
                            <tr><td><code>`kód`</code> a <code>```blok kódu```</code></td><td>Vložený kód / blok kódu (uvnitř bloku kódu se vlastní syntaxe dále nevyhodnocuje)</td></tr>
                            <tr><td><code>| a | b |</code> s řádkem <code>|---|---|</code></td><td>Tabulka</td></tr>
                            <tr><td><code>&lt;sub&gt;text&lt;/sub&gt;</code></td><td>Dolní index (spodní index), např. H<sub>2</sub>O</td></tr>
                        </tbody>
                    </table>
                </section>

                <section class="fl-section">
                    <h6>Zlomky</h6>
                    <table class="fl-table">
                        <tbody>
                            <tr><td><code>1/2</code></td><td>Jednoduchý zlomek z čísel/písmen: <code>1/2</code>, <code>a/b</code>, <code>-3/4</code></td></tr>
                            <tr><td><code>{'{'}x+1{'}'}/{'{'}2{'}'}</code></td><td>Zlomek s víceznakovým výrazem — každou stranu, která není jediné číslo/písmeno, obal do <code>{'{'} {'}'}</code></td></tr>
                            <tr><td><code>3,5/2</code></td><td>Desetinná čísla se čárkou fungují (automaticky se převedou na tečku)</td></tr>
                            <tr><td><code>- 1/2</code></td><td>Mezera + pomlčka před zlomkem se stane záporným zlomkem</td></tr>
                            <tr><td><code>ano/ne</code></td><td>Výjimka — zůstane jako obyčejný text, nepřevede se na zlomek</td></tr>
                        </tbody>
                    </table>
                </section>

                <section class="fl-section">
                    <h6>Matematika (KaTeX)</h6>
                    <table class="fl-table">
                        <tbody>
                            <tr><td><code>$x^2 + y^2$</code></td><td>Vzorec v textu (inline)</td></tr>
                            <tr><td><code>$$x^2 + y^2 = r^2$$</code></td><td>Vzorec na samostatném řádku (display)</td></tr>
                        </tbody>
                    </table>
                </section>

                <section class="fl-section">
                    <h6>Škrtnutí</h6>
                    <table class="fl-table">
                        <tbody>
                            <tr><td><code>#s#text#s#</code></td><td>Škrtne text: <del>text</del></td></tr>
                            <tr><td><code>{'{'}#s#2#s#{'}'}/{'{'}4{'}'}</code></td><td>Škrtnutí uvnitř zlomku (čitatel nebo jmenovatel) se ve zlomku vykreslí jako přeškrtnuté číslo</td></tr>
                        </tbody>
                    </table>
                </section>

                <section class="fl-section">
                    <h6>Rámečky (Tip / Zajímavost)</h6>
                    <table class="fl-table">
                        <tbody>
                            <tr><td><code>!!!tip Text rady !!!</code></td><td>Zvýrazněný rámeček se žárovkou a popiskem „Tip"</td></tr>
                            <tr><td><code>!!!sidefact Zajímavý fakt !!!</code></td><td>Zvýrazněný rámeček s ikonou „i" a popiskem „Zajímavost"</td></tr>
                        </tbody>
                    </table>
                    <p class="fl-note">Obsah rámečku píšeš mezi klíčové slovo a uzavírací <code>!!!</code>.</p>
                </section>

                <section class="fl-section">
                    <h6>Šipka</h6>
                    <table class="fl-table">
                        <tbody>
                            <tr><td><code>krok 1 -&gt; krok 2</code></td><td>Šipka mezi mezerami se změní na ikonu šipky doprava</td></tr>
                        </tbody>
                    </table>
                </section>

                <section class="fl-section">
                    <h6>Úvodní odstavec</h6>
                    <table class="fl-table">
                        <tbody>
                            <tr><td><code>... Krátký úvodní text ...</code></td><td>První výskyt tří teček na začátku a na konci se zvýrazní jako úvodní (lead) odstavec článku</td></tr>
                        </tbody>
                    </table>
                    <p class="fl-note">Tři tečky jsou vyhrazený znak — jinde v textu se jakékoli osamocené <code>...</code> z výstupu odstraní, takže je nepiš jako obyčejnou elipsu.</p>
                </section>

                <section class="fl-section">
                    <h6>Obrázek s popiskem a zdrojem</h6>
                    <pre class="fl-pre">![alt text](/images/obrazek.png)

Popisek obrázku (nepovinné, může být víc řádků)

Zdroj: Wikipedia</pre>
                    <p class="fl-note">Řádek začínající <code>Zdroj:</code> nebo <code>Autor:</code> hned pod obrázkem (a případným popiskem) se použije jako uvedení zdroje. Obsahuje-li „Tobiso", obrázek se považuje za vlastní a zobrazí se mírně jinak než u přebraných obrázků.</p>
                </section>

                <section class="fl-section">
                    <h6>Video a dokument</h6>
                    <table class="fl-table">
                        <tbody>
                            <tr><td><code>*[alt videa](videos/x.mp4)</code></td><td>Vloží přehrávatelné video (musí být samostatný odstavec, prázdný řádek před i po)</td></tr>
                            <tr><td><code>_[jméno odkazu](documents/x.docx)</code></td><td>Vloží odkaz ke stažení dokumentu (PDF, DOCX, PPTX, XLSX) — otevře se v nové záložce</td></tr>
                        </tbody>
                    </table>
                    <p class="fl-note">Cestu k souboru zkopíruj tlačítkem „Kopírovat URL" v sekci <a href="/videos">Videa</a> / <a href="/documents">Dokumenty</a> — video musí mít příponu <code>.mp4</code>. Videa z YouTube se nevkládají do textu, ale samostatným polem „YouTube URL" v editaci příspěvku.</p>
                </section>

                <section class="fl-section">
                    <h6>Dodatek (vysvětlivka v bublině)</h6>
                    <table class="fl-table">
                        <tbody>
                            <tr><td><code>(--DOD-5--)</code></td><td>Vloží klikací ikonu, která otevře dodatek s ID 5</td></tr>
                        </tbody>
                    </table>
                    <p class="fl-note">Dodatky (jejich text a ID) se spravují v sekci <a href="/addendums">Dodatky</a>.</p>
                </section>

                <section class="fl-section">
                    <h6>E-mailový odkaz</h6>
                    <table class="fl-table">
                        <tbody>
                            <tr><td><code>[Napiš nám](mailto:info@tobiso.cz?subject=Dotaz)</code></td><td>Odkaz otevře e-mailového klienta s předvyplněným předmětem (parametr <code>?subject=…</code> je nepovinný)</td></tr>
                        </tbody>
                    </table>
                </section>

                <section class="fl-section">
                    <h6>Graf</h6>
                    <p class="fl-note">Graf se popíše textem mezi značky <code>[graf…]</code> a <code>[/graf…]</code> a na webu i v PDF se vykreslí jako obrázek (SVG), který se přizpůsobí světlému i tmavému režimu. Zobrazí se stejně jako obrázky — vpravo a obtékaný textem (na mobilu přes celou šířku) — a po kliknutí se otevře přes celou obrazovku.</p>
                    <pre class="fl-pre">[graf1]
title: Pohyb robotů
x(t [s]): 0-10
y(v [m/s]): 0-50 (10)   // (10) = popisky po desítkách
curve1(name: robot1): [0;0] [6;7] [8;7] linear RED
curve2(name: robot2): [0;5] [4;30] [10;45] smooth BLUE dashed
point1(name: A): [5;8] LIGHT_BLUE
note: Červená křivka zobrazuje rychlost
[/graf1]</pre>

                    <table class="fl-table">
                        <tbody>
                            <tr><td><code>[graf1]</code> … <code>[/graf1]</code></td><td>Začátek a konec grafu. Každá značka musí být na samostatném řádku. Název musí začínat „graf" (může pokračovat písmeny, čísly, <code>_</code> nebo <code>-</code>, např. <code>[grafRychlost]</code>) a uzavírací značka musí mít <b>stejný</b> název. V jednom článku může být grafů libovolně mnoho. Uvnitř bloku kódu <code>```</code> se graf nevykreslí.</td></tr>
                            <tr><td><code>x(popisek): od-do (krok)</code><br /><code>y(popisek): od-do (krok)</code></td><td>Osy. Popisek v závorce se vypíše u osy a je nepovinný (<code>x: 0-10</code>). Krok v závorce za rozsahem je taky nepovinný. Na ose se vždy ukáže každý krok až do maxima (<code>0-50 (10)</code> → 0, 10, 20 … 50), i když tam nejsou žádná data. Bez kroku: krátké osy (rozpětí do 20) jdou po 1 (0, 1, 2, 3…), delší po „hezkém" kroku (2, 5, 10, 20…). Když maximum není násobkem kroku, osa se prodlouží na nejbližší další (<code>0-45 (10)</code> → až 50). Příliš malý krok (víc než 40 dílků) se ignoruje; když by se čísla překrývala, popíše se jen každé 2., 5.… (čárky na ose zůstanou u všech).</td></tr>
                            <tr><td><code>curve1(name: jméno): [x;y] [x;y] … typ BARVA</code></td><td>Křivka procházející zadanými body (v pořadí, jak jsou napsané) — každý zadaný bod je na čáře vidět jako tečka, takže to vypadá jako spojené body. Za body v libovolném pořadí: typ čáry, <code>dashed</code>, <code>nodots</code> a barva. Křivka s jediným bodem se vykreslí jako tečka.</td></tr>
                            <tr><td><code>point1(name: A): [x;y] BARVA</code></td><td>Samostatný bod. Jméno se vypíše vedle bodu a přidá se do legendy.</td></tr>
                            <tr><td><code>title: text</code></td><td>Nadpis nad grafem (nepovinný)</td></tr>
                            <tr><td><code>note: text</code></td><td>Popisek pod grafem — může jich být víc, každý na novém řádku. Funguje v něm i vzorec <code>$v = s/t$</code>.</td></tr>
                            <tr><td><code>// komentář</code></td><td>Zbytek řádku se ignoruje (na začátku řádku nebo za mezerou, takže <code>https://…</code> v poznámce zůstane celé)</td></tr>
                        </tbody>
                    </table>
                    <p class="fl-note">Klíčová slova jdou psát i česky a bez ohledu na velikost písmen a diakritiku: <code>krivka</code> / <code>cara</code> / <code>line</code> = <code>curve</code>, <code>bod</code> = <code>point</code>, <code>poznamka</code> / <code>popis</code> = <code>note</code>, <code>nazev</code> = <code>title</code>. Číslo za <code>curve</code>/<code>point</code> je jen pro tvou přehlednost a nemusí tam být.</p>

                    <h6>Rozsahy os</h6>
                    <table class="fl-table">
                        <tbody>
                            <tr><td><code>0-10</code>, <code>0..10</code>, <code>0–10</code></td><td>Rozsah od–do (pomlčka, dvě tečky nebo dlouhá pomlčka)</td></tr>
                            <tr><td><code>-20..-30</code> (doporučeno)<br /><code>-20 - -30</code>, <code>-20--30</code></td><td>Záporné rozsahy — fungují všechny tři zápisy, <code>..</code> je nejčitelnější. Závorky kolem záporných čísel (<code>(-20)-(-30)</code>) <b>nefungují</b>, kulatá závorka za rozsahem znamená krok.</td></tr>
                            <tr><td><code>-5..5 (1)</code></td><td>Rozsah přes nulu s krokem 1</td></tr>
                            <tr><td><code>0,5..2,5 (0,5)</code></td><td>Desetinná čísla s čárkou nebo tečkou</td></tr>
                            <tr><td><code>30..10</code></td><td>Pořadí nevadí — vždy se vezme menší číslo jako začátek (osa 10–30)</td></tr>
                            <tr><td><code>x(t [s]):</code> nebo bez řádku <code>x</code></td><td>Bez rozsahu se osa přizpůsobí datům a vždy obsahuje nulu</td></tr>
                        </tbody>
                    </table>
                    <p class="fl-note"><b>Kvadranty:</b> osy se kříží v počátku [0;0]. Když se rozsah dopočítává z dat, zobrazí se jen kvadranty, které jsou potřeba — při samých kladných číslech jen 1. kvadrant (osy vlevo a dole), se zápornými y i 4. kvadrant (osa x vede středem) atd. Ručně zadaný rozsah se použije přesně tak, jak je napsaný, i když v části grafu nejsou data. Rozsah, který neobsahuje nulu (např. <code>-30..-20</code>), má osu na nejbližším okraji. Popisky na osách se píšou s desetinnou čárkou; když se osy kříží uvnitř grafu, nula se v počátku vypíše jen jednou.</p>

                    <h6>Funkce</h6>
                    <pre class="fl-pre">[graf2]
x: -5..5
y: -5..10
function: y = 2x + 1 BLUE
function(name: parabola): y = x^2 - 3 RED
function(name: odmocnina, od: 0): y = sqrt(x) GREEN dashed
function: y = sin(x)
[/graf2]</pre>
                    <table class="fl-table">
                        <tbody>
                            <tr><td><code>function: y = předpis BARVA</code></td><td>Nakreslí funkci přes celou šířku grafu (také <code>funkce:</code>, <code>fce:</code>). <code>y =</code> nebo <code>f(x) =</code> na začátku je nepovinné. Za předpis jde napsat barvu a <code>dashed</code>. Bez jména se v legendě ukáže samotný předpis.</td></tr>
                            <tr><td><code>(name: …, od: 0, do: 5)</code></td><td>Jméno pro legendu a nepovinné omezení definičního oboru — funkce se nakreslí jen pro x od–do (také <code>from:</code> / <code>to:</code>, desetinná čárka jde: <code>do: 6,28</code>)</td></tr>
                            <tr><td><code>+ - * / ^</code>, <code>x²</code>, <code>x³</code></td><td>Počty a mocniny. <code>-x^2</code> = −(x²), <code>2^-1</code> = 0,5, <code>2^x^2</code> = 2^(x²)</td></tr>
                            <tr><td><code>2x</code>, <code>3(x+1)</code>, <code>(x+1)(x-1)</code>, <code>2sin(x)</code>, <code>x sin x</code></td><td>Násobení se nemusí psát. Pozor: <code>1/2x</code> je (1/2)·x — pro 1/(2x) použij závorky.</td></tr>
                            <tr><td><code>sqrt(x)</code>, <code>|x|</code> / <code>abs(x)</code></td><td>Odmocnina (také <code>odm</code>), absolutní hodnota</td></tr>
                            <tr><td><code>sin</code>, <code>cos</code>, <code>tg</code> / <code>tan</code>, <code>cotg</code> / <code>cot</code></td><td>Goniometrické funkce (v radiánech). <code>sin(x)^2</code> = (sin x)²</td></tr>
                            <tr><td><code>arcsin</code>, <code>arccos</code>, <code>arctg</code> (i <code>asin</code>, <code>acos</code>, <code>atan</code>)</td><td>Cyklometrické funkce</td></tr>
                            <tr><td><code>ln(x)</code>, <code>log(x)</code>, <code>exp(x)</code>, <code>e^x</code></td><td>Přirozený logaritmus, desítkový logaritmus, exponenciála</td></tr>
                            <tr><td><code>pi</code> / <code>π</code>, <code>e</code>, <code>0,5x</code></td><td>Konstanty, desetinná čárka i tečka</td></tr>
                        </tbody>
                    </table>
                    <p class="fl-note">Bez rozsahu osy x se funkce kreslí od −10 do 10 (nebo podle bodů/<code>od</code>/<code>do</code> v grafu), osa y se přizpůsobí hodnotám — u funkcí s asymptotou (<code>1/x</code>, <code>tg x</code>) se extrémní hodnoty ignorují, ale lepší je zadat rozsah <code>y</code> ručně. Kde funkce není definovaná (<code>sqrt</code> záporného čísla, dělení nulou), čára se přeruší. Když se předpis nepodaří přečíst, pod grafem se ukáže hláška, co je špatně.</p>

                    <h6>Body, čáry a legenda</h6>
                    <table class="fl-table">
                        <tbody>
                            <tr><td><code>[2;5]</code>, <code>[-1,5;0.25]</code></td><td>Bod [x;y] — středník mezi souřadnicemi, desetinná čárka i tečka, záporná čísla</td></tr>
                            <tr><td><code>linear</code> (výchozí)<br /><code>linearni</code>, <code>primka</code>, <code>rovna</code></td><td>Lomená čára — rovné úsečky mezi body</td></tr>
                            <tr><td><code>smooth</code><br /><code>curved</code>, <code>hladka</code>, <code>zakrivena</code>, <code>oblouk</code></td><td>Hladká křivka. Když body jdou zleva doprava, křivka nikdy „nepřestřelí" — vodorovný úsek (<code>[6;7] [8;7]</code>) zůstane rovný a kladné hodnoty nespadnou pod nulu. Když se x vrací zpět, vede se oblouk přes všechny body (jde nakreslit i smyčka).</td></tr>
                            <tr><td><code>dashed</code><br /><code>carkovana</code>, <code>prerusovana</code></td><td>Čárkovaná čára (dá se kombinovat s <code>linear</code>/<code>smooth</code>)</td></tr>
                            <tr><td><code>nodots</code><br /><code>bezbodu</code></td><td>Schová tečky v zadaných bodech a nechá jen čáru (hodí se u hladkých křivek s mnoha body)</td></tr>
                            <tr><td><code>(name: robot1)</code> nebo <code>(robot1)</code></td><td>Jméno křivky/bodu pro legendu (také <code>nazev:</code>, <code>jmeno:</code>, <code>popisek:</code>, <code>label:</code>). Bez jména se v legendě neukáže.</td></tr>
                            <tr><td><code>(name: robot1, color: RED)</code></td><td>Barvu jde zadat i v závorce (<code>color:</code> / <code>barva:</code>)</td></tr>
                        </tbody>
                    </table>
                    <p class="fl-note">Části křivek a body mimo rozsah os se oříznou na okraji grafu. Legenda se zobrazí pod grafem, jen pokud má aspoň jedna křivka nebo bod jméno.</p>

                    <h6>Barvy</h6>
                    <table class="fl-table">
                        <tbody>
                            <tr><td><code>RED</code> / <code>CERVENA</code>, <code>DARK_RED</code> / <code>TMAVE_CERVENA</code></td><td>Červená, tmavě červená</td></tr>
                            <tr><td><code>BLUE</code> / <code>MODRA</code>, <code>LIGHT_BLUE</code> / <code>SVETLE_MODRA</code>, <code>DARK_BLUE</code> / <code>TMAVE_MODRA</code></td><td>Modrá, světle modrá, tmavě modrá</td></tr>
                            <tr><td><code>GREEN</code> / <code>ZELENA</code>, <code>LIGHT_GREEN</code> / <code>SVETLE_ZELENA</code>, <code>DARK_GREEN</code> / <code>TMAVE_ZELENA</code></td><td>Zelená, světle zelená, tmavě zelená</td></tr>
                            <tr><td><code>ORANGE</code> / <code>ORANZOVA</code>, <code>YELLOW</code> / <code>ZLUTA</code></td><td>Oranžová, žlutá</td></tr>
                            <tr><td><code>PURPLE</code> / <code>FIALOVA</code>, <code>PINK</code> / <code>RUZOVA</code>, <code>BROWN</code> / <code>HNEDA</code></td><td>Fialová, růžová, hnědá</td></tr>
                            <tr><td><code>GRAY</code> / <code>GREY</code> / <code>SEDA</code></td><td>Šedá</td></tr>
                            <tr><td><code>BLACK</code> / <code>CERNA</code>, <code>WHITE</code> / <code>BILA</code></td><td>Barva textu — v tmavém režimu se sama přepne, aby byla vidět</td></tr>
                            <tr><td><code>#1e90ff</code>, <code>#f00</code></td><td>Libovolná barva v hex zápisu</td></tr>
                        </tbody>
                    </table>
                    <p class="fl-note">Na velikosti písmen a diakritice nezáleží (<code>Červená</code>, <code>light-blue</code> fungují). Bez barvy dostane každá křivka/bod další barvu z palety (červená, modrá, zelená, oranžová, fialová…).</p>

                    <h6>Na co si dát pozor</h6>
                    <ul class="fl-note">
                        <li>Neznámé nebo překlepnuté řádky se tiše ignorují — když se něco neukáže, zkontroluj název klíče a dvojtečku za ním.</li>
                        <li>Když v bloku nejsou osy ani žádná data, místo grafu se ukáže rámeček s chybou.</li>
                        <li>Do popisků os nepiš vzorce <code>$…$</code> — vzorce fungují jen v <code>title</code> a <code>note</code>. Lomítko jako <code>m/s</code> je v popiscích v pořádku (nezmění se na zlomek).</li>
                        <li>Zlomky, šipky <code>-&gt;</code> ani jiná pravidla formátování se uvnitř grafu nepoužijí.</li>
                    </ul>
                </section>

                <section class="fl-section">
                    <h6>Zmínky osob</h6>
                    <p class="fl-note">Stačí do textu napsat jméno nebo přezdívku známé osoby přirozeně — žádná speciální syntaxe není potřeba, systém jméno sám rozpozná a připojí k němu odkaz.</p>
                </section>

            </div>
        </div>
    </div>
}

