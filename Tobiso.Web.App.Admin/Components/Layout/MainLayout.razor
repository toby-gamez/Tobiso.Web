@using Microsoft.AspNetCore.Components.Authorization
@using Tobiso.Web.App.Authentication
@inject CredentialStore CredentialStore
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime
@inherits LayoutComponentBase

<div class="app-shell">
    <NavMenu />
    <main class="main-content">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _tokenRestored;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_tokenRestored) return;
        try
        {
            await CredentialStore.InitializeAsync(JSRuntime);
            _tokenRestored = true;
            StateHasChanged();
        }
        catch (InvalidOperationException)
        {
            // Prerendering - will retry after circuit connects
        }
    }
}
