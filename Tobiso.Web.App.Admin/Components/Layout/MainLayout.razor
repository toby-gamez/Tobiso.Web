@using Microsoft.AspNetCore.Components.Authorization
@using Tobiso.Api.Authentication
@using Tobiso.Web.App.Authentication
@implements IDisposable
@inject CredentialStore CredentialStore
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime
@inherits LayoutComponentBase

@* Pages are only rendered for a verified admin session. Routes.razor uses a plain RouteView, so a
   page's [Authorize] isn't enforced on client-side navigation - without this gate, anyone could
   open /login and navigate to pages that query the database directly. *@
@if (_isAdmin)
{
    <div class="app-shell">
        <NavMenu />
        <main class="main-content">
            @Body
        </main>
    </div>
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _checked;
    private bool _isAdmin;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_checked) return;
        _checked = true;

        // Drop the token older versions kept in localStorage; the session is an HttpOnly cookie now.
        await JSRuntime.InvokeVoidAsync("tobisoClearLegacyToken");

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (!AuthPolicies.IsAdmin(authState.User))
        {
            Navigation.NavigateTo("/login");
            return;
        }

        // Server-side API calls (AuthenticationHeaderHandler) send this circuit's token as Bearer.
        CredentialStore.Set(authState.User.FindFirst(ManualJwtAuthHandler.RawTokenClaim)?.Value);
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        _isAdmin = true;
        StateHasChanged();
    }

    // Revalidation ended the session (token expired): leave the admin pages at once.
    private void OnAuthenticationStateChanged(Task<AuthenticationState> task) =>
        _ = InvokeAsync(async () =>
        {
            if (AuthPolicies.IsAdmin((await task).User)) return;
            _isAdmin = false;
            CredentialStore.Clear();
            Navigation.NavigateTo("/login", forceLoad: true);
        });

    public void Dispose() =>
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
}
