@using Tobiso.Web.App.Authentication
@implements IDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject CredentialStore CredentialStore

<aside class="nav-rail">
    <a href="/" class="brand-link">
        <span class="brand-logo">T</span>
        <span class="brand-name">Tobiso Admin</span>
    </a>

    <div class="rail-section">
        <div class="rail-section-label">Obsah</div>
        <a href="/" class="rail-item @(IsActive("/") ? "active" : "")"><i data-lucide="home"></i> Home</a>
        <a href="/categories" class="rail-item @(IsActive("/categories") ? "active" : "")"><i data-lucide="folder-tree"></i> Categories</a>
        <a href="/related-posts" class="rail-item @(IsActive("/related-posts") ? "active" : "")"><i data-lucide="link"></i> Související posty</a>
        <a href="/addendums" class="rail-item @(IsActive("/addendums") ? "active" : "")"><i data-lucide="file-text"></i> Dodatky</a>
        <a href="/events" class="rail-item @(IsActive("/events") ? "active" : "")"><i data-lucide="calendar-days"></i> Události</a>
    </div>

    <div class="rail-section">
        <div class="rail-section-label">Cvičení</div>
        <a href="/exercises" class="rail-item @(IsActive("/exercises") ? "active" : "")"><i data-lucide="play"></i> Cvičení</a>
        <a href="/questions" class="rail-item @(IsActive("/questions") ? "active" : "")"><i data-lucide="help-circle"></i> Otázky</a>
        <a href="/grades" class="rail-item @(IsActive("/grades") ? "active" : "")"><i data-lucide="layers"></i> Grades</a>
    </div>

    <div class="rail-section">
        <div class="rail-section-label">Zpětná vazba &amp; statistiky</div>
        <a href="/feedbacks" class="rail-item @(IsActive("/feedbacks") ? "active" : "")"><i data-lucide="message-square-heart"></i> Zpětná vazba</a>
        <a href="/post-stats" class="rail-item @(IsActive("/post-stats") ? "active" : "")"><i data-lucide="bar-chart-3"></i> Statistiky</a>
    </div>

    <div class="rail-section">
        <div class="rail-section-label">Média</div>
        <a href="/images" class="rail-item @(IsActive("/images") ? "active" : "")"><i data-lucide="image"></i> Images</a>
    </div>

    <div class="rail-footer">
        <div class="theme-row">
            <span class="grade-label">Tmavý režim</span>
            <button class="theme-toggle @(_darkMode ? "on" : "")" @onclick="ToggleDark" aria-label="Tmavý režim">
                <span class="theme-thumb"></span>
            </button>
        </div>

        <button @onclick="Logout" class="rail-item logout-item">
            <i data-lucide="log-out"></i> Odhlásit se
        </button>
    </div>
</aside>

@code {
    private bool _darkMode;

    protected override void OnInitialized()
    {
        // NavMenu is part of the persistent layout and is never recreated by
        // interactive client-side navigation, so without this the "active" rail
        // highlight freezes on whatever page loaded the circuit and never updates.
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var saved = await JS.InvokeAsync<string>("getTheme");
            _darkMode = saved == "dark";
            StateHasChanged();
        }

        await JS.InvokeVoidAsync("initLucide");
    }

    private bool IsActive(string path)
    {
        var current = new Uri(Nav.Uri).AbsolutePath;
        return path == "/" ? current == "/" : current.StartsWith(path);
    }

    private async Task ToggleDark()
    {
        _darkMode = !_darkMode;
        await JS.InvokeVoidAsync("setTheme", _darkMode ? "dark" : "light");
    }

    private async Task Logout()
    {
        try
        {
            await CredentialStore.ClearAsync(JS);
            Nav.NavigateTo("/login", forceLoad: true);
        }
        catch (Exception)
        {
            Nav.NavigateTo("/login", forceLoad: true);
        }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
