@using Tobiso.Web.Shared.DTOs
@using Microsoft.AspNetCore.Components
@inject IJSRuntime Js

@code {
    [Parameter]
    public List<CategoryTreeResponse>? Children { get; set; }

    [Parameter]
    public int Depth { get; set; } = 0;

    [Parameter]
    public EventCallback<int> OnCategoryClick { get; set; }

    [Parameter]
    public EventCallback<CategoryTreeResponse> OnEditCategory { get; set; }

    [Parameter]
    public EventCallback<int> OnDeleteCategory { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // A toggle click re-renders only this node (and any newly-appearing
        // nested CategoryTreeNode), not the page - so this component must
        // call initLucide itself rather than relying on the parent page's.
        await Js.InvokeVoidAsync("initLucide");
    }

    private HashSet<int> expandedIds = new();

    private void ToggleExpand(int id)
    {
        if (!expandedIds.Add(id))
            expandedIds.Remove(id);
    }

    private void HandleCategoryTreeNodeToggleKey(KeyboardEventArgs e, int id)
    {
        if (e.Key == "Enter" || e.Key == " " || e.Key == "Spacebar")
            ToggleExpand(id);
    }
}

@if (Children != null && Children.Count > 0)
{
    <div class="tree">
        @foreach (var child in Children.OrderBy(c => c.Id))
        {
            var hasChildren = child.Children != null && child.Children.Count > 0;
            var isExpanded = expandedIds.Contains(child.Id);
            <div>
                <div class="tree-node" style="--depth: @Depth">
                    @if (hasChildren)
                    {
                        <button class="tree-toggle @(isExpanded ? "expanded" : "")" tabindex="0"
                                @onclick="() => ToggleExpand(child.Id)"
                                @onkeydown="@( (KeyboardEventArgs e) => HandleCategoryTreeNodeToggleKey(e, child.Id) )"
                                aria-label="Rozbalit/sbalit kategorii">
                            <i data-lucide="chevron-right"></i>
                        </button>
                    }
                    else
                    {
                        <span class="tree-toggle leaf"></span>
                    }
                    <button class="tree-label" @onclick="() => OnCategoryClick.InvokeAsync(child.Id)">@child.Name</button>
                    <div class="tree-actions">
                        <button class="btn btn-secondary btn-sm" aria-label="Upravit kategorii" @onclick="() => OnEditCategory.InvokeAsync(child)"><i data-lucide="pencil-line"></i></button>
                        <button class="btn btn-danger btn-sm" aria-label="Smazat kategorii" @onclick="() => OnDeleteCategory.InvokeAsync(child.Id)"><i data-lucide="trash-2"></i></button>
                    </div>
                </div>
                @if (hasChildren && isExpanded)
                {
                    <CategoryTreeNode Children="child.Children" Depth="Depth + 1" OnCategoryClick="OnCategoryClick" OnEditCategory="OnEditCategory" OnDeleteCategory="OnDeleteCategory" />
                }
            </div>
        }
    </div>
}
