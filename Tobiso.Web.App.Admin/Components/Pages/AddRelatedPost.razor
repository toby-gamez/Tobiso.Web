@page "/related-posts/add"
@using Tobiso.Web.Shared.DTOs
@using Tobiso.Web.Shared.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@inject ITobisoWebApi Api
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="page-header">
    <h2 class="header-title">
        <i data-lucide="plus"></i>
        Přidat souvisejíci post
    </h2>
    <button class="btn btn-secondary" @onclick="BackToList">
        <i data-lucide="arrow-left"></i>
        Zpět
    </button>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert-error">
        <strong>Chyba:</strong> @errorMessage
        @if (!string.IsNullOrEmpty(errorFullDetail))
        {
            <details class="error-detail">
                <summary>Detail chyby</summary>
                <pre>@errorFullDetail</pre>
            </details>
        }
    </div>
}

<EditForm Model="request" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />

    @if (!string.IsNullOrEmpty(validationErrorMessage))
    {
        <div class="alert-error">@validationErrorMessage</div>
    }

    <div class="form-grid-2">
        <div class="field">
            <label>Hlavní post <span class="required">*</span></label>
            <PostSearchComponent SelectedPost="selectedMainPost"
                               SelectedPostChanged="@OnMainPostChanged"
                               Placeholder="Vyhledejte hlavní post..."
                               IsValid="@(string.IsNullOrEmpty(mainPostError))"
                               ErrorMessage="@mainPostError" />
        </div>
        <div class="field">
            <label>Souvisejíci post <span class="required">*</span></label>
            <PostSearchComponent SelectedPost="selectedRelatedPost"
                               SelectedPostChanged="@OnRelatedPostChanged"
                               Placeholder="Vyhledejte související post..."
                               IsValid="@(string.IsNullOrEmpty(relatedPostError))"
                               ErrorMessage="@relatedPostError"
                               ExcludePostId="@selectedMainPost?.Id" />
        </div>
    </div>

    <div class="field form-field-block">
        <label for="text">Popisek souvislosti (volitelný)</label>
        <InputTextArea id="text" class="textarea" rows="3" @bind-Value="request.Text"
                      placeholder="Například: 'Navazuje na tuto lekci' nebo 'Doporučeno přečíst po tomto článku'"/>
        <div class="form-hint">
            Krátký popis toho, jak spolu posty souvisí. Zobrazí se uživatelům jako nápověda.
        </div>
    </div>

    <div class="form-field-block">
        <div class="checkbox-field">
            <InputCheckbox id="createReverse" @bind-Value="request.CreateReverse" />
            <label for="createReverse">
                Vytvořit i opačné spojení
            </label>
        </div>
        <div class="form-hint">
            Zaškrtni pro vytvoření obousměrného spojení (doporučeno). Pokud nezaškrtneš, vytvoří se pouze jednosměrné spojení.
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
            @if (isSubmitting)
            {
                <i data-lucide="loader-2" class="spinner"></i>
                <span>Ukládám...</span>
            }
            else
            {
                <i data-lucide="check-circle-2"></i>
                <span>Vytvořit souvislost</span>
            }
        </button>
        <button type="button" class="btn btn-secondary" @onclick="BackToList">
            <i data-lucide="x-circle"></i>
            Zrušit
        </button>
    </div>
</EditForm>

@code {
    private CreateRelatedPostRequest request = new();
    private PostLinkResponse? selectedMainPost;
    private PostLinkResponse? selectedRelatedPost;
    private string? errorMessage;
    private string? validationErrorMessage;
    private string? mainPostError;
    private string? relatedPostError;
    private string? errorFullDetail;
    private bool isSubmitting;

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        // Check if user is authenticated
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/login");
            return;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("initLucide");
    }

    private void OnMainPostChanged(PostLinkResponse? post)
    {
        selectedMainPost = post;
        request.PostId = post?.Id ?? 0;
        mainPostError = null;

        // Clear validation error if both posts are now selected
        if (selectedMainPost != null && selectedRelatedPost != null && selectedMainPost.Id == selectedRelatedPost.Id)
        {
            validationErrorMessage = "Post nemůže odkazovat sám na sebe.";
        }
        else
        {
            validationErrorMessage = null;
        }
    }

    private void OnRelatedPostChanged(PostLinkResponse? post)
    {
        selectedRelatedPost = post;
        request.RelatedPostId = post?.Id ?? 0;
        relatedPostError = null;

        // Clear validation error if both posts are now selected
        if (selectedMainPost != null && selectedRelatedPost != null && selectedMainPost.Id == selectedRelatedPost.Id)
        {
            validationErrorMessage = "Post nemůže odkazovat sám na sebe.";
        }
        else
        {
            validationErrorMessage = null;
        }
    }

    private async Task HandleValidSubmit()
    {
        if (!ValidateForm())
            return;

        isSubmitting = true;
        errorMessage = null;
        validationErrorMessage = null;

        try
        {
            var created = await Api.CreateRelatedPost(request);
            Navigation.NavigateTo("/related-posts");
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba při vytváření souvisejícího postu: {ex.Message}";
            errorFullDetail = GetFullExceptionDetail(ex);
            await LogErrorToConsole(errorMessage, errorFullDetail);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private bool ValidateForm()
    {
        bool isValid = true;

        mainPostError = null;
        relatedPostError = null;
        validationErrorMessage = null;

        if (request.PostId <= 0)
        {
            mainPostError = "Hlavní post je povinný.";
            isValid = false;
        }

        if (request.RelatedPostId <= 0)
        {
            relatedPostError = "Související post je povinný.";
            isValid = false;
        }

        if (request.PostId > 0 && request.RelatedPostId > 0 && request.PostId == request.RelatedPostId)
        {
            validationErrorMessage = "Post nemůže odkazovat sám na sebe.";
            isValid = false;
        }

        return isValid;
    }

    private void BackToList()
    {
        Navigation.NavigateTo("/related-posts");
    }

    private string GetFullExceptionDetail(Exception ex)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"Message: {ex.Message}");
        sb.AppendLine($"Type: {ex.GetType().FullName}");
        sb.AppendLine($"Source: {ex.Source}");
        sb.AppendLine($"StackTrace: {ex.StackTrace}");
        if (ex.Data != null && ex.Data.Count > 0)
        {
            sb.AppendLine("Data:");
            foreach (var key in ex.Data.Keys)
            {
                sb.AppendLine($"  {key}: {ex.Data[key]}");
            }
        }
        if (ex.InnerException != null)
        {
            sb.AppendLine("InnerException:");
            sb.AppendLine(GetFullExceptionDetail(ex.InnerException));
        }
        return sb.ToString();
    }

    private async Task LogErrorToConsole(string message, string? detail)
    {
        await JS.InvokeVoidAsync("console.error", $"{message}\n{detail}");
    }
}
