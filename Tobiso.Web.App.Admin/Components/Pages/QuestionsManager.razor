@using Tobiso.Web.Shared.DTOs
@using Tobiso.Web.Shared.Interfaces
@using Tobiso.Web.Api.Services
@inject ITobisoWebApi Api

<div class="panel questions-panel">
    <div class="panel-header">Otázky a odpovědi</div>
    <div class="panel-body">
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert-error">@errorMessage</div>
        }

        @if (PostId > 0 && questions.Any())
        {
            <h4>Existující otázky:</h4>
            @foreach (var question in questions)
            {
                <div class="panel question-card">
                    <div class="panel-header question-card-header">
                        <span>
                            @question.QuestionText
                            @{
                                var correctCount = question.Answers.Count(a => a.Correct == 1);
                                var totalCount = question.Answers.Count;
                            }
                            @if (totalCount == 1 && correctCount == 1)
                            {
                                <span class="badge">text</span>
                            }
                            else if (correctCount > 1)
                            {
                                <span class="badge badge-info">multi</span>
                            }
                        </span>
                        <div class="row-actions">
                            <button class="btn btn-secondary btn-sm" @onclick="() => StartEditQuestion(question)">
                                Editovat
                            </button>
                            <button class="btn btn-danger btn-sm" @onclick="() => DeleteQuestion(question.Id)">
                                Smazat
                            </button>
                        </div>
                    </div>
                    <div class="panel-body">
                        @if (editingQuestionId == question.Id)
                        {
                            <div class="field">
                                <label>Text otázky:</label>
                                <input type="text" class="input" @bind="editQuestion.QuestionText" />
                            </div>
                            <h4>Odpovědi:</h4>
                            @for (int i = 0; i < editQuestion.Answers.Count; i++)
                            {
                                var index = i;
                                <div class="answer-row">
                                    <input type="text" class="input" @bind="editQuestion.Answers[index].AnswerText" placeholder="Text odpovědi" />
                                    <label class="checkbox-field">
                                        <input type="checkbox"
                                               checked="@(editQuestion.Answers[index].Correct == 1)"
                                               @onchange="@((ChangeEventArgs e) => editQuestion.Answers[index].Correct = (bool)e.Value! ? 1 : 0)" />
                                        Správná
                                    </label>
                                    <button type="button" class="btn btn-danger btn-sm" @onclick="() => RemoveEditAnswer(index)">
                                        Odstranit
                                    </button>
                                </div>
                            }
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="AddEditAnswer">
                                Přidat odpověď
                            </button>

                            <h4>Vysvětlení:</h4>
                            @for (int i = 0; i < editQuestion.Explanations.Count; i++)
                            {
                                var index = i;
                                <div class="explanation-row">
                                    <textarea class="textarea" rows="2" @bind="editQuestion.Explanations[index].Text" placeholder="Text vysvětlení"></textarea>
                                    <button type="button" class="btn btn-danger btn-sm" @onclick="() => RemoveEditExplanation(index)">
                                        Odstranit
                                    </button>
                                </div>
                            }
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="AddEditExplanation">
                                <i data-lucide="plus"></i> Přidat vysvětlení
                            </button>
                            <div class="edit-actions">
                                <button type="button" class="btn btn-primary" @onclick="SaveEditQuestion">
                                    Uložit změny
                                </button>
                                <button type="button" class="btn btn-secondary" @onclick="CancelEdit">
                                    Zrušit
                                </button>
                            </div>
                        }
                        else
                        {
                            <h4>Odpovědi:</h4>
                            @foreach (var answer in question.Answers)
                            {
                                <label class="checkbox-field">
                                    <input type="checkbox" checked="@(answer.Correct == 1)" disabled>
                                    @answer.AnswerText
                                </label>
                            }

                            @if (question.Explanations.Any())
                            {
                                <h4 class="explanations-heading">Vysvětlení:</h4>
                                @foreach (var explanation in question.Explanations)
                                {
                                    <div class="explanation-view">
                                        @explanation.Text
                                    </div>
                                }
                            }
                        }
                    </div>
                </div>
            }
        }

        <div class="ai-generate-row">
            <span class="ai-generate-label">AI: Vygenerovat</span>
            <div class="ai-generate-buttons">
                @foreach (var n in new[] { 1, 3, 5, 10 })
                {
                    var count = n;
                    <button type="button" class="btn btn-secondary btn-sm"
                            @onclick="() => GenerateAiQuestions(count)"
                            disabled="@(isGenerating || (PostId == 0 && string.IsNullOrWhiteSpace(ContentOverride)))">
                        @if (isGenerating && generatingCount == count)
                        {
                            <i data-lucide="loader-2" class="spinner"></i>
                        }
                        else
                        {
                            @(count == 1 ? "1 otázku" : $"{count} otázky")
                        }
                    </button>
                }
            </div>
        </div>
        @if (!string.IsNullOrEmpty(aiSuccessMessage))
        {
            <div class="msg-success">@aiSuccessMessage</div>
        }
        @if (!string.IsNullOrEmpty(aiErrorMessage))
        {
            <div class="msg-warning">@aiErrorMessage</div>
        }

        <h4>Přidat novou otázku:</h4>
        <div class="field">
            <label for="newQuestionText">Text otázky:</label>
            <input type="text" id="newQuestionText" class="input" @bind="newQuestion.QuestionText" />
        </div>

        <h4>Odpovědi:</h4>
        @for (int i = 0; i < newQuestion.Answers.Count; i++)
        {
            var index = i; // Capture the loop variable
            <div class="answer-row">
                <input type="text" class="input" @bind="newQuestion.Answers[index].AnswerText" placeholder="Text odpovědi" />
                <label class="checkbox-field">
                    <input type="checkbox"
                           checked="@(newQuestion.Answers[index].Correct == 1)"
                           @onchange="@((ChangeEventArgs e) => newQuestion.Answers[index].Correct = (bool)e.Value! ? 1 : 0)" />
                    Správná
                </label>
                <button type="button" class="btn btn-danger btn-sm" @onclick="() => RemoveAnswer(index)">
                    Odstranit
                </button>
            </div>
        }

        <button type="button" class="btn btn-secondary btn-sm" @onclick="AddAnswer">
            Přidat odpověď
        </button>

        <h4>Vysvětlení:</h4>
        @for (int i = 0; i < newQuestion.Explanations.Count; i++)
        {
            var index = i;
            <div class="explanation-row">
                <textarea class="textarea" rows="2" @bind="newQuestion.Explanations[index].Text" placeholder="Text vysvětlení"></textarea>
                <button type="button" class="btn btn-danger btn-sm" @onclick="() => RemoveExplanation(index)">
                    Odstranit
                </button>
            </div>
        }

        <button type="button" class="btn btn-secondary btn-sm" @onclick="AddExplanation">
            <i data-lucide="plus"></i> Přidat vysvětlení
        </button>

        <div class="submit-row">
            <button type="button" class="btn btn-primary" @onclick="SaveQuestion" disabled="@(string.IsNullOrWhiteSpace(newQuestion.QuestionText) || !newQuestion.Answers.Any(a => !string.IsNullOrWhiteSpace(a.AnswerText)))">
                Přidat otázku
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public int PostId { get; set; }
    [Parameter] public string? ContentOverride { get; set; }
    [Parameter] public EventCallback<CreateQuestionRequest> OnQuestionGenerated { get; set; }
    [Inject] private IQuestionService QuestionService { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private List<QuestionResponse> questions = new();
    private CreateQuestionRequest newQuestion = new();
    private UpdateQuestionRequest editQuestion = new();
    private int? editingQuestionId = null;
    private string? errorMessage;
    private bool isGenerating = false;
    private int generatingCount = 0;
    private string? aiErrorMessage;
    private string? aiSuccessMessage;
    // question texts generated/saved this session - passed to AI to avoid duplicates
    private readonly HashSet<string> _sessionQuestionTexts = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        if (PostId > 0)
            await LoadQuestions();
        ResetNewQuestion();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (PostId > 0)
        {
            await LoadQuestions();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("initLucide");
    }

    private async Task LoadQuestions()
    {
        try
        {
            questions = await QuestionService.GetByPostId(PostId);
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba při načítání otázek: {ex.Message}";
        }
    }

    private void ResetNewQuestion()
    {
        newQuestion = new CreateQuestionRequest
        {
            PostId = PostId,
            QuestionText = "",
            Answers = new List<CreateAnswerRequest>
            {
                new() { AnswerText = "", Correct = 0 },
                new() { AnswerText = "", Correct = 0 }
            },
            Explanations = new List<CreateExplanationRequest>
            {
                new() { Text = "", QuestionId = PostId }
            }
        };
    }

    private void AddAnswer()
    {
        newQuestion.Answers.Add(new CreateAnswerRequest { AnswerText = "", Correct = 0 });
    }

    private void RemoveAnswer(int index)
    {
        if (newQuestion.Answers.Count > 1)
        {
            newQuestion.Answers.RemoveAt(index);
        }
    }

    private List<string> BuildExistingQuestionTexts() =>
        questions.Select(q => q.QuestionText)
            .Concat(_sessionQuestionTexts)
            .Where(t => !string.IsNullOrWhiteSpace(t))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

    private async Task GenerateAiQuestions(int count)
    {
        isGenerating = true;
        generatingCount = count;
        aiErrorMessage = null;
        aiSuccessMessage = null;
        try
        {
            var req = new GenerateQuestionRequest
            {
                PostId = PostId,
                Content = PostId == 0 ? ContentOverride : null,
                Count = count,
                ExistingQuestions = BuildExistingQuestionTexts()
            };
            var generated = await Api.GenerateQuestions(req);

            if (count == 1 && generated.Count > 0)
            {
                // Pre-fill the form for review
                var q = generated[0];
                newQuestion.QuestionText = q.QuestionText;
                newQuestion.Answers = q.Answers.Any() ? q.Answers : new List<CreateAnswerRequest> { new() };
                newQuestion.Explanations = q.Explanations.Any() ? q.Explanations : new List<CreateExplanationRequest> { new() { Text = "" } };
                newQuestion.PostId = PostId;
            }
            else
            {
                // Auto-save all generated questions
                var saved = 0;
                foreach (var q in generated)
                {
                    q.PostId = PostId;
                    if (PostId == 0)
                    {
                        if (OnQuestionGenerated.HasDelegate)
                            await OnQuestionGenerated.InvokeAsync(q);
                    }
                    else
                    {
                        await QuestionService.Create(q);
                    }
                    _sessionQuestionTexts.Add(q.QuestionText);
                    saved++;
                }
                if (PostId > 0)
                    await LoadQuestions();
                aiSuccessMessage = $"Vygenerováno a uloženo {saved} otázek.";
            }
        }
        catch (Exception ex)
        {
            aiErrorMessage = $"Chyba při generování otázek: {ex.Message}";
        }
        finally
        {
            isGenerating = false;
            generatingCount = 0;
        }
    }

    private async Task SaveQuestion()
    {
        try
        {
            // Filter out empty answers
            newQuestion.Answers = newQuestion.Answers
                .Where(a => !string.IsNullOrWhiteSpace(a.AnswerText))
                .ToList();

            // Filter out empty explanations
            newQuestion.Explanations = newQuestion.Explanations
                .Where(e => !string.IsNullOrWhiteSpace(e.Text))
                .ToList();

            if (!newQuestion.Answers.Any())
            {
                errorMessage = "Otázka musí mít alespoň jednu odpověď.";
                return;
            }

            _sessionQuestionTexts.Add(newQuestion.QuestionText);

            if (PostId == 0)
            {
                if (OnQuestionGenerated.HasDelegate)
                    await OnQuestionGenerated.InvokeAsync(newQuestion);
                ResetNewQuestion();
                errorMessage = null;
                return;
            }

            await QuestionService.Create(newQuestion);
            await LoadQuestions();
            ResetNewQuestion();
            errorMessage = null;
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba při ukládání otázky: {ex.Message}";
        }
    }

    private async Task DeleteQuestion(int questionId)
    {
        if (!await JsConfirm("Opravdu chcete smazat tuto otázku?"))
            return;

        try
        {
            await QuestionService.Delete(questionId);
            await LoadQuestions();
            errorMessage = null;
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba při mazání otázky: {ex.Message}";
        }
    }

    private async Task<bool> JsConfirm(string message)
    {
        return await JS.InvokeAsync<bool>("confirm", message);
    }

    // Edit question methods
    private void StartEditQuestion(QuestionResponse question)
    {
        editingQuestionId = question.Id;
        editQuestion = new UpdateQuestionRequest
        {
            Id = question.Id,
            QuestionText = question.QuestionText,
            Answers = question.Answers.Select(a => new UpdateAnswerRequest
            {
                Id = a.Id,
                AnswerText = a.AnswerText,
                Correct = a.Correct,
                QuestionId = a.QuestionId
            }).ToList(),
            Explanations = question.Explanations.Select(e => new UpdateExplanationRequest
            {
                Id = e.Id,
                Text = e.Text,
                QuestionId = e.QuestionId
            }).ToList()
        };
    }

    private void CancelEdit()
    {
        editingQuestionId = null;
        editQuestion = new UpdateQuestionRequest();
    }

    private void AddEditAnswer()
    {
        editQuestion.Answers.Add(new UpdateAnswerRequest
        {
            AnswerText = "",
            Correct = 0,
            QuestionId = editQuestion.Id
        });
    }

    private void RemoveEditAnswer(int index)
    {
        if (editQuestion.Answers.Count > 1)
        {
            editQuestion.Answers.RemoveAt(index);
        }
    }

    private async Task SaveEditQuestion()
    {
        try
        {
            // Filter out empty answers
            editQuestion.Answers = editQuestion.Answers
                .Where(a => !string.IsNullOrWhiteSpace(a.AnswerText))
                .ToList();

            // Filter out empty explanations
            editQuestion.Explanations = editQuestion.Explanations
                .Where(e => !string.IsNullOrWhiteSpace(e.Text))
                .ToList();

            if (!editQuestion.Answers.Any())
            {
                errorMessage = "Otázka musí mít alespoň jednu odpověď.";
                return;
            }

            await QuestionService.Update(editQuestion);
            await LoadQuestions();
            CancelEdit();
            errorMessage = null;
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba při aktualizaci otázky: {ex.Message}";
        }
    }

    // Explanation methods for new questions
    private void AddExplanation()
    {
        newQuestion.Explanations.Add(new CreateExplanationRequest { Text = "", QuestionId = PostId });
    }

    private void RemoveExplanation(int index)
    {
        newQuestion.Explanations.RemoveAt(index);
    }

    // Explanation methods for editing questions
    private void AddEditExplanation()
    {
        editQuestion.Explanations.Add(new UpdateExplanationRequest
        {
            Text = "",
            QuestionId = editQuestion.Id
        });
    }

    private void RemoveEditExplanation(int index)
    {
        editQuestion.Explanations.RemoveAt(index);
    }
}
