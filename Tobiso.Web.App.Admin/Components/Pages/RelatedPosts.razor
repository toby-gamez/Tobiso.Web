@page "/related-posts"
@using Tobiso.Web.Shared.DTOs
@using Tobiso.Web.Shared.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@inject ITobisoWebApi Api
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
<PageTitle>Související články</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>
        <i class="bi bi-link-45deg"></i>
        Související posty
    </h2>
    <button class="btn btn-primary" @onclick="NavigateToAdd">
        <i class="bi bi-plus-circle"></i>
        Přidat souvislost
    </button>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">
        <strong>Chyba:</strong> @errorMessage
        <details class="mt-2">
            <summary>Detail chyby</summary>
            <pre>
@errorFullDetail
            </pre>
        </details>
    </div>
}

@if (relatedPosts == null)
{
    <div class="d-flex justify-content-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Načítání...</span>
        </div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th scope="col">ID</th>
                    <th scope="col">Hlavní post</th>
                    <th scope="col">Související post</th>
                    <th scope="col">Text</th>
                    <th scope="col">Akce</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var relatedPost in relatedPosts)
                {
                    <tr>
                        <td>@relatedPost.Id</td>
                        <td>
                            <strong>@(postTitles.TryGetValue(relatedPost.PostId, out var title) ? title : $"ID: {relatedPost.PostId}")</strong>
                            <br>
                            <small class="text-muted">ID: @relatedPost.PostId</small>
                        </td>
                        <td>
                            <strong>@(postTitles.TryGetValue(relatedPost.RelatedPostId, out var relTitle) ? relTitle : $"ID: {relatedPost.RelatedPostId}")</strong>
                            <br>
                            <small class="text-muted">ID: @relatedPost.RelatedPostId</small>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(relatedPost.Text))
                            {
                                <span>@relatedPost.Text</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <button class="btn btn-outline-primary btn-sm" 
                                        @onclick="() => NavigateToEdit(relatedPost.Id)">
                                    <i class="bi bi-pencil"></i>
                                    Upravit
                                </button>
                                <button class="btn btn-outline-danger btn-sm" 
                                        @onclick="() => OnDeleteRelatedPost(relatedPost.Id)">
                                    <i class="bi bi-trash"></i>
                                    Smazat
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        <p class="text-muted">
            <i class="bi bi-info-circle"></i>
            Celkem souvislostí: <strong>@relatedPosts.Count</strong>
        </p>
    </div>
}

<div class="card mt-4">
    <div class="card-header d-flex align-items-center gap-2">
        <i class="bi bi-stars"></i>
        <strong>AI návrhy souvisejících článků</strong>
    </div>
    <div class="card-body">
        <div class="row g-2 align-items-end mb-3">
            <div class="col-auto">
                <label class="form-label mb-1">Zdrojový článek</label>
                <select class="form-select" @bind="_aiSourcePostId">
                    <option value="0">— vyberte článek —</option>
                    @foreach (var kv in postTitles.OrderBy(p => p.Value))
                    {
                        <option value="@kv.Key">@kv.Value</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button class="btn btn-outline-primary" @onclick="SuggestRelated" disabled="@(_aiSourcePostId == 0 || _aiLoading)">
                    @if (_aiLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        <span>Generuji…</span>
                    }
                    else
                    {
                        <i class="bi bi-magic me-1"></i>
                        <span>Navrhnout</span>
                    }
                </button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_aiError))
        {
            <div class="alert alert-danger">@_aiError</div>
        }

        @if (_aiSuggestions.Count > 0)
        {
            <p class="text-muted small mb-2">AI navrhuje tyto články jako příbuzné k <strong>@(postTitles.TryGetValue(_aiSourcePostId, out var srcTitle) ? srcTitle : _aiSourcePostId.ToString())</strong>:</p>
            <ul class="list-group mb-3">
                @foreach (var postId in _aiSuggestions)
                {
                    var pid = postId;
                    var pTitle = postTitles.TryGetValue(pid, out var t) ? t : $"ID: {pid}";
                    var alreadyLinked = relatedPosts?.Any(r =>
                        (r.PostId == _aiSourcePostId && r.RelatedPostId == pid) ||
                        (r.PostId == pid && r.RelatedPostId == _aiSourcePostId)) == true;

                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>@pTitle <small class="text-muted ms-1">(ID: @pid)</small></span>
                        @if (alreadyLinked)
                        {
                            <span class="badge bg-secondary">Již propojeno</span>
                        }
                        else
                        {
                            <button class="btn btn-success btn-sm" @onclick="() => AddSuggestion(pid)" disabled="@_aiAdding.Contains(pid)">
                                @if (_aiAdding.Contains(pid))
                                {
                                    <span class="spinner-border spinner-border-sm" role="status"></span>
                                }
                                else
                                {
                                    <i class="bi bi-plus-circle me-1"></i>
                                }
                                Přidat
                            </button>
                        }
                    </li>
                }
            </ul>
        }
    </div>
</div>

@code {
    private IList<RelatedPostResponse>? relatedPosts;
    private Dictionary<int, string> postTitles = new();
    private string? errorMessage;
    private string? errorDetail;
    private string? errorFullDetail;

    private async Task LoadPostTitles()
    {
        try
        {
            var posts = await Api.GetPostLinks();
            postTitles = posts.ToDictionary(p => p.Id, p => p.Title);
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            await LogErrorToConsole("Chyba při načítání názvů článků:", ex.Message);
        }
    }

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        // Check if user is authenticated
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadPostTitles();
        await LoadRelatedPosts();
    }

    private async Task LoadRelatedPosts()
    {
        try
        {
            relatedPosts = await Api.GetAllRelatedPosts();
            errorMessage = null;
            errorDetail = null;
            errorFullDetail = null;
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba při načítání souvisejících postů: {ex.Message}";
            errorDetail = ex.StackTrace;
            errorFullDetail = GetFullExceptionDetail(ex);
            await LogErrorToConsole(errorMessage, errorFullDetail);
        }
    }

    private async Task OnDeleteRelatedPost(int id)
    {
        if (await ConfirmDelete())
        {
            try
            {
                await Api.DeleteRelatedPost(id);
                await LoadRelatedPosts(); // Obnovit seznam
            }
            catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                Navigation.NavigateTo("/login");
            }
            catch (Exception ex)
            {
                errorMessage = $"Chyba při mazání souvisejícího postu: {ex.Message}";
                errorDetail = ex.StackTrace;
                errorFullDetail = GetFullExceptionDetail(ex);
                await LogErrorToConsole(errorMessage, errorFullDetail);
            }
        }
    }
    private string GetFullExceptionDetail(Exception ex)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"Message: {ex.Message}");
        sb.AppendLine($"Type: {ex.GetType().FullName}");
        sb.AppendLine($"Source: {ex.Source}");
        sb.AppendLine($"StackTrace: {ex.StackTrace}");
        if (ex.Data != null && ex.Data.Count > 0)
        {
            sb.AppendLine("Data:");
            foreach (var key in ex.Data.Keys)
            {
                sb.AppendLine($"  {key}: {ex.Data[key]}");
            }
        }
        if (ex.InnerException != null)
        {
            sb.AppendLine("InnerException:");
            sb.AppendLine(GetFullExceptionDetail(ex.InnerException));
        }
        return sb.ToString();
    }

    private void NavigateToAdd()
    {
        Navigation.NavigateTo("/related-posts/add");
    }

    private void NavigateToEdit(int id)
    {
        Navigation.NavigateTo($"/related-posts/edit/{id}");
    }

    private Task<bool> ConfirmDelete()
    {
        return Task.FromResult(true);
    }

    private async Task LogErrorToConsole(string message, string? detail)
    {
        await JS.InvokeVoidAsync("console.error", $"{message}\n{detail}");
    }

    // AI suggest related posts
    private int _aiSourcePostId = 0;
    private bool _aiLoading = false;
    private string? _aiError;
    private List<int> _aiSuggestions = new();
    private HashSet<int> _aiAdding = new();

    private async Task SuggestRelated()
    {
        if (_aiSourcePostId == 0 || _aiLoading) return;
        _aiLoading = true;
        _aiError = null;
        _aiSuggestions.Clear();
        StateHasChanged();
        try
        {
            var result = await Api.SuggestRelatedPosts(_aiSourcePostId);
            _aiSuggestions = result.PostIds;
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            _aiError = $"Chyba: {ex.Message}";
        }
        finally
        {
            _aiLoading = false;
            StateHasChanged();
        }
    }

    private async Task AddSuggestion(int relatedPostId)
    {
        _aiAdding.Add(relatedPostId);
        StateHasChanged();
        try
        {
            await Api.CreateRelatedPost(new CreateRelatedPostRequest
            {
                PostId = _aiSourcePostId,
                RelatedPostId = relatedPostId
            });
            await LoadRelatedPosts();
        }
        catch (Exception ex)
        {
            _aiError = $"Chyba při přidávání: {ex.Message}";
        }
        finally
        {
            _aiAdding.Remove(relatedPostId);
            StateHasChanged();
        }
    }
}