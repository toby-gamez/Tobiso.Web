@page "/related-posts"
@using Tobiso.Web.Shared.DTOs
@using Tobiso.Web.Shared.Interfaces
@inject ITobisoWebApi Api
@inject NavigationManager Navigation

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>
        <i class="bi bi-link-45deg"></i>
        Související posty
    </h2>
    <button class="btn btn-primary" @onclick="NavigateToAdd">
        <i class="bi bi-plus-circle"></i>
        Přidat souvislost
    </button>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (relatedPosts == null)
{
    <div class="d-flex justify-content-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Načítání...</span>
        </div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th scope="col">ID</th>
                    <th scope="col">Hlavní post</th>
                    <th scope="col">Související post</th>
                    <th scope="col">Text</th>
                    <th scope="col">Akce</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var relatedPost in relatedPosts)
                {
                    <tr>
                        <td>@relatedPost.Id</td>
                        <td>
                            <strong>@relatedPost.PostTitle</strong>
                            <br>
                            <small class="text-muted">ID: @relatedPost.PostId</small>
                        </td>
                        <td>
                            <strong>@relatedPost.RelatedPostTitle</strong>
                            <br>
                            <small class="text-muted">ID: @relatedPost.RelatedPostId</small>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(relatedPost.Text))
                            {
                                <span>@relatedPost.Text</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <button class="btn btn-outline-primary btn-sm" 
                                        @onclick="() => NavigateToEdit(relatedPost.Id)">
                                    <i class="bi bi-pencil"></i>
                                    Upravit
                                </button>
                                <button class="btn btn-outline-danger btn-sm" 
                                        @onclick="() => OnDeleteRelatedPost(relatedPost.Id)">
                                    <i class="bi bi-trash"></i>
                                    Smazat
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        <p class="text-muted">
            <i class="bi bi-info-circle"></i>
            Celkem souvislostí: <strong>@relatedPosts.Count</strong>
        </p>
    </div>
}

@code {
    private IList<RelatedPostResponse>? relatedPosts;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadRelatedPosts();
    }

    private async Task LoadRelatedPosts()
    {
        try
        {
            relatedPosts = await Api.GetAllRelatedPosts();
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba při načítání souvisejících postů: {ex.Message}";
        }
    }

    private async Task OnDeleteRelatedPost(int id)
    {
        if (await ConfirmDelete())
        {
            try
            {
                await Api.DeleteRelatedPost(id);
                await LoadRelatedPosts(); // Obnovit seznam
            }
            catch (Exception ex)
            {
                errorMessage = $"Chyba při mazání souvisejícího postu: {ex.Message}";
            }
        }
    }

    private void NavigateToAdd()
    {
        Navigation.NavigateTo("/related-posts/add");
    }

    private void NavigateToEdit(int id)
    {
        Navigation.NavigateTo($"/related-posts/edit/{id}");
    }

    private Task<bool> ConfirmDelete()
    {
        // Jednoduché potvrzení - v reálné aplikaci by bylo lepší použít modal dialog
        return Task.FromResult(true); // Pro jednoduchost - můžete přidat JS confirm dialog
    }
}