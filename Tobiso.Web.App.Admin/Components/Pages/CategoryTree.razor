@page "/categories"
@using DocumentFormat.OpenXml.Presentation
@using Tobiso.Web.Shared.DTOs
@using Tobiso.Web.Shared.Interfaces
@using Comment = DocumentFormat.OpenXml.Office2021.PowerPoint.Comment.Comment
@using Microsoft.AspNetCore.Components.Authorization
@inject ITobisoWebApi Api
@inject NavigationManager Navigation
@inject ILogger<CategoryTree> Logger
@inject IJSRuntime Js
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Categories</PageTitle>

<div class="page-header">
    <h1>Strom kategorií</h1>
    <button class="btn btn-primary" @onclick="ShowAddCategoryModal"><i data-lucide="plus"></i> Přidat kategorii</button>
</div>

@if (showCategoryModal)
{
    <div class="modal-backdrop" @onclick="CloseCategoryModal">
        <div class="modal-panel" @onclick:stopPropagation>
            <div class="modal-header">
                <h3>@((editCategoryId == null) ? "Přidat kategorii" : "Upravit kategorii")</h3>
                <button class="modal-close" aria-label="Zavřít" @onclick="CloseCategoryModal"><i data-lucide="x"></i></button>
            </div>
            <div class="modal-body">
                <div class="field">
                    <label for="categoryNameInput">Název kategorie</label>
                    <input id="categoryNameInput" class="input" placeholder="Název kategorie" @bind="categoryName" />
                </div>
                <div class="field">
                    <label for="parentCategorySelect">Rodičovská kategorie</label>
                    <select id="parentCategorySelect" class="select" @bind="parentCategoryId">
                        <option value="">Žádná (kořenová)</option>
                        @foreach (var cat in allCategories)
                        {
                            if (editCategoryId == null || cat.Id != editCategoryId)
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseCategoryModal">Zrušit</button>
                <button class="btn btn-primary" @onclick="SaveCategory">Uložit</button>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert-error">
        <strong>Error:</strong> @errorMessage
    </div>
}

@if (categoryTree == null)
{
    <p>Načítání...</p>
}
else
{
    <div class="tree">
        @foreach (var category in categoryTree.OrderBy(c => c.Id))
        {
            <div>
                <div class="tree-node" style="--depth: 0">
                    <button class="tree-toggle" tabindex="0"
                            @onclick="() => OnCategoryClick(category.Id)"
                            @onkeydown="@( (KeyboardEventArgs e) => HandleCategoryTreeToggleKey(e, category.Id) )"
                            aria-label="Zobrazit posty v kategorii">
                        <i data-lucide="folder-open"></i>
                    </button>
                    <button class="tree-label root-label" @onclick="() => OnCategoryClick(category.Id)">@category.Name</button>
                    <div class="tree-actions">
                        <button class="btn btn-secondary btn-sm" aria-label="Upravit kategorii" @onclick="() => ShowEditCategoryModal(category)"><i data-lucide="pencil-line"></i> Upravit</button>
                        <button class="btn btn-danger btn-sm" aria-label="Smazat kategorii" @onclick="() => DeleteCategory(category.Id)"><i data-lucide="trash-2"></i> Smazat</button>
                    </div>
                </div>
                @if (category.Children != null && category.Children.Count > 0)
                {
                    <CategoryTreeNode Children="category.Children" Depth="1" OnCategoryClick="OnCategoryClick" OnEditCategory="ShowEditCategoryModal" OnDeleteCategory="DeleteCategory" />
                }
            </div>
        }
    </div>
}

@if (selectedPosts != null)
{
    <h4 class="posts-heading">Posty v kategorii</h4>
    <div class="data-table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th scope="col">ID</th>
                    <th scope="col">Title</th>
                    <th scope="col">Category</th>
                    <th scope="col">File Path</th>
                    <th scope="col">Updated</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var post in selectedPosts)
                {
                    <tr>
                        <td>@post.Id</td>
                        <td><strong>@post.Title</strong></td>
                        <td>
                            @if (post.CategoryId.HasValue)
                            {
                                var name = GetCategoryNameById(post.CategoryId);
                                if (!string.IsNullOrEmpty(name))
                                {
                                    <span class="badge">@name</span>
                                }
                                else
                                {
                                    <span class="muted">-</span>
                                }
                            }
                            else
                            {
                                <span class="muted">-</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(post.FilePath))
                            {
                                <code class="file-path-code">@post.FilePath</code>
                            }
                            else
                            {
                                <span class="muted">-</span>
                            }
                        </td>
                        <td>
                            @if (GetLatest(post) is DateTime dt)
                            {
                                <small>@dt.ToString("MMM dd, yyyy HH:mm")</small>
                            }
                            else
                            {
                                <span class="muted">-</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="post-count">
        <i data-lucide="info"></i>
        Total posts: <strong>@selectedPosts.Count</strong>
    </div>
}

@code {
    private IList<CategoryTreeResponse>? categoryTree;
    private IList<PostSummaryResponse>? selectedPosts;
    private string? errorMessage;
    private HashSet<int> selectedCategoryIds = new();
    private bool showCategoryModal = false;
    private string categoryName = string.Empty;
    private int? editCategoryId = null;
    private int? parentCategoryId = null;

    private IList<CategoryResponse> allCategories = new List<CategoryResponse>();

    protected override async Task OnInitializedAsync()
    {
        // Check if user is authenticated
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            categoryTree = await Api.GetCategoryTree();
            allCategories = await Api.GetAllCategories();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await Js.InvokeVoidAsync("initLucide");
    }

    private async Task OnCategoryClick(int categoryId)
    {
        selectedCategoryIds.Clear();
        CollectCategoryIds(categoryId, categoryTree);
        try
        {
            var allPosts = await Api.GetPostSummaries();
            selectedPosts = allPosts.Where(p => p.CategoryId.HasValue && selectedCategoryIds.Contains(p.CategoryId.Value)).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void HandleCategoryTreeToggleKey(KeyboardEventArgs e, int categoryId)
    {
        if (e.Key == "Enter" || e.Key == " " || e.Key == "Spacebar")
        {
            OnCategoryClick(categoryId);
        }
    }

    private void CollectCategoryIds(int categoryId, IEnumerable<CategoryTreeResponse>? categories)
    {
        if (categories == null) return;
        foreach (var cat in categories)
        {
            if (cat.Id == categoryId)
            {
                AddCategoryAndChildren(cat);
                return;
            }

            if (cat.Children != null && cat.Children.Count > 0)
            {
                CollectCategoryIds(categoryId, cat.Children);
            }
        }
    }

    private void AddCategoryAndChildren(CategoryTreeResponse category)
    {
        selectedCategoryIds.Add(category.Id);
        if (category.Children != null)
        {
            foreach (var child in category.Children)
            {
                AddCategoryAndChildren(child);
            }
        }
    }

    private string? GetCategoryNameById(int? categoryId)
    {
        if (!categoryId.HasValue || categoryTree == null)
            return null;
        return FindCategoryName(categoryId.Value, categoryTree);
    }

    private DateTime? GetLatest(PostSummaryResponse post)
    {
        if (post == null) return null;
        if (post.LastFix.HasValue && post.LastEdit.HasValue)
        {
            return post.LastFix > post.LastEdit ? post.LastFix : post.LastEdit;
        }
        return post.LastFix ?? post.LastEdit;
    }

    private string? FindCategoryName(int categoryId, IEnumerable<CategoryTreeResponse> categories)
    {
        foreach (var cat in categories)
        {
            if (cat.Id == categoryId)
                return cat.Name;
            if (cat.Children != null && cat.Children.Count > 0)
            {
                var name = FindCategoryName(categoryId, cat.Children);
                if (!string.IsNullOrEmpty(name))
                    return name;
            }
        }

        return null;
    }

    private void ShowAddCategoryModal()
    {
        showCategoryModal = true;
        categoryName = string.Empty;
        editCategoryId = null;
        parentCategoryId = null;
    }

    private void ShowEditCategoryModal(CategoryTreeResponse category)
    {
        showCategoryModal = true;
        categoryName = category.Name;
        editCategoryId = category.Id;
        var cat = allCategories.FirstOrDefault(c => c.Id == category.Id);
        parentCategoryId = cat?.ParentId;
    }

    private void CloseCategoryModal()
    {
        showCategoryModal = false;
        categoryName = string.Empty;
        editCategoryId = null;
        parentCategoryId = null;
    }

    private async Task SaveCategory()
    {
        if (string.IsNullOrWhiteSpace(categoryName)) return;
        if (editCategoryId == null)
        {
            // Přidání nové kategorie
            await Api.CreateCategory(new CategoryResponse { Name = categoryName, ParentId = parentCategoryId });
        }
        else
        {
            // Úprava existující kategorie
            await Api.UpdateCategory(editCategoryId.Value, new CategoryResponse { Name = categoryName, ParentId = parentCategoryId });
        }

        await LoadCategories();
        CloseCategoryModal();
    }

    private async Task DeleteCategory(int id)
    {
        var confirmed = await Js.InvokeAsync<bool>("confirm", $"Opravdu chcete smazat kategorii s ID {id}?");
        if (!confirmed) return;
        await Api.DeleteCategory(id);
        await LoadCategories();
    }

    private async Task LoadCategories()
    {
        categoryTree = await Api.GetCategoryTree();
        StateHasChanged();
    }

}
