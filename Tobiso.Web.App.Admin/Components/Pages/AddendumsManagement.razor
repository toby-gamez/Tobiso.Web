@page "/addendums"
@using Tobiso.Web.Shared.DTOs
@using Tobiso.Web.Shared.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@inject ITobisoWebApi Api
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Správa dodatků - Admin</PageTitle>

<div class="page-header">
    <h1>Správa dodatků</h1>
    <button class="btn btn-primary" @onclick="ShowCreateModal">
        <i data-lucide="plus"></i> Nový dodatek
    </button>
</div>

@if (addendums == null)
{
    <div class="loading-state">
        <i data-lucide="loader-2" class="spinner"></i>
    </div>
}
else
{
    <div class="filter-bar">
        <input type="text" class="input" @bind="searchTerm" @onkeyup="OnSearchChanged"
               placeholder="Hledat dodatek..." />
    </div>

    <div class="data-table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Název</th>
                    <th>Datum aktualizace</th>
                    <th>Akce</th>
                </tr>
            </thead>
            <tbody>
                @if (!filteredAddendums.Any())
                {
                    <tr><td colspan="4" class="empty-row">Žádné dodatky k zobrazení.</td></tr>
                }
                else
                {
                    @foreach (var addendum in filteredAddendums)
                    {
                        <tr>
                            <td>@addendum.Id</td>
                            <td>@addendum.Name</td>
                            <td>@(addendum.UpdatedAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                            <td>
                                <div class="row-actions">
                                    <button class="btn btn-ghost btn-sm" @onclick="() => ShowViewModal(addendum)">
                                        <i data-lucide="eye"></i>
                                    </button>
                                    <button class="btn btn-ghost btn-sm" @onclick="() => ShowEditModal(addendum)">
                                        <i data-lucide="pencil-line"></i>
                                    </button>
                                    <button class="btn btn-ghost btn-sm" @onclick="() => DeleteAddendum(addendum.Id)">
                                        <i data-lucide="trash-2"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@* Modal pro vytvoření/editaci dodatku *@
@if (showModal)
{
    <div class="modal-backdrop" @onclick="CloseModal">
        <div class="modal-panel modal-panel--lg" @onclick:stopPropagation>
            <div class="modal-header">
                <h3>@(isEditing ? "Upravit dodatek" : "Nový dodatek")</h3>
                <button type="button" class="modal-close" aria-label="Zavřít" @onclick="CloseModal"><i data-lucide="x"></i></button>
            </div>
            <div class="modal-body">
                <EditForm Model="addendumModel" OnValidSubmit="SaveAddendum">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="field">
                        <label>Název *</label>
                        <InputText class="input" @bind-Value="addendumModel.Name" />
                        <ValidationMessage For="@(() => addendumModel.Name)" />
                    </div>

                    <div class="field">
                        <label>Obsah *</label>
                        <InputTextArea class="textarea" rows="10" @bind-Value="addendumModel.Content" />
                        <ValidationMessage For="@(() => addendumModel.Content)" />
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Zrušit</button>
                        <button type="submit" class="btn btn-primary">@(isEditing ? "Uložit změny" : "Vytvořit dodatek")</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@* Modal pro zobrazení obsahu *@
@if (showViewModal)
{
    <div class="modal-backdrop" @onclick="CloseViewModal">
        <div class="modal-panel modal-panel--lg" @onclick:stopPropagation>
            <div class="modal-header">
                <h3>@viewAddendum?.Name</h3>
                <button type="button" class="modal-close" aria-label="Zavřít" @onclick="CloseViewModal"><i data-lucide="x"></i></button>
            </div>
            <div class="modal-body">
                <div class="view-field"><strong>ID:</strong> @viewAddendum?.Id</div>
                <div class="view-field"><strong>Datum aktualizace:</strong> @(viewAddendum?.UpdatedAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</div>
                <div class="view-field">
                    <strong>Obsah:</strong>
                    <pre class="addendum-content">@viewAddendum?.Content</pre>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CloseViewModal">Zavřít</button>
                <button type="button" class="btn btn-primary" @onclick="() => { CloseViewModal(); ShowEditModal(viewAddendum!); }">Upravit</button>
            </div>
        </div>
    </div>
}

@code {
    private List<AddendumResponse>? addendums;
    private List<AddendumResponse> filteredAddendums = new();
    private string searchTerm = "";

    private bool showModal = false;
    private bool showViewModal = false;
    private bool isEditing = false;
    private AddendumResponse addendumModel = new();
    private AddendumResponse? viewAddendum;

    protected override async Task OnInitializedAsync()
    {
        // Check if user is authenticated
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadAddendums();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JSRuntime.InvokeVoidAsync("initLucide");
    }

    private async Task LoadAddendums()
    {
        try
        {
            addendums = (await Api.GetAllAddendums()).ToList();
            FilterAddendums();
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Chyba při načítání dodatků: {ex.Message}");
        }
    }

    private void FilterAddendums()
    {
        if (addendums == null) return;

        filteredAddendums = addendums.Where(a =>
            string.IsNullOrWhiteSpace(searchTerm) ||
            a.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
            a.Content.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
        ).OrderBy(a => a.Id).ToList();
    }

    private void OnSearchChanged()
    {
        FilterAddendums();
        StateHasChanged();
    }

    private void ShowCreateModal()
    {
        isEditing = false;
        addendumModel = new AddendumResponse();
        showModal = true;
    }

    private void ShowEditModal(AddendumResponse addendum)
    {
        isEditing = true;
        addendumModel = new AddendumResponse
        {
            Id = addendum.Id,
            Name = addendum.Name,
            Content = addendum.Content,
            UpdatedAt = addendum.UpdatedAt
        };
        showModal = true;
    }

    private void ShowViewModal(AddendumResponse addendum)
    {
        viewAddendum = addendum;
        showViewModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        addendumModel = new AddendumResponse();
    }

    private void CloseViewModal()
    {
        showViewModal = false;
        viewAddendum = null;
    }

    private async Task SaveAddendum()
    {
        try
        {
            if (isEditing)
            {
                await Api.UpdateAddendum(addendumModel.Id, addendumModel);
                await JSRuntime.InvokeVoidAsync("alert", "Dodatek byl úspěšně upraven.");
            }
            else
            {
                await Api.CreateAddendum(addendumModel);
                await JSRuntime.InvokeVoidAsync("alert", "Dodatek byl úspěšně vytvořen.");
            }

            CloseModal();
            await LoadAddendums();
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Chyba při ukládání dodatku: {ex.Message}");
        }
    }

    private async Task DeleteAddendum(int addendumId)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Opravdu chcete smazat tento dodatek?"))
        {
            try
            {
                await Api.DeleteAddendum(addendumId);
                await JSRuntime.InvokeVoidAsync("alert", "Dodatek byl úspěšně smazán.");
                await LoadAddendums();
            }
            catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                Navigation.NavigateTo("/login");
            }
            catch (Exception ex)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Chyba při mazání dodatku: {ex.Message}");
            }
        }
    }
}
