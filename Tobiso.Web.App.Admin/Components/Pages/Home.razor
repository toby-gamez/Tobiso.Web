                        <div class="cs-preview-line" style="width:72%"></div>
                    </div>
                    <div class="cs-card-label">Široký</div>
                    <div class="cs-card-sub">18 cm &nbsp;&bull;&nbsp; ~27 bodů</div>
                </a>
                <a class="cs-ratio-card" href="@($"{Configuration["Api:BaseAddress"]}/api/pdf/cheatsheet/{_cheatSheetPostId.Value}?ratio=1x2")" target="_blank" @onclick="CloseCheatSheetModal">
                    <div class="cs-preview cs-preview-1x2">
                        <div class="cs-preview-line" style="width:78%"></div>
                        <div class="cs-preview-line" style="width:62%"></div>
                        <div class="cs-preview-line" style="width:70%"></div>
                        <div class="cs-preview-line" style="width:55%"></div>
                        <div class="cs-preview-line" style="width:68%"></div>
                        <div class="cs-preview-line" style="width:74%"></div>
                        <div class="cs-preview-line" style="width:58%"></div>
                        <div class="cs-preview-line" style="width:66%"></div>
