@page "/"
@using Tobiso.Web.Shared.Interfaces
@using Tobiso.Web.Shared.DTOs
@using Microsoft.AspNetCore.Components.Authorization
@inject ITobisoWebApi Api
@inject NavigationManager Navigation
@inject ILogger<Home> Logger
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Home - Posts</PageTitle>

<h1>Posts</h1>
<div class="d-flex flex-wrap align-items-center mb-3">
    <button class="btn btn-success me-2" @onclick="GoToAddPost">Přidat článek</button>

    <div class="ms-auto d-flex align-items-center">
        <input class="form-control me-2" placeholder="Hledat podle názvu..." @bind="SearchTerm" @bind:event="oninput" style="width:260px;" />

        <select class="form-select me-2" style="width:200px;" @bind="SortBy">
            <option value="Updated">Nejnovější</option>
            <option value="Title">Název</option>
            <option value="Category">Kategorie</option>
            <option value="Id">ID</option>
            <option value="FilePath">Cesta</option>
        </select>

        <button class="btn btn-outline-secondary btn-sm" title="Přepnout směr řazení" @onclick="ToggleSortDirection">
            <i class="@(SortDescending ? "bi bi-sort-down" : "bi bi-sort-up")"></i>
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        <strong>Error:</strong> @errorMessage
    </div>
}

@if (posts == null)
{
    <p>Loading posts...</p>
}
else if (!posts.Any())
{
    <p>No posts found.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th scope="col">ID</th>
                    <th scope="col">Title</th>
                    <th scope="col">Category</th>
                    <th scope="col">File Path</th>
                    <th scope="col">Updated</th>
                    <th scope="col" style="width: 200px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var post in posts)
                {
                    <tr>
                        <td>@post.Id</td>
                        <td>
                            <strong>
                                <a href="/posts/edit/@post.Id" class="text-decoration-none">@post.Title</a>
                            </strong>
                        </td>
                        <td>
                            @if (post.CategoryId.HasValue)
                            {
                                var name = GetCategoryNameById(post.CategoryId);
                                if (!string.IsNullOrEmpty(name))
                                {
                                    <span class="badge bg-primary">@name</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(post.FilePath))
                            {
                                <code class="text-break">@post.FilePath</code>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (GetLatest(post) is DateTime dt)
                            {
                                <small>@dt.ToString("MMM dd, yyyy HH:mm")</small>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm" role="group">
                                <button class="btn btn-outline-primary" title="Správa cvičení" @onclick="@(() => GoToExercises(post.Id))">
                                    <i class="bi bi-puzzle"></i>
                                </button>
                                <button class="btn btn-outline-danger" title="Smazat" @onclick="() => OnDeletePost(post.Id)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        <p class="text-muted">
            <i class="bi bi-info-circle"></i>
            Total posts: <strong>@posts.Count</strong>
        </p>
    </div>
}

@code {
    private IList<PostSummaryResponse>? posts;
    private IList<PostSummaryResponse> allPosts = new List<PostSummaryResponse>();
    private string _searchTerm = string.Empty;
    private string SearchTerm
    {
        get => _searchTerm;
        set
        {
            if (_searchTerm == value) return;
            _searchTerm = value;
            ApplyFilters();
        }
    }
    private string _sortBy = "Id";
    private string SortBy
    {
        get => _sortBy;
        set
        {
            if (_sortBy == value) return;
            _sortBy = value;
            ApplyFilters();
        }
    }
    private bool SortDescending { get; set; } = false;
    private IList<CategoryResponse> categories = new List<CategoryResponse>();
    private Dictionary<int, string> categoryNames = new Dictionary<int, string>();
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        // Check if user is authenticated
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadCategories();
        await LoadPosts();
    }

    private async Task LoadCategories()
    {
        try
        {
            var loadedCategories = await Api.GetAllCategories();
            if (loadedCategories != null)
            {
                categories = loadedCategories;
                categoryNames = categories.ToDictionary(c => c.Id, c => c.Name);
                Logger.LogInformation("Successfully loaded {CategoryCount} categories", categories.Count);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading categories: {ex.Message}";
            Logger.LogError(ex, "Error loading categories: {Message}", ex.Message);
            // Ensure collections remain initialized even on error
            categories = new List<CategoryResponse>();
            categoryNames = new Dictionary<int, string>();
        }
    }

    private string? GetCategoryNameById(int? categoryId)
    {
        if (!categoryId.HasValue || categoryNames == null)
        {
            return null;
        }

        return categoryNames.TryGetValue(categoryId.Value, out var name) ? name : null;
    }
    private DateTime? GetLatest(PostSummaryResponse post)
    {
        if (post == null) return null;
        if (post.LastFix.HasValue && post.LastEdit.HasValue)
        {
            return post.LastFix > post.LastEdit ? post.LastFix : post.LastEdit;
        }
        return post.LastFix ?? post.LastEdit;
    }
    private async Task LoadPosts()
    {
        try
        {
            Console.WriteLine("Starting to load posts...");
            Logger.LogInformation("Starting to load posts from API");

            var loaded = await Api.GetPostSummaries();
            allPosts = loaded ?? new List<PostSummaryResponse>();

            ApplyFilters();

            Console.WriteLine($"Successfully loaded {allPosts.Count} posts");
            Logger.LogInformation("Successfully loaded {PostCount} posts", allPosts.Count);

        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Console.WriteLine("Unauthorized access - redirecting to login");
            Logger.LogWarning("Unauthorized access to posts - redirecting to login");
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading posts: {ex.Message}";
            Console.WriteLine($"Exception occurred while loading posts: {ex.Message}");
            Console.WriteLine($"Exception details: {ex}");
            Logger.LogError(ex, "Exception occurred while loading posts: {Message}", ex.Message);
        }
    }

    private async Task OnDeletePost(int id)
    {
        if (!await JsConfirm($"Opravdu chcete smazat post s ID {id}?")) return;
        try
        {
            await Api.DeletePost(id);
            await LoadPosts();
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba při mazání: {ex.Message}";
        }
    }

    private void ApplyFilters()
    {
        if (allPosts == null) allPosts = new List<PostSummaryResponse>();

        IEnumerable<PostSummaryResponse> query = allPosts;

        if (!string.IsNullOrWhiteSpace(SearchTerm))
        {
            query = query.Where(p => !string.IsNullOrEmpty(p.Title) && p.Title.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase));
        }

        switch (SortBy)
        {
            case "Title":
                query = SortDescending ? query.OrderByDescending(p => p.Title) : query.OrderBy(p => p.Title);
                break;
            case "Category":
                query = SortDescending ? query.OrderByDescending(p => p.CategoryId ?? int.MinValue) : query.OrderBy(p => p.CategoryId ?? int.MaxValue);
                break;
            case "Id":
                query = SortDescending ? query.OrderByDescending(p => p.Id) : query.OrderBy(p => p.Id);
                break;
            case "FilePath":
                query = SortDescending ? query.OrderByDescending(p => p.FilePath) : query.OrderBy(p => p.FilePath);
                break;
            case "Updated":
            default:
                query = SortDescending ? query.OrderByDescending(p => GetLatest(p) ?? DateTime.MinValue) : query.OrderBy(p => GetLatest(p) ?? DateTime.MinValue);
                break;
        }

        posts = query.ToList();
        StateHasChanged();
    }

    private void ToggleSortDirection()
    {
        SortDescending = !SortDescending;
        ApplyFilters();
    }

    private void GoToAddPost()
    {
        Navigation.NavigateTo("/posts/add");
    }

    private void GoToExercises(int postId)
    {
        Navigation.NavigateTo($"/admin/exercises/{postId}");
    }

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    private async Task<bool> JsConfirm(string message)
    {
        return await JS.InvokeAsync<bool>("confirm", message);
    }
}
