    <div class="modal-backdrop" @onclick="CloseCheatSheetModal">
        <div class="modal-panel" @onclick:stopPropagation>
            <div class="modal-header">
                <h3>Vyberte formát tahák&uacute;</h3>
                <button class="modal-close" aria-label="Zavřít" @onclick="CloseCheatSheetModal"><i data-lucide="x"></i></button>
