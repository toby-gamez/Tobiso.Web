@page "/"
@using Tobiso.Web.Shared.Interfaces
@using Tobiso.Web.Shared.DTOs
@using Tobiso.Web.Api.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject ITobisoWebApi Api
@inject IQuestionService QuestionService
@inject NavigationManager Navigation
@inject ILogger<Home> Logger
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IConfiguration Configuration

<PageTitle>Home - Posts</PageTitle>

<div class="panel">
    <div class="stats-panel-body">
        <strong>Způsobilost kartiček</strong>
        @if (flashcardStatsError != null)
        {
            <span class="muted">@flashcardStatsError</span>
        }
        else if (flashcardStats == null)
        {
            <span class="muted">Načítám…</span>
        }
        else
        {
            <span class="badge badge-success">@flashcardStats.Eligible způsobilé</span>
            <span class="badge badge-danger">@flashcardStats.Ineligible nezpůsobilé</span>
            <span class="badge badge-warning">@flashcardStats.Unclassified neklasifikováno</span>

            <button type="button" class="btn btn-primary btn-sm stats-action" @onclick="StartClassifying" disabled="@(isClassifying || flashcardStats.Unclassified == 0)">
                @if (isClassifying)
                {
                    <i data-lucide="loader-2" class="spinner"></i>
                    <span>Klasifikuji… (@classifiedThisRun)</span>
                }
                else if (flashcardStats.Unclassified == 0)
                {
                    <span>Vše zkontrolováno</span>
                }
                else
                {
                    <span>Klasifikovat</span>
                }
            </button>
            @if (isClassifying)
            {
                <button type="button" class="btn btn-secondary btn-sm" @onclick="StopClassifying">Zastavit</button>
            }
            else
            {
                <button type="button" class="btn btn-secondary btn-sm" title="Zruší všechny dosavadní klasifikace a nechá AI posoudit otázky znovu (podle aktuálního promptu)" @onclick="ResetAndReclassify">
                    Reklasifikovat vše znovu
                </button>
            }
        }
        @if (!string.IsNullOrEmpty(classifyError))
        {
            <span class="muted">@classifyError</span>
        }
    </div>
</div>

<div class="page-header">
    <h1>Posts</h1>
    <div class="toolbar">
        <button class="btn btn-primary" @onclick="GoToAddPost"><i data-lucide="plus"></i> Přidat článek</button>
        <input class="input search-input" placeholder="Hledat podle názvu..." @bind="SearchTerm" @bind:event="oninput" />
        <select class="select sort-select" @bind="SortBy">
            <option value="Updated">Nejnovější</option>
            <option value="Title">Název</option>
            <option value="Category">Kategorie</option>
            <option value="Id">ID</option>
            <option value="FilePath">Cesta</option>
        </select>
        <button class="btn btn-secondary btn-sm" aria-label="Přepnout směr řazení" @onclick="ToggleSortDirection">
            <i data-lucide="@(SortDescending ? "chevron-down" : "chevron-up")"></i>
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert-error">
        <strong>Error:</strong> @errorMessage
    </div>
}

@if (posts == null)
{
    <p>Loading posts...</p>
}
else if (!posts.Any())
{
    <p>No posts found.</p>
}
else
{
    <div class="data-table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th scope="col">ID</th>
                    <th scope="col">Title</th>
                    <th scope="col">Category</th>
                    <th scope="col">File Path</th>
                    <th scope="col">Updated</th>
                    <th scope="col" style="width: 150px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var post in posts)
                {
                    <tr>
                        <td>@post.Id</td>
                        <td>
                            <a href="/posts/edit/@post.Id" class="post-title-link">@post.Title</a>
                        </td>
                        <td>
                            @if (post.CategoryId.HasValue)
                            {
                                var name = GetCategoryNameById(post.CategoryId);
                                if (!string.IsNullOrEmpty(name))
                                {
                                    <span class="badge">@name</span>
                                }
                                else
                                {
                                    <span class="muted">-</span>
                                }
                            }
                            else
                            {
                                <span class="muted">-</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(post.FilePath))
                            {
                                <code class="file-path-code">@post.FilePath</code>
                            }
                            else
                            {
                                <span class="muted">-</span>
                            }
                        </td>
                        <td>
                            @if (GetLatest(post) is DateTime dt)
                            {
                                <small>@dt.ToString("MMM dd, yyyy HH:mm")</small>
                            }
                            else
                            {
                                <span class="muted">-</span>
                            }
                        </td>
                        <td>
                            <div class="row-actions">
                                <button class="btn btn-ghost btn-sm" aria-label="Správa cvičení" @onclick="@(() => GoToExercises(post.Id))">
                                    <i data-lucide="puzzle"></i>
                                </button>
                                <button class="btn btn-ghost btn-sm" aria-label="Tahák (PDF)" @onclick="@(() => OpenCheatSheetModal(post.Id))">
                                    <i data-lucide="file-text"></i>
                                </button>
                                <button class="btn btn-ghost btn-sm" aria-label="Smazat příspěvek" @onclick="() => OnDeletePost(post.Id)">
                                    <i data-lucide="trash-2"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="post-count">
        <i data-lucide="info"></i>
        Total posts: <strong>@posts.Count</strong>
    </div>
}

@if (_showCheatSheetModal && _cheatSheetPostId.HasValue)
