@code {
    private IList<PostSummaryResponse>? posts;
    private IList<PostSummaryResponse> allPosts = new List<PostSummaryResponse>();
    private string _searchTerm = string.Empty;
    private string SearchTerm
    {
        get => _searchTerm;
        set
        {
            if (_searchTerm == value) return;
            _searchTerm = value;
            ApplyFilters();
        }
    }
    private string _sortBy = "Id";
    private string SortBy
    {
        get => _sortBy;
        set
        {
            if (_sortBy == value) return;
            _sortBy = value;
            ApplyFilters();
        }
    }
    private bool SortDescending { get; set; } = false;
    private IList<CategoryResponse> categories = new List<CategoryResponse>();
    private Dictionary<int, string> categoryNames = new Dictionary<int, string>();
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        // Check if user is authenticated
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadCategories();
        await LoadPosts();
        await LoadFlashcardStats();
    }

    private FlashcardEligibilityStats? flashcardStats;
    private string? flashcardStatsError;
    private string? classifyError;
    private bool isClassifying;
    private bool stopClassifyingRequested;
    private int classifiedThisRun;

    private async Task LoadFlashcardStats()
    {
        try
        {
            flashcardStats = await QuestionService.GetFlashcardEligibilityStatsAsync();
            flashcardStatsError = null;
        }
        catch (Exception ex)
        {
            flashcardStatsError = $"Chyba: {ex.Message}";
        }
    }

    private async Task StartClassifying()
    {
        isClassifying = true;
        stopClassifyingRequested = false;
        classifyError = null;
        classifiedThisRun = 0;
        StateHasChanged();

        try
        {
            while (!stopClassifyingRequested)
            {
                var result = await Api.ClassifyFlashcardEligibilityBatch(new ClassifyFlashcardEligibilityRequest { BatchSize = 30 });

                if (!string.IsNullOrEmpty(result.Error))
                {
                    classifyError = result.Error;
                    break;
                }

                classifiedThisRun += result.Processed;
                flashcardStats = new FlashcardEligibilityStats
                {
                    Total = flashcardStats?.Total ?? 0,
                    Eligible = (flashcardStats?.Eligible ?? 0) + result.EligibleCount,
                    Ineligible = (flashcardStats?.Ineligible ?? 0) + result.IneligibleCount,
                    Unclassified = result.RemainingUnclassified
                };
                StateHasChanged();

                if (result.Processed == 0 || result.RemainingUnclassified == 0)
                    break;
            }
        }
        catch (Exception ex)
        {
            classifyError = $"Chyba při klasifikaci: {ex.Message}";
        }
        finally
        {
            isClassifying = false;
            await LoadFlashcardStats();
        }
    }

    private void StopClassifying() => stopClassifyingRequested = true;

    private async Task ResetAndReclassify()
    {
        if (!await JsConfirm("Opravdu zrušit všechny dosavadní klasifikace a nechat AI posoudit VŠECHNY otázky znovu? Může to chvíli trvat."))
            return;

        try
        {
            await QuestionService.ResetAllFlashcardEligibilityAsync();
            await LoadFlashcardStats();
            await StartClassifying();
        }
        catch (Exception ex)
        {
            classifyError = $"Chyba při resetu klasifikace: {ex.Message}";
        }
    }

    private async Task LoadCategories()
    {
        try
        {
            var loadedCategories = await Api.GetAllCategories();
            if (loadedCategories != null)
            {
                categories = loadedCategories;
                categoryNames = categories.ToDictionary(c => c.Id, c => c.Name);
                Logger.LogInformation("Successfully loaded {CategoryCount} categories", categories.Count);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading categories: {ex.Message}";
            Logger.LogError(ex, "Error loading categories: {Message}", ex.Message);
            // Ensure collections remain initialized even on error
            categories = new List<CategoryResponse>();
            categoryNames = new Dictionary<int, string>();
        }
    }

    private string? GetCategoryNameById(int? categoryId)
    {
        if (!categoryId.HasValue || categoryNames == null)
        {
            return null;
        }

        return categoryNames.TryGetValue(categoryId.Value, out var name) ? name : null;
    }
    private DateTime? GetLatest(PostSummaryResponse post)
    {
        if (post == null) return null;
        if (post.LastFix.HasValue && post.LastEdit.HasValue)
        {
            return post.LastFix > post.LastEdit ? post.LastFix : post.LastEdit;
        }
        return post.LastFix ?? post.LastEdit;
    }
    private async Task LoadPosts()
    {
        try
        {
            Logger.LogInformation("Starting to load posts from API");

            var loaded = await Api.GetPostSummaries();
            allPosts = loaded ?? new List<PostSummaryResponse>();

            ApplyFilters();

            Logger.LogInformation("Successfully loaded {PostCount} posts", allPosts.Count);
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Logger.LogWarning("Unauthorized access to posts - redirecting to login");
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading posts: {ex.Message}";
            Logger.LogError(ex, "Exception occurred while loading posts: {Message}", ex.Message);
        }
    }

    private async Task OnDeletePost(int id)
    {
        if (!await JsConfirm($"Opravdu chcete smazat post s ID {id}?")) return;
        try
        {
            await Api.DeletePost(id);
            await LoadPosts();
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba při mazání: {ex.Message}";
        }
    }

    private void ApplyFilters()
    {
        if (allPosts == null) allPosts = new List<PostSummaryResponse>();

        IEnumerable<PostSummaryResponse> query = allPosts;

        if (!string.IsNullOrWhiteSpace(SearchTerm))
        {
            query = query.Where(p => !string.IsNullOrEmpty(p.Title) && p.Title.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase));
        }

        switch (SortBy)
        {
            case "Title":
                query = SortDescending ? query.OrderByDescending(p => p.Title) : query.OrderBy(p => p.Title);
                break;
            case "Category":
                query = SortDescending ? query.OrderByDescending(p => p.CategoryId ?? int.MinValue) : query.OrderBy(p => p.CategoryId ?? int.MaxValue);
                break;
            case "Id":
                query = SortDescending ? query.OrderByDescending(p => p.Id) : query.OrderBy(p => p.Id);
                break;
            case "FilePath":
                query = SortDescending ? query.OrderByDescending(p => p.FilePath) : query.OrderBy(p => p.FilePath);
                break;
            case "Updated":
            default:
                query = SortDescending ? query.OrderByDescending(p => GetLatest(p) ?? DateTime.MinValue) : query.OrderBy(p => GetLatest(p) ?? DateTime.MinValue);
                break;
        }

        posts = query.ToList();
        StateHasChanged();
    }

    private void ToggleSortDirection()
    {
        SortDescending = !SortDescending;
        ApplyFilters();
    }

    private void GoToAddPost()
    {
        Navigation.NavigateTo("/posts/add");
    }

    private void GoToExercises(int postId)
    {
        Navigation.NavigateTo($"/admin/exercises/{postId}");
    }

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    private bool _showCheatSheetModal = false;
    private int? _cheatSheetPostId = null;
    private void OpenCheatSheetModal(int postId) { _cheatSheetPostId = postId; _showCheatSheetModal = true; }
    private void CloseCheatSheetModal() { _showCheatSheetModal = false; _cheatSheetPostId = null; }

    private async Task<bool> JsConfirm(string message)
    {
        return await JS.InvokeAsync<bool>("confirm", message);
    }
}

<style>
    .cs-modal-backdrop { position:fixed;inset:0;z-index:1100;background:rgba(0,0,0,.45);display:flex;align-items:center;justify-content:center; }
    .cs-modal-dialog { background:#fff;border-radius:12px;box-shadow:0 8px 32px rgba(0,0,0,.28);padding:1.4rem 1.6rem 1.2rem;min-width:320px;max-width:96vw; }
    .cs-modal-header { display:flex;justify-content:space-between;align-items:center;font-weight:600;font-size:1rem;margin-bottom:1.1rem; }
    .cs-modal-close { background:none;border:none;font-size:1.4rem;line-height:1;cursor:pointer;color:inherit;padding:0 .2rem; }
    .cs-modal-body { display:grid;grid-template-columns:1fr 1fr;gap:.9rem; }
    .cs-ratio-card { display:flex;flex-direction:column;align-items:center;gap:.55rem;padding:.7rem .8rem .9rem;border:2px solid #d89dbd;border-radius:10px;background:none;cursor:pointer;text-decoration:none;color:inherit;transition:border-color .15s,box-shadow .15s,background .15s; }
    .cs-ratio-card:hover { border-color:#c36f9a;background:#f3d6e5;box-shadow:0 2px 10px rgba(195,111,154,.2); }
    .cs-preview { display:flex;flex-direction:column;gap:4px;padding:6px 7px;border-radius:5px;border:1.5px solid #d89dbd;background:#f3d6e5; }
    .cs-preview-1x1 { width:54px;height:54px; }
    .cs-preview-1x2 { width:54px;height:90px; }
    .cs-preview-2x1 { width:90px;height:54px; }
    .cs-preview-2x2 { width:90px;height:90px; }
    .cs-preview-line { height:4px;border-radius:2px;background:#c36f9a;opacity:.55; }
    .cs-card-label { font-weight:600;font-size:.92rem;color:#c36f9a; }
    .cs-card-sub { font-size:.75rem;color:#888; }
</style>
