@page "/"
@using Tobiso.Web.Shared.Interfaces
@using Tobiso.Web.Shared.DTOs
@using Tobiso.Web.Api.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject ITobisoWebApi Api
@inject IQuestionService QuestionService
@inject NavigationManager Navigation
@inject ILogger<Home> Logger
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IConfiguration Configuration

<PageTitle>Home - Posts</PageTitle>

<div class="card mb-3">
    <div class="card-body d-flex align-items-center gap-3 flex-wrap py-2">
        <strong class="me-1">Způsobilost kartiček</strong>
        @if (flashcardStatsError != null)
        {
            <span class="text-danger small">@flashcardStatsError</span>
        }
        else if (flashcardStats == null)
        {
            <span class="text-muted small">Načítám…</span>
        }
        else
        {
            <span class="badge bg-success-subtle text-success-emphasis">@flashcardStats.Eligible způsobilé</span>
            <span class="badge bg-danger-subtle text-danger-emphasis">@flashcardStats.Ineligible nezpůsobilé</span>
            <span class="badge bg-warning-subtle text-warning-emphasis">@flashcardStats.Unclassified neklasifikováno</span>

            <button type="button" class="btn btn-sm btn-primary ms-auto" @onclick="StartClassifying" disabled="@(isClassifying || flashcardStats.Unclassified == 0)">
                @if (isClassifying)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    <span>Klasifikuji… (@classifiedThisRun)</span>
                }
                else if (flashcardStats.Unclassified == 0)
                {
                    <span>Vše zkontrolováno</span>
                }
                else
                {
                    <span>Klasifikovat</span>
                }
            </button>
            @if (isClassifying)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="StopClassifying">Zastavit</button>
            }
            else
            {
                <button type="button" class="btn btn-sm btn-outline-secondary" title="Zruší všechny dosavadní klasifikace a nechá AI posoudit otázky znovu (podle aktuálního promptu)" @onclick="ResetAndReclassify">
                    Reklasifikovat vše znovu
                </button>
            }
        }
        @if (!string.IsNullOrEmpty(classifyError))
        {
            <span class="text-danger small">@classifyError</span>
        }
    </div>
</div>

<h1>Posts</h1>
<div class="d-flex flex-wrap align-items-center mb-3">
    <button class="btn btn-success me-2" @onclick="GoToAddPost">Přidat článek</button>

    <div class="ms-auto d-flex align-items-center">
        <input class="form-control me-2" placeholder="Hledat podle názvu..." @bind="SearchTerm" @bind:event="oninput" style="width:260px;" />

        <select class="form-select me-2" style="width:200px;" @bind="SortBy">
            <option value="Updated">Nejnovější</option>
            <option value="Title">Název</option>
            <option value="Category">Kategorie</option>
            <option value="Id">ID</option>
            <option value="FilePath">Cesta</option>
        </select>

        <button class="btn btn-outline-secondary btn-sm" aria-label="Přepnout směr řazení" @onclick="ToggleSortDirection">
            <i class="@(SortDescending ? "bi bi-sort-down" : "bi bi-sort-up")"></i>
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        <strong>Error:</strong> @errorMessage
    </div>
}

@if (posts == null)
{
    <p>Loading posts...</p>
}
else if (!posts.Any())
{
    <p>No posts found.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th scope="col">ID</th>
                    <th scope="col">Title</th>
                    <th scope="col">Category</th>
                    <th scope="col">File Path</th>
                    <th scope="col">Updated</th>
                    <th scope="col" style="width: 200px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var post in posts)
                {
                    <tr>
                        <td>@post.Id</td>
                        <td>
                            <strong>
                                <a href="/posts/edit/@post.Id" class="text-decoration-none">@post.Title</a>
                            </strong>
                        </td>
                        <td>
                            @if (post.CategoryId.HasValue)
                            {
                                var name = GetCategoryNameById(post.CategoryId);
                                if (!string.IsNullOrEmpty(name))
                                {
                                    <span class="badge bg-primary">@name</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(post.FilePath))
                            {
                                <code class="text-break">@post.FilePath</code>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (GetLatest(post) is DateTime dt)
                            {
                                <small>@dt.ToString("MMM dd, yyyy HH:mm")</small>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm" role="group">
                                <button class="btn btn-outline-primary" aria-label="Správa cvičení" @onclick="@(() => GoToExercises(post.Id))">
                                    <i class="bi bi-puzzle"></i>
                                </button>
                                <button class="btn btn-outline-info" aria-label="Tahák (PDF)" @onclick="@(() => OpenCheatSheetModal(post.Id))">
                                    <i class="bi bi-file-earmark-text"></i>
                                </button>
                                <button class="btn btn-outline-danger" aria-label="Smazat příspěvek" @onclick="() => OnDeletePost(post.Id)">
                                    <i class="bi bi-trash"></i>
                                </button>
                                @* edit link removed (use title link) *@
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        <p class="text-muted">
            <i class="bi bi-info-circle"></i>
            Total posts: <strong>@posts.Count</strong>
        </p>
    </div>
}

