@page "/exercises/{PostId:int}/new"
@page "/exercises/{PostId:int}/edit/{ExerciseId:int}"
@using Tobiso.Web.Shared.DTOs
@using Tobiso.Web.Shared.Interfaces
@using Tobiso.Web.Api.Services
@using System.Text.Json
@inject IInteractiveExerciseService ExerciseService
@inject IPostService PostService
@inject ICategoryService CategoryService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>@(_isEditMode ? "Úprava cvičení" : "Nové cvičení") - Admin</PageTitle>

<div class="page-header">
    <div>
        <h2>@(_isEditMode ? "Úprava cvičení" : "Nové cvičení")</h2>
        @if (_post != null)
        {
            <p class="muted">Článek: <strong>@_post.Title</strong></p>
        }
    </div>
    <button class="btn btn-secondary" @onclick="BackToList">
        <i data-lucide="arrow-left"></i> Zpět na seznam
    </button>
</div>

@if (_loading)
{
    <div class="loading-row">
        <i data-lucide="loader-2" class="spinner"></i>
        <span>Načítání...</span>
    </div>
}
else
{
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert-error">
            <i data-lucide="alert-triangle"></i>
            <span><strong>Error:</strong> @_error</span>
            <button type="button" class="modal-close" @onclick="() => _error = null"><i data-lucide="x"></i></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(_success))
    {
        <div class="alert-success">
            <i data-lucide="check-circle-2"></i>
            <span>@_success</span>
            <button type="button" class="modal-close" @onclick="() => _success = null"><i data-lucide="x"></i></button>
        </div>
    }

    <EditForm Model="@_model" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />

        <div class="editor-grid">
            <div class="editor-main">
                <div class="panel">
                    <div class="panel-header">Základní informace</div>
                    <div class="panel-body">
                        <div class="field">
                            <label>Přiřazené články</label>
                            <div class="checklist-box">
                                @foreach (var p in _allPosts)
                                {
                                    <div class="checkbox-field">
                                        <input type="checkbox" id="postchk-@p.Id" checked="@(_model.PostIds?.Contains(p.Id) == true)" @onchange="(e) => TogglePost(p.Id, e.Value?.ToString())" />
                                        <label for="postchk-@p.Id">@p.Title</label>
                                    </div>
                                }
                            </div>
                            <small class="muted">Zaškrtněte všechny články, ke kterým má být cvičení přiřazeno.</small>
                        </div>

                        <div class="field">
                            <label>Přiřazené kategorie</label>
                            <div class="checklist-box">
                                @foreach (var c in _allCategories)
                                {
                                    <div class="checkbox-field">
                                        <input type="checkbox" id="catchk-@c.Id" checked="@(_model.CategoryIds?.Contains(c.Id) == true)" @onchange="(e) => ToggleCategory(c.Id, e.Value?.ToString())" />
                                        <label for="catchk-@c.Id">@BuildCategoryLabel(c)</label>
                                    </div>
                                }
                            </div>
                            <small class="muted">Kategorie dědí cvičení na všechny články v nich (rekurzivně).</small>
                        </div>

                        <div class="field">
                            <label>Název cvičení *</label>
                            <InputText @bind-Value="_model.Title" class="input" placeholder="Např: Zapoj sériový obvod" />
                            <ValidationMessage For="@(() => _model.Title)" />
                        </div>

                        <div class="field">
                            <label>Typ cvičení *</label>
                            <InputSelect @bind-Value="_model.Type" class="select" @onchange="OnTypeChanged">
                                <option value="">-- Vyberte typ --</option>
                                <option value="circuit">Fyzikální obvod</option>
                                <option value="timeline">Časová osa</option>
                                <option value="drag-drop">Přetahování do kategorií</option>
                                <option value="molecule">Chemická molekula</option>
                                <option value="matching">Párování</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => _model.Type)" />
                        </div>

                        <div class="field">
                            <label>Instrukce (Markdown)</label>
                            <InputTextArea @bind-Value="_model.InstructionsMarkdown" class="textarea" rows="4"
                                           placeholder="Volitelné instrukce, které se zobrazí nad cvičením..." />
                        </div>

                        <div class="field-row">
                            <div class="field">
                                <label>Pořadí</label>
                                <InputNumber @bind-Value="_model.OrderIndex" class="input" />
                                <small class="muted">Čím nižší číslo, tím výše se zobrazí</small>
                            </div>
                            <div class="field">
                                <label>Stav</label>
                                <div class="checkbox-field status-check">
                                    <InputCheckbox @bind-Value="_model.IsActive" id="isActiveSwitch" />
                                    <label for="isActiveSwitch">
                                        @(_model.IsActive ? "Aktivní (viditelné pro uživatele)" : "Neaktivní (skryté)")
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="panel">
                    <div class="panel-header">
                        <span>Konfigurace cvičení *</span>
                        <div class="seg-control">
                            <button type="button" class="seg-btn @(_useVisualEditor ? "active" : "")" @onclick="() => _useVisualEditor = true">
                                <i data-lucide="list-checks"></i> Vizuální editor
                            </button>
                            <button type="button" class="seg-btn @(!_useVisualEditor ? "active" : "")" @onclick="() => _useVisualEditor = false">
                                <i data-lucide="code-2"></i> JSON editor
                            </button>
                        </div>
                    </div>
                    <div class="panel-body">
                        @if (_useVisualEditor && !string.IsNullOrEmpty(_model.Type))
                        {
                            @switch (_model.Type)
                            {
                                case ExerciseTypeConstants.Circuit:
                                    <CircuitEditorComponent ConfigJson="@_model.ConfigJson" ConfigJsonChanged="OnConfigChanged" />
                                    break;
                                case ExerciseTypeConstants.Timeline:
                                    <TimelineEditorComponent ConfigJson="@_model.ConfigJson" ConfigJsonChanged="OnConfigChanged"
                                                            SolutionJson="@_model.SolutionJson" SolutionJsonChanged="OnSolutionChanged" />
                                    break;
                                case ExerciseTypeConstants.DragDrop:
                                    <DragDropEditorComponent ConfigJson="@_model.ConfigJson" ConfigJsonChanged="OnConfigChanged"
                                                            SolutionJson="@_model.SolutionJson" SolutionJsonChanged="OnSolutionChanged" />
                                    break;
                                case ExerciseTypeConstants.Matching:
                                    <MatchingEditorComponent ConfigJson="@_model.ConfigJson" ConfigJsonChanged="OnConfigChanged"
                                                            SolutionJson="@_model.SolutionJson" SolutionJsonChanged="OnSolutionChanged" />
                                    break;
                                default:
                                    <div class="empty-hint">
                                        <i data-lucide="info"></i> Vizuální editor pro tento typ cvičení zatím není k dispozici. Použijte JSON editor.
                                    </div>
                                    break;
                            }
                        }
                        else
                        {
                            @if (!string.IsNullOrEmpty(_model.Type))
                            {
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="LoadExampleConfig">
                                    <i data-lucide="file-code"></i> Načíst příklad
                                </button>
                            }
                            <InputTextArea @bind-Value="_model.ConfigJson" class="textarea code-input" rows="15"
                                           placeholder='{"components": [...], "availableComponents": [...]}' />
                            <ValidationMessage For="@(() => _model.ConfigJson)" />
                            @if (!string.IsNullOrEmpty(_configError))
                            {
                                <div class="field-error">
                                    <i data-lucide="alert-circle"></i> @_configError
                                </div>
                            }
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="ValidateConfigJson">
                                <i data-lucide="check-circle-2"></i> Validovat JSON
                            </button>
                        }
                    </div>
                </div>

                <div class="panel">
                    <div class="panel-header">
                        <span>Správné řešení (JSON) *</span>
                        @if (!string.IsNullOrEmpty(_model.Type))
                        {
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="LoadExampleSolution">
                                <i data-lucide="file-code"></i> Načíst příklad
                            </button>
                        }
                    </div>
                    <div class="panel-body">
                        <InputTextArea @bind-Value="_model.SolutionJson" class="textarea code-input" rows="12"
                                       placeholder='{"correctConnections": [...], "explanation": "..."}' />
                        <ValidationMessage For="@(() => _model.SolutionJson)" />
                        @if (!string.IsNullOrEmpty(_solutionError))
                        {
                            <div class="field-error">
                                <i data-lucide="alert-circle"></i> @_solutionError
                            </div>
                        }
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="ValidateSolutionJson">
                            <i data-lucide="check-circle-2"></i> Validovat JSON
                        </button>
                    </div>
                </div>
            </div>

            <div class="editor-side">
                <div class="panel help-panel">
                    <div class="panel-header">Nápověda</div>
                    <div class="panel-body">
                        @if (string.IsNullOrEmpty(_model.Type))
                        {
                            <p class="muted">Vyberte typ cvičení pro zobrazení nápovědy...</p>
                        }
                        else
                        {
                            @switch (_model.Type)
                            {
                                case ExerciseTypeConstants.Circuit:
                                    <h6>Fyzikální obvod</h6>
                                    <p><strong>Příklad ConfigJson:</strong></p>
                                    <pre class="code-preview">@GetCircuitExample()</pre>
                                    break;
                                case ExerciseTypeConstants.Timeline:
                                    <h6>Časová osa</h6>
                                    <p><strong>Příklad ConfigJson:</strong></p>
                                    <pre class="code-preview">@GetTimelineExample()</pre>
                                    break;
                                case ExerciseTypeConstants.DragDrop:
                                    <h6>Přetahování</h6>
                                    <p><strong>Příklad ConfigJson:</strong></p>
                                    <pre class="code-preview">@GetDragDropExample()</pre>
                                    break;
                                case ExerciseTypeConstants.Molecule:
                                    <h6>Molekula</h6>
                                    <p><strong>Příklad ConfigJson:</strong></p>
                                    <pre class="code-preview">@GetMoleculeExample()</pre>
                                    break;
                                case ExerciseTypeConstants.Matching:
                                    <h6>Párování</h6>
                                    <p>Podobné jako drag-drop, ale pro spojování prvků.</p>
                                    break;
                            }
                            <hr />
                            <a href="/docs/INTERACTIVE_EXERCISES_DOCS.md" target="_blank" class="btn btn-secondary btn-sm doc-link">
                                <i data-lucide="book-open"></i> Kompletní dokumentace
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <button type="button" class="btn btn-secondary" @onclick="BackToList">
                <i data-lucide="x-circle"></i> Zrušit
            </button>
            <button type="submit" class="btn btn-primary" disabled="@_saving">
                @if (_saving)
                {
                    <i data-lucide="loader-2" class="spinner"></i>
                }
                <i data-lucide="save"></i> @(_isEditMode ? "Uložit změny" : "Vytvořit cvičení")
            </button>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public int PostId { get; set; }

    [Parameter]
    public int? ExerciseId { get; set; }

    private bool _isEditMode => ExerciseId.HasValue;
    private PostResponse? _post;
    private List<PostLinkResponse> _allPosts = new();
    private List<CategoryResponse> _allCategories = new();
    private ExerciseEditorModel _model = new();
    private bool _loading = true;
    private bool _saving = false;
    private string? _error;
    private string? _success;
    private string? _configError;
    private string? _solutionError;
    private bool _useVisualEditor = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("initLucide");
    }

    private async Task LoadData()
    {
        _loading = true;
        _error = null;

        try
        {
            // Pokud je PostId == 0, jedná se o globální cvičení (není vázané na konkrétní článek)
            if (PostId != 0)
            {
                _post = await PostService.GetById(PostId);
                if (_post == null)
                {
                    _error = "Článek nenalezen.";
                    return;
                }
            }

            if (_isEditMode)
            {
                var exercise = await ExerciseService.GetByIdAsync(ExerciseId!.Value);
                if (exercise == null)
                {
                    _error = "Cvičení nenalezeno.";
                    return;
                }

                // Načíst i řešení (pouze pro admin)
                var solution = await ExerciseService.GetSolutionAsync(ExerciseId.Value);

                _model = new ExerciseEditorModel
                {
                    Title = exercise.Title,
                    Type = exercise.Type,
                    ConfigJson = FormatJson(exercise.ConfigJson),
                    SolutionJson = FormatJson(solution?.SolutionJson ?? "{}"),
                    InstructionsMarkdown = exercise.InstructionsMarkdown,
                    OrderIndex = exercise.OrderIndex,
                    IsActive = exercise.IsActive
                    ,PostIds = exercise.PostIds ?? new List<int>()
                    ,CategoryIds = exercise.CategoryIds ?? new List<int>()
                };
            }
            else
            {
                _model = new ExerciseEditorModel
                {
                    OrderIndex = 0,
                    IsActive = true
                };
            }

            // načíst seznam postů a kategorií pro multi-select
            _allPosts = await PostService.GetLinks();
            _allCategories = await CategoryService.GetAll();
        }
        catch (Exception ex)
        {
            _error = $"Chyba při načítání: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task HandleSubmit()
    {
        _error = null;
        _success = null;
        _saving = true;

        try
        {
            // Validace JSON
            if (!ValidateJson(_model.ConfigJson, out var configError))
            {
                _error = $"Chybný ConfigJson: {configError}";
                return;
            }

            if (!ValidateJson(_model.SolutionJson, out var solutionError))
            {
                _error = $"Chybný SolutionJson: {solutionError}";
                return;
            }

            if (_isEditMode)
            {
                var request = new UpdateInteractiveExerciseRequest
                {
                    Id = ExerciseId!.Value,
                    // Include post and category associations when updating
                    PostIds = _model.PostIds != null && _model.PostIds.Any()
                        ? _model.PostIds
                        : (PostId != 0 ? new List<int> { PostId } : null),
                    CategoryIds = _model.CategoryIds,
                    Title = _model.Title,
                    Type = _model.Type,
                    ConfigJson = _model.ConfigJson,
                    SolutionJson = _model.SolutionJson,
                    InstructionsMarkdown = _model.InstructionsMarkdown,
                    OrderIndex = _model.OrderIndex,
                    IsActive = _model.IsActive
                };

                var result = await ExerciseService.UpdateAsync(request);
                if (result != null)
                {
                    _success = "Cvičení bylo úspěšně uloženo!";
                    await Task.Delay(1500);
                    BackToList();
                }
                else
                {
                    _error = "Nepodařilo se aktualizovat cvičení.";
                }
            }
            else
            {
                var request = new CreateInteractiveExerciseRequest
                {
                    // Pokud uživatel vybral nějaké konkrétní články, použij je.
                    // Pokud ne a PostId != 0 (vytvořeno z kontextu článku), přiřaď ten článek.
                    // Pokud jde o globální cvičení (PostId == 0) a uživatel nic nevybral, nech PostIds null.
                    PostIds = _model.PostIds != null && _model.PostIds.Any()
                        ? _model.PostIds
                        : (PostId != 0 ? new List<int> { PostId } : null),
                    CategoryIds = _model.CategoryIds,
                    Title = _model.Title,
                    Type = _model.Type,
                    ConfigJson = _model.ConfigJson,
                    SolutionJson = _model.SolutionJson,
                    InstructionsMarkdown = _model.InstructionsMarkdown,
                    OrderIndex = _model.OrderIndex,
                    IsActive = _model.IsActive
                };

                var result = await ExerciseService.CreateAsync(request);
                _success = "Cvičení bylo úspěšně vytvořeno!";
                await Task.Delay(1500);
                BackToList();
            }
        }
        catch (Exception ex)
        {
            _error = $"Chyba při ukládání: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private void ValidateConfigJson()
    {
        _configError = ValidateJson(_model.ConfigJson, out var error)
            ? null
            : error;
    }

    private void ValidateSolutionJson()
    {
        _solutionError = ValidateJson(_model.SolutionJson, out var error)
            ? null
            : error;
    }

    private bool ValidateJson(string json, out string? error)
    {
        error = null;
        if (string.IsNullOrWhiteSpace(json))
        {
            error = "JSON nesmí být prázdný";
            return false;
        }

        try
        {
            JsonDocument.Parse(json);
            return true;
        }
        catch (JsonException ex)
        {
            error = ex.Message;
            return false;
        }
    }

    private string FormatJson(string json)
    {
        try
        {
            var doc = JsonDocument.Parse(json);
            return JsonSerializer.Serialize(doc, new JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            return json;
        }
    }

    private void OnTypeChanged(ChangeEventArgs e)
    {
        _model.Type = e.Value?.ToString() ?? "";
    }

    private void OnConfigChanged(string json)
    {
        _model.ConfigJson = json;
        // Žádné další akce, pouze aktualizace modelu
    }

    private void OnSolutionChanged(string json)
    {
        _model.SolutionJson = json;
        StateHasChanged();
    }

    private void TogglePost(int postId, string? value)
    {
        if (_model.PostIds == null) _model.PostIds = new List<int>();
        if (_model.PostIds.Contains(postId))
            _model.PostIds.Remove(postId);
        else
            _model.PostIds.Add(postId);
    }

    private void ToggleCategory(int categoryId, string? value)
    {
        if (_model.CategoryIds == null) _model.CategoryIds = new List<int>();
        if (_model.CategoryIds.Contains(categoryId))
            _model.CategoryIds.Remove(categoryId);
        else
            _model.CategoryIds.Add(categoryId);
    }

    private string BuildCategoryLabel(CategoryResponse c)
    {
        // Build simple label with parent info
        var names = new List<string> { c.Name };
        var current = c.ParentId;
        while (current.HasValue)
        {
            var parent = _allCategories.FirstOrDefault(x => x.Id == current.Value);
            if (parent == null) break;
            names.Insert(0, parent.Name);
            current = parent.ParentId;
        }
        return string.Join(" > ", names);
    }

    private void LoadExampleConfig()
    {
        _model.ConfigJson = _model.Type switch
        {
            ExerciseTypeConstants.Circuit  => GetCircuitConfigExample(),
            ExerciseTypeConstants.Timeline => GetTimelineConfigExample(),
            ExerciseTypeConstants.DragDrop => GetDragDropConfigExample(),
            ExerciseTypeConstants.Molecule => GetMoleculeConfigExample(),
            ExerciseTypeConstants.Matching => GetMatchingConfigExample(),
            _ => "{}"
        };
    }

    private void LoadExampleSolution()
    {
        _model.SolutionJson = _model.Type switch
        {
            ExerciseTypeConstants.Circuit  => GetCircuitSolutionExample(),
            ExerciseTypeConstants.Timeline => GetTimelineSolutionExample(),
            ExerciseTypeConstants.DragDrop => GetDragDropSolutionExample(),
            ExerciseTypeConstants.Molecule => GetMoleculeSolutionExample(),
            ExerciseTypeConstants.Matching => GetMatchingSolutionExample(),
            _ => "{}"
        };
    }

    private void BackToList()
    {
        Navigation.NavigateTo($"/exercises");
    }

    // Helper methods pro příklady
    private string GetCircuitExample() => "{\n  \"components\": [...],\n  \"availableComponents\": [...]\n}";
    private string GetTimelineExample() => "{\n  \"events\": [...],\n  \"timeRange\": {...}\n}";
    private string GetDragDropExample() => "{\n  \"items\": [...],\n  \"categories\": [...]\n}";
    private string GetMatchingExample() => "{\n  \"left\": [...],\n  \"right\": [...]\n}";
    private string GetMoleculeExample() => "{\n  \"availableAtoms\": [...]\n}";
        private string GetMatchingConfigExample() => @"{
    ""left"": [
        { ""id"": ""l-1"", ""text"": ""Jablko"" },
        { ""id"": ""l-2"", ""text"": ""Pes"" }
    ],
    ""right"": [
        { ""id"": ""r-1"", ""text"": ""Ovoce"" },
        { ""id"": ""r-2"", ""text"": ""Zvíře"" }
    ]
}";

        private string GetMatchingSolutionExample() => @"{
    ""pairs"": [
        { ""id"": ""pair-1"", ""leftId"": ""l-1"", ""rightId"": ""r-1"" },
        { ""id"": ""pair-2"", ""leftId"": ""l-2"", ""rightId"": ""r-2"" }
    ],
    ""explanation"": ""Správné páry levá-pravá""
}";

    private string GetCircuitConfigExample() => @"{
  ""components"": [
    { ""id"": ""battery-1"", ""type"": ""battery"", ""voltage"": 12, ""x"": 50, ""y"": 100 },
    { ""id"": ""bulb-1"", ""type"": ""bulb"", ""resistance"": 6, ""x"": 200, ""y"": 100 }
  ],
  ""availableComponents"": [
    { ""type"": ""bulb"", ""label"": ""Žárovka"" },
    { ""type"": ""switch"", ""label"": ""Přepínač"" }
  ]
}";

    private string GetCircuitSolutionExample() => @"{
  ""correctConnections"": [
    { ""from"": ""battery-1"", ""to"": ""bulb-1"" },
    { ""from"": ""bulb-1"", ""to"": ""battery-1"" }
  ],
  ""explanation"": ""Správně zapojený obvod""
}";

    private string GetTimelineConfigExample() => @"{
  ""events"": [
    { ""id"": ""event-1"", ""label"": ""Bitva u Lipan"", ""year"": 1434 },
    { ""id"": ""event-2"", ""label"": ""Bitva na Bílé hoře"", ""year"": 1620 }
  ],
  ""timeRange"": { ""start"": 1300, ""end"": 1700 }
}";

    private string GetTimelineSolutionExample() => @"{
  ""correctOrder"": [""event-1"", ""event-2""],
  ""explanation"": ""Chronologické pořadí""
}";

    private string GetDragDropConfigExample() => @"{
  ""items"": [
    { ""id"": ""word-1"", ""text"": ""pes"" },
    { ""id"": ""word-2"", ""text"": ""běží"" }
  ],
  ""categories"": [
    { ""id"": ""noun"", ""label"": ""Podstatné jméno"" },
    { ""id"": ""verb"", ""label"": ""Sloveso"" }
  ]
}";

    private string GetDragDropSolutionExample() => @"{
  ""correctPlacements"": {
    ""word-1"": ""noun"",
    ""word-2"": ""verb""
  },
  ""explanation"": ""Správné zařazení""
}";

    private string GetMoleculeConfigExample() => @"{
  ""availableAtoms"": [
    { ""symbol"": ""H"", ""count"": 4 },
    { ""symbol"": ""O"", ""count"": 2 }
  ]
}";

    private string GetMoleculeSolutionExample() => @"{
  ""correctAtoms"": [
    { ""id"": ""atom-1"", ""symbol"": ""H"", ""bonds"": 1 },
    { ""id"": ""atom-2"", ""symbol"": ""O"", ""bonds"": 2 }
  ],
  ""explanation"": ""H₂O""
}";

    private class ExerciseEditorModel
    {
        public string Title { get; set; } = "";
        public string Type { get; set; } = "";
        public string ConfigJson { get; set; } = "{}";
        public string SolutionJson { get; set; } = "{}";
        public string? InstructionsMarkdown { get; set; }
        public int OrderIndex { get; set; }
        public bool IsActive { get; set; }
        public List<int>? PostIds { get; set; }
        public List<int>? CategoryIds { get; set; }
    }
}
