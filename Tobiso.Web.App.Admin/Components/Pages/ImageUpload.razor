@page "/images"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Text
@using Refit
@using Tobiso.Web.Shared.Interfaces
@inject ITobisoWebApi Api
@inject IJSRuntime JSRuntime
@inject ILogger<ImageUpload> Logger
@inject IConfiguration Configuration
@inject HttpClient HttpClient
@inject Tobiso.Web.App.Authentication.CredentialStore CredentialStore

<PageTitle>Správa obrázků</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col">
            <h1>Správa obrázků</h1>
            
            <div class="image-uploader">
                <div class="mb-3">
                    <label class="form-label">Nahrát nový obrázek</label>
                    <div class="mb-1">
                        <small class="text-muted">Aktuální files base: <strong>@GetBaseAddress()</strong></small>
                    </div>
                    
                    @if (!string.IsNullOrEmpty(currentImageUrl))
                    {
                        <div class="current-image mb-3">
                            <img src="@GetFullImageUrl(currentImageUrl)" alt="Current image" class="img-thumbnail" style="max-height: 200px; max-width: 300px;" />
                            <div class="mt-2">
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="RemoveImage" disabled="@isUploading">
                                    <i class="bi bi-trash"></i> Odstranit obrázek
                                </button>
                            </div>
                        </div>
                    }
                    
                    <div class="upload-area @(isDragOver ? "drag-over" : "")" 
                         @ondragover="HandleDragOver" 
                         @ondragover:preventDefault="true"
                         @ondragleave="HandleDragLeave"
                         @ondrop="HandleDrop" 
                         @ondrop:preventDefault="true">
                        
                        <div class="upload-content">
                            @if (isUploading)
                            {
                                <div class="text-center">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Nahrávám...</span>
                                    </div>
                                    <p class="mt-2 mb-0">Nahrávám obrázek...</p>
                                </div>
                            }
                            else
                            {
                                <div class="text-center">
                                    <p class="mt-2 mb-2">Přetáhněte obrázek sem, nebo 
                                        <button type="button" class="btn btn-link p-0" @onclick="TriggerFileInput">
                                            klikněte pro výběr
                                        </button>
                                    </p>
                                    <small class="text-muted">Podporované: JPG, PNG, WEBP (max 10MB)</small>
                                </div>
                            }
                        </div>
                    </div>
                    
                    <InputFile @ref="fileInput" 
                               OnChange="HandleFileSelected" 
                               accept="image/*" 
                               style="display: none;" />
                    
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger mt-2" role="alert">
                            @errorMessage
                        </div>
                    }
                    
                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success mt-2" role="alert">
                            @successMessage
                        </div>
                    }
                </div>
            </div>

            <!-- Galerie obrázků -->
            <div class="image-gallery mt-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="mb-0">Nahrané obrázky</h3>
                    <!-- 
                    <button type="button" class="btn btn-outline-primary" 
                            @onclick="SyncImagesFromMainWeb" 
                            disabled="@(isUploading || isSyncing)">
                        @if (isSyncing)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Synchronizuji...</span>
                        }
                        else
                        {
                            <i class="bi bi-cloud-download me-2"></i>
                            <span>Sync images from Main Web</span>
                        }
                    </button>
                    -->
                </div>
                
                @if (isLoadingImages)
                {
                    <div class="text-center">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Načítám obrázky...</span>
                        </div>
                        <p class="mt-2">Načítám seznam obrázků...</p>
                    </div>
                }
                else if (images?.Any() == true)
                {
                    <div class="row g-3">
                        @foreach (var image in images)
                        {
                            <div class="col-md-3 col-sm-4 col-6">
                                <div class="card image-card">
                                    <img src="@GetFullImageUrl(image.Url)" class="card-img-top" alt="@image.OriginalFileName" />
                                    <div class="card-body p-2">
                                        <h6 class="card-title text-truncate" title="@image.OriginalFileName">
                                            @image.OriginalFileName
                                        </h6>
                                        <small class="text-muted d-block">
                                            @(image.Size / 1024) KB
                                        </small>
                                        <div class="mt-2">
                                            <button type="button" class="btn btn-sm btn-primary me-1" 
                                                    @onclick="() => CopyImageUrl(GetFullImageUrl(image.Url))">
                                                <i class="bi bi-clipboard"></i> Kopírovat URL
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger" 
                                                    @onclick="() => DeleteImage(image.FileName)" 
                                                    disabled="@isUploading">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> Zatím nebyly nahrány žádné obrázky.
                    </div>
                }
            </div>

        </div>
    </div>
</div>

<style>
    .upload-area {
        border: 2px dashed #dee2e6;
        border-radius: 8px;
        padding: 2rem;
        text-align: center;
        transition: all 0.3s ease;
        cursor: pointer;
        background-color: #f8f9fa;
    }
    
    .upload-area:hover {
        border-color: #0d6efd;
        background-color: #e7f3ff;
    }
    
    .upload-area.drag-over {
        border-color: #0d6efd;
        background-color: #e7f3ff;
        transform: scale(1.02);
    }
    
    .current-image {
        text-align: center;
    }
    
    .image-card {
        transition: transform 0.2s;
    }
    
    .image-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }
    
    .image-card .card-img-top {
        height: 150px;
        object-fit: contain;
        border-bottom: 1px solid #dee2e6;
    }
    
    .image-gallery {
        border-top: 1px solid #dee2e6;
        padding-top: 1.5rem;
    }
</style>

@code {
    private InputFile? fileInput;
    private bool isUploading = false;
    private bool isDragOver = false;
    private bool isSyncing = false;
    private string? errorMessage;
    private string? successMessage;
    private string? currentImageUrl;
    private bool isLoadingImages = false;
    private List<Tobiso.Web.Shared.DTOs.FileUploadResponse>? images;
    
    private static readonly string[] AllowedTypes = { "image/jpeg", "image/jpg", "image/png", "image/webp" };
    private const long MaxFileSize = 10 * 1024 * 1024; // 10MB

    protected override async Task OnInitializedAsync()
    {
        await LoadImages();
    }

    private async Task LoadImages()
    {
        try
        {
            isLoadingImages = true;
            StateHasChanged();
            
            // Use files base address (full URL) so UI and API calls are consistent
            var filesBase = GetBaseAddress().TrimEnd('/');
            var listUrl = filesBase + "/api/files";
            var req = new HttpRequestMessage(HttpMethod.Get, listUrl);
            var auth = await GetAuthorizationHeaderAsync();
            if (auth != null) req.Headers.Authorization = auth;
            var resp = await HttpClient.SendAsync(req);
            resp.EnsureSuccessStatusCode();
            var content = await resp.Content.ReadAsStringAsync();
            images = System.Text.Json.JsonSerializer.Deserialize<List<Tobiso.Web.Shared.DTOs.FileUploadResponse>>(content,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true })?.ToList() ?? new List<Tobiso.Web.Shared.DTOs.FileUploadResponse>();
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba při načítání obrázků: {ex.Message}";
            Logger.LogError(ex, "Error loading images");
        }
        finally
        {
            isLoadingImages = false;
            StateHasChanged();
        }
    }

    private async Task TriggerFileInput()
    {
        if (fileInput?.Element != null)
        {
            await JSRuntime.InvokeVoidAsync("eval", "document.querySelector('input[type=file]').click()");
        }
    }
    
    private void HandleDragOver()
    {
        isDragOver = true;
    }
    
    private void HandleDragLeave()
    {
        isDragOver = false;
    }
    
    private Task HandleDrop()
    {
        isDragOver = false;
        // Note: Drag and drop file handling requires additional JavaScript interop
        return Task.CompletedTask;
    }
    
    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        
        await ProcessFile(file);
    }
    
    private async Task ProcessFile(IBrowserFile file)
    {
        try
        {
            ClearMessages();
            
            // Validate file
            if (!AllowedTypes.Contains(file.ContentType.ToLowerInvariant()))
            {
                errorMessage = $"Typ souboru '{file.ContentType}' není podporován. Použijte JPG, PNG nebo WEBP.";
                return;
            }
            
            if (file.Size > MaxFileSize)
            {
                errorMessage = $"Velikost souboru ({file.Size / (1024 * 1024):F1}MB) překračuje maximální povolenou velikost 10MB.";
                return;
            }
            
            isUploading = true;
            StateHasChanged();
            
            // Create stream for upload
            using var stream = file.OpenReadStream(MaxFileSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;
            
            // Upload via API - STEJNĚ jako v SentrySMP
            // Upload to files API using the configured files base address
            var filesBase = GetBaseAddress().TrimEnd('/');
            var uploadUrl = filesBase + "/api/files/upload";

            using var multipart = new MultipartFormDataContent();
            ms.Position = 0;
            var streamContent = new StreamContent(ms);
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            multipart.Add(streamContent, "file", file.Name);

            var req = new HttpRequestMessage(HttpMethod.Post, uploadUrl) { Content = multipart };
            var authHeader = await GetAuthorizationHeaderAsync();
            if (authHeader != null) req.Headers.Authorization = authHeader;
            var uploadResp = await HttpClient.SendAsync(req);
            uploadResp.EnsureSuccessStatusCode();
            var uploadJson = await uploadResp.Content.ReadAsStringAsync();
            var response = System.Text.Json.JsonSerializer.Deserialize<Tobiso.Web.Shared.DTOs.FileUploadResponse>(uploadJson,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            
            // Update current image URL
            currentImageUrl = response.Url;
            
            successMessage = "Obrázek byl úspěšně nahrán!";
            Logger.LogInformation("Successfully uploaded image: {FileName}", file.Name);
            
            // Force re-render to show uploaded image
            StateHasChanged();
            
            // Clear success message after 3 seconds
            _ = Task.Delay(3000).ContinueWith(t => 
            {
                successMessage = null;
                InvokeAsync(StateHasChanged);
            });
            
            // Reload images to show the new one
            await LoadImages();
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba při nahrávání obrázku: {ex.Message}";
            Logger.LogError(ex, "Error uploading image");
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }
    
    private async Task RemoveImage()
    {
        if (string.IsNullOrEmpty(currentImageUrl)) return;
        
        try
        {
            // Extract filename from URL for deletion
            var fileName = currentImageUrl?.Contains("/") == true ? 
                Path.GetFileName(new Uri(currentImageUrl).LocalPath) : currentImageUrl;
                
            if (!string.IsNullOrEmpty(fileName))
            {
                var filesBase = GetBaseAddress().TrimEnd('/');
                var deleteUrl = filesBase + $"/api/files/{Uri.EscapeDataString(fileName)}";
                var req = new HttpRequestMessage(HttpMethod.Delete, deleteUrl);
                var authH = await GetAuthorizationHeaderAsync();
                if (authH != null) req.Headers.Authorization = authH;
                var delResp = await HttpClient.SendAsync(req);
                if (!delResp.IsSuccessStatusCode)
                {
                    throw new Exception($"Delete failed: {delResp.StatusCode}");
                }
            }
            
            currentImageUrl = null;
            
            successMessage = "Obrázek byl úspěšně odstraněn!";
            
            // Clear success message after 3 seconds
            _ = Task.Delay(3000).ContinueWith(t => 
            {
                successMessage = null;
                InvokeAsync(StateHasChanged);
            });
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba při odstraňování obrázku: {ex.Message}";
            Logger.LogError(ex, "Error removing image");
        }
    }
    
    private async Task CopyImageUrl(string imageUrl)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", imageUrl);
            successMessage = "URL obrázku byla zkopírována do schránky!";
            
            // Clear success message after 2 seconds
            _ = Task.Delay(2000).ContinueWith(t => 
            {
                successMessage = null;
                InvokeAsync(StateHasChanged);
            });
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba při kopírování URL: {ex.Message}";
            Logger.LogError(ex, "Error copying image URL");
        }
    }
    
    private async Task DeleteImage(string fileName)
    {
        try
        {
            ClearMessages();
            
            var filesBaseForDelete = GetBaseAddress().TrimEnd('/');
            var deleteUrl2 = filesBaseForDelete + $"/api/files/{Uri.EscapeDataString(fileName)}";
            var req2 = new HttpRequestMessage(HttpMethod.Delete, deleteUrl2);
            var authH2 = await GetAuthorizationHeaderAsync();
            if (authH2 != null) req2.Headers.Authorization = authH2;
            var delResp2 = await HttpClient.SendAsync(req2);
            if (!delResp2.IsSuccessStatusCode)
            {
                throw new Exception($"Delete failed: {delResp2.StatusCode}");
            }
            
            // Remove from current image if it's the same
            if (currentImageUrl?.Contains(fileName) == true)
            {
                currentImageUrl = null;
            }
            
            successMessage = "Obrázek byl úspěšně smazán!";
            
            // Clear success message after 3 seconds
            _ = Task.Delay(3000).ContinueWith(t => 
            {
                successMessage = null;
                InvokeAsync(StateHasChanged);
            });
            
            // Reload images to reflect the deletion
            await LoadImages();
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba při mazání obrázku: {ex.Message}";
            Logger.LogError(ex, "Error deleting image: {FileName}", fileName);
        }
    }

    private void ClearMessages()
    {
        errorMessage = null;
        successMessage = null;
    }
    
    private string GetFullImageUrl(string imageUrl)
    {
        if (string.IsNullOrEmpty(imageUrl))
            return string.Empty;
            
        // Pokud už je URL plná (obsahuje http/https), vrať ji jak je
        if (imageUrl.StartsWith("http://") || imageUrl.StartsWith("https://"))
            return imageUrl;
            
        // Pokud je relativní, přidej baseUrl pro soubory z konfigurace (pokud existuje), jinak obecné Api:BaseAddress
        var filesBase = Configuration["Api:FilesBaseAddress"]?.TrimEnd('/');
        var apiBase = Configuration["Api:BaseAddress"]?.TrimEnd('/');

        var baseUrl = !string.IsNullOrEmpty(filesBase) ? filesBase : (apiBase ?? "https://localhost:7270");

        // Ensure leading slash on imageUrl
        var relative = imageUrl.StartsWith('/') ? imageUrl : "/" + imageUrl;
        return $"{baseUrl}{relative}";
    }

    private string GetBaseAddress()
    {
        var filesBase = Configuration["Api:FilesBaseAddress"]?.TrimEnd('/');
        var apiBase = Configuration["Api:BaseAddress"]?.TrimEnd('/');
        return !string.IsNullOrEmpty(filesBase) ? filesBase : (apiBase ?? "https://localhost:7270");
    }

    private async Task<System.Net.Http.Headers.AuthenticationHeaderValue?> GetAuthorizationHeaderAsync()
    {
        try
        {
            var creds = CredentialStore.Get();
            if (creds is (var username, var password))
            {
                var bytes = Encoding.ASCII.GetBytes($"{username}:{password}");
                var value = Convert.ToBase64String(bytes);
                return new System.Net.Http.Headers.AuthenticationHeaderValue("Basic", value);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to build auth header");
        }

        return null;
    }
    
    private async Task SyncImagesFromMainWeb()
    {
        try
        {
            isSyncing = true;
            ClearMessages();
            StateHasChanged();
            
            Logger.LogInformation("Starting image sync from main web");
            
            // Získej seznam současných obrázků
            var currentImages = images?.Select(i => i.FileName).ToHashSet() ?? new HashSet<string>();
            
            // Získej seznam obrázků z produkční verze
            var mainWebImages = await GetMainWebImageList();
            
            if (!mainWebImages.Any())
            {
                errorMessage = "API endpoint na produkční verzi není dostupný. Synchronizace vyžaduje funkční API přístup.";
                return;
            }
            
            Logger.LogInformation("Local images count: {LocalCount}, Main web images count: {MainCount}", 
                currentImages.Count, mainWebImages.Count);
            Logger.LogDebug("Local images: {LocalImages}", string.Join(", ", currentImages.Take(10)));
            Logger.LogDebug("Main web images: {MainImages}", string.Join(", ", mainWebImages.Take(10)));
            
            var downloadedCount = 0;
            var skippedCount = 0;
            
            var processedCount = 0;
            foreach (var imageFileName in mainWebImages)
            {
                try
                {
                    processedCount++;
                    
                    // Detailní debugging pro první několik obrázků
                    if (processedCount <= 5)
                    {
                        Logger.LogInformation("Processing image {Count}/{Total}: '{FileName}', Exists locally: {Exists}", 
                            processedCount, mainWebImages.Count, imageFileName, currentImages.Contains(imageFileName));
                    }
                    
                    // Pokud obrázek už existuje, přeskoč ho
                    if (currentImages.Contains(imageFileName))
                    {
                        skippedCount++;
                        if (processedCount <= 5)
                        {
                            Logger.LogDebug("Skipping existing image: {FileName}", imageFileName);
                        }
                        continue;
                    }
                    
                    // Stáhni a nahraj obrázek
                    await DownloadAndUploadImage(imageFileName);
                    downloadedCount++;
                    
                    Logger.LogInformation("Successfully synced image: {FileName}", imageFileName);
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Failed to sync image: {FileName}", imageFileName);
                    // Pokračuj s dalšími obrázky i při chybě
                }
            }
            
            successMessage = $"Synchronizace dokončena! Staženo: {downloadedCount}, Přeskočeno: {skippedCount}";
            
            // Znovu načti seznam obrázků
            await LoadImages();
            
            Logger.LogInformation("Image sync completed. Downloaded: {Downloaded}, Skipped: {Skipped}", 
                downloadedCount, skippedCount);
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba při synchronizaci obrázků: {ex.Message}";
            Logger.LogError(ex, "Error during image sync");
        }
        finally
        {
            isSyncing = false;
            StateHasChanged();
        }
    }
    
    private async Task<List<string>> GetMainWebImageList()
    {
        var imageList = new List<string>();
        
        try
        {
            // Zkus získat seznam přes hlavní API (pokud má endpoint pro listing obrázků)
            var mainWebClient = new HttpClient();
            // Přidej timeout pro rychlejší fallback
            mainWebClient.Timeout = TimeSpan.FromSeconds(30);
            var mainWebApiUrl = "https://www.tobiso.com/api/files";
            
            Logger.LogInformation("Attempting to get image list from API: {Url}", mainWebApiUrl);
            
            // Zkus zavolat API endpoint
            var response = await mainWebClient.GetAsync(mainWebApiUrl);
            
            Logger.LogInformation("Main web API response: Status={StatusCode}, ReasonPhrase={ReasonPhrase}", 
                response.StatusCode, response.ReasonPhrase);
            
            if (response.IsSuccessStatusCode)
            {
                var content = await response.Content.ReadAsStringAsync();
                Logger.LogDebug("API response content length: {Length}", content.Length);
                
                var apiImages = System.Text.Json.JsonSerializer.Deserialize<List<Tobiso.Web.Shared.DTOs.FileUploadResponse>>(content, 
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                
                if (apiImages != null)
                {
                    imageList.AddRange(apiImages.Select(i => i.FileName));
                    Logger.LogInformation("Retrieved {Count} images from main web API", imageList.Count);
                    if (apiImages.Count > 0)
                    {
                        Logger.LogDebug("First few images from API: {Images}", 
                            string.Join(", ", apiImages.Take(5).Select(i => i.FileName)));
                    }
                    return imageList;
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                Logger.LogWarning("API endpoint requires authentication, using fallback method");
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to get image list from API: {Message}, will try fallback method", ex.Message);
        }
        
        // Fallback: API není dostupné
        Logger.LogWarning("API endpoint for image list is not available. Sync function requires API access to work properly.");
        
        // Pro ukázku vraťme prázdný seznam, aby synchronizace nedělala nic
        return new List<string>();

    }
    
    private async Task DownloadAndUploadImage(string fileName)
    {
        var imageUrl = $"https://www.tobiso.com/images/{fileName}";
        
        // Stáhni obrázek
        var response = await HttpClient.GetAsync(imageUrl);
        response.EnsureSuccessStatusCode();
        
        var imageBytes = await response.Content.ReadAsByteArrayAsync();
        var contentType = response.Content.Headers.ContentType?.MediaType ?? "image/jpeg";
        
        // Vytvoř stream pro upload
        using var ms = new MemoryStream(imageBytes);
        var filesBase = GetBaseAddress().TrimEnd('/');
        var uploadUrl = filesBase + "/api/files/upload";

        using var multipart = new MultipartFormDataContent();
        ms.Position = 0;
        var sc = new StreamContent(ms);
        sc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(contentType);
        multipart.Add(sc, "file", fileName);

        var req = new HttpRequestMessage(HttpMethod.Post, uploadUrl) { Content = multipart };
        var auth = await GetAuthorizationHeaderAsync();
        if (auth != null) req.Headers.Authorization = auth;
        var uploadResp = await HttpClient.SendAsync(req);
        uploadResp.EnsureSuccessStatusCode();
        
        Logger.LogDebug("Downloaded and uploaded image: {FileName}, Size: {Size} bytes", fileName, imageBytes.Length);
    }
}