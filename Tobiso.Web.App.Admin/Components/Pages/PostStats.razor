@page "/post-stats"
@using Tobiso.Web.Shared.DTOs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Tobiso.Api.Infrastructure.Data
@inject TobisoDbContext Db
@inject NavigationManager Navigation
@inject IJSRuntime JS
@attribute [Authorize]

<PageTitle>Statistiky článků - Admin</PageTitle>

<div class="stats-container">
    <div class="stats-header">
        <h1><i data-lucide="bar-chart-3"></i> Statistiky článků</h1>
        <div class="stats-header-controls">
            <input class="input search-input" placeholder="Hledat článek…" @bind="_search" @bind:event="oninput" />
            <select class="select sort-select" @bind="_sortBy">
                <option value="title">Název A–Z</option>
                <option value="total">Počet hodnocení</option>
                <option value="hard">Nejvíce Těžký</option>
                <option value="easy">Nejvíce Snadný</option>
            </select>
        </div>
    </div>

    @if (_loading)
    {
        <div class="loading-row"><i data-lucide="loader-2" class="spinner"></i></div>
    }
    else if (_rows.Count == 0)
    {
        <div class="callout-sidefact">Žádná hodnocení ještě nebyla přidána.</div>
    }
    else
    {
        <div class="stats-summary">
            <span class="badge">Celkem hodnocených: <strong>@_rows.Count(r => r.Total > 0)</strong></span>
            <span class="badge badge-success">Snadný: <strong>@_rows.Sum(r => r.Easy)</strong></span>
            <span class="badge badge-warning">OK: <strong>@_rows.Sum(r => r.Ok)</strong></span>
            <span class="badge badge-danger">Těžký: <strong>@_rows.Sum(r => r.Hard)</strong></span>
        </div>

        <div class="data-table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Článek</th>
                        <th class="col-center">😊 Snadný</th>
                        <th class="col-center">😐 OK</th>
                        <th class="col-center">😕 Těžký</th>
                        <th class="col-center">Celkem</th>
                        <th style="min-width:160px">Rozložení</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Filtered)
                    {
                        <tr>
                            <td>
                                <a href="/post-stats" class="row-title-link" @onclick="() => GoToPost(row.PostId)" @onclick:preventDefault="true">
                                    @row.Title
                                </a>
                            </td>
                            <td class="col-center val-easy">@row.Easy</td>
                            <td class="col-center val-ok">@row.Ok</td>
                            <td class="col-center val-hard">@row.Hard</td>
                            <td class="col-center">@row.Total</td>
                            <td>
                                @if (row.Total > 0)
                                {
                                    var easyPct = row.Easy * 100 / row.Total;
                                    var okPct   = row.Ok   * 100 / row.Total;
                                    var hardPct = row.Hard * 100 / row.Total;
                                    <div class="diff-bar">
                                        @if (easyPct > 0) { <div class="diff-seg easy" style="width:@(easyPct)%" title="Snadný @(easyPct)%"></div> }
                                        @if (okPct > 0)   { <div class="diff-seg ok"   style="width:@(okPct)%"   title="OK @(okPct)%"></div> }
                                        @if (hardPct > 0) { <div class="diff-seg hard" style="width:@(hardPct)%" title="Těžký @(hardPct)%"></div> }
                                    </div>
                                    <small class="muted">@(easyPct)% / @(okPct)% / @(hardPct)%</small>
                                }
                                else
                                {
                                    <span class="muted">–</span>
                                }
                            </td>
                            <td>
                                <a class="btn btn-secondary btn-sm" href="posts/edit/@row.PostId">Editovat</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private List<StatsRow> _rows = new();
    private string _search = "";
    private string _sortBy = "total";

    private IEnumerable<StatsRow> Filtered => _rows
        .Where(r => string.IsNullOrEmpty(_search) || r.Title.Contains(_search, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(r => _sortBy switch {
            "total" => r.Total,
            "hard"  => r.Hard,
            "easy"  => r.Easy,
            _       => 0
        })
        .ThenBy(r => _sortBy == "title" ? r.Title : "");

    protected override async Task OnInitializedAsync()
    {
        var posts = await Db.Posts
            .Select(p => new { p.Id, p.Title })
            .ToListAsync();

        var ratings = await Db.PostDifficultyRatings
            .GroupBy(r => r.PostId)
            .Select(g => new {
                PostId = g.Key,
                Easy   = g.Count(r => r.Rating == 1),
                Ok     = g.Count(r => r.Rating == 2),
                Hard   = g.Count(r => r.Rating == 3),
                Total  = g.Count()
            })
            .ToListAsync();

        var ratingsMap = ratings.ToDictionary(r => r.PostId);

        _rows = posts.Select(p => {
            ratingsMap.TryGetValue(p.Id, out var r);
            return new StatsRow {
                PostId = p.Id,
                Title  = p.Title ?? $"Post {p.Id}",
                Easy   = r?.Easy  ?? 0,
                Ok     = r?.Ok    ?? 0,
                Hard   = r?.Hard  ?? 0,
                Total  = r?.Total ?? 0,
            };
        }).ToList();

        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("initLucide");
    }

    private void GoToPost(int id) => Navigation.NavigateTo($"/posts/edit/{id}");

    private record StatsRow
    {
        public int PostId { get; init; }
        public string Title { get; init; } = "";
        public int Easy  { get; init; }
        public int Ok    { get; init; }
        public int Hard  { get; init; }
        public int Total { get; init; }
    }
}
