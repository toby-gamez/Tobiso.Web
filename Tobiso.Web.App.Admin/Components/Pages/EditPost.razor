@page "/posts/edit/{Id:int}"
@using Tobiso.Web.Shared.DTOs
@using Tobiso.Web.Shared.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@using Tobiso.Web.Api.Services
@using System
@inject ITobisoWebApi Api
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IConfiguration Configuration

<PageTitle>Editace článku</PageTitle>

<h3>Editace článku</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (post == null)
{
    <p>Načítání...</p>
}
else
{
    <EditForm Model="post" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="mb-3">
            <label for="title" class="form-label">Název</label>
            <InputText id="title" class="form-control" @bind-Value="post.Title" />
        </div>
        <div class="mb-3">
            <label for="filePath" class="form-label">Soubor</label>
            <InputText id="filePath" class="form-control" @bind-Value="post.FilePath" />
        </div>
        <div class="mb-3">
            <label for="category" class="form-label">Kategorie</label>
            <SearchableCategorySelect Categories="categories" Value="post.CategoryId" ValueChanged="id => post.CategoryId = id" />
        </div>
        <div class="mb-3">
            <label for="grade" class="form-label">Ročník (verze)</label>
            @* Use Value+ValueChanged instead of @bind-Value+@onchange — Blazor's @bind-Value already
               subscribes the change event internally, so adding @onchange would fire twice and conflict.
               ValueExpression is required when splitting @bind-Value into Value+ValueChanged manually. *@
            <InputSelect id="grade" class="form-select" TValue="int?"
                         Value="_selectedGradeId"
                         ValueChanged="OnGradeChanged"
                         ValueExpression="@(() => _selectedGradeId)">
                <option value="">-- vyberte ročník --</option>
                @foreach (var g in grades)
                {
                    <option value="@g.Id">@g.Name</option>
                }
            </InputSelect>
        </div>
        <div class="mb-3">
            <label for="content" class="form-label">Obsah</label>
            <MarkdownEditor @ref="markdownEditor" @bind-Value="_editContent" Placeholder="Začněte psát váš Markdown obsah..." Rows="15" />
            <div class="mt-2">
                <button type="button" class="btn btn-sm btn-outline-primary me-2" @onclick="CheckGrammar" disabled="@isChecking">Zkontrolovat gramatiku</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearGrammarHighlights">Vyčistit zvýraznění</button>
            </div>
            <GrammarCheckPanel Issues="grammarIssues" />
        </div>
        <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" id="isFix" @bind="_isFixSelected" />
            <label class="form-check-label" for="isFix">Oprava (Fix)</label>
        </div>
        <button type="submit" class="btn btn-primary">Uložit změny</button>
        <button type="button" class="btn btn-secondary ms-2" @onclick="GoBack">Zpět</button>
        <button type="button" class="btn btn-danger ms-2" @onclick="OnDeletePost">Smazat</button>
        <button type="button" class="btn btn-outline-info ms-2" title="Vygenerovat tahák (PDF) pomocí AI" @onclick="OpenCheatSheetModal">
            <i class="bi bi-file-earmark-text"></i> Tahák
        </button>
    </EditForm>

    <!-- Přidání komponenty pro správu otázek -->
    <QuestionsManager PostId="@Id" />
}

@if (_showCheatSheetModal)
{
    <div class="cs-modal-backdrop" @onclick="CloseCheatSheetModal">
        <div class="cs-modal-dialog" @onclick:stopPropagation>
            <div class="cs-modal-header">
                <span>Vyberte formát tahák&uacute;</span>
                <button class="cs-modal-close" aria-label="Zavřít" @onclick="CloseCheatSheetModal">&times;</button>
            </div>
            <div class="cs-modal-body">
                <a class="cs-ratio-card" href="@($"{Configuration["Api:BaseAddress"]}/api/pdf/cheatsheet/{Id}?ratio=1x1")" target="_blank" @onclick="CloseCheatSheetModal">
                    <div class="cs-preview cs-preview-1x1">
                        <div class="cs-preview-line" style="width:80%"></div>
                        <div class="cs-preview-line" style="width:65%"></div>
                        <div class="cs-preview-line" style="width:72%"></div>
                        <div class="cs-preview-line" style="width:58%"></div>
                        <div class="cs-preview-line" style="width:70%"></div>
                        <div class="cs-preview-line" style="width:60%"></div>
                    </div>
                    <div class="cs-card-label">Čtvercový</div>
                    <div class="cs-card-sub">10 &times; 10 cm &nbsp;&bull;&nbsp; ~20 bodů</div>
                </a>
                <a class="cs-ratio-card" href="@($"{Configuration["Api:BaseAddress"]}/api/pdf/cheatsheet/{Id}?ratio=1x2")" target="_blank" @onclick="CloseCheatSheetModal">
                    <div class="cs-preview cs-preview-1x2">
                        <div class="cs-preview-line" style="width:80%"></div>
                        <div class="cs-preview-line" style="width:65%"></div>
                        <div class="cs-preview-line" style="width:72%"></div>
                        <div class="cs-preview-line" style="width:58%"></div>
                        <div class="cs-preview-line" style="width:70%"></div>
                        <div class="cs-preview-line" style="width:60%"></div>
                        <div class="cs-preview-line" style="width:75%"></div>
                        <div class="cs-preview-line" style="width:50%"></div>
                        <div class="cs-preview-line" style="width:68%"></div>
                        <div class="cs-preview-line" style="width:62%"></div>
                    </div>
                    <div class="cs-card-label">Na výšku</div>
                    <div class="cs-card-sub">10 &times; 20 cm &nbsp;&bull;&nbsp; ~35 bodů</div>
                </a>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private PostResponse? post;
    private List<CategoryResponse> categories = new();
    private List<GradeResponse> grades = new();
    private string? errorMessage;
    private bool _isFixSelected = false;
    /// <summary>Tracks the currently selected grade independently of the loaded version.</summary>
    private int? _selectedGradeId;
    /// <summary>Content being edited (bound to MarkdownEditor instead of post.Content).</summary>
    private string _editContent = string.Empty;
    private DateTime? _editLastFix;
    private DateTime? _editLastEdit;
    private Tobiso.Web.App.Admin.Components.MarkdownEditor? markdownEditor;
    private List<Tobiso.Web.Shared.DTOs.GrammarIssue> grammarIssues = new();
    private bool isChecking = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            categories = (await Api.GetAllCategories()).ToList();
            grades = (await Api.GetGrades()).ToList();
            // Load the post without a specific grade preference so all versions are available
            post = await Api.GetPostById(Id);
            if (post != null)
            {
                // Default to first version's grade, or highest grade available
                var firstVersion = post.Versions?.FirstOrDefault();
                _selectedGradeId = firstVersion?.GradeId
                    ?? (grades.Any() ? grades.OrderByDescending(g => g.Level).First().Id : null);
                // Load content from the version for the selected grade
                if (_selectedGradeId.HasValue)
                {
                    var ver = post.Versions?.FirstOrDefault(v => v.GradeId == _selectedGradeId.Value)
                              ?? post.Versions?.FirstOrDefault();
                    if (ver != null)
                    {
                        _editContent = ver.Content ?? string.Empty;
                        _editLastFix = ver.LastFix;
                        _editLastEdit = ver.LastEdit;
                    }
                }
                _isFixSelected = _editLastFix.HasValue && (_editLastEdit == null || _editLastFix > _editLastEdit);
            }
        }
        catch (Refit.ApiException rex) when (rex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            errorMessage = $"Post s ID {Id} nebyl nalezen (404). Mohl být smazán nebo nemá žádnou PostVersion.";
            categories = new List<CategoryResponse>();
            grades = new List<GradeResponse>();
            Console.WriteLine($"Post {Id} not found when loading for edit: {rex.Message}");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            Console.WriteLine($"Error initializing EditPost for {Id}: {ex.Message}");
        }
    }

    private async Task CheckGrammar()
    {
        if (post == null) return;
        try
        {
            isChecking = true;
            grammarIssues.Clear();
            var req = new Tobiso.Web.Shared.DTOs.GrammarCheckRequest { Content = _editContent };
            var resp = await Api.CheckGrammar(req);
            if (resp?.Issues != null && resp.Issues.Count > 0)
            {
                grammarIssues = resp.Issues;
                if (markdownEditor != null)
                    await markdownEditor.HighlightErrors(grammarIssues);
            }
            else
            {
                grammarIssues = new List<Tobiso.Web.Shared.DTOs.GrammarIssue>();
                if (markdownEditor != null)
                    await markdownEditor.ClearHighlights();
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isChecking = false;
        }
    }

    private async Task ClearGrammarHighlights()
    {
        grammarIssues.Clear();
        if (markdownEditor != null) await markdownEditor.ClearHighlights();
    }

    private async Task HandleValidSubmit()
    {
        if (post == null) return;
        try
        {
            // 1. Save post metadata (title, filePath, category)
            await Api.UpdatePost(post.Id, new UpdatePostRequest
            {
                Title = post.Title,
                FilePath = post.FilePath ?? string.Empty,
                CategoryId = post.CategoryId
            });

            // 2. Save version content for the selected grade
            if (_selectedGradeId.HasValue)
            {
                var lastFix = _isFixSelected ? DateTime.UtcNow : (DateTime?)null;
                var lastEdit = _isFixSelected ? (DateTime?)null : DateTime.UtcNow;

                var versions = (await Api.GetVersionsByPost(Id))?.ToList() ?? new List<PostVersionResponse>();
                var existing = versions.FirstOrDefault(v => v.GradeId == _selectedGradeId.Value);
                if (existing != null)
                {
                    await Api.UpdateVersion(existing.Id, new UpdateVersionRequest
                    {
                        Content = _editContent,
                        LastFix = lastFix,
                        LastEdit = lastEdit
                    });
                }
                else
                {
                    await Api.CreateVersion(new CreateVersionRequest
                    {
                        PostId = post.Id,
                        GradeId = _selectedGradeId.Value,
                        Content = _editContent,
                        LastFix = lastFix,
                        LastEdit = lastEdit
                    });
                }
            }

            errorMessage = null;
            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    /// <summary>
    /// Called when the user picks a different grade from the dropdown.
    /// Loads the version content for that grade (or clears editor if no version exists yet).
    /// Uses ValueChanged pattern to avoid @bind-Value + @onchange conflict.
    /// </summary>
    private async Task OnGradeChanged(int? gradeId)
    {
        _selectedGradeId = gradeId;
        if (post == null || !gradeId.HasValue) return;
        try
        {
            var versions = await Api.GetVersionsByPost(Id);
            var version = versions?.FirstOrDefault(v => v.GradeId == gradeId.Value);
            if (version != null)
            {
                _editContent = version.Content ?? string.Empty;
                _editLastEdit = version.LastEdit;
                _editLastFix = version.LastFix;
                if (markdownEditor != null)
                {
                    await markdownEditor.SetValue(_editContent);
                    await markdownEditor.ClearHighlights();
                }
                _isFixSelected = _editLastFix.HasValue && (_editLastEdit == null || _editLastFix > _editLastEdit);
            }
            else
            {
                // No version exists for this grade yet — clear editor
                _editContent = string.Empty;
                _editLastEdit = null;
                _editLastFix = null;
                if (markdownEditor != null)
                {
                    await markdownEditor.SetValue(string.Empty);
                    await markdownEditor.ClearHighlights();
                }
                _isFixSelected = false;
            }
            grammarIssues.Clear();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void GoBack() => Navigation.NavigateTo("/");

    private async Task OnDeletePost()
    {
        if (post == null) return;
        if (!await JsConfirm($"Opravdu chcete smazat post s ID {post.Id}?")) return;
        try
        {
            await Api.DeletePost(post.Id);
            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba při mazání: {ex.Message}";
        }
    }

    private bool _showCheatSheetModal = false;
    private void OpenCheatSheetModal() => _showCheatSheetModal = true;
    private void CloseCheatSheetModal() => _showCheatSheetModal = false;

    [Inject]
    private IJSRuntime JS { get; set; } = default!;
    private async Task<bool> JsConfirm(string message)
    {
        return await JS.InvokeAsync<bool>("confirm", message);
    }
}

<style>
    .cs-modal-backdrop { position:fixed;inset:0;z-index:1100;background:rgba(0,0,0,.45);display:flex;align-items:center;justify-content:center; }
    .cs-modal-dialog { background:#fff;border-radius:12px;box-shadow:0 8px 32px rgba(0,0,0,.28);padding:1.4rem 1.6rem 1.2rem;min-width:320px;max-width:96vw; }
    .cs-modal-header { display:flex;justify-content:space-between;align-items:center;font-weight:600;font-size:1rem;margin-bottom:1.1rem; }
    .cs-modal-close { background:none;border:none;font-size:1.4rem;line-height:1;cursor:pointer;color:inherit;padding:0 .2rem; }
    .cs-modal-body { display:flex;gap:1.2rem;justify-content:center; }
    .cs-ratio-card { display:flex;flex-direction:column;align-items:center;gap:.55rem;padding:.8rem .9rem 1rem;border:2px solid #ddd;border-radius:10px;background:none;cursor:pointer;text-decoration:none;color:inherit;transition:border-color .15s,box-shadow .15s; }
    .cs-ratio-card:hover { border-color:#4f8ef7;box-shadow:0 2px 10px rgba(79,142,247,.18); }
    .cs-preview { display:flex;flex-direction:column;gap:5px;padding:7px 8px;border-radius:5px;border:1.5px solid #ccc;background:#f8f8f8; }
    .cs-preview-1x1 { width:72px;height:72px; }
    .cs-preview-1x2 { width:60px;height:120px; }
    .cs-preview-line { height:4px;border-radius:2px;background:#bbb; }
    .cs-card-label { font-weight:600;font-size:.92rem; }
    .cs-card-sub { font-size:.75rem;color:#888; }
</style>
