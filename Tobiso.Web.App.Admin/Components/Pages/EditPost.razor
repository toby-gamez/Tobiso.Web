@page "/posts/edit/{Id:int}"
@using Tobiso.Web.Shared.DTOs
@using Tobiso.Web.Shared.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@using Tobiso.Web.Api.Services
@inject ITobisoWebApi Api
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@using System

<PageTitle>Editace článku</PageTitle>

<h3>Editace článku</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (post == null)
{
    <p>Načítání...</p>
}
else
{
    <EditForm Model="post" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="mb-3">
            <label for="title" class="form-label">Název</label>
            <InputText id="title" class="form-control" @bind-Value="post.Title" />
        </div>
        <div class="mb-3">
            <label for="filePath" class="form-label">Soubor</label>
            <InputText id="filePath" class="form-control" @bind-Value="post.FilePath" />
        </div>
        <div class="mb-3">
            <label for="category" class="form-label">Kategorie</label>
            <SearchableCategorySelect Categories="categories" Value="post.CategoryId" ValueChanged="id => post.CategoryId = id" />
        </div>
        <div class="mb-3">
            <label for="grade" class="form-label">Ročník (verze)</label>
            <InputSelect id="grade" class="form-select" TValue="int?" @bind-Value="post.GradeId" @onchange="OnGradeChanged">
                <option value="">-- vyberte ročník --</option>
                @foreach (var g in grades)
                {
                    <option value="@g.Id">@g.Name</option>
                }
            </InputSelect>
        </div>
        <div class="mb-3">
            <label for="content" class="form-label">Obsah</label>
            <MarkdownEditor @ref="markdownEditor" @bind-Value="post.Content" For="@(() => post.Content)" Placeholder="Začněte psát váš Markdown obsah..." Rows="15" />
            <div class="mt-2">
                <button type="button" class="btn btn-sm btn-outline-primary me-2" @onclick="CheckGrammar" disabled="@isChecking">Zkontrolovat gramatiku</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearGrammarHighlights">Vyčistit zvýraznění</button>
            </div>
            <GrammarCheckPanel Issues="grammarIssues" />
        </div>
        <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" id="isFix" @bind="_isFixSelected" />
            <label class="form-check-label" for="isFix">Oprava (Fix)</label>
        </div>
        <button type="submit" class="btn btn-primary">Uložit změny</button>
        <button type="button" class="btn btn-secondary ms-2" @onclick="GoBack">Zpět</button>
        <button type="button" class="btn btn-danger ms-2" @onclick="OnDeletePost">Smazat</button>
    </EditForm>

    <!-- Přidání komponenty pro správu otázek -->
    <QuestionsManager PostId="@Id" />
}

@code {
    [Parameter]
    public int Id { get; set; }

    private PostResponse? post;
    private List<CategoryResponse> categories = new();
    private List<GradeResponse> grades = new();
    private string? errorMessage;
    private bool _isFixSelected = false;
    private Tobiso.Web.App.Admin.Components.MarkdownEditor? markdownEditor;
    private List<Tobiso.Web.Shared.DTOs.GrammarIssue> grammarIssues = new();
    private bool isChecking = false;

    protected override async Task OnInitializedAsync()
    {
        // Check if user is authenticated
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            categories = (await Api.GetAllCategories()).ToList();
            grades = (await Api.GetGrades()).ToList();
            // load default version (no grade specified) - admin can choose grade to edit
            post = await Api.GetPostById(Id);
            if (post != null)
            {
                // default checkbox state: true if LastFix is newer than LastEdit
                _isFixSelected = post.LastFix.HasValue && (post.LastEdit == null || post.LastFix > post.LastEdit);
            }
        }
        catch (Refit.ApiException rex) when (rex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            // Friendly message when post not found
            errorMessage = $"Post with ID {Id} was not found (404). It may have been deleted or missing PostVersion entries after migration.";
            // leave post as null so form is not shown
            categories = new List<CategoryResponse>();
            grades = new List<GradeResponse>();
            Console.WriteLine($"Post {Id} not found when loading for edit: {rex.Message}");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            Console.WriteLine($"Error initializing EditPost for {Id}: {ex.Message}");
        }
    }

    private async Task CheckGrammar()
    {
        if (post == null) return;
        try
        {
            isChecking = true;
            grammarIssues.Clear();
            var req = new Tobiso.Web.Shared.DTOs.GrammarCheckRequest { Content = post.Content ?? string.Empty };
            var resp = await Api.CheckGrammar(req);
            if (resp?.Issues != null && resp.Issues.Count > 0)
            {
                grammarIssues = resp.Issues;
                if (markdownEditor != null)
                {
                    await markdownEditor.HighlightErrors(grammarIssues);
                }
            }
            else
            {
                grammarIssues = new List<Tobiso.Web.Shared.DTOs.GrammarIssue>();
                if (markdownEditor != null)
                {
                    await markdownEditor.ClearHighlights();
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isChecking = false;
        }
    }

    private async Task ClearGrammarHighlights()
    {
        grammarIssues.Clear();
        if (markdownEditor != null) await markdownEditor.ClearHighlights();
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            if (post == null) return;
            if (_isFixSelected)
            {
                post.LastFix = DateTime.UtcNow;
                post.LastEdit = null;
            }
            else
            {
                post.LastEdit = DateTime.UtcNow;
                post.LastFix = null;
            }
            // Update post metadata
            await Api.UpdatePost(post.Id, post);

            // Persist the edited content as a PostVersion (create or update)
            if (post.GradeId.HasValue)
            {
                var versions = (await Api.GetVersionsByPost(Id))?.ToList() ?? new List<PostVersionResponse>();
                var existing = versions.FirstOrDefault(v => v.GradeId == post.GradeId.Value);
                if (existing != null)
                {
                    existing.Content = post.Content;
                    existing.LastEdit = post.LastEdit;
                    existing.LastFix = post.LastFix;
                    await Api.UpdateVersion(existing.Id, existing);
                }
                else
                {
                    var newVersion = new PostVersionResponse
                    {
                        PostId = post.Id,
                        GradeId = post.GradeId,
                        Content = post.Content,
                        LastEdit = post.LastEdit,
                        LastFix = post.LastFix
                    };
                    await Api.CreateVersion(newVersion);
                }
            }
            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task OnGradeChanged(ChangeEventArgs args)
    {
        if (post == null) return;
        if (args?.Value == null) return;
        if (!int.TryParse(args.Value.ToString(), out var gradeId)) return;
        try
        {
            // reload version content for selected grade
            var versions = await Api.GetVersionsByPost(Id);
            var version = versions?.FirstOrDefault(v => v.GradeId == gradeId);
            if (version != null)
            {
                post.Content = version.Content;
                post.LastEdit = version.LastEdit;
                post.LastFix = version.LastFix;
                post.GradeId = version.GradeId;
                // Set the markdown editor value and clear previous highlights
                if (markdownEditor != null)
                {
                    await markdownEditor.SetValue(post.Content ?? string.Empty);
                    await markdownEditor.ClearHighlights();
                }
                // Update fix checkbox default
                _isFixSelected = post.LastFix.HasValue && (post.LastEdit == null || post.LastFix > post.LastEdit);
            }
            else
            {
                // No version for this grade yet - clear editor and set grade
                post.Content = string.Empty;
                post.LastEdit = null;
                post.LastFix = null;
                post.GradeId = gradeId;
                if (markdownEditor != null)
                {
                    await markdownEditor.SetValue(string.Empty);
                    await markdownEditor.ClearHighlights();
                }
                _isFixSelected = false;
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/");
    }

    private async Task OnDeletePost()
    {
        if (post == null) return;
        if (!await JsConfirm($"Opravdu chcete smazat post s ID {post.Id}?") ) return;
        try
        {
            await Api.DeletePost(post.Id);
            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba při mazání: {ex.Message}";
        }
    }

    [Inject]
    private IJSRuntime JS { get; set; } = default!;
    private async Task<bool> JsConfirm(string message)
    {
        return await JS.InvokeAsync<bool>("confirm", message);
    }
}
