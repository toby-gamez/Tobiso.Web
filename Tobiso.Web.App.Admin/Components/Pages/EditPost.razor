@page "/posts/edit/{Id:int}"
@using Tobiso.Web.Shared.DTOs
@using Tobiso.Web.Shared.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@using Tobiso.Web.Api.Services
@using System
@inject ITobisoWebApi Api
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IConfiguration Configuration
@inject System.Net.Http.HttpClient Http

<PageTitle>Editace článku</PageTitle>

<h3>Editace článku</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert-error">@errorMessage</div>
}
@if (!string.IsNullOrEmpty(_successMessage))
{
    <div class="success-banner">
        <span><i data-lucide="check-circle-2"></i> @_successMessage</span>
        <button type="button" class="modal-close" aria-label="Zavřít" @onclick="() => _successMessage = null"><i data-lucide="x"></i></button>
    </div>
}

@if (post == null)
{
    <p>Načítání...</p>
}
else
{
    <EditForm Model="post" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="field">
            <label for="title">Název</label>
            <InputText id="title" class="input" @bind-Value="post.Title" />
        </div>
        <div class="field">
            <label for="filePath">Soubor</label>
            <InputText id="filePath" class="input" @bind-Value="post.FilePath" />
        </div>
        <div class="field">
            <label for="category">Kategorie</label>
            <SearchableCategorySelect Categories="categories" Value="post.CategoryId" ValueChanged="id => post.CategoryId = id" />
        </div>
        <div class="field">
            <label for="grade">Ročník (verze)</label>
            @* Use Value+ValueChanged instead of @bind-Value+@onchange - Blazor's @bind-Value already
               subscribes the change event internally, so adding @onchange would fire twice and conflict.
               ValueExpression is required when splitting @bind-Value into Value+ValueChanged manually. *@
            <InputSelect id="grade" class="select" TValue="int?"
                         Value="_selectedGradeId"
                         ValueChanged="OnGradeChanged"
                         ValueExpression="@(() => _selectedGradeId)">
                <option value="">-- vyberte ročník --</option>
                @foreach (var g in grades)
                {
                    <option value="@g.Id">@g.Name</option>
                }
            </InputSelect>
        </div>
        <div class="field">
            <label for="content">Obsah</label>
            <MarkdownEditor @ref="markdownEditor" @bind-Value="_editContent" Placeholder="Začněte psát váš Markdown obsah..." Rows="15" />
            <div class="editor-toolbar-row">
                <button type="button" class="btn btn-secondary btn-sm" @onclick="CheckGrammar" disabled="@isChecking">Zkontrolovat gramatiku</button>
                <button type="button" class="btn btn-secondary btn-sm" @onclick="ClearGrammarHighlights">Vyčistit zvýraznění</button>
                <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _showLegend = true"><i data-lucide="help-circle"></i> Nápověda k formátování</button>
            </div>
            <GrammarCheckPanel Issues="grammarIssues" />
        </div>
        <fieldset class="choice-group @(_selectedGradeId.HasValue && !CanSaveVersion ? "choice-group-incomplete" : "")">
            <legend>Typ úpravy <span class="required-mark">*</span></legend>
            <div class="radio-field">
                <input type="radio" id="editTypeFix" name="editType" checked="@(_editType == "fix")" @onchange="SetEditTypeFix" />
                <label for="editTypeFix">
                    <span class="radio-title">Oprava (Fix)</span>
                    <span class="radio-desc">Malá oprava — automaticky se označí jako zkontrolováno</span>
                </label>
            </div>
            <div class="radio-field">
                <input type="radio" id="editTypeEdit" name="editType" checked="@(_editType == "edit")" @onchange="SetEditTypeEdit" />
                <label for="editTypeEdit">
                    <span class="radio-title">Velká úprava (Edit)</span>
                    <span class="radio-desc">Nový obsah nebo funkce</span>
                </label>
            </div>

            @if (_editType == "edit")
            {
                <div class="choice-subgroup">
                    <div class="choice-subgroup-label">Byl nový obsah zkontrolován? <span class="required-mark">*</span></div>
                    <div class="radio-field">
                        <input type="radio" id="checkedYes" name="isCheckedChoice" checked="@(_isCheckedChoice == true)" @onchange="SetCheckedYes" />
                        <label for="checkedYes">
                            <span class="radio-title">Ano, obsah byl zkontrolován</span>
                        </label>
                    </div>
                    <div class="radio-field">
                        <input type="radio" id="checkedNo" name="isCheckedChoice" checked="@(_isCheckedChoice == false)" @onchange="SetCheckedNo" />
                        <label for="checkedNo">
                            <span class="radio-title">Ne, ještě nebyl zkontrolován</span>
                        </label>
                    </div>
                </div>
            }

            @if (_selectedGradeId.HasValue && !CanSaveVersion)
            {
                <p class="choice-hint">
                    <i data-lucide="alert-circle"></i>
                    Vyberte typ úpravy@(_editType == "edit" ? " a zda byl obsah zkontrolován" : "") před uložením.
                </p>
            }
        </fieldset>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary" disabled="@(_selectedGradeId.HasValue && !CanSaveVersion)">Uložit změny</button>
            <button type="button" class="btn btn-secondary" @onclick="GoBack">Zpět</button>
            <button type="button" class="btn btn-danger" @onclick="OnDeletePost">Smazat</button>
            <button type="button" class="btn btn-secondary" title="Vygenerovat tahák (PDF) pomocí AI" @onclick="OpenCheatSheetModal">
                <i data-lucide="file-text"></i> Tahák
            </button>
        </div>
    </EditForm>

    <div class="panel post-section">
        <div class="panel-header">Video k článku</div>
        <div class="panel-body">
            <div class="field">
                <label>YouTube URL</label>
                <input class="input" @bind="_videoUrl" placeholder="https://www.youtube.com/watch?v=..." />
            </div>
            <div class="field">
                <label>Začít od (sekundy)</label>
                <input class="input" type="number" @bind="_videoTimestamp" min="0" />
            </div>
            <div class="field">
                <label>Popisek karty</label>
                <input class="input" @bind="_videoLabel" placeholder="Video k tématu" />
            </div>
            @if (!string.IsNullOrEmpty(_videoSaveMsg))
            {
                <div class="success-banner">@_videoSaveMsg</div>
            }
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="SaveVideoAsync">Uložit video</button>
                @if (!string.IsNullOrEmpty(_videoUrl))
                {
                    <button class="btn btn-secondary" @onclick="RemoveVideoAsync">Odebrat</button>
                }
            </div>
        </div>
    </div>

    <div class="panel post-section">
        <div class="panel-header">Verze článku</div>
        <div class="panel-body">
            @if (_versions.Count == 0)
            {
                <p class="muted">Žádné verze</p>
            }
            else
            {
                <div class="data-table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Ročník</th>
                                <th>Obsah</th>
                                <th>Poslední editace</th>
                                <th>Poslední oprava</th>
                                <th>Zkontrolováno</th>
                                <th>Akce</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in _versions.OrderBy(v => v.GradeLevel ?? 0))
                            {
                                var version = v;
                                var isActive = version.GradeId == _selectedGradeId;
                                <tr class="@(isActive ? "active-row" : "")">
                                    <td>
                                        @if (_editingGradeVersionId == version.Id)
                                        {
                                            <select class="select inline-select" @bind="_editingNewGradeId">
                                                @foreach (var g in grades)
                                                {
                                                    <option value="@g.Id">@g.Name</option>
                                                }
                                            </select>
                                            <button class="btn btn-primary btn-sm" @onclick="() => SaveVersionGrade(version.Id)">Uložit</button>
                                            <button class="btn btn-secondary btn-sm" @onclick="CancelVersionGradeEdit">Zrušit</button>
                                        }
                                        else
                                        {
                                            @version.GradeName
                                            <button class="btn btn-ghost btn-sm"
                                                    @onclick="() => StartVersionGradeEdit(version)"
                                                    title="Změnit ročník">
                                                <i data-lucide="tag"></i>
                                            </button>
                                        }
                                    </td>
                                    <td class="muted truncate-cell">@Truncate(version.Content, 80)</td>
                                    <td>@(version.LastEdit?.ToString("g") ?? "-")</td>
                                    <td>@(version.LastFix?.ToString("g") ?? "-")</td>
                                    <td>@(version.IsChecked == true ? "Ano" : version.IsChecked == false ? "Ne" : "-")</td>
                                    <td>
                                        <div class="row-actions">
                                            <button class="btn btn-ghost btn-sm"
                                                    @onclick="() => SelectVersion(version.GradeId)"
                                                    title="Upravit tuto verzi">
                                                <i data-lucide="pencil-line"></i>
                                            </button>
                                            <button class="btn btn-ghost btn-sm"
                                                    @onclick="() => DeleteVersion(version.Id)"
                                                    disabled="@(_versions.Count <= 1)"
                                                    title="@(_versions.Count <= 1 ? "Nelze smazat poslední verzi" : "Smazat tuto verzi")">
                                                <i data-lucide="trash-2"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Přidání komponenty pro správu otázek -->
    <QuestionsManager PostId="@Id" />
}

@if (_showCheatSheetModal)
{
