@page "/videos"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Text
@using Microsoft.JSInterop
@using Refit
@using Tobiso.Web.Shared.Interfaces
@inject IJSRuntime JSRuntime
@inject ILogger<VideoUpload> Logger
@inject IConfiguration Configuration
@inject HttpClient HttpClient

<PageTitle>Správa videí</PageTitle>

<div class="image-upload-page">
    <h1>Správa videí</h1>

    <div class="panel">
        <div class="panel-body">
            <label class="upload-field-label">Nahrát nové video</label>
            <div class="base-address-note">Aktuální files base: <strong>@GetBaseAddress()</strong></div>

            @if (!string.IsNullOrEmpty(currentVideoUrl))
            {
                <div class="current-image-preview">
                    <video data-src="@GetFullFileUrl(currentVideoUrl)" controls preload="metadata" style="max-height:200px;max-width:300px;"></video>
                    <div>
                        <button type="button" class="btn btn-danger btn-sm" @onclick="RemoveVideo" disabled="@isUploading">
                            <i data-lucide="trash-2"></i> Odstranit video
                        </button>
                    </div>
                </div>
            }

            <div class="upload-dropzone @(isDragOver ? "dropzone-active" : "")"
                 @ondragover="HandleDragOver"
                 @ondragover:preventDefault="true"
                 @ondragleave="HandleDragLeave"
                 @ondrop="HandleDrop"
                 @ondrop:preventDefault="true">

                @if (isUploading)
                {
                    <div class="upload-dropzone-status">
                        <i data-lucide="loader-2" class="spinner"></i>
                        <p>Nahrávám video...</p>
                    </div>
                }
                else
                {
                    <div class="upload-dropzone-status">
                        <p>
                            Přetáhněte video sem, nebo
                            <button type="button" class="upload-link-btn" @onclick="TriggerFileInput">klikněte pro výběr</button>
                        </p>
                        <span class="upload-hint">Podporované: MP4 (max 200MB)</span>
                    </div>
                }
            </div>

            <InputFile @ref="fileInput"
                       OnChange="HandleFileSelected"
                       accept="video/mp4"
                       style="display: none;" />

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert-error">@errorMessage</div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="callout-sidefact">@successMessage</div>
            }
        </div>
    </div>

    <div class="gallery-header">
        <h3>Nahraná videa</h3>
    </div>

    @if (isLoadingVideos)
    {
        <div class="gallery-loading">
            <i data-lucide="loader-2" class="spinner"></i>
            <p>Načítám seznam videí...</p>
        </div>
    }
    else if (videos?.Any() == true)
    {
        <div class="gallery-grid">
            @foreach (var video in videos)
            {
                <div class="gallery-tile">
                    <video data-src="@GetFullFileUrl(video.Url)" class="gallery-tile-thumb" controls preload="metadata"></video>
                    <div class="gallery-tile-body">
                        <div class="gallery-tile-name" aria-label="Název souboru: @video.OriginalFileName">@video.OriginalFileName</div>
                        <span class="gallery-tile-size">@(video.Size / 1024) KB</span>
                        <div class="gallery-tile-actions">
                            <button type="button" class="btn btn-primary btn-sm gallery-tile-copy-btn"
                                    title="Kopírovat URL"
                                    @onclick="() => CopyVideoUrl(GetFullFileUrl(video.Url))">
                                <i data-lucide="clipboard"></i> <span class="gallery-tile-copy-label">Kopírovat URL</span>
                            </button>
                            <button type="button" class="btn btn-danger btn-sm gallery-tile-delete-btn"
                                    title="Odstranit video"
                                    @onclick="() => DeleteVideo(video.FileName)"
                                    disabled="@isUploading">
                                <i data-lucide="trash-2"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="gallery-empty callout-sidefact">
            <i data-lucide="info"></i> Zatím nebyla nahrána žádná videa.
        </div>
    }
</div>

@code {
    private InputFile? fileInput;
    private bool isUploading = false;
    private bool isDragOver = false;
    private string? errorMessage;
    private string? successMessage;
    private string? currentVideoUrl;
    private bool isLoadingVideos = false;
    private List<Tobiso.Web.Shared.DTOs.FileUploadResponse>? videos;

    private const long MaxFileSize = 200 * 1024 * 1024; // 200MB
    private const string Category = "videos";

    protected override async Task OnInitializedAsync()
    {
        await LoadVideos();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JSRuntime.InvokeVoidAsync("initLucide");
        await JSRuntime.InvokeVoidAsync("initVideoSources");
    }

    private async Task LoadVideos()
    {
        try
        {
            isLoadingVideos = true;
            StateHasChanged();

            var filesBase = GetBaseAddress().TrimEnd('/');
            var listUrl = filesBase + $"/api/files/{Category}";
            var req = new HttpRequestMessage(HttpMethod.Get, listUrl);
            var auth = await GetAuthorizationHeaderAsync();
            if (auth != null) req.Headers.Authorization = auth;
            var resp = await HttpClient.SendAsync(req);
            resp.EnsureSuccessStatusCode();
            var content = await resp.Content.ReadAsStringAsync();
            videos = System.Text.Json.JsonSerializer.Deserialize<List<Tobiso.Web.Shared.DTOs.FileUploadResponse>>(content,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true })?.ToList() ?? new List<Tobiso.Web.Shared.DTOs.FileUploadResponse>();
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba při načítání videí: {ex.Message}";
            Logger.LogError(ex, "Error loading videos");
        }
        finally
        {
            isLoadingVideos = false;
            StateHasChanged();
        }
    }

    private async Task TriggerFileInput()
    {
        // Send a native "click" to the hidden InputFile's element via a named JS
        // function in interop-helpers.js -- never eval(), which CSP blocks.
        if (fileInput?.Element is { } element)
        {
            await JSRuntime.InvokeVoidAsync("clickElement", element);
        }
    }

    private void HandleDragOver()
    {
        isDragOver = true;
    }

    private void HandleDragLeave()
    {
        isDragOver = false;
    }

    private Task HandleDrop()
    {
        isDragOver = false;
        // Note: Drag and drop file handling requires additional JavaScript interop
        return Task.CompletedTask;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        await ProcessFile(file);
    }

    private async Task ProcessFile(IBrowserFile file)
    {
        try
        {
            ClearMessages();

            // Validate by extension: content-type sniffing for video/* is unreliable
            // across browsers/OSes, so require a literal .mp4 extension.
            var ext = Path.GetExtension(file.Name).ToLowerInvariant();
            if (ext != ".mp4")
            {
                errorMessage = $"Typ souboru '{ext}' není podporován. Je povolen pouze formát MP4.";
                return;
            }

            if (file.Size > MaxFileSize)
            {
                errorMessage = $"Velikost souboru ({file.Size / (1024 * 1024):F1}MB) překračuje maximální povolenou velikost 200MB.";
                return;
            }

            isUploading = true;
            StateHasChanged();

            using var stream = file.OpenReadStream(MaxFileSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            var filesBase = GetBaseAddress().TrimEnd('/');
            var uploadUrl = filesBase + $"/api/files/{Category}/upload";

            using var multipart = new MultipartFormDataContent();
            ms.Position = 0;
            var streamContent = new StreamContent(ms);
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("video/mp4");
            multipart.Add(streamContent, "file", file.Name);

            var req = new HttpRequestMessage(HttpMethod.Post, uploadUrl) { Content = multipart };
            var authHeader = await GetAuthorizationHeaderAsync();
            if (authHeader != null) req.Headers.Authorization = authHeader;
            var uploadResp = await HttpClient.SendAsync(req);
            uploadResp.EnsureSuccessStatusCode();
            var uploadJson = await uploadResp.Content.ReadAsStringAsync();
            var response = System.Text.Json.JsonSerializer.Deserialize<Tobiso.Web.Shared.DTOs.FileUploadResponse>(uploadJson,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });

            currentVideoUrl = response?.Url;

            successMessage = "Video bylo úspěšně nahráno!";
            Logger.LogInformation("Successfully uploaded video: {FileName}", file.Name);

            StateHasChanged();

            _ = Task.Delay(3000).ContinueWith(t =>
            {
                successMessage = null;
                InvokeAsync(StateHasChanged);
            });

            await LoadVideos();
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba při nahrávání videa: {ex.Message}";
            Logger.LogError(ex, "Error uploading video");
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }

    private async Task RemoveVideo()
    {
        if (string.IsNullOrEmpty(currentVideoUrl)) return;

        try
        {
            var fileName = currentVideoUrl?.Contains("/") == true ?
                Path.GetFileName(new Uri(currentVideoUrl).LocalPath) : currentVideoUrl;

            if (!string.IsNullOrEmpty(fileName))
            {
                var filesBase = GetBaseAddress().TrimEnd('/');
                var deleteUrl = filesBase + $"/api/files/{Category}/{Uri.EscapeDataString(fileName)}";
                var req = new HttpRequestMessage(HttpMethod.Delete, deleteUrl);
                var authH = await GetAuthorizationHeaderAsync();
                if (authH != null) req.Headers.Authorization = authH;
                var delResp = await HttpClient.SendAsync(req);
                if (!delResp.IsSuccessStatusCode)
                {
                    throw new Exception($"Delete failed: {delResp.StatusCode}");
                }
            }

            currentVideoUrl = null;

            successMessage = "Video bylo úspěšně odstraněno!";

            _ = Task.Delay(3000).ContinueWith(t =>
            {
                successMessage = null;
                InvokeAsync(StateHasChanged);
            });
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba při odstraňování videa: {ex.Message}";
            Logger.LogError(ex, "Error removing video");
        }
    }

    private async Task CopyVideoUrl(string videoUrl)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", videoUrl);
            successMessage = "URL videa byla zkopírována do schránky!";

            _ = Task.Delay(2000).ContinueWith(t =>
            {
                successMessage = null;
                InvokeAsync(StateHasChanged);
            });
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba při kopírování URL: {ex.Message}";
            Logger.LogError(ex, "Error copying video URL");
        }
    }

    private async Task DeleteVideo(string fileName)
    {
        try
        {
            ClearMessages();

            var filesBase = GetBaseAddress().TrimEnd('/');
            var deleteUrl = filesBase + $"/api/files/{Category}/{Uri.EscapeDataString(fileName)}";
            var req = new HttpRequestMessage(HttpMethod.Delete, deleteUrl);
            var authH = await GetAuthorizationHeaderAsync();
            if (authH != null) req.Headers.Authorization = authH;
            var delResp = await HttpClient.SendAsync(req);
            if (!delResp.IsSuccessStatusCode)
            {
                throw new Exception($"Delete failed: {delResp.StatusCode}");
            }

            if (currentVideoUrl?.Contains(fileName) == true)
            {
                currentVideoUrl = null;
            }

            successMessage = "Video bylo úspěšně smazáno!";

            _ = Task.Delay(3000).ContinueWith(t =>
            {
                successMessage = null;
                InvokeAsync(StateHasChanged);
            });

            await LoadVideos();
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba při mazání videa: {ex.Message}";
            Logger.LogError(ex, "Error deleting video: {FileName}", fileName);
        }
    }

    private void ClearMessages()
    {
        errorMessage = null;
        successMessage = null;
    }

    private const string FilesBaseAddress = "https://files.tobiso.com";

    private string GetFullFileUrl(string url)
    {
        if (string.IsNullOrEmpty(url))
            return string.Empty;

        if (url.StartsWith("http://") || url.StartsWith("https://"))
        {
            var uri = new Uri(url);
            if (!string.Equals(uri.Host, "files.tobiso.com", StringComparison.OrdinalIgnoreCase))
                return $"{FilesBaseAddress}{uri.PathAndQuery}";
            return url;
        }

        var relative = url.StartsWith('/') ? url : "/" + url;
        return $"{FilesBaseAddress}{relative}";
    }

    private string GetBaseAddress()
    {
        return FilesBaseAddress;
    }

    private async Task<System.Net.Http.Headers.AuthenticationHeaderValue?> GetAuthorizationHeaderAsync()
    {
        try
        {
            // Tobiso.Web.Files is a separate deployable authenticated with HTTP Basic auth
            // (BasicAuthHandler), not the admin's own JWT - so this uses a dedicated
            // Files:BasicAuth:* credential rather than the CredentialStore JWT used for
            // calls to the main Tobiso.Web.App API.
            var user = Configuration["Files:BasicAuth:Username"];
            var pass = Configuration["Files:BasicAuth:Password"];
            if (!string.IsNullOrEmpty(user) && pass != null)
            {
                var raw = System.Text.Encoding.UTF8.GetBytes($"{user}:{pass}");
                return new System.Net.Http.Headers.AuthenticationHeaderValue("Basic", Convert.ToBase64String(raw));
            }
            Logger.LogWarning("Files:BasicAuth:Username/Password is not configured");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to build auth header");
        }

        return null;
    }
}
