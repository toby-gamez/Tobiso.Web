@page "/documents"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Text
@using Microsoft.JSInterop
@using Refit
@using Tobiso.Web.Shared.Interfaces
@inject IJSRuntime JSRuntime
@inject ILogger<DocumentUpload> Logger
@inject IConfiguration Configuration
@inject HttpClient HttpClient

<PageTitle>Správa dokumentů</PageTitle>

<div class="image-upload-page">
    <h1>Správa dokumentů</h1>

    <div class="panel">
        <div class="panel-body">
            <label class="upload-field-label">Nahrát nový dokument</label>
            <div class="base-address-note">Aktuální files base: <strong>@GetBaseAddress()</strong></div>

            <div class="upload-dropzone @(isDragOver ? "dropzone-active" : "")"
                 @ondragover="HandleDragOver"
                 @ondragover:preventDefault="true"
                 @ondragleave="HandleDragLeave"
                 @ondrop="HandleDrop"
                 @ondrop:preventDefault="true">

                @if (isUploading)
                {
                    <div class="upload-dropzone-status">
                        <i data-lucide="loader-2" class="spinner"></i>
                        <p>Nahrávám dokument...</p>
                    </div>
                }
                else
                {
                    <div class="upload-dropzone-status">
                        <p>
                            Přetáhněte dokument sem, nebo
                            <button type="button" class="upload-link-btn" @onclick="TriggerFileInput">klikněte pro výběr</button>
                        </p>
                        <span class="upload-hint">Podporované: DOCX, PDF, PPTX, XLSX (max 25MB)</span>
                    </div>
                }
            </div>

            <InputFile @ref="fileInput"
                       OnChange="HandleFileSelected"
                       accept=".docx,.pdf,.pptx,.xlsx"
                       style="display: none;" />

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert-error">@errorMessage</div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="callout-sidefact">@successMessage</div>
            }
        </div>
    </div>

    <div class="gallery-header">
        <h3>Nahrané dokumenty</h3>
    </div>

    @if (isLoadingDocuments)
    {
        <div class="gallery-loading">
            <i data-lucide="loader-2" class="spinner"></i>
            <p>Načítám seznam dokumentů...</p>
        </div>
    }
    else if (documents?.Any() == true)
    {
        <div class="gallery-grid">
            @foreach (var doc in documents)
            {
                <div class="gallery-tile">
                    <div class="gallery-tile-icon">
                        <i data-lucide="@GetIconFor(doc.OriginalFileName)"></i>
                    </div>
                    <div class="gallery-tile-body">
                        <div class="gallery-tile-name" aria-label="Název souboru: @doc.OriginalFileName">@doc.OriginalFileName</div>
                        <span class="gallery-tile-size">@(doc.Size / 1024) KB</span>
                        <div class="gallery-tile-actions">
                            <button type="button" class="btn btn-primary btn-sm gallery-tile-copy-btn"
                                    title="Kopírovat URL"
                                    @onclick="() => CopyDocumentUrl(GetFullFileUrl(doc.Url))">
                                <i data-lucide="clipboard"></i> <span class="gallery-tile-copy-label">Kopírovat URL</span>
                            </button>
                            <button type="button" class="btn btn-danger btn-sm gallery-tile-delete-btn"
                                    title="Odstranit dokument"
                                    @onclick="() => DeleteDocument(doc.FileName)"
                                    disabled="@isUploading">
                                <i data-lucide="trash-2"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="gallery-empty callout-sidefact">
            <i data-lucide="info"></i> Zatím nebyly nahrány žádné dokumenty.
        </div>
    }
</div>

@code {
    private InputFile? fileInput;
    private bool isUploading = false;
    private bool isDragOver = false;
    private string? errorMessage;
    private string? successMessage;
    private bool isLoadingDocuments = false;
    private List<Tobiso.Web.Shared.DTOs.FileUploadResponse>? documents;

    private static readonly string[] AllowedExts = { ".docx", ".pdf", ".pptx", ".xlsx" };
    private const long MaxFileSize = 25 * 1024 * 1024; // 25MB
    private const string Category = "documents";

    protected override async Task OnInitializedAsync()
    {
        await LoadDocuments();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JSRuntime.InvokeVoidAsync("initLucide");
    }

    private async Task LoadDocuments()
    {
        try
        {
            isLoadingDocuments = true;
            StateHasChanged();

            var filesBase = GetBaseAddress().TrimEnd('/');
            var listUrl = filesBase + $"/api/files/{Category}";
            var req = new HttpRequestMessage(HttpMethod.Get, listUrl);
            var auth = await GetAuthorizationHeaderAsync();
            if (auth != null) req.Headers.Authorization = auth;
            var resp = await HttpClient.SendAsync(req);
            resp.EnsureSuccessStatusCode();
            var content = await resp.Content.ReadAsStringAsync();
            documents = System.Text.Json.JsonSerializer.Deserialize<List<Tobiso.Web.Shared.DTOs.FileUploadResponse>>(content,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true })?.ToList() ?? new List<Tobiso.Web.Shared.DTOs.FileUploadResponse>();
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba při načítání dokumentů: {ex.Message}";
            Logger.LogError(ex, "Error loading documents");
        }
        finally
        {
            isLoadingDocuments = false;
            StateHasChanged();
        }
    }

    private async Task TriggerFileInput()
    {
        // Send a native "click" to the hidden InputFile's element via a named JS
        // function in interop-helpers.js -- never eval(), which CSP blocks.
        if (fileInput?.Element is { } element)
        {
            await JSRuntime.InvokeVoidAsync("clickElement", element);
        }
    }

    private void HandleDragOver()
    {
        isDragOver = true;
    }

    private void HandleDragLeave()
    {
        isDragOver = false;
    }

    private Task HandleDrop()
    {
        isDragOver = false;
        // Note: Drag and drop file handling requires additional JavaScript interop
        return Task.CompletedTask;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        await ProcessFile(file);
    }

    private async Task ProcessFile(IBrowserFile file)
    {
        try
        {
            ClearMessages();

            // Validate by extension: MIME sniffing for Office/PDF documents is unreliable
            // across browsers/OSes, so match the allow-list against the file extension.
            var ext = Path.GetExtension(file.Name).ToLowerInvariant();
            if (!AllowedExts.Contains(ext))
            {
                errorMessage = $"Typ souboru '{ext}' není podporován. Jsou povoleny: {string.Join(", ", AllowedExts)}.";
                return;
            }

            if (file.Size > MaxFileSize)
            {
                errorMessage = $"Velikost souboru ({file.Size / (1024 * 1024):F1}MB) překračuje maximální povolenou velikost 25MB.";
                return;
            }

            isUploading = true;
            StateHasChanged();

            using var stream = file.OpenReadStream(MaxFileSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            var filesBase = GetBaseAddress().TrimEnd('/');
            var uploadUrl = filesBase + $"/api/files/{Category}/upload";

            using var multipart = new MultipartFormDataContent();
            ms.Position = 0;
            var streamContent = new StreamContent(ms);
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(GetContentType(ext));
            multipart.Add(streamContent, "file", file.Name);

            var req = new HttpRequestMessage(HttpMethod.Post, uploadUrl) { Content = multipart };
            var authHeader = await GetAuthorizationHeaderAsync();
            if (authHeader != null) req.Headers.Authorization = authHeader;
            var uploadResp = await HttpClient.SendAsync(req);
            uploadResp.EnsureSuccessStatusCode();

            successMessage = "Dokument byl úspěšně nahrán!";
            Logger.LogInformation("Successfully uploaded document: {FileName}", file.Name);

            StateHasChanged();

            _ = Task.Delay(3000).ContinueWith(t =>
            {
                successMessage = null;
                InvokeAsync(StateHasChanged);
            });

            await LoadDocuments();
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba při nahrávání dokumentu: {ex.Message}";
            Logger.LogError(ex, "Error uploading document");
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }

    private async Task CopyDocumentUrl(string url)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", url);
            successMessage = "URL dokumentu byla zkopírována do schránky!";

            _ = Task.Delay(2000).ContinueWith(t =>
            {
                successMessage = null;
                InvokeAsync(StateHasChanged);
            });
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba při kopírování URL: {ex.Message}";
            Logger.LogError(ex, "Error copying document URL");
        }
    }

    private async Task DeleteDocument(string fileName)
    {
        try
        {
            ClearMessages();

            var filesBase = GetBaseAddress().TrimEnd('/');
            var deleteUrl = filesBase + $"/api/files/{Category}/{Uri.EscapeDataString(fileName)}";
            var req = new HttpRequestMessage(HttpMethod.Delete, deleteUrl);
            var authH = await GetAuthorizationHeaderAsync();
            if (authH != null) req.Headers.Authorization = authH;
            var delResp = await HttpClient.SendAsync(req);
            if (!delResp.IsSuccessStatusCode)
            {
                throw new Exception($"Delete failed: {delResp.StatusCode}");
            }

            successMessage = "Dokument byl úspěšně smazán!";

            _ = Task.Delay(3000).ContinueWith(t =>
            {
                successMessage = null;
                InvokeAsync(StateHasChanged);
            });

            await LoadDocuments();
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba při mazání dokumentu: {ex.Message}";
            Logger.LogError(ex, "Error deleting document: {FileName}", fileName);
        }
    }

    private void ClearMessages()
    {
        errorMessage = null;
        successMessage = null;
    }

    private static string GetIconFor(string fileName)
    {
        var ext = Path.GetExtension(fileName).ToLowerInvariant();
        return ext switch
        {
            ".pdf" => "file-text",
            ".pptx" => "presentation",
            ".xlsx" => "file-spreadsheet",
            _ => "file"
        };
    }

    private static string GetContentType(string ext) => ext switch
    {
        ".pdf" => "application/pdf",
        ".docx" => "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        ".pptx" => "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        ".xlsx" => "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        _ => "application/octet-stream"
    };

    private const string FilesBaseAddress = "https://files.tobiso.com";

    private string GetFullFileUrl(string url)
    {
        if (string.IsNullOrEmpty(url))
            return string.Empty;

        if (url.StartsWith("http://") || url.StartsWith("https://"))
        {
            var uri = new Uri(url);
            if (!string.Equals(uri.Host, "files.tobiso.com", StringComparison.OrdinalIgnoreCase))
                return $"{FilesBaseAddress}{uri.PathAndQuery}";
            return url;
        }

        var relative = url.StartsWith('/') ? url : "/" + url;
        return $"{FilesBaseAddress}{relative}";
    }

    private string GetBaseAddress()
    {
        return FilesBaseAddress;
    }

    private async Task<System.Net.Http.Headers.AuthenticationHeaderValue?> GetAuthorizationHeaderAsync()
    {
        try
        {
            // Tobiso.Web.Files is a separate deployable authenticated with HTTP Basic auth
            // (BasicAuthHandler), not the admin's own JWT - so this uses a dedicated
            // Files:BasicAuth:* credential rather than the CredentialStore JWT used for
            // calls to the main Tobiso.Web.App API.
            var user = Configuration["Files:BasicAuth:Username"];
            var pass = Configuration["Files:BasicAuth:Password"];
            if (!string.IsNullOrEmpty(user) && pass != null)
            {
                var raw = System.Text.Encoding.UTF8.GetBytes($"{user}:{pass}");
                return new System.Net.Http.Headers.AuthenticationHeaderValue("Basic", Convert.ToBase64String(raw));
            }
            Logger.LogWarning("Files:BasicAuth:Username/Password is not configured");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to build auth header");
        }

        return null;
    }
}
