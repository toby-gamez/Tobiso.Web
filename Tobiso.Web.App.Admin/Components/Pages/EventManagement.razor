@page "/events"
@using Tobiso.Web.Shared.DTOs
@using Tobiso.Web.Shared.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@inject ITobisoWebApi Api
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Správa událostí - Admin</PageTitle>

<div class="page-header">
    <h1>Správa událostí</h1>
    <button class="btn btn-primary" @onclick="ShowCreateModal">
        <i data-lucide="plus"></i> Nová událost
    </button>
</div>

@if (events == null)
{
    <div class="loading-state">
        <i data-lucide="loader-2" class="spinner"></i>
    </div>
}
else
{
    <div class="filter-bar">
        <input type="text" class="input" @bind="searchTerm" @onkeyup="OnSearchChanged"
               placeholder="Hledat událost..." />
        <input type="date" class="input" @bind="filterStartDate" @bind:after="OnFilterChanged" />
        <input type="date" class="input" @bind="filterEndDate" @bind:after="OnFilterChanged" />
    </div>

    <div class="data-table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Název</th>
                    <th>Datum začátku</th>
                    <th>Datum konce</th>
                    <th>Typ</th>
                    <th>Místo</th>
                    <th>Akce</th>
                </tr>
            </thead>
            <tbody>
                @if (!filteredEvents.Any())
                {
                    <tr><td colspan="6" class="empty-row">Žádné události k zobrazení.</td></tr>
                }
                else
                {
                    @foreach (var eventItem in filteredEvents)
                    {
                        <tr>
                            <td>
                                <div class="event-title-cell">
                                    <div class="event-color-indicator" style="background-color: @eventItem.Color"></div>
                                    @eventItem.Title
                                </div>
                            </td>
                            <td>@eventItem.StartDate.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@(eventItem.EndDate?.ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                            <td>
                                @if (eventItem.IsAllDay)
                                {
                                    <span class="badge badge-info">Celodenní</span>
                                }
                                else
                                {
                                    <span class="badge">Časová</span>
                                }
                                @if (eventItem.IsRecurring)
                                {
                                    <span class="badge badge-warning">Opakující se</span>
                                }
                            </td>
                            <td>@(eventItem.Location ?? "-")</td>
                            <td>
                                <div class="row-actions">
                                    <button class="btn btn-ghost btn-sm" @onclick="() => ShowEditModal(eventItem)">
                                        <i data-lucide="pencil-line"></i>
                                    </button>
                                    <button class="btn btn-ghost btn-sm" @onclick="() => DeleteEvent(eventItem.Id)">
                                        <i data-lucide="trash-2"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@* Modal pro vytvoření/editaci události *@
@if (showModal)
{
    <div class="modal-backdrop" @onclick="CloseModal">
        <div class="modal-panel modal-panel--lg" @onclick:stopPropagation>
            <div class="modal-header">
                <h3>@(isEditing ? "Upravit událost" : "Nová událost")</h3>
                <button type="button" class="modal-close" aria-label="Zavřít" @onclick="CloseModal"><i data-lucide="x"></i></button>
            </div>
            <div class="modal-body">
                <EditForm Model="eventModel" OnValidSubmit="SaveEvent">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="form-grid-2">
                        <div class="field">
                            <label>Název události *</label>
                            <InputText class="input" @bind-Value="eventModel.Title" />
                            <ValidationMessage For="@(() => eventModel.Title)" />
                        </div>
                        <div class="field">
                            <label>Barva</label>
                            <InputText type="color" class="input" @bind-Value="eventModel.Color" />
                        </div>
                    </div>

                    <div class="field">
                        <label>Popis</label>
                        <InputTextArea class="textarea" rows="3" @bind-Value="eventModel.Description" />
                    </div>

                    <div class="form-grid-3">
                        <div class="field">
                            <label>Datum začátku *</label>
                            <InputDate class="input" @bind-Value="startDate" />
                        </div>
                        <div class="field">
                            <label>Čas začátku</label>
                            <InputText type="time" class="input" @bind-Value="startTime" disabled="@eventModel.IsAllDay" />
                        </div>
                        <div class="checkbox-field">
                            <InputCheckbox @bind-Value="eventModel.IsAllDay" />
                            <label>Celodenní událost</label>
                        </div>
                    </div>

                    @if (!eventModel.IsAllDay)
                    {
                        <div class="form-grid-2-even">
                            <div class="field">
                                <label>Datum konce</label>
                                <InputDate class="input" @bind-Value="endDate" />
                            </div>
                            <div class="field">
                                <label>Čas konce</label>
                                <InputText type="time" class="input" @bind-Value="endTime" />
                            </div>
                        </div>
                    }

                    <div class="field">
                        <label>Místo</label>
                        <InputText class="input" @bind-Value="eventModel.Location" />
                    </div>

                    <div class="checkbox-field">
                        <InputCheckbox @bind-Value="eventModel.IsRecurring" />
                        <label>Opakující se událost</label>
                    </div>

                    @if (eventModel.IsRecurring)
                    {
                        <div class="form-grid-2-even">
                            <div class="field">
                                <label>Vzor opakování</label>
                                <InputSelect class="select" @bind-Value="eventModel.RecurrencePattern">
                                    <option value="">Vyberte vzor</option>
                                    <option value="daily">Denně</option>
                                    <option value="weekly">Týdně</option>
                                    <option value="monthly">Měsíčně</option>
                                    <option value="yearly">Ročně</option>
                                </InputSelect>
                            </div>
                            <div class="field">
                                <label>Konec opakování</label>
                                <InputDate class="input" @bind-Value="recurrenceEndDate" />
                            </div>
                        </div>
                    }

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Zrušit</button>
                        <button type="submit" class="btn btn-primary">@(isEditing ? "Uložit změny" : "Vytvořit událost")</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private List<EventResponse>? events;
    private List<EventResponse> filteredEvents = new();
    private string searchTerm = "";
    private DateTime? filterStartDate;
    private DateTime? filterEndDate;

    private bool showModal = false;
    private bool isEditing = false;
    private EventModel eventModel = new();

    // Pomocné properties pro formulář
    private DateTime startDate = DateTime.Today;
    private string startTime = "";
    private DateTime? endDate;
    private string endTime = "";
    private DateTime? recurrenceEndDate;

    protected override async Task OnInitializedAsync()
    {
        // Check if user is authenticated
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadEvents();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JSRuntime.InvokeVoidAsync("initLucide");
    }

    private async Task LoadEvents()
    {
        try
        {
            events = (await Api.GetAllEvents()).ToList();
            FilterEvents();
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Chyba při načítání událostí: {ex.Message}");
        }
    }

    private void FilterEvents()
    {
        if (events == null) return;

        filteredEvents = events.Where(e =>
            (string.IsNullOrWhiteSpace(searchTerm) ||
             e.Title.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
             (e.Description?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)) &&
            (!filterStartDate.HasValue || e.StartDate.Date >= filterStartDate.Value.Date) &&
            (!filterEndDate.HasValue || e.StartDate.Date <= filterEndDate.Value.Date)
        ).OrderBy(e => e.StartDate).ToList();
    }

    private void OnSearchChanged()
    {
        FilterEvents();
        StateHasChanged();
    }

    private void OnFilterChanged()
    {
        FilterEvents();
        StateHasChanged();
    }

    private void ShowCreateModal()
    {
        isEditing = false;
        eventModel = new EventModel();
        startDate = DateTime.Today;
        startTime = "";
        endDate = null;
        endTime = "";
        recurrenceEndDate = null;
        showModal = true;
    }

    private void ShowEditModal(EventResponse eventResponse)
    {
        isEditing = true;
        eventModel = new EventModel
        {
            Id = eventResponse.Id,
            Title = eventResponse.Title,
            Description = eventResponse.Description,
            IsAllDay = eventResponse.IsAllDay,
            Location = eventResponse.Location,
            Color = eventResponse.Color,
            IsRecurring = eventResponse.IsRecurring,
            RecurrencePattern = eventResponse.RecurrencePattern
        };

        startDate = eventResponse.StartDate.Date;
        startTime = eventResponse.IsAllDay ? "" : eventResponse.StartDate.ToString("HH:mm");
        endDate = eventResponse.EndDate?.Date;
        endTime = eventResponse.EndDate?.ToString("HH:mm") ?? "";
        recurrenceEndDate = eventResponse.RecurrenceEndDate?.Date;

        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        eventModel = new EventModel();
    }

    private async Task SaveEvent()
    {
        try
        {
            // Sestavení DateTime hodnot
            var startDateTime = startDate;
            if (!eventModel.IsAllDay && !string.IsNullOrWhiteSpace(startTime))
            {
                if (TimeSpan.TryParse(startTime, out var time))
                {
                    startDateTime = startDate.Add(time);
                }
            }

            DateTime? endDateTime = null;
            if (!eventModel.IsAllDay && endDate.HasValue)
            {
                endDateTime = endDate.Value;
                if (!string.IsNullOrWhiteSpace(endTime) && TimeSpan.TryParse(endTime, out var endTimeSpan))
                {
                    endDateTime = endDate.Value.Add(endTimeSpan);
                }
            }

            if (isEditing)
            {
                var updateRequest = new UpdateEventRequest
                {
                    Title = eventModel.Title,
                    Description = eventModel.Description,
                    StartDate = startDateTime,
                    EndDate = endDateTime,
                    IsAllDay = eventModel.IsAllDay,
                    Location = eventModel.Location,
                    Color = eventModel.Color,
                    IsRecurring = eventModel.IsRecurring,
                    RecurrencePattern = eventModel.RecurrencePattern,
                    RecurrenceEndDate = recurrenceEndDate
                };

                await Api.UpdateEvent(eventModel.Id, updateRequest);
                await JSRuntime.InvokeVoidAsync("alert", "Událost byla úspěšně upravena.");
            }
            else
            {
                var createRequest = new CreateEventRequest
                {
                    Title = eventModel.Title,
                    Description = eventModel.Description,
                    StartDate = startDateTime,
                    EndDate = endDateTime,
                    IsAllDay = eventModel.IsAllDay,
                    Location = eventModel.Location,
                    Color = eventModel.Color,
                    IsRecurring = eventModel.IsRecurring,
                    RecurrencePattern = eventModel.RecurrencePattern,
                    RecurrenceEndDate = recurrenceEndDate
                };

                await Api.CreateEvent(createRequest);
                await JSRuntime.InvokeVoidAsync("alert", "Událost byla úspěšně vytvořena.");
            }

            CloseModal();
            await LoadEvents();
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Chyba při ukládání události: {ex.Message}");
        }
    }

    private async Task DeleteEvent(int eventId)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Opravdu chcete smazat tuto událost?"))
        {
            try
            {
                await Api.DeleteEvent(eventId);
                await JSRuntime.InvokeVoidAsync("alert", "Událost byla úspěšně smazána.");
                await LoadEvents();
            }
            catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                Navigation.NavigateTo("/login");
            }
            catch (Exception ex)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Chyba při mazání události: {ex.Message}");
            }
        }
    }

    private class EventModel
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
        public string? Description { get; set; }
        public bool IsAllDay { get; set; }
        public string? Location { get; set; }
        public string Color { get; set; } = "#007bff";
        public bool IsRecurring { get; set; }
        public string? RecurrencePattern { get; set; }
    }
}
