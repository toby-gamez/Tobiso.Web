@page "/events"
@using Tobiso.Web.Shared.DTOs
@using Tobiso.Web.Api.Services
@using Tobiso.Web.Domain.Entities
@using Microsoft.AspNetCore.Components.Authorization
@* Talks to the services directly (like Users.razor): the public /api/events read only returns
   global events, but the admin has to see and edit the ones students add too. *@
@inject IEventService EventService
@inject IClassService ClassService
@inject ITimetableService TimetableService
@inject ICategoryService CategoryService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Správa událostí - Admin</PageTitle>

<div class="page-header">
    <h1>Správa událostí</h1>
    <button class="btn btn-primary" @onclick="ShowCreateModal">
        <i data-lucide="plus"></i> Nová událost
    </button>
</div>

@if (events == null)
{
    <div class="loading-state">
        <i data-lucide="loader-2" class="spinner"></i>
    </div>
}
else
{
    <div class="filter-bar">
        <input type="text" class="input" @bind="searchTerm" @onkeyup="OnSearchChanged"
               placeholder="Hledat událost..." />
        <input type="date" class="input" @bind="filterStartDate" @bind:after="OnFilterChanged" />
        <input type="date" class="input" @bind="filterEndDate" @bind:after="OnFilterChanged" />
        <select class="select" @bind="filterSource" @bind:after="OnFilterChanged">
            <option value="">Všechny události</option>
            <option value="admin">Přidané adminem</option>
            <option value="student">Přidané žáky</option>
        </select>
        <select class="select" @bind="filterClassId" @bind:after="OnFilterChanged">
            <option value="0">Všechny třídy</option>
            @foreach (var c in classes)
            {
                <option value="@c.Id">@c.Name</option>
            }
        </select>
    </div>

    <div class="ev-chips">
        <button type="button" class="ev-chip @(filterType == null ? "ev-chip-on" : "")" @onclick="() => SetTypeFilter(null)">
            Vše <span class="ev-chip-count">@typeCounts.Values.Sum()</span>
        </button>
        @foreach (var t in new[] { EventType.Test, EventType.Homework, EventType.DayOff, EventType.Other })
        {
            <button type="button" class="ev-chip @(filterType == t ? "ev-chip-on" : "")" @onclick="() => SetTypeFilter(t)">
                <span class="ev-dot" style="background:@Tobiso.Web.Domain.Entities.Event.DefaultColor(t)"></span>
                @TypeLabel(t) <span class="ev-chip-count">@(typeCounts.GetValueOrDefault(t))</span>
            </button>
        }
        <button type="button" class="ev-chip ev-chip-end @(onlyUpcoming ? "ev-chip-on" : "")" @onclick="ToggleUpcoming">
            <i data-lucide="calendar-clock"></i> Dnes a budoucí
        </button>
    </div>

    @if (!filteredEvents.Any())
    {
        <div class="ev-empty">Žádné události k zobrazení.</div>
    }
    else
    {
        @foreach (var month in filteredEvents.GroupBy(e => new DateTime(e.StartDate.Year, e.StartDate.Month, 1)))
        {
            <div class="ev-month">@month.Key.ToString("MMMM yyyy", Cs)</div>
            <div class="ev-list">
                @foreach (var eventItem in month)
                {
                    var past = (eventItem.EndDate ?? eventItem.StartDate).Date < DateTime.Today;
                    <div class="ev-row @(past ? "ev-past" : "")">
                        <span class="ev-date" style="background:color-mix(in srgb, @eventItem.Color 22%, var(--color-surface)); color:color-mix(in srgb, @eventItem.Color 70%, black)">
                            <span class="ev-date-day">@eventItem.StartDate.Day</span>
                            <span class="ev-date-dow">@eventItem.StartDate.ToString("ddd", Cs)</span>
                        </span>
                        <div class="ev-main">
                            <div class="ev-title">
                                @eventItem.Title
                                <span class="badge">@TypeLabel(eventItem.Type)</span>
                                @if (eventItem.IsRecurring)
                                {
                                    <i data-lucide="repeat" class="ev-icon" title="Opakující se"></i>
                                }
                                @if (eventItem.CreatedByUserId != null)
                                {
                                    <span class="badge badge-warning">Žák</span>
                                }
                            </div>
                            <div class="ev-meta">
                                <span>@FormatWhen(eventItem)</span>
                                <span>·</span>
                                <span>@ScopeLabel(eventItem)</span>
                                @if (eventItem.CreatedByUserId != null)
                                {
                                    <span>·</span>
                                    <span>@eventItem.CreatedByName</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(eventItem.Location))
                                {
                                    <span>·</span>
                                    <span>@eventItem.Location</span>
                                }
                            </div>
                        </div>
                        <div class="row-actions">
                            <button class="btn btn-ghost btn-sm" aria-label="Upravit" @onclick="() => ShowEditModal(eventItem)">
                                <i data-lucide="pencil-line"></i>
                            </button>
                            <button class="btn btn-ghost btn-sm" aria-label="Smazat" @onclick="() => DeleteEvent(eventItem.Id)">
                                <i data-lucide="trash-2"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    }
}

@* Modal pro vytvoření/editaci události *@
@if (showModal)
{
    <div class="modal-backdrop" @onclick="CloseModal">
        <div class="modal-panel modal-panel--lg" @onclick:stopPropagation>
            <div class="modal-header">
                <h3>@(isEditing ? "Upravit událost" : "Nová událost")</h3>
                <button type="button" class="modal-close" aria-label="Zavřít" @onclick="CloseModal"><i data-lucide="x"></i></button>
            </div>
            <div class="modal-body">
                <EditForm Model="eventModel" OnValidSubmit="SaveEvent">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="form-grid-2">
                        <div class="field">
                            <label>Název události *</label>
                            <InputText class="input" @bind-Value="eventModel.Title" />
                            <ValidationMessage For="@(() => eventModel.Title)" />
                        </div>
                        <div class="field">
                            <label>Barva</label>
                            <div class="checkbox-field">
                                <InputCheckbox id="event-custom-color" @bind-Value="eventModel.UseCustomColor" @bind-Value:after="OnCustomColorToggled" />
                                <label for="event-custom-color">Vlastní barva</label>
                            </div>
                            @if (eventModel.UseCustomColor)
                            {
                                <InputText type="color" class="input" @bind-Value="eventModel.Color" />
                            }
                            else
                            {
                                <div class="event-title-cell">
                                    <div class="event-color-indicator" style="background-color: @(Tobiso.Web.Domain.Entities.Event.DefaultColor(eventModel.Type))"></div>
                                    Podle typu
                                </div>
                            }
                        </div>
                    </div>

                    <div class="form-grid-3">
                        <div class="field">
                            <label>Typ</label>
                            <InputSelect class="select" @bind-Value="eventModel.Type">
                                <option value="@EventType.DayOff">Volno (nejde se do školy)</option>
                                <option value="@EventType.Test">Test</option>
                                <option value="@EventType.Homework">Úkol</option>
                                <option value="@EventType.Other">Jiné</option>
                            </InputSelect>
                        </div>
                        <div class="field">
                            <label>Pro koho</label>
                            <InputSelect class="select" @bind-Value="eventModel.Scope">
                                <option value="@EventScope.Global">Všichni</option>
                                <option value="@EventScope.Class">Třída</option>
                                <option value="@EventScope.Group">Skupina</option>
                                @if (eventModel.CreatedByUserId != null)
                                {
                                    <option value="@EventScope.Personal">Jen autor (osobní)</option>
                                }
                            </InputSelect>
                        </div>
                        @if (eventModel.Scope == EventScope.Class)
                        {
                            <div class="field">
                                <label>Třída</label>
                                <InputSelect class="select" @bind-Value="eventModel.ClassId">
                                    <option value="">Všechny třídy</option>
                                    @foreach (var c in classes)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                </InputSelect>
                            </div>
                        }
                        else if (eventModel.Scope == EventScope.Group)
                        {
                            <div class="field">
                                <label>Skupina</label>
                                <InputSelect class="select" @bind-Value="eventModel.GroupId">
                                    <option value="">Vyberte skupinu</option>
                                    @foreach (var c in classes)
                                    {
                                        @foreach (var g in c.Groups)
                                        {
                                            <option value="@g.Id">@c.Name – @g.Name</option>
                                        }
                                    }
                                </InputSelect>
                            </div>
                        }
                    </div>

                    @if (eventModel.CreatedByUserId != null)
                    {
                        <p class="event-author-note">Přidal/a žák: <strong>@eventModel.CreatedByName</strong></p>
                    }

                    @if (eventModel.Type == EventType.Test)
                    {
                        <div class="field">
                            <label>Témata</label>
                            <div class="form-grid-2-even">
                                <PostSearchComponent @key="@PostPickerKey" Placeholder="Přidat článek..." SelectedPostChanged="AddPostTheme" />
                                <SearchableCategorySelect @key="@CategoryPickerKey" Categories="categories" ValueChanged="AddCategoryTheme" />
                            </div>
                            @if (eventModel.Themes.Count > 0)
                            {
                                <div class="calendar-tags">
                                    @foreach (var t in eventModel.Themes)
                                    {
                                        <span class="badge">
                                            <i data-lucide="@(t.PostId != null ? "file-text" : "folder")"></i> @t.Name
                                            <button type="button" class="btn btn-ghost btn-sm" aria-label="Odebrat" @onclick="() => eventModel.Themes.Remove(t)"><i data-lucide="x"></i></button>
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <div class="field">
                        <label>Popis</label>
                        <InputTextArea class="textarea" rows="3" @bind-Value="eventModel.Description" />
                    </div>

                    @if (eventModel.Type is EventType.Test or EventType.Homework)
                    {
                        <div class="field">
                            <label>Vybrat z rozvrhu</label>
                            <div class="form-grid-3">
                                <InputText class="input" @bind-Value="timetableSubject" placeholder="Předmět, např. MAT" @onkeydown="OnTimetableKey" />
                                <InputSelect class="select" @bind-Value="timetableWeek">
                                    <option value="@TimetableWeek.Actual">Tento týden</option>
                                    <option value="@TimetableWeek.Next">Příští týden</option>
                                </InputSelect>
                                <InputText class="input" @bind-Value="timetableClass" placeholder="Třída" />
                            </div>
                            <button type="button" class="btn btn-ghost btn-sm" @onclick="SearchTimetable" disabled="@timetableLoading">
                                <i data-lucide="search"></i> @(timetableLoading ? "Načítám..." : "Najít hodiny")
                            </button>
                            @if (timetableError != null)
                            {
                                <p class="event-author-note">@timetableError</p>
                            }
                            else if (timetableLessons != null && timetableLessons.Count == 0)
                            {
                                <p class="event-author-note">Žádná hodina nenalezena.</p>
                            }
                            @if (timetableLessons is { Count: > 0 })
                            {
                                <div class="calendar-tags">
                                    @foreach (var l in timetableLessons)
                                    {
                                        <button type="button" class="badge" @onclick="() => PickLesson(l)">
                                            @LessonLabel(l)
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <div class="form-grid-3">
                        <div class="field">
                            <label>Datum začátku *</label>
                            <InputDate class="input" @bind-Value="startDate" />
                        </div>
                        <div class="field">
                            <label>Čas začátku</label>
                            <InputText type="time" class="input" @bind-Value="startTime" disabled="@eventModel.IsAllDay" />
                        </div>
                        <div class="checkbox-field">
                            <InputCheckbox @bind-Value="eventModel.IsAllDay" />
                            <label>Celodenní událost</label>
                        </div>
                    </div>

                    @if (!eventModel.IsAllDay)
                    {
                        <div class="form-grid-2-even">
                            <div class="field">
                                <label>Datum konce</label>
                                <InputDate class="input" @bind-Value="endDate" />
                            </div>
                            <div class="field">
                                <label>Čas konce</label>
                                <InputText type="time" class="input" @bind-Value="endTime" />
                            </div>
                        </div>
                    }

                    <div class="field">
                        <label>Místo</label>
                        <InputText class="input" @bind-Value="eventModel.Location" />
                    </div>

                    <div class="checkbox-field">
                        <InputCheckbox @bind-Value="eventModel.IsRecurring" />
                        <label>Opakující se událost</label>
                    </div>

                    @if (eventModel.IsRecurring)
                    {
                        <div class="form-grid-2-even">
                            <div class="field">
                                <label>Vzor opakování</label>
                                <InputSelect class="select" @bind-Value="eventModel.RecurrencePattern">
                                    <option value="">Vyberte vzor</option>
                                    <option value="daily">Denně</option>
                                    <option value="weekly">Týdně</option>
                                    <option value="monthly">Měsíčně</option>
                                    <option value="yearly">Ročně</option>
                                </InputSelect>
                            </div>
                            <div class="field">
                                <label>Konec opakování</label>
                                <InputDate class="input" @bind-Value="recurrenceEndDate" />
                            </div>
                        </div>
                    }

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Zrušit</button>
                        <button type="submit" class="btn btn-primary">@(isEditing ? "Uložit změny" : "Vytvořit událost")</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private List<EventResponse>? events;
    private List<EventResponse> filteredEvents = new();
    private List<SchoolClassDto> classes = new();
    private List<CategoryResponse> categories = new();
    private int themePickerKey;
    private string PostPickerKey => $"post-{themePickerKey}";
    private string CategoryPickerKey => $"cat-{themePickerKey}";
    private string searchTerm = "";
    private DateTime? filterStartDate;
    private DateTime? filterEndDate;
    private string filterSource = "";
    private int filterClassId;
    private EventType? filterType;
    private bool onlyUpcoming = true;
    private Dictionary<EventType, int> typeCounts = new();

    private bool showModal = false;
    private bool isEditing = false;
    private EventModel eventModel = new();

    // Pomocné properties pro formulář
    private DateTime startDate = DateTime.Today;
    private string startTime = "";
    private DateTime? endDate;
    private string endTime = "";
    private DateTime? recurrenceEndDate;

    // Výběr z rozvrhu (Bakaláři)
    private static readonly System.Globalization.CultureInfo Cs = new("cs-CZ");
    private string timetableClass = "3B";
    private string timetableSubject = "";
    private TimetableWeek timetableWeek = TimetableWeek.Actual;
    private List<TimetableLesson>? timetableLessons;
    private string? timetableError;
    private bool timetableLoading;

    private static string LessonLabel(TimetableLesson l) =>
        $"{l.Start.ToString("ddd d. M.", Cs)} {l.Start:HH:mm} · {l.SubjectAbbrev}" +
        (l.Group != null ? $" ({l.Group})" : "") + (l.Room != null ? $" · {l.Room}" : "");

    private async Task OnTimetableKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SearchTimetable();
    }

    private async Task SearchTimetable()
    {
        timetableLoading = true;
        timetableError = null;
        try
        {
            timetableLessons = await TimetableService.FindLessonsAsync(timetableClass, timetableWeek, timetableSubject);
        }
        catch (InvalidOperationException ex)
        {
            timetableLessons = null;
            timetableError = ex.Message;
        }
        finally
        {
            timetableLoading = false;
        }
    }

    private void PickLesson(TimetableLesson lesson)
    {
        eventModel.IsAllDay = false;
        startDate = lesson.Start.Date;
        startTime = lesson.Start.ToString("HH:mm");
        endDate = lesson.End.Date;
        endTime = lesson.End.ToString("HH:mm");
        if (string.IsNullOrWhiteSpace(eventModel.Title))
            eventModel.Title = $"{lesson.SubjectName} – {(eventModel.Type == EventType.Test ? "test" : "úkol")}";
    }

    protected override async Task OnInitializedAsync()
    {
        // Check if user is authenticated
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadEvents();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JSRuntime.InvokeVoidAsync("initLucide");
    }

    private async Task LoadEvents()
    {
        try
        {
            classes = await ClassService.GetAllAsync();
            categories = await CategoryService.GetAll();
            events = await EventService.GetAllForAdmin();
            FilterEvents();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Chyba při načítání událostí: {ex.Message}");
        }
    }

    private void FilterEvents()
    {
        if (events == null) return;

        var matching = events.Where(e =>
            (string.IsNullOrWhiteSpace(searchTerm) ||
             e.Title.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
             (e.Description?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)) &&
            (!filterStartDate.HasValue || e.StartDate.Date >= filterStartDate.Value.Date) &&
            (!filterEndDate.HasValue || e.StartDate.Date <= filterEndDate.Value.Date) &&
            (filterSource == "" || (filterSource == "student") == (e.CreatedByUserId != null)) &&
            (filterClassId == 0 || e.ClassId == filterClassId) &&
            (!onlyUpcoming || (e.EndDate ?? e.StartDate).Date >= DateTime.Today)
        ).ToList();

        typeCounts = matching.GroupBy(e => e.Type).ToDictionary(g => g.Key, g => g.Count());
        filteredEvents = matching.Where(e => filterType == null || e.Type == filterType)
            .OrderBy(e => e.StartDate).ToList();
    }

    private void ToggleUpcoming()
    {
        onlyUpcoming = !onlyUpcoming;
        FilterEvents();
    }

    private void SetTypeFilter(EventType? type)
    {
        filterType = type;
        FilterEvents();
    }

    private static string FormatWhen(EventResponse e)
    {
        if (e.IsAllDay) return e.EndDate is { } end && end.Date != e.StartDate.Date
            ? $"{e.StartDate:d. M.} – {end:d. M.}" : "Celý den";
        var s = e.StartDate.ToString("HH:mm");
        if (e.EndDate is not { } en) return s == "00:00" ? "Celý den" : s;
        return en.Date == e.StartDate.Date ? $"{s} – {en:HH:mm}" : $"{e.StartDate:d. M. HH:mm} – {en:d. M. HH:mm}";
    }

    private void OnSearchChanged()
    {
        FilterEvents();
        StateHasChanged();
    }

    private void OnFilterChanged()
    {
        FilterEvents();
        StateHasChanged();
    }

    private void ShowCreateModal()
    {
        isEditing = false;
        eventModel = new EventModel();
        startDate = DateTime.Today;
        startTime = "";
        endDate = null;
        endTime = "";
        recurrenceEndDate = null;
        showModal = true;
    }

    private void ShowEditModal(EventResponse eventResponse)
    {
        isEditing = true;
        eventModel = new EventModel
        {
            Id = eventResponse.Id,
            Title = eventResponse.Title,
            Description = eventResponse.Description,
            IsAllDay = eventResponse.IsAllDay,
            Location = eventResponse.Location,
            Color = eventResponse.CustomColor ?? eventResponse.Color,
            UseCustomColor = eventResponse.CustomColor != null,
            IsRecurring = eventResponse.IsRecurring,
            RecurrencePattern = eventResponse.RecurrencePattern,
            Type = eventResponse.Type,
            Scope = eventResponse.Scope,
            ClassId = eventResponse.ClassId,
            GroupId = eventResponse.GroupId,
            CreatedByUserId = eventResponse.CreatedByUserId,
            CreatedByName = eventResponse.CreatedByName,
            Themes = eventResponse.Themes.Select(t => new EventThemeDto { PostId = t.PostId, CategoryId = t.CategoryId, Name = t.Name }).ToList()
        };

        startDate = eventResponse.StartDate.Date;
        startTime = eventResponse.IsAllDay ? "" : eventResponse.StartDate.ToString("HH:mm");
        endDate = eventResponse.EndDate?.Date;
        endTime = eventResponse.EndDate?.ToString("HH:mm") ?? "";
        recurrenceEndDate = eventResponse.RecurrenceEndDate?.Date;

        showModal = true;
    }

    // Turning the own color on starts the picker from the type's color, not from a stale blue.
    private void OnCustomColorToggled()
    {
        if (eventModel.UseCustomColor)
            eventModel.Color = Tobiso.Web.Domain.Entities.Event.DefaultColor(eventModel.Type);
    }

    private void AddPostTheme(PostLinkResponse? post)
    {
        if (post == null) return;
        if (!eventModel.Themes.Any(t => t.PostId == post.Id))
            eventModel.Themes.Add(new EventThemeDto { PostId = post.Id, Name = post.Title });
        themePickerKey++;
    }

    private void AddCategoryTheme(int? categoryId)
    {
        if (categoryId == null) return;
        if (!eventModel.Themes.Any(t => t.CategoryId == categoryId))
            eventModel.Themes.Add(new EventThemeDto { CategoryId = categoryId, Name = categories.FirstOrDefault(c => c.Id == categoryId)?.Name ?? "" });
        themePickerKey++;
    }

    private void CloseModal()
    {
        showModal = false;
        eventModel = new EventModel();
    }

    private async Task SaveEvent()
    {
        try
        {
            // Sestavení DateTime hodnot
            var startDateTime = startDate;
            if (!eventModel.IsAllDay && !string.IsNullOrWhiteSpace(startTime))
            {
                if (TimeSpan.TryParse(startTime, out var time))
                {
                    startDateTime = startDate.Add(time);
                }
            }

            DateTime? endDateTime = null;
            if (!eventModel.IsAllDay && endDate.HasValue)
            {
                endDateTime = endDate.Value;
                if (!string.IsNullOrWhiteSpace(endTime) && TimeSpan.TryParse(endTime, out var endTimeSpan))
                {
                    endDateTime = endDate.Value.Add(endTimeSpan);
                }
            }

            if (isEditing)
            {
                var updateRequest = new UpdateEventRequest
                {
                    Title = eventModel.Title,
                    Description = eventModel.Description,
                    StartDate = startDateTime,
                    EndDate = endDateTime,
                    IsAllDay = eventModel.IsAllDay,
                    Location = eventModel.Location,
                    Color = eventModel.UseCustomColor ? eventModel.Color : null,
                    IsRecurring = eventModel.IsRecurring,
                    RecurrencePattern = eventModel.RecurrencePattern,
                    RecurrenceEndDate = recurrenceEndDate,
                    Type = eventModel.Type,
                    Scope = eventModel.Scope,
                    ClassId = eventModel.ClassId,
                    GroupId = eventModel.GroupId,
                    Themes = eventModel.Themes
                };

                if (!await EventService.Update(eventModel.Id, updateRequest))
                {
                    await JSRuntime.InvokeVoidAsync("alert", "Událost se nepodařilo upravit - zkontrolujte třídu/skupinu.");
                    return;
                }
                await JSRuntime.InvokeVoidAsync("alert", "Událost byla úspěšně upravena.");
            }
            else
            {
                var createRequest = new CreateEventRequest
                {
                    Title = eventModel.Title,
                    Description = eventModel.Description,
                    StartDate = startDateTime,
                    EndDate = endDateTime,
                    IsAllDay = eventModel.IsAllDay,
                    Location = eventModel.Location,
                    Color = eventModel.UseCustomColor ? eventModel.Color : null,
                    IsRecurring = eventModel.IsRecurring,
                    RecurrencePattern = eventModel.RecurrencePattern,
                    RecurrenceEndDate = recurrenceEndDate,
                    Type = eventModel.Type,
                    Scope = eventModel.Scope,
                    ClassId = eventModel.ClassId,
                    GroupId = eventModel.GroupId,
                    Themes = eventModel.Themes
                };

                if (await EventService.Create(createRequest) == null)
                {
                    await JSRuntime.InvokeVoidAsync("alert", "Událost se nepodařilo vytvořit - zkontrolujte třídu/skupinu.");
                    return;
                }
                await JSRuntime.InvokeVoidAsync("alert", "Událost byla úspěšně vytvořena.");
            }

            CloseModal();
            await LoadEvents();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Chyba při ukládání události: {ex.Message}");
        }
    }

    private async Task DeleteEvent(int eventId)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Opravdu chcete smazat tuto událost?"))
        {
            try
            {
                await EventService.Delete(eventId);
                await JSRuntime.InvokeVoidAsync("alert", "Událost byla úspěšně smazána.");
                await LoadEvents();
            }
            catch (Exception ex)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Chyba při mazání události: {ex.Message}");
            }
        }
    }

    private class EventModel
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
        public string? Description { get; set; }
        public bool IsAllDay { get; set; }
        public string? Location { get; set; }
        // Unchecked = the event follows its type's color; Color is then ignored.
        public bool UseCustomColor { get; set; }
        public string Color { get; set; } = "#007bff";
        public bool IsRecurring { get; set; }
        public string? RecurrencePattern { get; set; }
        public EventType Type { get; set; } = EventType.DayOff;
        public EventScope Scope { get; set; } = EventScope.Global;
        public int? ClassId { get; set; }
        public int? GroupId { get; set; }
        public int? CreatedByUserId { get; set; }
        public string? CreatedByName { get; set; }
        public List<EventThemeDto> Themes { get; set; } = [];
    }

    private static string TypeLabel(EventType type) => type switch
    {
        EventType.Test => "Test",
        EventType.Homework => "Úkol",
        EventType.Other => "Jiné",
        _ => "Volno"
    };

    private static string ScopeLabel(EventResponse e) => e.Scope switch
    {
        EventScope.Class => e.ClassName == null ? "Všechny třídy" : $"Třída {e.ClassName}",
        EventScope.Group => $"Skupina {e.ClassName} – {e.GroupName}",
        EventScope.Personal => "Jen autor",
        _ => "Všichni"
    };
}
