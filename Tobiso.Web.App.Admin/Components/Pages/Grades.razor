@page "/grades"
@using Tobiso.Web.Shared.DTOs
@using Tobiso.Web.Shared.Interfaces
@using Refit
@inject ITobisoWebApi Api
@inject IJSRuntime JS

<PageTitle>Grades</PageTitle>

<h1>Grades / Versions</h1>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert-error">@errorMessage</div>
}

<div class="toolbar-row">
    <button class="btn btn-secondary btn-sm" @onclick="SeedGrades"><i data-lucide="zap"></i> Seed default grades</button>
    <span class="muted">(only inserts when no grades exist)</span>
</div>

<div class="panel">
    <div class="panel-body">
        <h3>Create Grade</h3>
        <div class="create-row">
            <input class="input" placeholder="Name" @bind="newName" />
            <input class="input" type="number" placeholder="Level" @bind="newLevel" />
            <button class="btn btn-primary btn-sm" @onclick="CreateGrade"><i data-lucide="plus"></i> Create</button>
        </div>
        @if (!string.IsNullOrEmpty(createError))
        {
            <div class="field-error">@createError</div>
        }
    </div>
</div>

<div class="data-table-wrap">
    <table class="data-table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Level</th>
                <th style="width:190px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var g in grades)
            {
                <tr>
                    <td>@g.Id</td>
                    <td>
                        @if (editId == g.Id)
                        {
                            <input class="input" @bind="editName" />
                        }
                        else
                        {
                            @g.Name
                        }
                    </td>
                    <td>
                        @if (editId == g.Id)
                        {
                            <input class="input" type="number" @bind="editLevel" />
                        }
                        else
                        {
                            @g.Level
                        }
                    </td>
                    <td>
                        <div class="row-actions">
                            @if (editId == g.Id)
                            {
                                <button class="btn btn-primary btn-sm" @onclick="() => SaveEdit(g.Id)"><i data-lucide="save"></i> Save</button>
                                <button class="btn btn-secondary btn-sm" @onclick="CancelEdit"><i data-lucide="x"></i> Cancel</button>
                            }
                            else
                            {
                                <button class="btn btn-ghost btn-sm" @onclick="() => StartEdit(g)"><i data-lucide="pencil-line"></i> Edit</button>
                                <button class="btn btn-danger btn-sm" @onclick="() => DeleteGrade(g.Id)"><i data-lucide="trash-2"></i> Delete</button>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private List<GradeResponse> grades = new();
    private string? errorMessage;
    private string newName = string.Empty;
    private int newLevel = 6;
    private string? createError;

    private int editId = -1;
    private string editName = string.Empty;
    private int editLevel;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            grades = (await Api.GetGrades()).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("initLucide");
    }

    private async Task SeedGrades()
    {
        try
        {
            await Api.SeedGrades();
            grades = (await Api.GetGrades()).ToList();
            errorMessage = null;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task CreateGrade()
    {
        try
        {
            createError = null;
            var created = await Api.CreateGrade(new CreateGradeRequest { Name = newName, Level = newLevel });
            grades = (await Api.GetGrades()).ToList();
            newName = string.Empty;
            newLevel = 6;
        }
        catch (ApiException ex)
        {
            createError = ex.Message;
        }
        catch (Exception ex)
        {
            createError = ex.Message;
        }
    }

    private void StartEdit(GradeResponse g)
    {
        editId = g.Id;
        editName = g.Name;
        editLevel = g.Level;
    }

    private void CancelEdit()
    {
        editId = -1;
        editName = string.Empty;
        editLevel = 0;
    }

    private async Task SaveEdit(int id)
    {
        try
        {
            await Api.UpdateGrade(id, new UpdateGradeRequest { Name = editName, Level = editLevel });
            grades = (await Api.GetGrades()).ToList();
            CancelEdit();
            errorMessage = null;
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task DeleteGrade(int id)
    {
        if (!await JsConfirm($"Delete grade #{id}? This cannot be undone.")) return;
        try
        {
            await Api.DeleteGrade(id);
            grades = (await Api.GetGrades()).ToList();
            errorMessage = null;
        }
        catch (ApiException ex)
        {
            // try to parse conflict message
            errorMessage = ex.Content ?? ex.Message;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task<bool> JsConfirm(string message)
    {
        try
        {
            return await JS.InvokeAsync<bool>("confirm", message);
        }
        catch
        {
            return false;
        }
    }
}
