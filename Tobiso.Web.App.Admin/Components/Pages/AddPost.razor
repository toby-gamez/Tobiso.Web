@page "/posts/add"
@using Tobiso.Web.Shared.DTOs
@using Tobiso.Web.Shared.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@using Tobiso.Web.Api.Services
@using System
@inject ITobisoWebApi Api
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Přidat nový článek</PageTitle>

<h3>Přidat nový článek</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert-error">@errorMessage</div>
}

<EditForm Model="request" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="field">
        <label for="title">Název</label>
        <InputText id="title" class="input" @bind-Value="request.Title" @bind-Value:after="GenerateFilePath" />
    </div>
    <div class="field">
        <label for="filePath">Soubor</label>
        <InputText id="filePath" class="input" @bind-Value="request.FilePath" />
    </div>
    <div class="field">
        <label for="category">Kategorie</label>
        <SearchableCategorySelect Categories="categories" Value="request.CategoryId" ValueChanged="id => request.CategoryId = id" />
    </div>
    <div class="field">
        <label for="grade">Ročník (verze obsahu)</label>
        <InputSelect id="grade" class="select" @bind-Value="request.GradeId">
            <option value="">-- vyberte ročník --</option>
            @foreach (var g in grades)
            {
                <option value="@g.Id">@g.Name</option>
            }
        </InputSelect>
    </div>
    <div class="field">
        <label for="content">Obsah</label>
        <MarkdownEditor @ref="markdownEditor" @bind-Value="request.Content" For="@(() => request.Content)" Placeholder="Začněte psát váš Markdown obsah..." Rows="15" />
        <div class="editor-toolbar-row">
            <button type="button" class="btn btn-secondary btn-sm" @onclick="CheckGrammar" disabled="@isChecking">Zkontrolovat gramatiku</button>
            <button type="button" class="btn btn-secondary btn-sm" @onclick="ClearGrammarHighlights">Vyčistit zvýraznění</button>
            <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _showLegend = true"><i data-lucide="help-circle"></i> Nápověda k formátování</button>
        </div>
        <GrammarCheckPanel Issues="grammarIssues" />
    </div>
    <fieldset class="choice-group @(!CanSave ? "choice-group-incomplete" : "")">
        <legend>Typ úpravy <span class="required-mark">*</span></legend>
        <div class="radio-field">
            <input type="radio" id="editTypeFix" name="editType" checked="@(_editType == "fix")" @onchange="SetEditTypeFix" />
            <label for="editTypeFix">
                <span class="radio-title">Oprava (Fix)</span>
                <span class="radio-desc">Malá oprava — automaticky se označí jako zkontrolováno</span>
            </label>
        </div>
        <div class="radio-field">
            <input type="radio" id="editTypeEdit" name="editType" checked="@(_editType == "edit")" @onchange="SetEditTypeEdit" />
            <label for="editTypeEdit">
                <span class="radio-title">Velká úprava (Edit)</span>
                <span class="radio-desc">Nový obsah nebo funkce</span>
            </label>
        </div>

        @if (_editType == "edit")
        {
            <div class="choice-subgroup">
                <div class="choice-subgroup-label">Byl nový obsah zkontrolován? <span class="required-mark">*</span></div>
                <div class="radio-field">
                    <input type="radio" id="checkedYes" name="isCheckedChoice" checked="@(_isCheckedChoice == true)" @onchange="SetCheckedYes" />
                    <label for="checkedYes">
                        <span class="radio-title">Ano, obsah byl zkontrolován</span>
                    </label>
                </div>
                <div class="radio-field">
                    <input type="radio" id="checkedNo" name="isCheckedChoice" checked="@(_isCheckedChoice == false)" @onchange="SetCheckedNo" />
                    <label for="checkedNo">
                        <span class="radio-title">Ne, ještě nebyl zkontrolován</span>
                    </label>
                </div>
            </div>
        }

        @if (!CanSave)
        {
            <p class="choice-hint">
                <i data-lucide="alert-circle"></i>
                Vyberte typ úpravy@(_editType == "edit" ? " a zda byl obsah zkontrolován" : "") před uložením.
            </p>
        }
    </fieldset>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary" disabled="@(!CanSave)">Přidat článek</button>
        <button type="button" class="btn btn-secondary" @onclick="GoBack">Zpět</button>
    </div>
</EditForm>

<QuestionsManager PostId="0"
                  ContentOverride="@request.Content"
                  OnQuestionGenerated="HandleQuestionGenerated" />
@if (pendingQuestions.Any())
{
    <div class="info-banner">
        @pendingQuestions.Count otázka(y) čekají na uložení článku.
    </div>
}

<FormattingLegend @bind-Visible="_showLegend" />

@code {
    private bool _showLegend = false;
    private CreatePostRequest request = new();
    private List<CategoryResponse> categories = new();
    private List<GradeResponse> grades = new();
    private string? errorMessage;
    private Tobiso.Web.App.Admin.Components.MarkdownEditor? markdownEditor;
    private List<Tobiso.Web.Shared.DTOs.GrammarIssue> grammarIssues = new();
    private bool isChecking = false;
    private List<CreateQuestionRequest> pendingQuestions = new();

    /// <summary>"fix" | "edit" | null. Never defaulted - every save requires an explicit, conscious choice.</summary>
    private string? _editType;
    /// <summary>Only relevant when _editType == "edit". Never defaulted - must be explicitly chosen.</summary>
    private bool? _isCheckedChoice;

    /// <summary>True once the admin has made all choices required to save the initial version (or no version is being created).</summary>
    private bool CanSave =>
        !request.GradeId.HasValue ||
        _editType == "fix" ||
        (_editType == "edit" && _isCheckedChoice.HasValue);

    private void SetEditTypeFix() { _editType = "fix"; _isCheckedChoice = null; }
    private void SetEditTypeEdit() { _editType = "edit"; _isCheckedChoice = null; }
    private void SetCheckedYes() => _isCheckedChoice = true;
    private void SetCheckedNo() => _isCheckedChoice = false;

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    private void HandleQuestionGenerated(CreateQuestionRequest q) => pendingQuestions.Add(q);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            categories = (await Api.GetAllCategories()).ToList();
            grades = (await Api.GetGrades()).ToList();
            // default to highest available grade
            if (grades.Any())
                request.GradeId = grades.OrderByDescending(g => g.Level).First().Id;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("initLucide");
    }

    private async Task CheckGrammar()
    {
        try
        {
            isChecking = true;
            grammarIssues.Clear();
            var req = new Tobiso.Web.Shared.DTOs.GrammarCheckRequest { Content = request.Content ?? string.Empty };
            var resp = await Api.CheckGrammar(req);
            if (resp?.Issues != null && resp.Issues.Count > 0)
            {
                grammarIssues = resp.Issues;
                if (markdownEditor != null)
                    await markdownEditor.HighlightErrors(grammarIssues);
            }
            else
            {
                grammarIssues = new List<Tobiso.Web.Shared.DTOs.GrammarIssue>();
                if (markdownEditor != null)
                    await markdownEditor.ClearHighlights();
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isChecking = false;
        }
    }

    private async Task ClearGrammarHighlights()
    {
        grammarIssues.Clear();
        if (markdownEditor != null) await markdownEditor.ClearHighlights();
    }

    private async Task HandleValidSubmit()
    {
        // Belt-and-suspenders: the submit button is already disabled in this state, but never
        // let a save through without an explicit, freshly-made choice.
        if (!CanSave)
        {
            errorMessage = "Vyberte typ úpravy" + (_editType == "edit" ? " a zda byl obsah zkontrolován" : "") + " před uložením.";
            return;
        }

        request.IsFix = _editType == "fix";
        // Fix implies checked automatically; an Edit uses whatever the admin explicitly chose.
        request.IsChecked = request.IsFix ? true : _isCheckedChoice;

        try
        {
            var created = await Api.CreatePost(request);
            errorMessage = null;

            foreach (var q in pendingQuestions)
            {
                q.PostId = created.Id;
                await Api.CreateQuestion(q);
            }

            Navigation.NavigateTo($"/posts/edit/{created.Id}");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void GenerateFilePath()
    {
        if (!string.IsNullOrWhiteSpace(request.Title))
            request.FilePath = "/" + ToKebabCase(request.Title) + ".md";
    }

    private static string ToKebabCase(string text)
    {
        var normalized = text.Normalize(System.Text.NormalizationForm.FormD);
        var sb = new System.Text.StringBuilder();
        foreach (var c in normalized)
        {
            if (System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c) != System.Globalization.UnicodeCategory.NonSpacingMark)
                sb.Append(c);
        }

        var result = new System.Text.StringBuilder();
        foreach (var c in sb.ToString().ToLowerInvariant())
        {
            if (char.IsLetterOrDigit(c))
                result.Append(c);
            else if (c == ' ' || c == '-' || c == '_')
                result.Append('-');
        }

        return result.ToString().Trim('-');
    }

    private void GoBack() => Navigation.NavigateTo("/");
}
