@page "/posts/add"
@using Tobiso.Web.Shared.DTOs
@using Tobiso.Web.Shared.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@using Tobiso.Web.Api.Services
@using System
@inject ITobisoWebApi Api
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Přidat nový článek</PageTitle>

<h3>Přidat nový článek</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<EditForm Model="post" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="mb-3">
        <label for="title" class="form-label">Název</label>
        <InputText id="title" class="form-control" @bind-Value="post.Title" @bind-Value:after="GenerateFilePath" />
    </div>
    <div class="mb-3">
        <label for="filePath" class="form-label">Soubor</label>
        <InputText id="filePath" class="form-control" @bind-Value="post.FilePath" />
    </div>
    <div class="mb-3">
        <label for="category" class="form-label">Kategorie</label>
        <SearchableCategorySelect Categories="categories" Value="post.CategoryId" ValueChanged="id => post.CategoryId = id" />
    </div>
    <div class="mb-3">
        <label for="content" class="form-label">Obsah</label>
        <MarkdownEditor @ref="markdownEditor" @bind-Value="post.Content" For="@(() => post.Content)" Placeholder="Začněte psát váš Markdown obsah..." Rows="15" />
        <div class="mt-2">
            <button type="button" class="btn btn-sm btn-outline-primary me-2" @onclick="CheckGrammar" disabled="@isChecking">Zkontrolovat gramatiku</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearGrammarHighlights">Vyčistit zvýraznění</button>
        </div>
        <GrammarCheckPanel Issues="grammarIssues" />
    </div>
    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" id="isFix" @bind="_isFixSelected" />
        <label class="form-check-label" for="isFix">Oprava (Fix)</label>
    </div>
    <button type="submit" class="btn btn-success">Přidat článek</button>
    <button type="button" class="btn btn-secondary ms-2" @onclick="GoBack">Zpět</button>
</EditForm>

@code {
    private PostResponse post = new();
    private List<CategoryResponse> categories = new();
    private string? errorMessage;
    private bool _isFixSelected = false;
    private Tobiso.Web.App.Admin.Components.MarkdownEditor? markdownEditor;
    private List<Tobiso.Web.Shared.DTOs.GrammarIssue> grammarIssues = new();
    private bool isChecking = false;

    protected override async Task OnInitializedAsync()
    {
        // Check if user is authenticated
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            categories = (await Api.GetAllCategories()).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task CheckGrammar()
    {
        try
        {
            isChecking = true;
            grammarIssues.Clear();
            var req = new Tobiso.Web.Shared.DTOs.GrammarCheckRequest { Content = post.Content ?? string.Empty };
            var resp = await Api.CheckGrammar(req);
            if (resp?.Issues != null && resp.Issues.Count > 0)
            {
                grammarIssues = resp.Issues;
                if (markdownEditor != null)
                {
                    await markdownEditor.HighlightErrors(grammarIssues);
                }
            }
            else
            {
                grammarIssues = new List<Tobiso.Web.Shared.DTOs.GrammarIssue>();
                if (markdownEditor != null)
                {
                    await markdownEditor.ClearHighlights();
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isChecking = false;
        }
    }

    private async Task ClearGrammarHighlights()
    {
        grammarIssues.Clear();
        if (markdownEditor != null) await markdownEditor.ClearHighlights();
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            if (_isFixSelected)
            {
                post.LastFix = DateTime.UtcNow;
                post.LastEdit = null;
            }
            else
            {
                post.LastEdit = DateTime.UtcNow;
                post.LastFix = null;
            }
            var created = await Api.CreatePost(post);
            errorMessage = null;
            Navigation.NavigateTo($"/posts/edit/{created.Id}");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void GenerateFilePath()
    {
        if (!string.IsNullOrWhiteSpace(post.Title))
        {
            post.FilePath = "/" + ToKebabCase(post.Title) + ".md";
        }
    }

    private static string ToKebabCase(string text)
    {
        var normalized = text.Normalize(System.Text.NormalizationForm.FormD);
        var sb = new System.Text.StringBuilder();
        foreach (var c in normalized)
        {
            if (System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c) != System.Globalization.UnicodeCategory.NonSpacingMark)
                sb.Append(c);
        }

        var result = new System.Text.StringBuilder();
        foreach (var c in sb.ToString().ToLowerInvariant())
        {
            if (char.IsLetterOrDigit(c))
                result.Append(c);
            else if (c == ' ' || c == '-' || c == '_')
                result.Append('-');
        }

        return result.ToString().Trim('-');
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/");
    }
}
