@page "/posts/add"
@using Tobiso.Web.Shared.DTOs
@using Tobiso.Web.Shared.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@using Tobiso.Web.Api.Services
@inject ITobisoWebApi Api
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<h3>Přidat nový post</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<EditForm Model="post" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="mb-3">
        <label for="title" class="form-label">Název</label>
        <InputText id="title" class="form-control" @bind-Value="post.Title" @bind-Value:after="GenerateFilePath" />
    </div>
    <div class="mb-3">
        <label for="filePath" class="form-label">Soubor</label>
        <InputText id="filePath" class="form-control" @bind-Value="post.FilePath" />
    </div>
    <div class="mb-3">
        <label for="category" class="form-label">Kategorie</label>
        <InputSelect id="category" class="form-select" @bind-Value="post.CategoryId">
            <option value="">-- vyber kategorii --</option>
            @foreach (var cat in categories)
            {
                <option value="@cat.Id">@cat.Name</option>
            }
        </InputSelect>
    </div>
    <div class="mb-3">
        <label for="content" class="form-label">Obsah</label>
        <MarkdownEditor @bind-Value="post.Content" For="@(() => post.Content)" Placeholder="Začněte psát váš Markdown obsah..." Rows="15" />
    </div>
    <button type="submit" class="btn btn-success">Přidat post</button>
    <button type="button" class="btn btn-secondary ms-2" @onclick="GoBack">Zpět</button>
</EditForm>

@if (createdPostId.HasValue)
{
    <!-- Přidání komponenty pro správu otázek po vytvoření postu -->
    <QuestionsManager PostId="@createdPostId.Value" />
}

@code {
    private PostResponse post = new();
    private List<CategoryResponse> categories = new();
    private string? errorMessage;
    private int? createdPostId = null;

    protected override async Task OnInitializedAsync()
    {
        // Check if user is authenticated
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            categories = (await Api.GetAllCategories()).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            var created = await Api.CreatePost(post);
            createdPostId = created.Id;
            errorMessage = null;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void GenerateFilePath()
    {
        if (!string.IsNullOrWhiteSpace(post.Title))
        {
            post.FilePath = "/" + ToKebabCase(post.Title) + ".md";
        }
    }

    private static string ToKebabCase(string text)
    {
        var normalized = text.Normalize(System.Text.NormalizationForm.FormD);
        var sb = new System.Text.StringBuilder();
        foreach (var c in normalized)
        {
            if (System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c) != System.Globalization.UnicodeCategory.NonSpacingMark)
                sb.Append(c);
        }

        var result = new System.Text.StringBuilder();
        foreach (var c in sb.ToString().ToLowerInvariant())
        {
            if (char.IsLetterOrDigit(c))
                result.Append(c);
            else if (c == ' ' || c == '-' || c == '_')
                result.Append('-');
        }

        return result.ToString().Trim('-');
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/");
    }
}

