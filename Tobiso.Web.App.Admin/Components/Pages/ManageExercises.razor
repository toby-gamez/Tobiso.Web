@page "/admin/exercises/{PostId:int}"
@using Tobiso.Web.Shared.DTOs
@using Tobiso.Web.Shared.Interfaces
@using Tobiso.Web.Api.Services
@inject IInteractiveExerciseService ExerciseService
@inject IPostService PostService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Správa cvičení - @(_post?.Title ?? "Článek") - Admin</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Interaktivní cvičení</h2>
            @if (_post != null)
            {
                <p class="text-muted mb-0">Článek: <strong>@_post.Title</strong></p>
            }
        </div>
        <div>
            <button class="btn btn-secondary" @onclick="BackToPosts">
                <i class="bi bi-arrow-left"></i> Zpět na články
            </button>
            <button class="btn btn-primary" @onclick="CreateNew">
                <i class="bi bi-plus-circle"></i> Nové cvičení
            </button>
        </div>
    </div>

    @if (_loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Načítání...</span>
            </div>
        </div>
    }
    else if (_error != null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle"></i> @_error
        </div>
    }
    else if (!_exercises.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> Tento článek zatím nemá žádná cvičení.
            <button class="btn btn-sm btn-primary ms-2" @onclick="CreateNew">
                Vytvořit první cvičení
            </button>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th style="width: 50px;">Pořadí</th>
                        <th>Název</th>
                        <th style="width: 120px;">Typ</th>
                        <th style="width: 100px;">Aktivní</th>
                        <th style="width: 150px;">Vytvořeno</th>
                        <th style="width: 180px;">Akce</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var exercise in _exercises.OrderBy(e => e.OrderIndex))
                    {
                        <tr class="@(!exercise.IsActive ? "table-secondary" : "")">
                            <td>
                                <span class="badge bg-secondary">@exercise.OrderIndex</span>
                            </td>
                            <td>
                                <strong>@exercise.Title</strong>
                                @if (!string.IsNullOrEmpty(exercise.InstructionsMarkdown))
                                {
                                    <br/>
                                    <small class="text-muted">
                                        @(exercise.InstructionsMarkdown.Length > 60 
                                            ? exercise.InstructionsMarkdown.Substring(0, 60) + "..." 
                                            : exercise.InstructionsMarkdown)
                                    </small>
                                }
                            </td>
                            <td>
                                <span class="badge bg-info">@GetTypeLabel(exercise.Type)</span>
                            </td>
                            <td>
                                @if (exercise.IsActive)
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle"></i> Aktivní
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        <i class="bi bi-x-circle"></i> Neaktivní
                                    </span>
                                }
                            </td>
                            <td>
                                <small>@exercise.CreatedAt.ToString("d. M. yyyy")</small>
                                @if (exercise.UpdatedAt.HasValue)
                                {
                                    <br/>
                                    <small class="text-muted">Upraveno: @exercise.UpdatedAt.Value.ToString("d. M. yyyy")</small>
                                }
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <button class="btn btn-sm btn-outline-primary" 
                                            @onclick="() => EditExercise(exercise.Id)"
                                            title="Upravit">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-success" 
                                            @onclick="() => TestExercise(exercise.Id)"
                                            title="Testovat">
                                        <i class="bi bi-play-circle"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" 
                                            @onclick="() => ConfirmDelete(exercise)"
                                            title="Smazat">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* Confirmation Modal for Delete *@
@if (_exerciseToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Potvrzení smazání</h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>Opravdu chcete smazat cvičení <strong>@_exerciseToDelete.Title</strong>?</p>
                    <p class="text-danger">Tato akce je nevratná!</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelDelete">Zrušit</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteExercise">
                        <i class="bi bi-trash"></i> Smazat
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int PostId { get; set; }

    private PostResponse? _post;
    private List<InteractiveExerciseResponse> _exercises = new();
    private bool _loading = true;
    private string? _error;
    private InteractiveExerciseResponse? _exerciseToDelete;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        _error = null;
        
        try
        {
            _post = await PostService.GetById(PostId);
            if (_post == null)
            {
                _error = "Článek nenalezen.";
                return;
            }

            _exercises = await ExerciseService.GetByPostIdAsync(PostId, includeInactive: true);
        }
        catch (Exception ex)
        {
            _error = $"Chyba při načítání dat: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void CreateNew()
    {
        Navigation.NavigateTo($"/admin/exercises/{PostId}/new");
    }

    private void EditExercise(int exerciseId)
    {
        Navigation.NavigateTo($"/admin/exercises/{PostId}/edit/{exerciseId}");
    }

    private void TestExercise(int exerciseId)
    {
        // TODO: Otevřít modal nebo stránku pro testování cvičení
        Navigation.NavigateTo($"/admin/exercises/{PostId}/test/{exerciseId}");
    }

    private void ConfirmDelete(InteractiveExerciseResponse exercise)
    {
        _exerciseToDelete = exercise;
    }

    private void CancelDelete()
    {
        _exerciseToDelete = null;
    }

    private async Task DeleteExercise()
    {
        if (_exerciseToDelete == null) return;

        try
        {
            var success = await ExerciseService.DeleteAsync(_exerciseToDelete.Id);
            if (success)
            {
                _exercises.Remove(_exerciseToDelete);
                _exerciseToDelete = null;
                StateHasChanged();
            }
            else
            {
                _error = "Nepodařilo se smazat cvičení.";
            }
        }
        catch (Exception ex)
        {
            _error = $"Chyba při mazání: {ex.Message}";
        }
    }

    private void BackToPosts()
    {
        Navigation.NavigateTo("/admin/posts");
    }

    private string GetTypeLabel(string type)
    {
        return type switch
        {
            "circuit" => "Obvod",
            "timeline" => "Časová osa",
            "drag-drop" => "Přetahování",
            "molecule" => "Molekula",
            "matching" => "Párování",
            _ => type
        };
    }
}
