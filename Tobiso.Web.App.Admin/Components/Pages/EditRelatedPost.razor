@page "/related-posts/edit/{Id:int}"
@using Tobiso.Web.Shared.DTOs
@using Tobiso.Web.Shared.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@inject ITobisoWebApi Api
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>
        <i class="bi bi-pencil"></i>
        Upravit souvisejíci post
    </h2>
    <button class="btn btn-secondary" @onclick="BackToList">
        <i class="bi bi-arrow-left"></i>
        Zpět
    </button>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (relatedPost == null)
{
    <div class="d-flex justify-content-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Načítání...</span>
        </div>
    </div>
}
else
{
    <EditForm Model="request" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        
        @if (!string.IsNullOrEmpty(validationErrorMessage))
        {
            <div class="alert alert-warning">@validationErrorMessage</div>
        }
        
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label">Hlavní post <span class="text-danger">*</span></label>
                    <PostSearchComponent SelectedPost="selectedMainPost" 
                                       SelectedPostChanged="@((PostLinkResponse? post) => selectedMainPost = post)"
                                       Placeholder="Vyhledejte hlavní post..."
                                       IsValid="@(string.IsNullOrEmpty(mainPostError))"
                                       ErrorMessage="@mainPostError" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label">Souvisejíci post <span class="text-danger">*</span></label>
                    <PostSearchComponent SelectedPost="selectedRelatedPost" 
                                       SelectedPostChanged="@((PostLinkResponse? post) => selectedRelatedPost = post)"
                                       Placeholder="Vyhledejte související post..."
                                       IsValid="@(string.IsNullOrEmpty(relatedPostError))"
                                       ErrorMessage="@relatedPostError"
                                       ExcludePostId="@selectedMainPost?.Id" />
                </div>
            </div>
        </div>
        
        <div class="mb-3">
            <label for="text" class="form-label">Popisek souvislosti (volitelný)</label>
            <InputTextArea id="text" class="form-control" rows="3" @bind-Value="request.Text" 
                          placeholder="Například: 'Navazuje na tuto lekci' nebo 'Doporučeno přečíst po tomto článku'"/>
            <div class="form-text">
                Krátký popis toho, jak spolu posty souvisí. Zobrazí se uživatelům jako nápověda.
            </div>
        </div>
        
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    <span>Ukládám...</span>
                }
                else
                {
                    <i class="bi bi-check-circle"></i>
                    <span>Uložit změny</span>
                }
            </button>
            <button type="button" class="btn btn-outline-secondary" @onclick="BackToList">
                <i class="bi bi-x-circle"></i>
                Zrušit
            </button>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private UpdateRelatedPostRequest request = new();
    private RelatedPostResponse? relatedPost;
    private IList<PostLinkResponse>? posts;
    private PostLinkResponse? selectedMainPost;
    private PostLinkResponse? selectedRelatedPost;
    private string? errorMessage;
    private string? validationErrorMessage;
    private string? mainPostError;
    private string? relatedPostError;
    private bool isSubmitting;

    protected override async Task OnInitializedAsync()
    {
        // Check if user is authenticated
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            var loadPostsTask = Api.GetPostLinks();
            var loadRelatedPostTask = Api.GetRelatedPostById(Id);

            await Task.WhenAll(loadPostsTask, loadRelatedPostTask);

            posts = await loadPostsTask;
            relatedPost = await loadRelatedPostTask;

            if (relatedPost != null && posts != null)
            {
                request.PostId = relatedPost.PostId;
                request.RelatedPostId = relatedPost.RelatedPostId;
                request.Text = relatedPost.Text;
                
                // Najít odpovídající posty pro komponenty
                selectedMainPost = posts.FirstOrDefault(p => p.Id == relatedPost.PostId);
                selectedRelatedPost = posts.FirstOrDefault(p => p.Id == relatedPost.RelatedPostId);
            }
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba při načítání dat: {ex.Message}";
        }
    }

    private async Task HandleValidSubmit()
    {
        if (!ValidateForm())
            return;

        isSubmitting = true;
        errorMessage = null;
        validationErrorMessage = null;

        try
        {
            request.PostId = selectedMainPost!.Id;
            request.RelatedPostId = selectedRelatedPost!.Id;
            
            await Api.UpdateRelatedPost(Id, request);
            Navigation.NavigateTo("/related-posts");
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba při aktualizaci souvisejícího postu: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private bool ValidateForm()
    {
        bool isValid = true;
        
        mainPostError = null;
        relatedPostError = null;
        validationErrorMessage = null;

        if (selectedMainPost == null)
        {
            mainPostError = "Hlavní post je povinný.";
            isValid = false;
        }

        if (selectedRelatedPost == null)
        {
            relatedPostError = "Související post je povinný.";
            isValid = false;
        }

        if (selectedMainPost != null && selectedRelatedPost != null && selectedMainPost.Id == selectedRelatedPost.Id)
        {
            validationErrorMessage = "Post nemůže odkazovat sám na sebe.";
            isValid = false;
        }

        return isValid;
    }

    private void BackToList()
    {
        Navigation.NavigateTo("/related-posts");
    }
}