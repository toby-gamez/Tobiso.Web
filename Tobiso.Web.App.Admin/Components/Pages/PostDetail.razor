@page "/post/{id:int}"
@using Tobiso.Web.Shared.DTOs
@using Markdig
@using Microsoft.AspNetCore.Components.Authorization
@inject Tobiso.Web.Shared.Interfaces.ITobisoWebApi Api
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS

<PageTitle>Blogový post</PageTitle>

@if (post == null)
{
    <p>Načítám...</p>
}
else
{
    <div class="toolbar-row">
        <button class="btn btn-secondary" @onclick="BackToList">Zpět na seznam</button>
        <button class="btn btn-primary" @onclick="SaveChanges">Uložit</button>
    </div>
    <h2 class="post-title"><i data-lucide="file-text"></i> @post.Title</h2>
    <div class="fix-row">
        <label class="checkbox-field">
            <input type="checkbox" @bind="_isFixSelected" /> Fix
        </label>
        <span class="muted">@GetLatestEditDateDisplay()</span>
    </div>
    <div class="post-body">
        @((MarkupString)Markdig.Markdown.ToHtml(ActiveVersion?.Content ?? string.Empty))
    </div>
}

@code {
    [Parameter]
    public int id { get; set; }
    private PostResponse? post;
    private PostVersionResponse? ActiveVersion => post?.Versions?.FirstOrDefault();
    private bool _isFixSelected = false;
    private string? _saveStatus;

    protected override async Task OnInitializedAsync()
    {
        // Check if user is authenticated
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            post = await Api.GetPostById(id);
            // Default checkbox selection: choose Fix if LastFix is newer or only one exists
            if (post != null)
            {
                var av = post.Versions?.FirstOrDefault();
                if (av?.LastFix.HasValue == true && av?.LastEdit.HasValue == true)
                {
                    _isFixSelected = av.LastFix >= av.LastEdit;
                }
                else if (av?.LastFix.HasValue == true)
                {
                    _isFixSelected = true;
                }
                else
                {
                    _isFixSelected = false;
                }
            }
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("initLucide");
    }

    private void BackToList()
    {
        Navigation.NavigateTo("/posts-incognito");
    }

    private async Task SaveChanges()
    {
        if (post == null) return;
        DateTime? lastFix = _isFixSelected ? DateTime.UtcNow : null;
        DateTime? lastEdit = _isFixSelected ? null : DateTime.UtcNow;

        try
        {
            // Update post metadata
            await Api.UpdatePost(post.Id, new UpdatePostRequest
            {
                Title = post.Title,
                FilePath = post.FilePath ?? string.Empty,
                CategoryId = post.CategoryId
            });

            // Update the active version's timestamps (use first version)
            if (post.Versions?.Any() == true)
            {
                var activeVersion = post.Versions.First();
                await Api.UpdateVersion(activeVersion.Id, new UpdateVersionRequest
                {
                    Content = activeVersion.Content,
                    LastFix = lastFix,
                    LastEdit = lastEdit
                });
            }

            _saveStatus = "Uloženo";
        }
        catch (Refit.ApiException ex)
        {
            _saveStatus = $"Chyba: {ex.StatusCode}";
        }
        StateHasChanged();
    }

    private DateTime? GetLatestEditDate()
    {
        if (post == null) return null;
        var e = ActiveVersion?.LastEdit;
        var f = ActiveVersion?.LastFix;
        if (e.HasValue && f.HasValue) return e > f ? e : f;
        return e ?? f;
    }

    private string GetLatestEditDateDisplay()
    {
        var d = GetLatestEditDate();
        return d?.ToString("d. M. yyyy") ?? string.Empty;
    }
}
