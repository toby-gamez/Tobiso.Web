@using System.Text.Json
@using Tobiso.Web.Shared.DTOs
@inject IJSRuntime JS

<div class="dragdrop-editor">
    <div class="editor-columns">
        <div class="panel">
            <div class="panel-header"><i data-lucide="package"></i> Kategorie</div>
            <div class="panel-body">
                <button type="button" class="btn btn-primary btn-sm" @onclick="AddCategory">
                    <i data-lucide="plus"></i> Přidat kategorii
                </button>

                @if (!_categories.Any())
                {
                    <div class="callout-tip">
                        <i data-lucide="info"></i> Přidejte kategorie (např. "Podstatné jméno", "Sloveso")
                    </div>
                }
                else
                {
                    <div class="editor-list">
                        @foreach (var category in _categories)
                        {
                            <div class="editor-list-item">
                                <div class="editor-list-row">
                                    <input type="text" class="input" @bind="category.Label" @bind:after="GenerateJson" placeholder="Název kategorie" />
                                    <button type="button" class="btn btn-ghost btn-sm" @onclick="() => RemoveCategory(category.Id)">
                                        <i data-lucide="trash-2"></i>
                                    </button>
                                </div>
                                <small class="editor-item-id">ID: @category.Id</small>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="panel">
            <div class="panel-header"><i data-lucide="file-text"></i> Prvky k zařazení</div>
            <div class="panel-body">
                <button type="button" class="btn btn-primary btn-sm" @onclick="AddItem">
                    <i data-lucide="plus"></i> Přidat prvek
                </button>

                @if (!_items.Any())
                {
                    <div class="callout-tip">
                        <i data-lucide="info"></i> Přidejte prvky, které budou přiřazeny ke kategoriím
                    </div>
                }
                else
                {
                    <div class="editor-list">
                        @foreach (var item in _items)
                        {
                            <div class="editor-list-item">
                                <div class="editor-list-row editor-list-row--item">
                                    <input type="text" class="input" @bind="item.Text" @bind:after="GenerateJson" placeholder="Text prvku" />
                                    <select class="select" @bind-Value="item.CorrectCategory" @bind-Value:event="onchange" @bind-Value:after="GenerateJson">
                                        <option value="">-- Kategorie --</option>
                                        @foreach (var cat in _categories)
                                        {
                                            <option value="@cat.Id">@cat.Label</option>
                                        }
                                    </select>
                                    <button type="button" class="btn btn-ghost btn-sm" @onclick="() => RemoveItem(item.Id)">
                                        <i data-lucide="trash-2"></i>
                                    </button>
                                </div>
                                <small class="editor-item-id">ID: @item.Id</small>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    @if (_categories.Any() && _items.Any())
    {
        <div class="panel preview-panel">
            <div class="panel-header"><i data-lucide="eye"></i> Náhled</div>
            <div class="panel-body">
                <div class="preview-grid">
                    @foreach (var category in _categories)
                    {
                        <div class="bucket">
                            <strong class="preview-category-label">@category.Label</strong>
                            <div class="preview-category-items">
                                @foreach (var item in _items.Where(i => i.CorrectCategory == category.Id))
                                {
                                    <span class="exercise-pill">@item.Text</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <div class="editor-actions">
        <button type="button" class="btn btn-secondary" @onclick="GenerateJson">
            <i data-lucide="code-2"></i> Aktualizovat JSON
        </button>
        <button type="button" class="btn btn-danger" @onclick="ClearAll">
            <i data-lucide="x-circle"></i> Vymazat vše
        </button>
    </div>
</div>

@code {
    [Parameter]
    public string ConfigJson { get; set; } = "{}";

    [Parameter]
    public EventCallback<string> ConfigJsonChanged { get; set; }

    [Parameter]
    public string SolutionJson { get; set; } = "{}";

    [Parameter]
    public EventCallback<string> SolutionJsonChanged { get; set; }

    private List<DragDropCategory> _categories = new();
    private List<DragDropItem> _items = new();
    private int _categoryCounter = 0;
    private int _itemCounter = 0;
    private string _lastLoadedConfigJson = "";
    private string _lastLoadedSolutionJson = "";

    protected override void OnParametersSet()
    {
        // Načíst data pouze pokud se JSON skutečně změnil (ne při našem vlastním generování)
        if (ConfigJson != _lastLoadedConfigJson || SolutionJson != _lastLoadedSolutionJson)
        {
            LoadFromJson();
            _lastLoadedConfigJson = ConfigJson;
            _lastLoadedSolutionJson = SolutionJson;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("initLucide");
    }

    private void LoadFromJson()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(ConfigJson) || ConfigJson == "{}") return;

            var doc = JsonDocument.Parse(ConfigJson);

            if (doc.RootElement.TryGetProperty("categories", out var categoriesArray))
            {
                _categories.Clear();
                _categoryCounter = 0;
                foreach (var item in categoriesArray.EnumerateArray())
                {
                    var id = item.GetProperty("id").GetString() ?? "";
                    _categories.Add(new DragDropCategory
                    {
                        Id = id,
                        Label = item.GetProperty("label").GetString() ?? ""
                    });

                    // Aktualizovat čítač podle načtených ID (např. "cat-5" -> 5)
                    if (id.StartsWith("cat-") && int.TryParse(id.Substring(4), out var num))
                    {
                        _categoryCounter = Math.Max(_categoryCounter, num);
                    }
                }
            }

            if (doc.RootElement.TryGetProperty("items", out var itemsArray))
            {
                _items.Clear();
                _itemCounter = 0;

                // Načíst solution pro správné kategorie
                var correctPlacements = new Dictionary<string, string>();
                if (!string.IsNullOrWhiteSpace(SolutionJson) && SolutionJson != "{}")
                {
                    var solutionDoc = JsonDocument.Parse(SolutionJson);
                    if (solutionDoc.RootElement.TryGetProperty("correctPlacements", out var placements))
                    {
                        foreach (var prop in placements.EnumerateObject())
                        {
                            correctPlacements[prop.Name] = prop.Value.GetString() ?? "";
                        }
                    }
                }

                foreach (var item in itemsArray.EnumerateArray())
                {
                    var id = item.GetProperty("id").GetString() ?? "";
                    _items.Add(new DragDropItem
                    {
                        Id = id,
                        Text = item.GetProperty("text").GetString() ?? "",
                        CorrectCategory = correctPlacements.ContainsKey(id) ? correctPlacements[id] : ""
                    });

                    // Aktualizovat čítač podle načtených ID (např. "item-5" -> 5)
                    if (id.StartsWith("item-") && int.TryParse(id.Substring(5), out var num))
                    {
                        _itemCounter = Math.Max(_itemCounter, num);
                    }
                }
            }
        }
        catch
        {
            // Ignorovat chyby parsování
        }
    }

    private void AddCategory()
    {
        var id = $"cat-{++_categoryCounter}";
        _categories.Add(new DragDropCategory
        {
            Id = id,
            Label = $"Kategorie {_categoryCounter}"
        });
    }

    private void RemoveCategory(string id)
    {
        _categories.RemoveAll(c => c.Id == id);
    }

    private void AddItem()
    {
        var id = $"item-{++_itemCounter}";
        _items.Add(new DragDropItem
        {
            Id = id,
            Text = $"Prvek {_itemCounter}",
            CorrectCategory = _categories.FirstOrDefault()?.Id ?? ""
        });
    }

    private void RemoveItem(string id)
    {
        _items.RemoveAll(i => i.Id == id);
        GenerateJson();
    }

    private void OnCategoryChanged(string itemId, string? categoryId)
    {
        var item = _items.FirstOrDefault(i => i.Id == itemId);
        if (item != null)
        {
            item.CorrectCategory = categoryId ?? "";
            GenerateJson();
        }
    }

    private void ClearAll()
    {
        _categories.Clear();
        _items.Clear();
        _categoryCounter = 0;
        _itemCounter = 0;
        GenerateJson();
    }

    private void GenerateJson()
    {
        // Config JSON
        var config = new
        {
            type = "drag-drop",
            items = _items.Select(i => new
            {
                id = i.Id,
                text = i.Text
            }),
            categories = _categories.Select(c => new
            {
                id = c.Id,
                label = c.Label
            })
        };

        var configJson = JsonSerializer.Serialize(config, new JsonSerializerOptions { WriteIndented = true });
        _lastLoadedConfigJson = configJson; // Aktualizovat před odesláním, aby se zabránilo reload
        ConfigJsonChanged.InvokeAsync(configJson);

        // Solution JSON
        var solution = new
        {
            correctPlacements = _items.Where(i => !string.IsNullOrEmpty(i.CorrectCategory))
                                      .ToDictionary(i => i.Id, i => i.CorrectCategory),
            explanation = "Správné zařazení prvků do kategorií"
        };

        var solutionJson = JsonSerializer.Serialize(solution, new JsonSerializerOptions { WriteIndented = true });
        _lastLoadedSolutionJson = solutionJson; // Aktualizovat před odesláním, aby se zabránilo reload
        SolutionJsonChanged.InvokeAsync(solutionJson);

        StateHasChanged();
    }

    private class DragDropCategory
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
    }

    private class DragDropItem
    {
        public string Id { get; set; } = "";
        public string Text { get; set; } = "";
        public string CorrectCategory { get; set; } = "";
    }
}
