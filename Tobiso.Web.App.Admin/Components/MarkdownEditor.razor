@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Forms
@using System.Linq.Expressions
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<div>
    <textarea id="@textareaId" class="form-control" style="display: none;">@Value</textarea>
    @if (For != null && CascadedEditContext != null)
    {
        <ValidationMessage For="For" />
    }
</div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; } = "Začněte psát váš Markdown obsah...";
    [Parameter] public int Rows { get; set; } = 10;
    [Parameter] public Expression<Func<string>>? For { get; set; }

    [CascadingParameter] EditContext? CascadedEditContext { get; set; }
    
    private FieldIdentifier FieldIdentifier;
    private string textareaId = $"markdown-editor-{Guid.NewGuid():N}";
    private IJSObjectReference? jsModule;
    private bool isInitialized = false;
    private bool hasHighlights = false;

    protected override void OnParametersSet()
    {
        if (For != null && CascadedEditContext != null)
        {
            FieldIdentifier = FieldIdentifier.Create(For);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeEditor();
        }
    }

    private async Task InitializeEditor()
    {
        try
        {
            // Načteme JavaScript modul pro Markdown editor
            jsModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/markdown-editor.js");
            
            // Inicializujeme editor
            var dotNetRef = DotNetObjectReference.Create(this);
            await jsModule.InvokeVoidAsync("initializeMarkdownEditor", textareaId, dotNetRef, Placeholder, Value ?? "");
            
            isInitialized = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Chyba při inicializaci Markdown editoru: {ex.Message}");
        }
    }

    [JSInvokable]
    public async Task OnContentChanged(string content)
    {
        Value = content;
        await ValueChanged.InvokeAsync(content);
    }

    public async Task SetValue(string content)
    {
        if (isInitialized && jsModule != null)
        {
            await jsModule.InvokeVoidAsync("setEditorValue", textareaId, content);
        }
        Value = content;
        // Notify parent binding of changed value
        await ValueChanged.InvokeAsync(content);
        // Notify EditContext (for validation) if present
        if (For != null && CascadedEditContext != null)
        {
            try
            {
                CascadedEditContext.NotifyFieldChanged(FieldIdentifier);
            }
            catch
            {
                // ignore notify errors
            }
        }
    }

    public async Task HighlightErrors(List<Tobiso.Web.Shared.DTOs.GrammarIssue> issues)
    {
        if (!isInitialized || jsModule == null) return;
        await jsModule.InvokeVoidAsync("highlightGrammarErrors", textareaId, issues);
        hasHighlights = issues != null && issues.Count > 0;
    }

    public async Task ClearHighlights()
    {
        if (!isInitialized || jsModule == null) return;
        await jsModule.InvokeVoidAsync("clearGrammarHighlights", textareaId);
        hasHighlights = false;
    }

    public async ValueTask DisposeAsync()
    {
        if (jsModule != null)
        {
            try
            {
                await jsModule.InvokeVoidAsync("disposeMarkdownEditor", textareaId);
                await jsModule.DisposeAsync();
            }
            catch (Exception)
            {
                // Ignore dispose errors
            }
        }
    }
}
