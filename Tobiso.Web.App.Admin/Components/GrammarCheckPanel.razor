@using Tobiso.Web.Shared.DTOs

<div class="panel grammar-panel" style="display:@(Issues?.Any() == true ? "block" : "none")">
    <div class="panel-header">Návrhy oprav</div>
    <div class="panel-body">
        @if (Issues == null || Issues.Count == 0)
        {
            <div class="grammar-ok">Žádné chyby nenalezeny.</div>
        }
        else
        {
            <ul class="grammar-issue-list">
                @foreach (var it in Issues)
                {
                    <li class="grammar-issue-item">
                        <strong>Originál:</strong> <code>@it.OriginalText</code>
                        <br />
                        <strong>Návrh:</strong> <code>@it.Correction</code>
                        <br />
                        <small class="grammar-issue-explanation">@it.Explanation</small>
                    </li>
                }
            </ul>
        }
    </div>
</div>

@code {
    [Parameter] public List<GrammarIssue>? Issues { get; set; }
}
