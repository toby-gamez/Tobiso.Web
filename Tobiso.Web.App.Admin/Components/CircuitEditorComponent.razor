@using System.Text.Json
@using Tobiso.Web.Shared.DTOs
@inject IJSRuntime JS

<div class="circuit-editor">
    <div class="circuit-columns">
        <div class="panel canvas-panel">
            <div class="panel-header"><i data-lucide="zap"></i> Editor obvodu</div>
            <div class="panel-body">
                <div class="canvas-container" style="position: relative;">
                    @foreach (var component in _components)
                    {
                        <div class="circuit-component @(component.Id == _selectedComponentId ? "selected" : "")"
                             style="position: absolute; left: @(component.X)px; top: @(component.Y)px;"
                             @onclick="() => SelectComponent(component.Id)"
                             draggable="true">
                            <div class="component-visual">
                                @GetComponentIcon(component.Type)
                                <div class="component-label">@component.Type</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="sidebar-stack">
            <div class="panel">
                <div class="panel-header">Dostupné komponenty</div>
                <div class="panel-body component-palette">
                    <button class="btn btn-secondary" @onclick='() => AddComponent("battery")'>
                        <i data-lucide="battery-charging"></i> Baterie
                    </button>
                    <button class="btn btn-secondary" @onclick='() => AddComponent("bulb")'>
                        <i data-lucide="lightbulb"></i> Žárovka
                    </button>
                    <button class="btn btn-secondary" @onclick='() => AddComponent("switch")'>
                        <i data-lucide="toggle-right"></i> Přepínač
                    </button>
                    <button class="btn btn-secondary" @onclick='() => AddComponent("resistor")'>
                        <i data-lucide="activity"></i> Odpor
                    </button>
                    <button class="btn btn-secondary" @onclick='() => AddComponent("wire")'>
                        <i data-lucide="minus"></i> Vodič
                    </button>
                </div>
            </div>

            @if (_selectedComponentId != null)
            {
                var component = _components.FirstOrDefault(c => c.Id == _selectedComponentId);
                if (component != null)
                {
                    <div class="panel">
                        <div class="panel-header">Vlastnosti: @component.Type</div>
                        <div class="panel-body properties-body">
                            <div class="field">
                                <label>ID</label>
                                <input type="text" class="input" @bind="component.Id" disabled />
                            </div>

                            @if (component.Type == "battery")
                            {
                                <div class="field">
                                    <label>Napětí (V)</label>
                                    <input type="number" class="input" @bind="component.Voltage" />
                                </div>
                            }
                            else if (component.Type == "bulb" || component.Type == "resistor")
                            {
                                <div class="field">
                                    <label>Odpor (Ω)</label>
                                    <input type="number" class="input" @bind="component.Resistance" />
                                </div>
                            }

                            <div class="field">
                                <label>X pozice</label>
                                <input type="number" class="input" @bind="component.X" />
                            </div>
                            <div class="field">
                                <label>Y pozice</label>
                                <input type="number" class="input" @bind="component.Y" />
                            </div>

                            <button class="btn btn-danger btn-sm properties-remove" @onclick="RemoveSelectedComponent">
                                <i data-lucide="trash-2"></i> Odstranit
                            </button>
                        </div>
                    </div>
                }
            }

            <div class="panel">
                <div class="panel-header">Akce</div>
                <div class="panel-body actions-body">
                    <button class="btn btn-secondary btn-sm" @onclick="GenerateJson">
                        <i data-lucide="code-2"></i> Generovat JSON
                    </button>
                    <button class="btn btn-danger btn-sm" @onclick="ClearAll">
                        <i data-lucide="x-circle"></i> Vymazat vše
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string ConfigJson { get; set; } = "{}";

    [Parameter]
    public EventCallback<string> ConfigJsonChanged { get; set; }

    private List<CircuitComponent> _components = new();
    private string? _selectedComponentId;
    private int _componentCounter = 0;

    protected override void OnParametersSet()
    {
        LoadFromJson();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("initLucide");
    }

    private void LoadFromJson()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(ConfigJson) || ConfigJson == "{}") return;

            var doc = JsonDocument.Parse(ConfigJson);
            if (doc.RootElement.TryGetProperty("components", out var componentsArray))
            {
                _components.Clear();
                foreach (var item in componentsArray.EnumerateArray())
                {
                    var component = new CircuitComponent
                    {
                        Id = item.GetProperty("id").GetString() ?? "",
                        Type = item.GetProperty("type").GetString() ?? "",
                        X = item.TryGetProperty("x", out var x) ? x.GetInt32() : 50,
                        Y = item.TryGetProperty("y", out var y) ? y.GetInt32() : 50
                    };

                    if (item.TryGetProperty("voltage", out var voltage))
                        component.Voltage = voltage.GetInt32();

                    if (item.TryGetProperty("resistance", out var resistance))
                        component.Resistance = resistance.GetInt32();

                    _components.Add(component);
                }
            }
        }
        catch
        {
            // Ignorovat chyby parsování
        }
    }

    private void AddComponent(string type)
    {
        var id = $"{type}-{++_componentCounter}";
        var component = new CircuitComponent
        {
            Id = id,
            Type = type,
            X = 50 + (_components.Count * 30),
            Y = 50 + (_components.Count * 30),
            Voltage = type == "battery" ? 12 : 0,
            Resistance = (type == "bulb" || type == "resistor") ? 6 : 0
        };

        _components.Add(component);
        _selectedComponentId = id;
        GenerateJson();
    }

    private void SelectComponent(string id)
    {
        _selectedComponentId = id;
    }

    private void RemoveSelectedComponent()
    {
        if (_selectedComponentId != null)
        {
            _components.RemoveAll(c => c.Id == _selectedComponentId);
            _selectedComponentId = null;
            GenerateJson();
        }
    }

    private void ClearAll()
    {
        _components.Clear();
        _selectedComponentId = null;
        _componentCounter = 0;
        GenerateJson();
    }

    private void GenerateJson()
    {
        var config = new
        {
            type = "circuit",
            components = _components.Select(c => new
            {
                id = c.Id,
                type = c.Type,
                x = c.X,
                y = c.Y,
                voltage = c.Voltage > 0 ? c.Voltage : (int?)null,
                resistance = c.Resistance > 0 ? c.Resistance : (int?)null
            }),
            availableComponents = new[]
            {
                new { type = "bulb", label = "Žárovka" },
                new { type = "resistor", label = "Odpor" },
                new { type = "switch", label = "Přepínač" },
                new { type = "wire", label = "Vodič" }
            }
        };

        var json = JsonSerializer.Serialize(config, new JsonSerializerOptions { WriteIndented = true });
        ConfigJsonChanged.InvokeAsync(json);
    }

    private RenderFragment GetComponentIcon(string type) => builder =>
    {
        var icon = type switch
        {
            "battery" => "battery-charging",
            "bulb" => "lightbulb",
            "switch" => "toggle-right",
            "resistor" => "activity",
            "wire" => "minus",
            _ => "help-circle"
        };

        builder.OpenElement(0, "i");
        builder.AddAttribute(1, "data-lucide", icon);
        builder.CloseElement();
    };

    private class CircuitComponent
    {
        public string Id { get; set; } = "";
        public string Type { get; set; } = "";
        public int X { get; set; }
        public int Y { get; set; }
        public int Voltage { get; set; }
        public int Resistance { get; set; }
    }
}
